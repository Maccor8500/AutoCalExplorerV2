procedure CreateJSONString(const Header : String; const Keys, Values : TStringList; var JSONString : string);
var JSONObject : TJSONObject;
    i: Integer;
    JSONid : String;
begin

  if (Keys = NIL) or (Values = NIL) then
  begin
    showMessage('Either keys or values is uninitialized');
    Exit;
  end;

  if Values.Count <> Keys.Count then
  begin
    ShowMessage('Uneven items in keys and values');
    Exit;
  end;

  Randomize;
  JSONid := IntToStr(Random(37273));
  JSONObject := TJSONObject.Create;

  try
    for i := 0 to Keys.Count -1 do
      JSONObject.AddPair(Keys[i], TJSONString.Create(Values[i]));

    JSONString := JSONObject.ToString;
  finally
    JSONObject.Free;
  end;

  JSONString :='{'+ Header + JSONString + ',"id":'+ JSONid +'}';
end;

function ParseToJSONObject(const JSONStr: string): TJSONObject;
var
  Val: TJSONValue;
begin
  Result := nil;
  if JSONStr.Trim = '' then Exit;
  Val := TJSONObject.ParseJSONValue(JSONStr);
  if (Val = nil) then Exit;

  if Val is TJSONObject then Result := TJSONObject(Val)
  else
  begin
    Val.Free;
    Result := nil;
  end;
end;

