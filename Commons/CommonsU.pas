function PadStr(const Str : String; const Len : Integer; const Pos : TStrPadPosition) : String;
var
  i, SLen : Integer;
  X : String;
begin
  Result := Str;
  X := '';

  SLen := Length(Str);
  for i := 0 to (Len -SLen) do
    X := X + ' ';

  case Pos of
    spRight: Result := Result +X;
    spLeft: Result := X +Result;
  end;
end;

procedure PadStr(var Str : String; const Len : Integer; const PadChar: Char; const Pos : TStrPadPosition);
var
  i, SLen : Integer;
  X : String;
begin
  X := '';

  SLen := Length(Str);
  for i := 0 to (Len -SLen) do
    X := X + PadChar;

  case Pos of
    spRight: Str := Str +X;
    spLeft: Str := X +Str;
  end;
end;

function IntToStrPad(const I : Integer; PadChar: Char = '0'; PadLen : Integer = 1) : String;
var
  J : Integer;
  S : String;
begin
  Result := '';
  S := Result;

  if TryIntToStr(I, S) then
  begin
    for J := 1 to PadLen do
      Result := Result + PadChar;

    AddStr(Result, S);
  end;
end;

function GenerateMd5Hash(const path : String) : String;
var
  idmd5 : TIdHashMessageDigest5;
  fs : TFileStream;
begin
  Result := '';

  if FileExists(path) then
  begin
    idmd5 := TIdHashMessageDigest5.Create;
    fs := TFileStream.Create(path, fmOpenRead + fmShareDenyWrite);
    fs.Seek(0, soFromBeginning);

    try
       Result := idmd5.HashStreamAsHex(fs);
    finally
      fs.Free;
      idmd5.Free;
    end;
  end
end;

procedure GenerateMd5Hash(const path : String; var Md5Hash : String);
begin
  Md5Hash := GenerateMd5Hash(Path);
end;

function EightBitChecksum(const path: String): String;
var
  Reader : TFileReader;
  Str : String;
  Len : SmallInt;
begin
  Str := '';
  Result := Str;

  if FileExists(path) then
  begin
    Reader := TFileReader.Create(path);

    try
      while Reader.Read(Str) = 0 do
      begin
        // Get Last Byte Hex
        Str := Trim(Str);
        Len := Length(Str);
        if Len <= 0 then continue;
        Str := Copy(Str, Length(Str) -2);
        //LineSum := StrToInt(format('$%s', [Str, Len]));
      end;
    finally
      Reader.Free;
    end;
  end;
end;

