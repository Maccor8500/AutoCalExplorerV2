class function TMaccorSystem.GetChanInfo(const Chan: NativeInt; const Brd: PBrdTypeStruct; PassValue: PCurrency): String;
var
  Module: TMaccorPowerRangeModule;
  ActiveChans: TMaccorActiveChans;
  BrickStr: String;

const
  POINT05: Currency = 0.05;
  POINT02: Currency = 0.02;
begin
  ActiveChans := TMaccorActiveChans(Brd^.ActiveChan);
  BrickStr := EmptyString;

  case MacSysPtr^.SysId of
    tLabSystem, t8500:
    begin
      case ActiveChans of
        macOne:
        begin
          case TMaccorBrickType(Brd^.BrdType) of
            btrMultiHS: BrickStr := format('[%d]  Multi-HS', [Brd^.BrdType]);
            btrSingleHS: BrickStr := format('[%d]  Single-HS', [Brd^.BrdType]);
            btrH3: BrickStr := format('[%d]  H3', [Brd^.BrdType]);
            btrH2: BrickStr := format('[%d]  H2', [Brd^.BrdType]);
          end;
        end;

        else
        begin
          case TMaccorBrickType(Brd^.BrdType) of
            btrSingle: BrickStr := format('[%d]  Single', [Brd^.BrdType]);
            btrMulti: BrickStr := format('[%d]  Multi', [Brd^.BrdType]);
            btrH3: BrickStr := format('[%d]  H3', [Brd^.BrdType]);
            btrH2: BrickStr := format('[%d]  H2', [Brd^.BrdType]);
          end;
        end;
      end;

      if BrickStr <> '' then
      begin
        Module := TMaccorPowerRangeModule(Brd^.SpecialRange);

        case Module of
          prmNormal:
          begin
            BrickStr := format('%s<2CHMR>', [BrickStr]);
            if Assigned(PassValue) then PassValue^ := POINT02;
          end;

          prmDual, prmTriple, Xjsdf, prmHyperSwitch:
          begin
            BrickStr := format('%s<VER. 6>', [BrickStr]);
            if Assigned(PassValue) then PassValue^ := POINT05;
          end;
        end;
      end;
    end;

    t50msPrimaryHV, tFormation:
    begin
      case TMaccorBrickType(Brd^.BrdType) of
        btrSingle: BrickStr := format('[%d]  Single', [Brd^.BrdType]);
        btrMulti: BrickStr := format('[%d]  Multi', [Brd^.BrdType]);
      end;

      case MacSysPtr^.SysId of
        t50msPrimaryHV: BrickStr := format('%s<50ms>', [BrickStr]);
        tFormation: BrickStr := format('%s<500ms>', [BrickStr]);
      end;

      if Assigned(PassValue) then PassValue^ := POINT05;
    end;
  end;

  Result := BrickStr;
end;

class function TMaccorSystem.GetBoardPassValue(const BrdNum: Integer): Currency;
var
  Module: TMaccorPowerRangeModule;
  Brd: PBrdTypeStruct;

const
  POINT05: Currency = 0.05;
  POINT02: Currency = 0.02;
begin
  Result := POINT02;
  Brd := @MacSysPtr^.BrdDataNorm[BrdNum];

  case MacSysPtr^.SysId of
    tLabSystem:
    begin
      Module := TMaccorPowerRangeModule(Brd^.SpecialRange);

      case Module of
        prmNormal: Result := POINT02;
        prmDual, prmTriple, Xjsdf, prmHyperSwitch: Result := POINT05;
      end;
    end;

    t50msPrimaryHV: Result := POINT05;
    t8500: Result := POINT05;
  end;
end;

