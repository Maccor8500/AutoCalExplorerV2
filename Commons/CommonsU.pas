function TUdpSocketEx.SetReceiveBuffer(const Size: Integer): Boolean;
var
  T: UInt64;
begin
  Result := False;
  WSAEventSelect(Sock, WSAEvent, 0);
  T := GetTickCountEx(50);
  while (SocketActive) or (GetTickCountEx < T) do;

  try
    AltBufferSize := Size;
    AltRxBuffer := (Size > 0) and (Size > 0);
    if not AltRxBuffer then Exit;
    SetLength(AltBuffer, Size);
    Result := AltRxBuffer and (Length(AltBuffer) = AltBufferSize);
    if Result then
    begin
      AltBufferPtr := @AltBuffer[0];
      Fill(AltBufferPtr, 0, AltBufferSize);
    end;
  finally
    WSAEventSelect(Sock, WSAEvent, SocketEventFlags);
  end;
end;

