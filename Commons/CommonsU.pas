  result := ifSock.GetSocket <> INVALID_SOCKET;
end;

function TTCPClient.GetAddress: string;
begin
  result := ifSock.GetServerAddress;
end;

procedure TTCPClient.SetAddress( sAddr: string );
begin
  ifSock.SetServerAddress( sAddr );
end;

procedure TTCPClient.SetPort( sPort: string );
begin
  ifSock.SetPort( sPort );
end;

function TTCPClient.GetPort: string;
begin
  result := ifSock.GetPort;
end;

procedure TTCPClient.ExecProc;
begin
  if ifSock.CanRead then
  begin
    ptrMess := ifSock.ReceiveData( iMessSize );
    if ptrMess <> nil then
    begin
      MultiReadExclusiveWriteSynchronizer.BeginWrite;
      QueryPerformanceCounter(LastReceiveReceivedCNTvar);
      MultiReadExclusiveWriteSynchronizer.EndWrite;

      if Synchronized then
        Synchronize( DataAvailable )
      else
        DataAvailable;
    end;
  end;
end;

procedure TTCPClient.DataAvailable;
begin
  if Assigned( FOnDataAvailable )then
    FOnDataAvailable( ptrMess, iMessSize );
end;

{ THxBlockServer }

function THxBlockServer.Accept: TSocket;
var
  iLen: integer;
begin
  if sktSocket = INVALID_SOCKET then
    sktSocket := Socket( AF_INET, SOCK_STREAM, IPPROTO_TCP );

  iLen := SizeOf( rRemoteAddress );
  result := winsock.accept( sktSocket, @rRemoteAddress, @iLen );
end;

procedure THxBlockServer.Listen;
begin
  if sPortNr = UNSET then
    raise Exception.Create('Server-port not set');

  if sktSocket = INVALID_SOCKET then
    sktSocket := Socket( AF_INET, SOCK_STREAM, 0 );

  if sktSocket = INVALID_SOCKET then
    raise Exception.Create( GetSocketLastError );

  rServerAddress.sin_family := AF_INET;
  rServerAddress.sin_addr.S_addr := INADDR_ANY;

  if winsock.bind( sktSocket, rServerAddress, Sizeof( rServerAddress ))<> 0 then
    raise Exception.Create( GetSocketLastError );

  if winsock.listen( sktSocket, SOMAXCONN )<> 0 then
    raise Exception.Create( GetSocketLastError );

  bConnected := True;
end;

procedure THxBlockSocket.SetSocket( skt: TSocket );
begin
  if sktSocket <> INVALID_SOCKET then
    Disconnect;

  if skt <> INVALID_SOCKET then
  begin
    sktSocket := skt;
    bConnected := True;
  end;
end;

procedure THxBlockServer.SetListening( bValue: boolean );
begin
  if bValue = bConnected then
    exit;

  if bValue then
    Listen
  else
    Disconnect;
end;

{ THxTcpServer }

constructor TTCPServer.Create;
begin
  inherited;

  iLastNewClient := -1;
  bsSvr := THxBlockServer.Create( Self );

  thdConnections := THxConnThread.Create( Self );
end;

destructor TTCPServer.Destroy;
begin
  inherited;

  if Assigned( thdConnections )then
    thdConnections.Free;

  if Assigned( bsSvr )then
    bsSvr.Free;
end;

procedure TTCPServer.ExecProc;
begin
  if( bsSvr.Listening )and( bsSvr.CanRead )then
    AcceptConnection;
end;

procedure TTCPServer.AcceptConnection;
var
  blkS: THxBlockSocket;
  skt: TSocket;
  iDescr: integer;
begin
  skt := bsSvr.Accept;

  if skt = INVALID_SOCKET then
    exit;

  blkS := THxBlockSocket.Create( self );
  blkS.SetSocket( skt );

  iDescr := thdConnections.AddConnection( blkS );

  if thdConnections.Suspended then
    thdConnections.Suspended := False;

  NewClientSync( iDescr );
end;

function TTCPServer.GetPort: string;
begin
  result := bsSvr.GetPort;
end;

procedure TTCPServer.SetPort(const Value: string);
begin
  if bsSvr.Listening then
  begin
    if not( Suspended )then
      Suspended := True;
    bsSvr.Listening := False;
    bsSvr.SetPort( Value );
    Listen;
  end
  else
    bsSvr.SetPort( Value );
end;

procedure TTCPServer.Listen;
begin
  if Suspended then
  begin
    bsSvr.Listening := True;
    Suspended := False;
  end;
end;

procedure TTCPServer.NewClientSync( iDescr: integer );
begin
  iLastNewClient := iDescr;
  Synchronize( NewClient );
  iLastNewClient := -1;
end;

procedure TTCPServer.ClientAbortedSync( iDescr: integer );
begin
  iLastAbortedClient := iDescr;
  Synchronize( ClientAborted );
  iLastAbortedClient := -1;
end;

procedure TTCPServer.ClientAborted;
begin
  if Assigned( FOnClientAborted )then
    FOnClientAborted( iLastAbortedClient );
end;

procedure TTCPServer.NewClient;
begin
  if Assigned( FOnNewClient )then
    FOnNewClient( iLastNewClient );
end;

procedure TTCPServer.DataAvailable;
begin
  if Assigned( FOnDataAvailable )then
    FOnDataAvailable( pLastMessPtr, iLastMessSize, iLastDescr );
end;

procedure TTCPServer.DataAvailableSync( ptr: pointer; iSize, iDescr: integer );
begin
  pLastMessPtr := ptr;
  iLastMessSize := iSize;
  iLastDescr := iDescr;

  Synchronize( DataAvailable );
end;

