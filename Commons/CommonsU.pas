{TSpinLockEx}
procedure TSpinLockEx.Lock(SPIN_ITERATIONS: Integer = 40);
var
  Iteration: Integer;
begin
  Iteration := 0;
  while TInterlocked.CompareExchange(FLock, 1, 0) <> 0 do
  begin
    if (Iteration < SPIN_ITERATIONS) then YieldProcessor
    else Sleep(1);
    Inc(Iteration);
  end;
end;

procedure TSpinLockEx.Unlock;
begin
  TInterlocked.Exchange(FLock, 0);
end;

{ TQueueEx<T> }
constructor TQueueEx<T>.Create;
begin
  Create(100000);
  inherited Create;
end;

procedure TQueueEx<T>.Clear;
begin
  Lock;
  try
    FQueue.Clear;
  finally
    UnLock;
  end;
end;

{ TQueueEx:: deprecated... use TThreadedQueue going forward }
constructor TQueueEx<T>.Create(const depth: Integer);
var
  i: Integer;
begin
  FCount := 0;
  InitializeCriticalSection(CriticalSection);
  FQueue := TQueue<T>.Create;
  FQueue.Capacity := Depth;
  FQueue.Clear;
  StartTime := GetTickCountEx;
end;

function TQueueEx<T>.Dequeue: T;
begin
  Lock; {Lock!}

  try
    Result := Default(T);
    if FQueue.Count <> 0 then
    begin
      Dec(FCount);
      Exit(FQueue.Dequeue);
    end;
  finally
    UnLock; {Un-Lock!}
  end;
end;

function TQueueEx<T>.ToArray: TArray<T>;
begin
  if Assigned(FQueue) and (FQueue.Count > 0) then Result := FQueue.ToArray
  else Result := nil;
end;

function TQueueEx<T>.TryDequeue(var item: T): boolean;
begin
  Lock;
  try
    item := Default(T);
    Result := (FQueue.Count > 0);
    if not Result then Exit;
    Item := FQueue.Dequeue;
    FCount := FQueue.Count;
  finally
    UnLock;
  end;
end;

function TQueueEx<T>.TryDequeueEx(var item: T; var Time: Single): boolean;
var
  Freq, Time1, Time2: Comp;
begin
  Time := 0;
  Result := False;
  if not QueryPerformanceFrequency(TLargeInteger((@Freq)^)) then Exit;

  QueryPerformanceCounter(TLargeInteger((@Time1)^));
  Result := TryDequeue(item);
  QueryPerformanceCounter(TLargeInteger((@Time2)^));
  Time := (Time2 - Time1)/Freq;
end;

destructor TQueueEx<T>.Destroy;
begin
  FQueue.Clear;
  FreeAndNil(FQueue);
  DeleteCriticalSection(CriticalSection);

  inherited Destroy;
end;

function TQueueEx<T>.Empty: Boolean;
begin
  Lock;
  try
    Result := (FQueue.Count = 0);
  finally
    UnLock;
  end;
end;

procedure TQueueEx<T>.Enqueue(const item: T);
var
  L : Integer;
begin
  Lock;
  try
    FQueue.Enqueue(item);
    FCount := FQueue.Count;
  finally
    UnLock;
  end;
end;

procedure TQueueEx<T>.EnqueueEx(const item: T; var Time: Single);
var
  Freq, Time1, Time2: Comp;
begin
  Time := 0;
  if not QueryPerformanceFrequency(TLargeInteger((@Freq)^)) then Exit;

  QueryPerformanceCounter(TLargeInteger((@Time1)^));
  EnQueue(item);
  QueryPerformanceCounter(TLargeInteger((@Time2)^));
  Time := (Time2 - Time1)/Freq;
end;

function TQueueEx<T>.GetCapacity: Integer;
begin
  Result := FQueue.Capacity;
end;

function TQueueEx<T>.GetCount: Integer;
begin
  Lock;
  try
    Result := FCount;
  finally
    UnLock;
  end;
end;

function TQueueEx<T>.ItemSize: Integer;
begin
  Result := SizeOf(T);
end;

procedure TQueueEx<T>.Lock;
begin
  EnterCriticalSection(CriticalSection);
end;

procedure TQueueEx<T>.UnLock;
begin
  LeaveCriticalSection(CriticalSection);
end;

procedure TQueueEx<T>.Resize(const depth: Integer);
begin
  if depth <= FQueue.Capacity then Exit;
  FQueue.Capacity := depth;
end;

{ TRegistryWriterEx }
constructor TRegistryWriterEx.Create(const Base : String; Key : HKEY; Access : LongWord);
begin
  R := TRegistry.Create(Access);
  R.RootKey := Key;
  BasePath := Base;
end;

procedure TRegistryWriterEx.DeletePath(const Path: String);
var
  Options, Desired : Cardinal;
  KeyHandle: HKEY;
  LPath : String;
begin
  LPath := Format('%s\%s', [BasePath, Path]);
  KeyHandle := 0;
  Options := 0;
  Desired := (KEY_SET_VALUE);

  try
    { open:  }
    RegOpenKeyExA(R.RootKey, PAnsiChar(AnsiString(LPath)), Options, Desired, KeyHandle);
    { delete the key }
    if RegDeleteKey(R.RootKey, PChar(LPath)) = ERROR_SUCCESS then
      { notify the shell of the change }
      SHChangeNotify(SHCNE_DELETE, SHCNF_PATH, PChar(LPath), nil);

    { Close handle }
    RegCloseKey(KeyHandle);
  except
    On E: Exception do
      ShowDialog(dtInfo, E.Message);
  end;
end;

destructor TRegistryWriterEx.Destroy;
begin
  FreeAndNil(R);
end;

procedure TRegistryWriterEx.SetPath(const Path: String; UpdateBase : Boolean);
var
  NewPath : String;
begin
  if Trim(Path) = '' then Exit;

  { over-write current path }
  if (not UpdateBase) then NewPath := format('%s\%s', [BasePath, Path])
  { path gets deeper/different }
  else
  begin
    if RegPath = '' then NewPath := Path
    else NewPath := format('%s\%s', [RegPath, Path]);
  end;
  RegPath := NewPath;
end;

procedure TRegistryWriterEx.Write(Key: String; Buf: Pointer; const Len : UInt32);
begin
  if Trim(RegPath) = '' then SetPath(BasePath, True);
  if R.Access <> KEY_ALL_ACCESS then R.Access := KEY_ALL_ACCESS;

  if R.OpenKey(RegPath, True) then
  begin
    try
      try
        if R.KeyExists(Key) then
          if R.DeleteKey(Key) then
            R.WriteBinaryData(Key, Buf, Len);
      finally
        R.CloseKey;
      end;
    except
      On E: Exception do
        ShowDialog(dtInfo, E.Message);
    end;
  end;
end;

