function WriteTextFile(const Path: String; const Content: AnsiString; Append: Boolean): Boolean;
var
  F: TextFile;
begin
{$I-}
  try
    AssignFile(F, Path);

    try
      if Append then
      begin
        if not FileExists(Path) then ReWrite(F)
        else Reset(F);
      end

      else ReWrite(F);

      WriteLn(F, Content);
      Result := True;
    finally
      CloseFile(F);
    end;

  except
    On E: Exception do
      Result := False;
  end;
end;

function AbbreviateFilePath(const FileName: string; Depth: Byte = 1): String;
var
  Dir: string;
  Part: string;
  I: Byte;
begin
  Result := ExtractFileName(FileName);

  if (Result = '') or (Depth = 0) then Exit;

  Dir := ExcludeTrailingPathDelimiter(ExtractFileDir(FileName));

  for I := 1 to Depth do
  begin
    Part := ExtractFileName(Dir);
    if Part = '' then Break;

    Result := Part + PathDelim + Result;
    Dir := ExcludeTrailingPathDelimiter(ExtractFileDir(Dir));
  end;

  if Result <> ExtractFileName(FileName) then
    Result := '...' + PathDelim +Result;
end;

