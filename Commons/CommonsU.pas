{ legacy floats arrive unvetted <blank flash reads back as QNaN> :: repaired
  and naturalized at import, our records carry no non-numbers past this
  boundary. Default 0 leaves a legitimate zero untouched }
procedure Naturalize(var F: Single; const Default: Single); overload;
begin
  if IsNan(F) or IsInfinite(F) or (F = 0) then F := Default;
end;

procedure Naturalize(var F: Double; const Default: Double); overload;
begin
  if IsNan(F) or IsInfinite(F) or (F = 0) then F := Default;
end;

procedure GetSysChanConfig(MacEnv: PMaccorSystem);
var
  S : TFileStream;
  Chan, DataSz: Integer;
begin
  { reset this first }
  SetLength(MacEnv^.ChanData, 0);
  if (not FileExists(MacEnv^.ChCfgFile)) or (MacEnv = nil) then Exit;
  DataSz := SizeOf(ChParm);

  S := TFileStream.Create(MacEnv^.ChCfgFile, fmOpenRead +fmShareDenyNone);
  try
    S.Seek(0, soFromBeginning);
    SetLength(MacEnv^.ChanDataNorm, Round(S.Size /DataSz));
    SetLength(MacEnv^.ChanData, Length(MacEnv^.ChanDataNorm));

    { read the rest of 'em! }
    for Chan := Low(MacEnv^.ChanData) to High(MacEnv^.ChanData) do
    begin
      if S.Read(MacEnv^.ChanDataNorm[Chan], DataSz) = DataSz then
      begin
        { fix blanks + naturalize <slopes/ratios: 0 or NaN/Inf -> identity;
          offsets/limits: NaN/Inf -> 0, a real zero stays> }
        with MacEnv^.ChanDataNorm[Chan] do
        begin
          Naturalize(chg.Islope3, 1);   Naturalize(chg.Ioffset3, 0);
          Naturalize(chg.Islope2, 1);   Naturalize(chg.Ioffset2, 0);
          Naturalize(chg.Islope1, 1);   Naturalize(chg.Ioffset1, 0);
          Naturalize(chg.Islope,  1);   Naturalize(chg.Ioffset,  0);
          Naturalize(dis.Islope3, 1);   Naturalize(dis.Ioffset3, 0);
          Naturalize(dis.Islope2, 1);   Naturalize(dis.Ioffset2, 0);
          Naturalize(dis.Islope1, 1);   Naturalize(dis.Ioffset1, 0);
          Naturalize(dis.Islope,  1);   Naturalize(dis.Ioffset,  0);

          Naturalize(chg.Imax, 0.1);
          Naturalize(chg.Ilim, 0.1);
          { dis Imax/Ilim were never zero-repaired :: NaN-guard only }
          Naturalize(dis.Imax, 0);
          Naturalize(dis.Ilim, 0);

          Naturalize(chg.IoutSlope4, 1); Naturalize(chg.IoutOffset4, 0);
          Naturalize(chg.IoutSlope3, 1); Naturalize(chg.IoutOffset3, 0);
          Naturalize(chg.IoutSlope2, 1); Naturalize(chg.IoutOffset2, 0);
          Naturalize(chg.IoutSlope1, 1); Naturalize(chg.IoutOffset1, 0);
          Naturalize(dis.IoutSlope4, 1); Naturalize(dis.IoutOffset4, 0);
          Naturalize(dis.IoutSlope3, 1); Naturalize(dis.IoutOffset3, 0);
          Naturalize(dis.IoutSlope2, 1); Naturalize(dis.IoutOffset2, 0);
          Naturalize(dis.IoutSlope1, 1); Naturalize(dis.IoutOffset1, 0);

          Naturalize(chg.Vslope, 1);    Naturalize(chg.Voffset, 0);
          Naturalize(dis.Vslope, 1);    Naturalize(dis.Voffset, 0);

          Naturalize(chg.Vsafe, 0);  Naturalize(chg.Plim, 0);  Naturalize(chg.PmaxBr, 0);  Naturalize(chg.Vps, 0);
          Naturalize(dis.Vsafe, 0);  Naturalize(dis.Plim, 0);  Naturalize(dis.PmaxBr, 0);  Naturalize(dis.Vps, 0);
          Naturalize(minV, 0);
          Naturalize(maxV, 0);

          { ratios :: CreateChanConfig defaults }
          Naturalize(chg.Ratio1, 33333.331750085);
          Naturalize(chg.Ratio2, 1000.00002235174);
          Naturalize(chg.Ratio3, 33.3333320087857);
          Naturalize(chg.Ratio4, 1);
          Naturalize(dis.Ratio1, 33333.331750085);
          Naturalize(dis.Ratio2, 1000.00002235174);
          Naturalize(dis.Ratio3, 33.3333320087857);
          Naturalize(dis.Ratio4, 1);
        end;
        if MacEnv^.ChanDataNorm[Chan].Chg.Ratio_int = 0 then MacEnv^.ChanDataNorm[Chan].Chg.Ratio_int := 33333; //-32203 in VB6 (VB integer -> Delphi word)
        if MacEnv^.ChanDataNorm[Chan].Chg.Ratio_int1 = 0 then MacEnv^.ChanDataNorm[Chan].Chg.Ratio_int1 := 999;
        if MacEnv^.ChanDataNorm[Chan].Chg.Ratio_int2 = 0 then MacEnv^.ChanDataNorm[Chan].Chg.Ratio_int2 := 33;
        if MacEnv^.ChanDataNorm[Chan].Chg.ratio_int3 = 0 then MacEnv^.ChanDataNorm[Chan].Chg.ratio_int3 := 1;
        if MacEnv^.ChanDataNorm[Chan].Chg.Ratio_frac = 0 then MacEnv^.ChanDataNorm[Chan].Chg.Ratio_frac := 21741;
        if MacEnv^.ChanDataNorm[Chan].Chg.Ratio_frac1 = 0 then MacEnv^.ChanDataNorm[Chan].Chg.Ratio_frac1 := 65535; //-1 in VB6
        if MacEnv^.ChanDataNorm[Chan].Chg.Ratio_frac2 = 0 then MacEnv^.ChanDataNorm[Chan].Chg.Ratio_frac2 := 21845;
        if MacEnv^.ChanDataNorm[Chan].Chg.ratio_frac3 = 0 then MacEnv^.ChanDataNorm[Chan].Chg.ratio_frac3 := 0;
        if MacEnv^.ChanDataNorm[Chan].Dis.Ratio_int = 0 then MacEnv^.ChanDataNorm[Chan].Dis.Ratio_int := 33333; //-32203 in VB6
        if MacEnv^.ChanDataNorm[Chan].Dis.Ratio_int1 = 0 then MacEnv^.ChanDataNorm[Chan].Dis.Ratio_int1 := 999;
        if MacEnv^.ChanDataNorm[Chan].Dis.Ratio_int2 = 0 then MacEnv^.ChanDataNorm[Chan].Dis.Ratio_int2 := 33;
        if MacEnv^.ChanDataNorm[Chan].Dis.ratio_int3 = 0 then MacEnv^.ChanDataNorm[Chan].Dis.ratio_int3 := 1;
        if MacEnv^.ChanDataNorm[Chan].Dis.Ratio_frac = 0 then MacEnv^.ChanDataNorm[Chan].Dis.Ratio_frac := 21741;
        if MacEnv^.ChanDataNorm[Chan].Dis.Ratio_frac1 = 0 then MacEnv^.ChanDataNorm[Chan].Dis.Ratio_frac1 := 65535; //-1 in VB6
        if MacEnv^.ChanDataNorm[Chan].Dis.Ratio_frac2 = 0 then MacEnv^.ChanDataNorm[Chan].Dis.Ratio_frac2 := 21845;

        { clear VBChParm }
        MacSysPtr^.ChanData[Chan] := Default(TVBChParm);

        with MacSysPtr^.ChanData[Chan] do
        begin
          number := MacEnv^.ChanDataNorm[Chan].number;
          chg := MacEnv^.ChanDataNorm[Chan].chg;
          dis := MacEnv^.ChanDataNorm[Chan].dis;
          minV := MacEnv^.ChanDataNorm[Chan].minV;
          maxV := MacEnv^.ChanDataNorm[Chan].maxV;
        end;
      end;
    end;

    S.Seek(0, soFromBeginning);
    SetLength(MacSysPtr^.ChanDataBackup, S.Size);
    S.Read(MacSysPtr^.ChanDataBackup[0], S.Size);
  finally
    FreeAndNil(S);
  end;
end;

procedure GetExtChanConfig(MacEnv: PMaccorSystem);
var
  S: TFileStream;
  i, Chan, DataSz: Integer;
  ExtData: TExtParam;
begin
  if not FileExists(MacSys.ExtCfgFile) then Exit;
  DataSz := SizeOf(TExtParam);

  S := TFileStream.Create(MacSys.ExtCfgFile, fmOpenRead + fmShareDenyNone);
  try
    S.Seek(0, soFromBeginning);
    Chan := Round(S.Size /DataSz);
    SetLength(MacEnv.ExtData, Chan);
    SetLength(MacEnv.ExtDataNorm, Chan);

    for Chan := Low(MacEnv.ExtDataNorm) to High(MacEnv.ExtDataNorm) do
    begin
      if S.Read(ExtData, DataSz) = DataSz then
      begin
        MacEnv.ExtData[Chan] := Default(TVBExtParam);
        MacEnv.ExtDataNorm[Chan] := ExtData;

        with MacEnv.ExtData[Chan] do
        begin
          mode := ExtData.Mode;
          ECCmax := ExtData.ECCmax;
          ELCmax  := ExtData.ELCmax;
          ECCslope := ExtData.ECCslope;
          ECCoffset := ExtData.eccoffset;
          ELCslope := ExtData.elcslope;
          ELCoffset := ExtData.ELCoffset;
          for i := 1 to 18 do Idt[i] := WideChar(ExtData.Idt[i]);
          for i := 1 to 18 do Vdt[i] := WideChar(ExtData.Vdt[i]);
          for i := 1 to 18 do Extdt[i] := WideChar(ExtData.Extdt[i]);
          Flags := ExtData.Flags;
          EPCslope := ExtData.EPCslope;
          EPCoffset := ExtData.EPCoffset;
          D3 := ExtData.D3;
          D4 := ExtData.D4; //LowVoltDisOffset As Single
          SlowChannel := ExtData.SlowChannel;
          ECCmaxV := ExtData.ECCMaxV;
          ECCminV := ExtData.EccMinV;
          ELCmaxV := ExtData.ELCmaxV;
          ELCminV := ExtData.ELCminV;
          for i := 1 to 14 do Spare[i] := WideChar(ExtData.Spare[i]);
          BrdNr := ExtData.BrdNr;
          BrdPos := ExtData.BrdPos;
        end;
      end;
    end;

