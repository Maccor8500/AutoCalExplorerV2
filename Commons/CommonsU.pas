begin
  LeaveCriticalSection(Lock);
end;

{ TFTPClient }
constructor TFTPSocket.Create(const ConnType : TTFTPConnection; Timeout : Integer = 0; Callback : TProgressCallback = nil);
var
  Port : String;
begin
  ProgressCallback := Callback;
  Self.Timeout := IntTernary((Timeout > 0), Timeout, 1);

  try
    Socket := TUDPSocket.Create;

    with Socket do
    begin
      Port := IntToStr(TFTP_SERVER_PORT);
      DestinationAddress := '';

      case ConnType of
        tftpClient:
        begin
          Socket.DestinationPort := Port;
          //Socket.ListeningPort := PortManager.GetPort;
        end;

        tftpServer:
        begin
          if Socket.ListeningPort <> '' then
            //PortManager.Release(Socket.ListeningPort);
          Socket.ListeningPort := Port;
        end;
      end;

      Synchronized := false;
      OnDataAvailable := OnDataRecvd;
      Suspended := false;
    end;
  except
    On E: Exception do { eat it! }
  end;
end;

destructor TFTPSocket.Destroy;
begin
  { kill current operation }
  if Busy then
  begin
    Terminate := True;
    while Busy do;
  end;

  FreeAndNil(Socket);
  while(Assigned(Socket)) do;
  inherited;
end;

procedure TFTPSocket.AsyncPut(const file_path, Address : String;
  Callback: TAsyncCallback = nil);
begin
  TThread.CreateAnonymousThread(
  procedure
  var
    Err: TTFTPError;
  begin
    Err := Put(file_path, Address);
    if (Assigned(Callback)) then CallBack(Err);
  end).Start;
end;

procedure TFTPSocket.AsyncPut(const file_path: String; Address: ShortString;
  Callback : TTaggedProgressCallback);
begin
  TaggedCallback := Callback;
  Put(file_path, String(Address));
end;

function TFTPSocket.Put(const file_path : String; Address: string = ''; Progress : PWord = nil) : TTFTPError;
var
  Stream : TFileStream;
  Read, Block, TxLen, OpCode, TxProgress : Word;
begin
  Busy := True;
  Terminate := False;
  Result.Msg := '';

  try
    { set address }
    if Trim(Address) <> '' then
      if Socket.DestinationAddress <> Address then
        Socket.DestinationAddress := Trim(Address);

    { initial pre-check! }
    Result.Code := ecInvalidAddress;
    { check valid address : avoids raising bad address exception from UDP }
    if Not ValidAddress(Socket.DestinationAddress) then Exit;
    Result.Code := ecAddressUnreachable;
    if not (Ping(AnsiString(Socket.DestinationAddress)) and Ping(AnsiString(Socket.DestinationAddress))) then Exit;
    Result.Code := ecFileNotFound;
    { check file is actually on disk! }
    if not FileExists(file_path) then Exit;

    try
      { assume it will be fine }
      Result.Code := ecSuccessful;
      { clean tx }
      TxData := Default(TTFTPPacket);
      { open stream handle to file }
      Stream := TFileStream.Create(file_path, fmOpenRead + fmShareDenyNone);
      { go to file origin }
      Stream.Seek(0, soFromBeginning);

      { send WRQ }
      SendWriteRequest(ExtractFilename(file_path), dmOctet);
      { wait for ACK }
      AwaitResponse(@DataArrived, Timeout);
      { still intrested? }
      if Terminate then Exit;

      { if We received ack. code }
      repeat
        { reset read }
        Read := 0;

        if DataArrived then
        begin
          { get opcode }
          OpCode := (RxData^.AsAck.OpCode[0] shl 8) +RxData^.AsAck.OpCode[1];
          { get block }
          Block := (RxData^.AsAck.Block[0] shl 8) +RxData^.AsAck.Block[1];

          { go send next chunk }
          if (OpCode = TFTP_ACKNOWLEDGE) then
          begin
            { read from Stream }
            Read := Stream.Read(TxData.AsData.Payload, TFTP_DATA_SIZE);
            { update opcode }
            TxData.AsData.OpCode[0] := 0;
            TxData.AsData.OpCode[1] := TFTP_DATA;
            { update data block }
            Inc(Block);
            TxData.AsData.Block[0] := Block shr $08;
            TxData.AsData.Block[1] := Block and $FF;
            { reset flag }
            DataArrived := false;
            { transmit data }
            TxLen := Read +4;
            Socket.SendData(@TxData.AsData, TxLen);
            { wait for response }
            AwaitResponse(@DataArrived, Timeout);
            { progress }
            TxProgress := Round((Stream.Position /Stream.Size) * 100);

            { progress update }
            if Progress <> nil then Progress^ := TxProgress;
            if Assigned(ProgressCallback) then ProgressCallback(@TxProgress);
            if Assigned(TaggedCallback) then TaggedCallback(@Socket.DestinationAddress[1], @TxProgress);
          end;
        end

        { no response }
        else Result.Code := ecLostResponse;

        { processor idle keep }
        Sleep(1);
      until (Read < TFTP_DATA_SIZE) or (Stream.Position >= Stream.Size) or Terminate;

    finally
      if Stream <> nil then FreeAndNil(Stream);
      Busy := False;
      Result.Msg := ErrorCodeStr(Result.Code);
      Sleep(1000);
    end;
  except
    On E: Exception do
    begin
      Result.Code := ecUnknown;
      Result.Msg := E.Message;
      Busy := False;
    end;
  end;
end;

procedure TFTPSocket.SendWriteRequest(const filename : String; const Mode : TTFTPDataMode);
var
  OutStr, ModeStr : AnsiString;
  TxSize, I : Integer;
begin
  DataArrived := false;
  ModeStr := AnsiString(ModeToString(Mode));
  TxData.AsRequest.AsBytes[0] := 0;
  TxData.AsRequest.AsBytes[1] := TFTP_WRITE_REQUEST;

  OutStr := AnsiString(format('%s %s', [Filename, ModeStr]));
  for i := 1 to Length(OutStr) do
  begin
    if OutStr[i] = ' ' then TxData.AsRequest.AsBytes[i +1] := 0
    else TxData.AsRequest.AsAnsiChar[i +1] := AnsiChar(OutStr[i]);
  end;

  TxSize := Length(OutStr) +2;
  Socket.SendData(@TxData.AsRequest.AsBytes[0], TxSize);
end;

function TFTPSocket.Broadcast(Data: Pointer; Size: Integer): Boolean;
var
  TempPort : String;
begin
  TempPort := Socket.DestinationPort;
  Socket.DestinationPort := IntToStr(TFTP_BroadcastPort);
  Socket.DestinationAddress := '255.255.255.255';

  try
    Result := Socket.SendData(Data, Size);
  finally
    Socket.DestinationPort := TempPort;
  end;
end;

function TFTPSocket.ErrorCodeStr(const Error: TTFTPErrorCode): String;
begin
  Result := 'Unknown!';

  case Error of
    ecSuccessful:               Result := 'Sucessful!';
    ecFileNotFound:             Result := 'File not found!';
    ecAccessViolation:          Result := 'Access violation!';
    ecDiskFullOrAllocExceeded:  Result := 'Disk full or allocation exceeded!';
    ecIllegalOperation:         Result := 'Illegal TFTP operation!';
    ecUnknownTranferID:         Result := 'Unknown transfer ID!';
    ecFileExists:               Result := 'File already exists!';
    ecNoSuchUser:               Result := 'No such user!';
    ecInvalidAddress:           Result := 'destination address is INVALID!';
    ecAddressUnreachable:       Result := 'Destination address UNREACHABLE!';
    ecLostResponse:             Result := 'No/Lost response from sever';
  end;
end;

function TFTPSocket.ModeToString(const Mode: TTFTPDataMode): String;
begin
  case Mode of
    dmASCII: Result := 'netascii';
    dmOctet: Result := 'octet';
    dmMail:  Result := 'mail';
  end;
end;

procedure TFTPSocket.OnDataRecvd(Data: Pointer; Size: Integer; Address,
  Port: String);
begin
  RxData := Data;
  DataArrived := True;
  if Assigned(OnDataRxCallBack) then
    OnDataRxCallBack(Data, Size, Address, Port);
end;

