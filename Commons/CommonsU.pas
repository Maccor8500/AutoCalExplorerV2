function PacketLANCheckMsg(var LanMsg: MsgType; TimeVar: word; NoPing, AllowBrdIgnore: boolean): word;
var
  LocalTimeVar: word;
  MsgLen: word;
  LengthLO, LengthHI: byte;
  board_nr_tx: word;
  stT, stpT: dword;
  I: integer;
  PResult: boolean;
  GotReply, StopIt: boolean;
  BuffPos: integer;
  TempLength: word;
  BrdNumRecv: byte;
  BrdType: byte;
  PTempPacketBuffer: ^TPacketBuffer;

  DebugBuffer: array[0..2] of TReceiveBuff;
  DebugTime: array[0..2] of integer;
  L1, L2, L3, L4, L1a, L2a, L5: integer;

  MSG: TBuffer;
  PLanData: ^TLanData;

  EndOfMultiMessage: boolean;
  NormalOrPicType: integer; //0: Normal; 1: PIC
  NowTime: dword;
  DataFlag: word;
begin
  Result:=0;
  dataflag:=0;
  EndOfMultiMessage:=false;
  LocalTimeVar:= TimeVar;
  MsgLen:=LanMsg.NormMsg.MsgLen;
  if MsgLen mod 2 <> 0 THEN MsgLen:=MsgLen+1;
  LengthLO := MsgLen mod 256;
  LengthHI := MsgLen div 256;

  CopyMemory(@MSG[1], @LanMsg.NormMsg.Msg[1], MsgLen);
  if (MSG[1]=77) and  //M
     (MSG[2]=48) and  //F
     (MSG[3]=48) and  //0
