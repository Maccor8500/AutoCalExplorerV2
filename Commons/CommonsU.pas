class procedure TMaccorSystem.GetChannelRangeDataNorm(const Chan: Integer; const Run: TMaccorRunMode; const Mode: TMaccorControlMode; const Range: TMaccorBrickRange; var S, O: Single);
var
  Data: PChParm;
begin
  S := 0.0; O := 0.0;
  MacSysPtr^.GetChannelDataNormal(Chan, Data);
  if not Assigned(Data) then Exit;

  case Run of
    rmCurrent:
    begin
      case Range of
        mrRange1:
        begin
          case Mode of
            cmCharge:
            begin
              S := Data^.chg.Islope;
              O := Data^.chg.Ioffset;
            end;

            cmDischarge:
            begin
              S := Data^.dis.Islope;
              O := Data^.dis.Ioffset;
            end;
          end;
        end;

        mrRange2:
        begin
          case Mode of
            cmCharge:
            begin
              S := Data^.chg.Islope1;
              O := Data^.chg.Ioffset1;
            end;

            cmDischarge:
            begin
              S := Data^.dis.ISlope1;
              O := Data^.dis.Ioffset1;
            end;
          end;
        end;

        mrRange3:
        begin
          case Mode of
            cmCharge:
            begin
              S := Data^.chg.Islope2;
              O := Data^.chg.Ioffset2;
            end;

            cmDischarge:
            begin
              S := Data^.dis.Islope2;
              O := Data^.dis.Ioffset2;
            end;
          end;
        end;

        mrRange4:
        begin
          case Mode of
            cmCharge:
            begin
              S := Data^.chg.Islope3;
              O := Data^.chg.Ioffset3;
            end;

            cmDischarge:
            begin
              S := Data^.dis.Islope3;
              O := Data^.dis.Ioffset3;
            end;
          end;
        end;
      end;
    end;

    rmVoltage:
    begin
      S := Data^.chg.Vslope;
      O := Data.chg.Voffset;
    end;
  end;
end;

{
  this only cares about resetting slopes and offset for the target channel
  action will only get a reset versio of whats present. meaning, no system data
  is modified, just a copy of it... that way the system data is retianed as-is
  for continous usage, until such time as writing to file is needed. in which
  case it will be explicitly clear by action.

  application shall not manipulate data, unless said to do so. especially system
  core data and records. other non-significant perhaps.
}
class procedure TMaccorSystem.SetDefaultChannelParameters(const Chan: Integer; var Data: TMdlParam; Options: PResetOptions);
var
  X: TVBChParm;
  Z: TVBExtParam;
  EndCyc: Integer;
  VGain, AbsTRepAlign, RAttn: byte;
  i: integer;
  vDiv: single;
  OffsetNorm: integer;
  Range: TMaccorBrickRange;

  function n_to_2os(Value: Single): SmallInt;
  var
    L: integer;
  begin
    L := SmallInt(Round(Value));
    if L < 0 then Result := SmallInt(Round(abs(L)/2) +32768)
    else Result := SmallInt(Round(L /2));
  end;

begin
  if ((Chan > High(MacSysPtr^.PosData)) or (Chan < 0)) or ((Options = nil)) then Exit;
  { if this is not a reset operation... leave! its not if new data is present }
  if Assigned(Options^.NewData) then Exit;

  OffsetNorm := $10000;  { two16::DECL }

  X := MacSysPtr^.ChanData[Chan];
  Z := MacSysPtr^.ExtData[Chan];

  EndCyc := MacSysPtr^.PosData[Chan].EndCycle;
  VGain := MacSysPtr^.PosData[Chan].VGain;
  AbsTRepAlign := MacSysPtr^.PosData[Chan].AbsTRepAlign;
  RAttn := MacSysPtr^.BrdData[Z.BrdNr].RAttn;

  case Options^.Mode of
    rmCurrent:
    begin
      case Options^.Range of
        mrRange1:
        begin
          X.chg.Islope := 1;
          X.dis.Islope := 1;
          X.chg.Ioffset := 0;
          X.dis.Ioffset := 0;
        end;

        mrRange2:
        begin
          X.chg.Islope1 := 1;
          X.dis.Islope1 := 1;
          X.chg.Ioffset1 := 0;
          X.dis.Ioffset1 := 0;
        end;

        mrRange3:
        begin
          X.chg.Islope2 := 1;
          X.dis.Islope2 := 1;
          X.chg.Ioffset2 := 0;
          X.dis.Ioffset2 := 0;
        end;

        mrRange4:
        begin
          X.chg.Islope3 := 1;
          X.dis.Islope3 := 1;
          X.chg.Ioffset3 := 0;
          X.dis.Ioffset3 := 0;
        end;
      end;
    end;

    rmVoltage:
    begin
      case Options^.Ctrl of
        cmCharge:
        begin
          X.Chg.Vslope := 1;
