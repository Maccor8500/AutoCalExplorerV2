    case Length(A) of
      6: Result := format('%s:%s:%s:%s:%s:%s', [IntToHex(A[0], 2), IntToHex(A[1], 2), IntToHex(A[2], 2),
        IntToHex(A[3], 2), IntToHex(A[4], 2), IntToHex(A[5], 2)]);
      4: Result := format('%d:%d:%d:%d', [A[0], A[1], A[2], A[3]]);
