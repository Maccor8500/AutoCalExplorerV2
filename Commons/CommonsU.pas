procedure TUDPSocket.SetListeningPort( sLP: string );
var
  sktSocket: TSocket;
begin
  if not( Suspended )then
    Suspended := True;

  udpSock.Listening := False;
  ifSock.SetPort( sLP );

  sktSocket := Socket( AF_INET, SOCK_DGRAM, IPPROTO_UDP );

  if sktSocket = INVALID_SOCKET then
    raise Exception.Create('Invalid udp-socket returned, message: '+
                            ifSock.GetSocketLastError );

  ifSock.SetSocket( sktSocket );

  sListeningPort := sLP;

  Listen;
end;

