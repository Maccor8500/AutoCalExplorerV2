{ TMailOutlook }

class procedure TMailOutlook.Execute(const _To, _ToCC, _ToBCC, _Subject,
  _Body,_Attachment: String);
var
  Outlook: OleVariant;
  MailV: Variant;
begin
  if not HaveActiveOleObject('Outlook.Application') then
    Outlook := CreateOleObject('Outlook.Application')
  else
    Outlook:= GetActiveOleObject('Outlook.Application');

  MailV := Outlook.CreateItem(olMailItem);
  if (_To <> '') then MailV.To := _To;
  if (_ToBCC <> '') then MailV.BCC:= _ToBCC;
  if (_ToCC <> '') then MailV.CC:= _ToCC;
  MailV.Subject := _Subject;
  MailV.Body := _Body;
  if _Attachment <> '' then
  if FileExists(_Attachment) then
    MailV.Attachments.Add(_Attachment);

  MailV.Display;
end;

//// Want to Bypass exception so we check this without using the activex unit
class function TMailOutlook.HaveActiveOleObject(
  const ClassName: string): boolean;
var
  ClassID: TCLSID;
  Unknown: IUnknown;
  oleresult: HResult;
begin
  ClassID := ProgIDToClassID(ClassName);
  oleResult:= GetActiveObject(ClassID, nil, Unknown);
  result:= Succeeded(oleResult);
end;

class procedure TMailOutlook.Send(MailData: TArray<String>);
var
  Outlook: OleVariant;
  Mail: Variant;
  i : SmallInt;
begin
  CoInitialize(nil);
  if length(MailData) < 2 then Exit;

  try
    try
      if not HaveActiveOleObject('Outlook.Application') then
        Outlook := CreateOleObject('Outlook.Application')
      else
        Outlook:= GetActiveOleObject('Outlook.Application');

      Mail := Outlook.CreateItem(olMailItem);       // object creation
      Mail.Subject := MailData[0];                  // Add subject
      Mail.Body    := MailData[1];                  // add mail body

      for i := 2 to Length(MailData) -1 do
        Mail.Recipients.Add(MailData[i]);           // add recipients

      Mail.Send;                                    // send it!
    finally
      VarClear(OutLook);
    end;
  except
  end;
  CoUninitialize;
end;

{DLL_Loader}

function TDllLoader.LoadDll(const dll_path: String) : THandle;
begin
  { Attempt to load the DLL }
  Result := LoadLibrary(PWideChar(Trim(dll_path)));
  if (Result <> INVALID_HANDLE) and (Result > 0)then
  begin
    SetLength(fLibs, Length(fLibs) +1);
    fLibs[Length(fLibs) -1].Handle := Result;
    fLibs[Length(fLibs) -1].name := ShortString(ExtractFileNameEx(dll_path));
    fLibs[Length(fLibs) -1].Id := Length(fLibs);
    fLibs[Length(fLibs) -1].Path := AnsiString(dll_path);
    Inc(dll_handles);
  end
  else RaiseLastOSError;
end;

procedure TDllLoader.LoadDll(const dll_path: String; var H: THandle);
begin
  H := LoadDll(dll_path);
end;

function TDllLoader.LoadDLLAsData(const dll_path: String): THandle;
begin
  Result := SafeLoadLibrary(PWideChar(Trim(dll_path)));
  if (Result <> INVALID_HANDLE) and (Result > 0)then
  begin
    SetLength(fLibs, Length(fLibs) +1);
    fLibs[Length(fLibs) -1].Handle := Result;
    fLibs[Length(fLibs) -1].name := ShortString(ExtractFileNameEx(dll_path));
    fLibs[Length(fLibs) -1].Id := Length(fLibs);
    fLibs[Length(fLibs) -1].Path := AnsiString(dll_path);
    Inc(dll_handles);
  end
  else RaiseLastOSError;
end;

function TDllLoader.GetHandle(const Id : Byte) : THandle;
begin
  Result := 0;
  if Id < Length(fLibs) then
    Result := fLibs[Id].Handle;
end;

function TDllLoader.GetHandle(const LibName : ShortString) : THandle;
var
  Target: String;
  i: Integer;
begin
  Result := INVALID_HANDLE;
  { strip extension if found }
  if AnsiPos('.dll', String(LibName)) > 0 then Target := ExtractFilenameEx(String(LibName))
  else Target := String(LibName);

  for i := Low(fLibs) to High(fLibs) do
    if LowerCase(Target) = LowerCase(String(fLibs[i].name)) then
    begin
      Result := fLibs[i].Handle;
      break;
    end;
end;

procedure TDllLoader.GetPath(const dllhandle: THandle; var Path: AnsiString);
var
  i: Integer;
begin
  Path := '';

  for i := Low(fLibs) to High(fLibs) do
  begin
    if dllHandle <> FLibs[i].Handle then continue;

    Path := FLibs[i].path;
    break;
  end;
end;

function TDllLoader.GetFuncAddr(var dllHandle : THandle; const Name : AnsiString) : PHandle;
begin
  Result := GetProcAddress(dllHandle, PAnsiChar(Name));
end;

procedure TDllLoader.GetFuncAddr(var dllHandle: THandle; const FuncName: AnsiString; var FuncHandle: Pointer);
begin
  FuncHandle := GetProcAddress(dllHandle, PAnsiChar(FuncName));
end;

constructor TDllLoader.Create(const dll_path: String = ''; Style : TImportStyle = isNormal);
begin
  // LoadLibraryEx(exeName, Nil, LOAD_LIBRARY_AS_DATAFILE);
  if not FileExists(dll_path) then Exit;
  
  dll_handles := 0;

  if (Length(dll_path) > 0) and (dll_path <> '') then
  begin
    case Style of
      isNormal: LoadDll(dll_path);
      isSafe: LoadDllAsData(dll_path);
    end;
  end;
end;

destructor TDllLoader.Destroy;
var
  i: Integer;
begin
  for i := Low(fLibs) to High(fLibs) do
    if fLibs[i].Handle <> 0 then
      FreeLibrary(fLibs[i].Handle);

  inherited Destroy;
end;


