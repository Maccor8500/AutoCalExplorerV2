function TXXTEA.MX(Sum, Y, Z, P, E: PUint32; const K: PUint32Array): TUint32;
begin
  Result := (((Z^ shr 5) xor (Y^ shl 2)) + ((Y^ shr 3) xor (Z^ shl 4))) xor
    ((Sum^ xor Y^) + (K^[P^ and 3 xor TUint32(E^)] xor Z^));
end;

