begin
  if ContainsKey(Key) then
    Dict[Key] := Value;
end;

function TDictionaryEx<TKey, TVal>.ContainsKey(const Key: TKey): Boolean;
begin
  Result := Dict.ContainsKey(Key);
end;

procedure TDictionaryEx<TKey, TVal>.Remove(const Key: TKey);
begin
  Dict.Remove(Key);
end;

