begin
  if (AppHandle = 0) or (AppHandle = INVALID_HANDLE) then Exit;
  ShowWindow(AppHandle, SW_RESTORE or SW_SHOWNORMAL);
  SetForegroundWindow(AppHandle);
  SetWindowPos(AppHandle, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE or SWP_NOSIZE or SWP_SHOWWINDOW);
end;

function Base64Encode(const Value: AnsiString): AnsiString;
begin
  SetLength(Result,((Length(Value)+2) div 3) * 4);
  B64Encode(@Value[1], @Result[1], Length(Value));
end;

function B64Decode(pInput: pointer; pOutput: pointer; Size: longint): longint;
 var
  i, j, iptr, optr: integer;
  Temp: array[0..3] of byte;
  Input, Output: PByteArray;
begin
  Input:= PByteArray(pInput); Output:= PByteArray(pOutput);
  iptr:= 0; optr:= 0;
  Result:= 0;
  for i:= 1 to (Size div 4) do
  begin
    for j:= 0 to 3 do
    begin
      case Input^[iptr] of
        65..90 : Temp[j]:= Input^[iptr] - Ord('A');
        97..122: Temp[j]:= Input^[iptr] - Ord('a') + 26;
        48..57 : Temp[j]:= Input^[iptr] - Ord('0') + 52;
        43     : Temp[j]:= 62;
        47     : Temp[j]:= 63;
        61     : Temp[j]:= $FF;
      end;
      Inc(iptr);
    end;
    Output^[optr]:= (Temp[0] shl 2) or (Temp[1] shr 4);
    Result:= optr+1;

    if (Temp[2]<> $FF) and (Temp[3]= $FF) then
    begin
      Output^[optr+1]:= (Temp[1] shl 4) or (Temp[2] shr 2);
      Result:= optr+2;
      Inc(optr)
    end

    else if (Temp[2]<> $FF) then
    begin
      Output^[optr+1]:= (Temp[1] shl 4) or (Temp[2] shr 2);
      Output^[optr+2]:= (Temp[2] shl 6) or  Temp[3];
      Result:= optr+3;
      Inc(optr,2);
    end;

    Inc(optr);
  end;
end;

function Base64Decode(const Value: AnsiString): AnsiString;
begin
  SetLength(Result,(Length(Value) div 4) * 3);
  SetLength(Result,B64Decode(@Value[1],@Result[1],Length(Value)));
end;

procedure SetPortStart(const PortStart: Word; Increment: Word);
begin
  LastUniquePort := PortStart;
  PortIncrement := Increment;
end;

procedure GetUniquePort(const SockType: TSocketType; var Port: Word);
var
  ReservedPorts: TStrings;
  Line, PortStr: String;
  i: Integer;
  PortExists: Boolean;
begin
  I := 0;
  ReservedPorts := TStringList.Create;

  try
    { reset }
    ReservedPorts.Clear;
    { run netstat }
    ExecuteCommand('netstat -a -n', ReservedPorts);
    { admin only }
    if IsAdmin then ExecuteCommandAsAdmin('arp -d');

    { avoid infinite loop! }
    if PortIncrement <= 0 then PortIncrement := 1;
    if LastUniquePort <= 0 then LastUniquePort := 6500;

    { default port }
    Port := LastUniquePort;

    repeat
      { if we've been through some list [I] will not remain 0! }
      if I <> 0 then Inc(Port, PortIncrement);
      PortStr := IntToStr(Port);
      PortExists := False;

      {
        we need to exhaust this list before we know we have a truly unique port
        otherwise, how would we know?!

        after exhausting the list, if we never found a match. only then we have
        found unique port. otherwise, pick a new port and start over!
      }
      for i := 0 to ReservedPorts.Count -1 do
      begin
        { for every established ports }
        Line := String(Trim(ReservedPorts[i]));
        if Line = '' then continue;

        { check current Port against all in list }
        case SockType of
          stSockUDP:
          begin
            if AnsiPos(AnsiString('UDP'), Line) > 0 then
              PortExists := (AnsiPos(PortStr, Line) > 0);
          end;

          stSockTCP:
          begin
            if AnsiPos(AnsiString('TCP'), Line) > 0 then
              PortExists := (AnsiPos(PortStr, Line) > 0);
          end;
        end;

        {
          if it exists, we need not check the next in list, just try next port.
          we're yet to have a unique port!
        }
        if PortExists then break;
      end;
    until (not PortExists);

  finally
    FreeAndNil(ReservedPorts);
    LastUniquePort := Port;
    Inc(LastUniquePort, PortIncrement);
  end;
end;

