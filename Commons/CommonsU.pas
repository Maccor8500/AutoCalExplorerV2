function MillisToTimeStr(const Value{millis}: NativeInt): String;
var
 R,  Days, Hours, Min, Sec, Ms: NativeInt;
const
  ONE_SEC = 1000;
  ONE_MIN = 60 * ONE_SEC;
  ONE_HR  = 60 * ONE_MIN;
  ONE_DAY = 24 * ONE_HR;
begin
  if Value <= 0 then
    Exit('--.--.-');

  R := Value;

  Days  := R div ONE_DAY;
  R     := R mod ONE_DAY;

  Hours := R div ONE_HR;
  R     := R mod ONE_HR;

  Min   := R div ONE_MIN;
  R     := R mod ONE_MIN;

  Sec   := R div ONE_SEC;
  Ms    := R mod ONE_SEC;

  if (Days = 0) and (Hours = 0) and (Min = 0) then
    Result := Format('%.2d.%.3d', [Sec, Ms])
  else if (Days = 0) and (Hours = 0) then
    Result := Format('%.2d:%.2d.%.3d', [Min, Sec, Ms])
  else if (Days = 0) then
    Result := Format('%.2d:%.2d:%.2d.%.3d', [Hours, Min, Sec, Ms])
  else
    Result := Format('%.2d:%.2d:%.2d:%.2d.%.3d', [Days, Hours, Min, Sec, Ms]);
end;

function IntToTime(const Value: Cardinal): string;
var
  X, Hours, Minutes, Seconds: Word;
begin
  Hours := Value div 3600;
  X := Value mod 3600;
  Minutes := X div 60;
  Seconds := X mod 60;

  Result := Format('%.2d:%.2d:%.2d', [Hours, Minutes, Seconds]);
end;

function FloatToTime(Value: Single): string;
var
  Hours, Minutes, Seconds: Word;
begin
  Hours := Trunc(Value / 3600);
  Value := Value - Hours * 3600;
  Minutes := Trunc(Value / 60);
  Seconds := Round(Value - Minutes * 60);

  Result := Format('%.2d:%.2d:%.2d', [Hours, Minutes, Seconds]);
end;

function DateTimeToCountdown(const Target: TDateTime): ShortString;
var
  TotalSeconds, Days, Hours, Minutes, Seconds: Int64;
begin
  if Target <= 0 then Exit('00:00:00:00');

  TotalSeconds := Round(Target * 24 * 60 * 60);

  Days := TotalSeconds div 86400;
  TotalSeconds := TotalSeconds mod 86400;

  Hours := TotalSeconds div 3600;
  TotalSeconds := TotalSeconds mod 3600;

  Minutes := TotalSeconds div 60;
  Seconds := TotalSeconds mod 60;

  Result := ShortString(Format('%.2d:%.2d:%.2d:%.2d', [Days, Hours, Minutes, Seconds]));
end;

