    HandleEvent(Format('function [%s @ 0x%x] ready!'#13#10, [USB_RESET, NativeUInt(@libusb_reset_device)]));
    Inc(C);
  end;

  if not Assigned(libusb_get_device_descriptor) then
    HandleEvent(format('failed to get function handle [%s]'#13#10, [USB_GET_DESC]))
