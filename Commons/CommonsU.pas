    { release call-back if assigned }
    if MemoLock[i].CallBackProc <> nil then
      MemoLock[i].CallBackProc := nil;
    { free this handle! }
    FreeAndNil(MemoLock[i]);
  end;
end;

function GetSubString(S: string; Index: integer; Delimiter: char): string;
var
  Len, i, P1, P2, DelCount: integer;
begin
  Result:='';
  P1:=-1;
  P2:=0;
  DelCount:=0;
  Len:=Length(S);

  if Index=0 then
    P1:=0
  else
  begin
    for i:=1 to Len do
      if S[i]=Delimiter then
      begin
        Inc(DelCount);
        if DelCount>=Index then
        begin
          P1:=i;
          Break;
        end;
      end;
  end;
  if (P1+1)<=Len then
  begin
  for i:=P1+1 to Len do
    if (i>=Len) or (S[i]=Delimiter) then
    begin
      if (i>=Len) then
        P2:=i+1
      else
        P2:=i;
      Break;
    end;
  end;

  if P2=0 then
    Result:=S
  else
    Result:=Copy(S, P1+1, P2-P1-1);
end;

procedure BusyWait(MSec: Integer; Cancel: PBoolean);
begin
  var T0: UInt64 := GetTickCountEx(MSec);

  repeat
    ProcessMsgs(10);
    if Assigned(Cancel) then
      if Cancel^ then break;
  until (GetTickCountEx >= T0);
end;

{ these are expected to timeout! they are place-holder for sleep }
procedure AvoidBusyWait(MSec: Integer);
begin
  if (GlobalWaitEvent = nil) then Exit;
  { no zero! }
  if MSec < 10 then MSec := 10;
  GlobalWaitEvent.WaitFor(MSec);
end;

procedure AvoidBusyWait(const Secs: Single);
var
  Duration: Integer;
begin
  Duration := Round(Secs *1000);
  AvoidBusyWait(Duration);
end;

procedure AvoidBusyWait(const Thread: TThread; MSec: Integer);
begin
  if (Thread <> nil) and (MSec >= 1) then GlobalWaitEvent.WaitFor(MSec)
  else TThread.Yield;
end;

function GetExceptionStackInfo(P: PExceptionRecord): Pointer;
const
  DELPHI_EXCEPTION = $0EEDFADE;
begin
  var Info: PRtlStackInfo;
  New(Info);
  Info.Victims := EmptyString;
  Info.Count := RtlCaptureStackBackTrace(0, Length(Info.Frames), @Info.Frames, nil);

  { the fsShowing race enrichment <formerly ShowingTrapU's private trap> ::
    only Delphi-raised records carry an object, and Screen belongs to the
    main thread — every other exception passes through untouched }
  if (P^.ExceptionCode = DELPHI_EXCEPTION)
    and (TObject(P^.ExceptObject) is EInvalidOperation)
    and (EInvalidOperation(P^.ExceptObject).Message = SVisibleChanged)
    and (GetCurrentThreadId = MainThreadID) then
      for var i := 0 to Screen.CustomFormCount -1 do
        with Screen.CustomForms[i] do
          if fsShowing in FormState then
            Info.Victims := Info.Victims
              +format('victim <fsShowing held>: %s: %s <Visible=%s>'#13#10,
                [Name, ClassName, BooleanToStr(Visible)]);

  Result := Info;
end;

function GetStackInfoString(Info: Pointer): String;
var
  MBI: TMemoryBasicInformation;
  ModName: array[0..MAX_PATH] of Char;
begin
  Result := EmptyString;
  if Info = nil then Exit;

  Result := PRtlStackInfo(Info).Victims;

  for var i := 0 to PRtlStackInfo(Info).Count -1 do
  begin
    var Frame := PRtlStackInfo(Info).Frames[i];
    var Line := format('$%p', [Frame]);

    if (VirtualQuery(Frame, MBI, SizeOf(MBI)) = SizeOf(MBI))
      and (MBI.State = MEM_COMMIT) and (MBI.AllocationBase <> nil) then
      if GetModuleFileName(HMODULE(MBI.AllocationBase), ModName, MAX_PATH) > 0 then
        Line := format('%s + $%x', [ExtractFileName(ModName),
          NativeUInt(Frame) -NativeUInt(MBI.AllocationBase)]);

    Result := Result +Line +sLineBreak;
  end;
end;

procedure CleanUpStackInfo(Info: Pointer);
begin
  { Exception.Destroy calls this with NIL for never-raised exceptions
    <the preallocated EInvalidPointer/EOutOfMemory singletons included> —
    Dispose(nil) walks the nil record and AVs at Victims <offset 8> }
  if Info <> nil then Dispose(PRtlStackInfo(Info));
end;

procedure InstallRtlExceptionStackTrace;
begin
  Exception.GetExceptionStackInfoProc := GetExceptionStackInfo;
  Exception.GetStackInfoStringProc := GetStackInfoString;
  Exception.CleanUpStackInfoProc := CleanUpStackInfo;
end;

type
  {
    unhandled-exception reporter <absorbed ShowingTrapU> :: publishes message,
    active form and the provider's trace through the event path — so unhandled
    exceptions reach the journal AND the StackTrace dump folder — then shows
    the same dialog TApplication shows when no handler is assigned. inert in
    the DLL instance: its Application pumps no messages of its own.
  }
  TUnhandledExceptionReporter = class(TObject)
    procedure HandleException(Sender: TObject; E: Exception);
  end;

var
  UnhandledReporter: TUnhandledExceptionReporter;

procedure TUnhandledExceptionReporter.HandleException(Sender: TObject; E: Exception);
begin
  try
    var S := format('[Unhandled] :: %s <thread: %s>', [E.Message,
      StrTernary(GetCurrentThreadId = MainThreadID, 'main', IntToStr(GetCurrentThreadId))]);
    if Screen.ActiveForm <> nil then
      S := S +format(' <active form: %s: %s>',
        [Screen.ActiveForm.Name, Screen.ActiveForm.ClassName]);
    S := S +#13#10 +E.StackTrace;

    OutputDebugString(PWideChar(S));
    TUtils.HandleEvent(etAppException, S +#13#10);
  except
    { the reporter must never stack a second failure on the one it reports }
  end;

  Application.ShowException(E);
end;

