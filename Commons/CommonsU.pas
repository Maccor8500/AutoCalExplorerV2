function  EncryptPassword(const password : String) : string;
var Pass,
    Lpassword,
    OrdStr  : string;
    CharOrd : SmallInt;
          i,
    PassLen, r : Integer;
begin
  if password = '' then
    Exit;

  Pass := '';
  Randomize;
  Lpassword := AnsiReverseString(password);
  PassLen   := Length(LPassword);

  for i := 1 to Length(password) do
  begin
    CharOrd := Ord(LPassword[i]) -3;
    OrdStr := FormatFloat('000', CharOrd) ;

    if OrdStr[1] = '0' then
    begin
      r := Random(6);

      case r of
        0: OrdStr[1] := 'A';
        1: OrdStr[1] := 'B';
        2: OrdStr[1] := 'C';
        3: OrdStr[1] := 'D';
        4: OrdStr[1] := 'E';
        5: OrdStr[1] := 'F';
      end;
    end;

    Pass := Pass + OrdStr;
  end;

  //Pass := AnsiReverseString(Pass);
  Result := Trim(Pass) + IntToStr(PassLen) + IntToStr(Length(IntToStr(PassLen)));  // Append the password Length to it
end;

function  DecryptPassword(password : string) : string;
const OrdSize = 3;
var Lpassword, s : string;
    PassSize,
    SizeOfPassSize,
    PassLen   : smallInt;
begin
  if password = '' then
    Exit;

  PassLen  := Length(password);                                                  // Length of encrypted password
  SizeOfPassSize := StrToInt(password[passLen]);                                 // Chars in password length ? --> last char
  PassSize := StrToInt(Copy(password, PassLen -SizeOfPassSize, SizeOfPassSize)); // Size of original password

  password := Copy(password, 1, PassLen -(SizeOfPassSize +1));
  //password := AnsiReverseString(password);

  repeat
    s := Copy(password, 1, OrdSize);
    if CharInSet(s[1], ['A'..'F']) then
      s[1] := '0';

    Lpassword := Lpassword + Char(StrToInt(s) +3);

    // Delete this char section from password
    Delete(password, 1, OrdSize);
  until Length(Lpassword) = PassSize;

  Result := AnsiReverseString(Lpassword);
end;

procedure CopyFolderRecursively(SourceDir: String; DestDir: String; Cancel: PBoolean; Memo : PDebugMemo);
var
  Files : TArray<String>;
  I : Integer;
  D, F : String;
  Res : HResult;
begin
  if Memo <> nil then Memo.WriteLn('gathering all files...', clSilver);
  { get all files in folder and sub-folders }
  GetFiles(SourceDir, Files, True);

  { start copying all files }
  if Memo <> nil then Memo.WriteLn(format('copying all gathered %d files...',
    [Length(Files)]), clSilver);

  for I := Low(Files) to High(Files) do
  begin
    F := StringReplace(Files[i], SourceDir, DestDir, [rfReplaceAll, rfIgnoreCase]);
    D := ExtractFileDir(F);
    if not DirectoryExists(D) then
    begin
      if Memo <> nil then Memo.WriteLn(format('creating folder [%s]', [D]),
        clPurple);
      ForceDirectories(D);
      Sleep(100);
    end;

    if Memo <> nil then Memo.Write(format('copying file [%s]', [ExtractFileName(Files[i])]),
      clSilver, True);

    if FileExists(F) then DeleteFile(F);
    Res := FastFileCopy(PWideChar(Files[i]), PWideChar(D), nil, FOF_SILENT);

    if Memo <> nil then
    begin
      if Succeeded(Res) then Memo.WriteLastLn(' success'#13, clGreen)
      else Memo.WriteLastLn(' failure!'#13, clRed)
    end;

    if Cancel <> nil then
      if Cancel^ then
      begin
        if Memo <> nil then Memo.WriteLn('copy task terminated successfully!', clRed);
        break;
      end;
  end;
end;

procedure CopyFolderRecursively(SourceDir: String; DestDir: String; Cancel: PBoolean = nil; Callback : TFileCopyCallback = nil);
var
  Files : TArray<String>;
  I, L : Integer;
  D, F : String;
  Res : HResult;
begin
  { get all files in folder and sub-folders }
  GetFiles(SourceDir, Files, True);
  L := Length(Files);

  for I := Low(Files) to High(Files) do
  begin
    F := StringReplace(Files[i], SourceDir, DestDir, [rfReplaceAll, rfIgnoreCase]);
    D := ExtractFileDir(F);
    if not DirectoryExists(D) then
    begin
      ForceDirectories(D);
      Sleep(50);
    end;

    if FileExists(F) then DeleteFile(F);
    { debug }
    if Assigned(Callback) then Callback(0, @Files[i], @F, i, L, False);
    { action::copy! }
    Res := FastFileCopy(PWideChar(Files[i]), PWideChar(D), nil, FOF_SILENT);
    { debug }
    if Assigned(Callback) then Callback(1, @Files[i], @F, i, L, Succeeded(Res));

    if Cancel <> nil then
      if Cancel^ then break;
  end;
end;

//-------------------------  Fast File Copy (Very Fffast!)  -------------------------------
function FastFileCopy(const aSrcItem, aDest, aNewName: PWideChar; const OpFlag: word): HRESULT;
const
  CLSID_FileOp: TGUID = '{3ad05575-8857-4850-9277-11b85bdb8e09}';
var
  lFileOperation: IFileOperation;
  psiFrom, psiTo: IShellItem;
begin
  {
    opFlags :
    FOF_FILESONLY (0x0080)  Perform the operation only on files (not on folders) if a wildcard file name (.) is specified.
    FOF_NOCONFIRMATION (0x0010) Respond with Yes to All for any dialog box that is displayed.
    FOF_NOCONFIRMMKDIR (0x0200) Do not confirm the creation of a new folder if the operation requires one to be created.
    FOF_NO_CONNECTED_ELEMENTS (0x2000) Do not move connected items as a group. Only move the specified files.
    FOF_NOCOPYSECURITYATTRIBS (0x0800) Do not copy the security attributes of the item.
    FOF_NOERRORUI (0x0400) Do not display a message to the user if an error occurs. If this flag is set without
    ```````````````````````FOFX_EARLYFAILURE, any error is treated as if the user had chosen Ignore or Continue in a dialog box.
    ```````````````````````I[]t halts the current action, sets a flag to indicate that an action was aborted,
    ```````````````````````and proceeds with the rest of the operation.
    FOF_NORECURSION (0x1000) Only operate in the local folder. Do not operate recursively into subdirectories.
    FOF_RENAMEONCOLLISION (0x0008) Give the item being operated on a new name in a move, copy, or rename operation
    ```````````````````````````````if an item with the target name already exists.
    FOF_SILENT (0x0004) Do not display a progress dialog box.
    FOF_WANTNUKEWARNING (0x4000) Send a warning if a file or folder is being destroyed during a delete operation rather
    `````````````````````````````than recycled. This flag partially overrides FOF_NOCONFIRMATION.
    https://docs.microsoft.com/en-us/windows/desktop/api/shobjidl_core/nf-shobjidl_core-ifileoperation-setoperationflags
  }
  // Initialize COM as STA.
  Result := CoInitializeEx(nil, COINIT_APARTMENTTHREADED or COINIT_DISABLE_OLE1DDE);
  if Succeeded(Result) then
  begin
    // Create the IFileOperation interface
    Result := CoCreateInstance(CLSID_FileOp, nil, CLSCTX_ALL, IFileOperation,
                          lFileOperation);
    if Succeeded(Result) then
    begin
      Result := lFileOperation.SetOperationFlags(OpFlag);
      if Succeeded(Result) then
      begin
        Result := SHCreateItemFromParsingName(aSrcItem,
                                         nil,
                                         IShellItem, psiFrom);
        if Succeeded(Result) then
        begin
          if aDest <> '' then
            Result := SHCreateItemFromParsingName(aDest,
                                             nil,
                                             IShellItem, psiTo);

          if Succeeded(Result) then
            Result := lFileOperation.CopyItem(psiFrom, psiTo, aNewName, nil);
        end;

        if Succeeded(Result) then
          Result := lFileOperation.PerformOperations;
      end;
    end;

    CoUninitialize;
  end;
end;

function CopyFileProgress(TotalFileSize, TotalBytesTransferred, StreamSize,
  StreamBytesTransferred: LARGE_INTEGER; dwStreamNumber, dwCallbackReason,
  hSourceFile, hDestinationFile: DWORD; lpData: Pointer): DWORD; stdcall;
begin
  if CancelCopy = True then
  begin
    SendMessage(THandle(lpData), CEXM_CANCEL, 0, 0);
    result := PROGRESS_CANCEL;
    exit;
  end;
  case dwCallbackReason of
    CALLBACK_CHUNK_FINISHED:
      begin
        SendMessage(THandle(lpData), CEXM_CONTINUE, TotalBytesTransferred.LowPart, TotalBytesTransferred.HighPart);
        result := PROGRESS_CONTINUE;
      end;
    CALLBACK_STREAM_SWITCH:
      begin
        SendMessage(THandle(lpData), CEXM_MAXBYTES, TotalFileSize.LowPart, TotalFileSize.HighPart);
        result := PROGRESS_CONTINUE;
      end;
  else
    result := PROGRESS_CONTINUE;
  end;

