function ExecuteCommand(const cmd : String; const Dir : String; var Memo : TMemo): Boolean;
var
  Res, cmd_str: String;
  StartupInfo: TStartupInfo;
  ProcessInfo: TProcessInformation;
  SecurityAttr: TSecurityAttributes;
  ReadPipe, WritePipe: THandle;
  Buffer: array[0..255] of AnsiChar;
  BytesRead, TotBytes: DWORD;
begin
  Result := False;
  if (Trim(cmd) = '') or (Memo = nil) then
    Exit;

  cmd_str := Format('cmd.exe /k %s', [cmd]);

  SecurityAttr.nLength := SizeOf(TSecurityAttributes);
  SecurityAttr.bInheritHandle := True;
  SecurityAttr.lpSecurityDescriptor := nil;

  if CreatePipe(ReadPipe, WritePipe, @SecurityAttr, 0) then
  begin
    FillChar(StartupInfo, SizeOf(TStartupInfo), 0);
    StartupInfo.cb := SizeOf(TStartupInfo);
    StartupInfo.hStdInput := ReadPipe;
    StartupInfo.hStdOutput := WritePipe;
    StartupInfo.hStdError := WritePipe;
    StartupInfo.dwFlags := STARTF_USESTDHANDLES or STARTF_USESHOWWINDOW;
    StartupInfo.wShowWindow := SW_HIDE;
    TotBytes := 0;

    if CreateProcess(nil, PChar(cmd_str), @SecurityAttr, @SecurityAttr, True, 0, nil, PChar(Dir), StartupInfo, ProcessInfo) then
    begin
      CloseHandle(WritePipe);
      try
        repeat
          Res := '';
          FillChar(Buffer, 256, #0);
          if not ReadFile(ReadPipe, Buffer, SizeOf(Buffer), BytesRead, nil) then
            Continue
          else
          begin
            SetString(Res, PAnsiChar(@Buffer[0]), BytesRead);
            Memo.SelText := (Res);
          end;

          inc(TotBytes, BytesRead);
        until BytesRead = 0;

        Result := (TotBytes > 0);
      finally
        CloseHandle(ReadPipe);
        CloseHandle(ProcessInfo.hProcess);
        CloseHandle(ProcessInfo.hThread);
      end;
    end;
  end;
end;

function RunAndGetExitCode(const Cmd: String): Cardinal;
var
  SI: TStartupInfo;
  PI: TProcessInformation;
  CmdLine: string;
begin
  ZeroMemory(@SI, SizeOf(SI));
  ZeroMemory(@PI, SizeOf(PI));
  SI.cb := SizeOf(SI);
  SI.dwFlags := STARTF_USESHOWWINDOW;
  SI.wShowWindow := SW_HIDE;

  CmdLine := Cmd;

  if not CreateProcess(nil, PChar(CmdLine), nil, nil, False,
                       CREATE_NO_WINDOW, nil, nil, SI, PI) then
    raise Exception.CreateFmt('Failed to run: %s', [Cmd]);

  WaitForSingleObject(PI.hProcess, INFINITE);
  GetExitCodeProcess(PI.hProcess, Result);

  CloseHandle(PI.hProcess);
  CloseHandle(PI.hThread);
end;

function DetectDotNetVersion(const DllPath: String): String;
var
  ExitCode: Cardinal;
  RegAsm4, RegAsm2: string;
begin
  RegAsm4 := 'C:\Windows\Microsoft.NET\Framework\v4.0.30319\regasm.exe "' +
             DllPath + '" /regfile /nologo';
  RegAsm2 := 'C:\Windows\Microsoft.NET\Framework\v2.0.50727\regasm.exe "' +
             DllPath + '" /regfile /nologo';

  // Test CLR 4 RegAsm
  ExitCode := RunAndGetExitCode(RegAsm4);
  if ExitCode = 0 then
    Exit('NET40'); // .NET 4.0–4.8

  // Test CLR 2 RegAsm
  ExitCode := RunAndGetExitCode(RegAsm2);
  if ExitCode = 0 then
    Exit('NET20'); // .NET 2.0–3.5

  Exit('NOT_DOTNET'); // Native or .NET Core
end;

function FindWindowByPID(PID: DWORD): HWND;
var
  Handle: HWND;
  WinPID: DWORD;
begin
  Result := 0;
  Handle := GetTopWindow(0);
  while Handle <> 0 do
  begin
    GetWindowThreadProcessId(Handle, @WinPID);
    if WinPID = PID then
    begin
      Result := Handle;
      Exit;
    end;
    Handle := GetWindow(Handle, GW_HWNDNEXT);
  end;
end;

procedure CloseProcessWindow(Handle: THandle);
var
  PID: DWORD;
  LHandle: HWND;
begin
  PID := Windows.GetProcessId(Handle);
  LHandle := FindWindowByPID(PID);
  if LHandle <> 0 then
    PostMessage(LHandle, WM_CLOSE, 0, 0);
end;

function EnumWindowsByPID(PID: DWORD): TArray<HWND>;
var
  Handles: TList<HWND>;

  function EnumProc(hWnd: HWND; lParam: LPARAM): BOOL; stdcall;
  var
    WinPID: DWORD;
  begin
    GetWindowThreadProcessId(hWnd, @WinPID);
    if WinPID = PID then
      Handles.Add(hWnd);
    Result := True; // continue enumeration
  end;

begin
  Handles := TList<HWND>.Create;
  try
    EnumWindows(@EnumProc, 0);
    Result := Handles.ToArray;
  finally
    Handles.Free;
  end;
end;

procedure Terminate(var Handle: THandle; Brute: Boolean);
var
  PID: DWORD;
  Handles: TArray<HWND>;
  LHandle: HWND;
begin
  if Handle = 0 then Exit;
  try
    if Brute then TerminateProcess(Handle, 0)
    else
    begin
      Exit;

      PID := Windows.GetProcessId(Handle);
      Handles := EnumWindowsByPID(PID);
      for LHandle in Handles do PostMessage(LHandle, WM_CLOSE, 0, 0);
      WaitForSingleObject(Handle, 5000);
    end;
  finally
    CloseHandle(Handle);
    Handle := 0;
  end;
end;

function GetAddressMAC(const Addr: String): String;
var
  AdapterInfo: PIP_ADAPTER_INFO;
  AdapterInfoSize: ULONG;
  ErrorCode: DWORD;
begin
  Result := '';

  { first, obtain the required size of the buffer }
  AdapterInfoSize := 0;
  GetAdaptersInfo(nil, AdapterInfoSize);

  { allocate memory for the adapter information }
  GetMem(AdapterInfo, AdapterInfoSize);
  try
    { get the adapter information }
    ErrorCode := GetAdaptersInfo(AdapterInfo, AdapterInfoSize);
    if ErrorCode = ERROR_SUCCESS then
    begin
      { iterate through the adapter information to find the matching IP address }
      while Assigned(AdapterInfo) do
      begin
        if (CompareStr(String(AdapterInfo^.IpAddressList.IpAddress.S), Addr) = 0) then
        begin
          Result := Format('%02X:%02X:%02X:%02X:%02X:%02X',
            [AdapterInfo^.Address[0], AdapterInfo^.Address[1],
             AdapterInfo^.Address[2], AdapterInfo^.Address[3],
             AdapterInfo^.Address[4], AdapterInfo^.Address[5]]);
          Break;
        end;

        AdapterInfo := AdapterInfo^.Next;
      end;
    end;
  finally
    FreeMem(AdapterInfo);
  end;
end;

procedure GetAddressMAC(const Addr: String; var MAC : String);
begin
  MAC := GetAddressMAC(Addr);
end;

procedure GetIPFromMAC(const MAC: String; var Addr: String);
var
  AdapterInfo: PIP_ADAPTER_INFO;
  AdapterInfoPtr: PIP_ADAPTER_INFO;
  OutBufLen: ULONG;
  MACBytes : Array [0..5] of Byte;

  procedure MACStrToBytes(MStr : String; var MBytes : Array of Byte);
  var
    i : Integer;
    MArr : TArray<String>;
  begin
    SplitStr(MStr, '-', MArr);
    ZeroMemory(@MBytes, Length(MBytes));
    for i := Low(MArr) to High(MArr) do
      MBytes[i] := StrToInt(format('$%s', [MArr[i]]));
  end;
begin
  Addr := '';
  MACStrToBytes(MAC, MACBytes);

  // Initialize OutBufLen to the size of the buffer
  OutBufLen := SizeOf(PIP_ADAPTER_INFO);
  GetMem(AdapterInfo, OutBufLen);
  try
    // Call GetAdaptersInfo to get the necessary size
    if GetAdaptersInfo(AdapterInfo, OutBufLen) = ERROR_BUFFER_OVERFLOW then
    begin
      FreeMem(AdapterInfo);
      GetMem(AdapterInfo, OutBufLen);
    end;

    // Call GetAdaptersInfo again with the correct buffer size
    if GetAdaptersInfo(AdapterInfo, OutBufLen) = NO_ERROR then
    begin
      AdapterInfoPtr := AdapterInfo;
      while Assigned(AdapterInfoPtr) do
      begin
        if CompareMem(@MACBytes, @AdapterInfoPtr^.Address, 6) then
        begin
          // Found the adapter with the matching MAC address
          Addr := String(AdapterInfoPtr^.IpAddressList.IpAddress.S);
          Break;
        end;
        AdapterInfoPtr := AdapterInfoPtr^.Next;
      end;
    end;
  finally
    FreeMem(AdapterInfo);
  end;
end;

