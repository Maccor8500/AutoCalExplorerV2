class function TUtils.Toggle<T>(const Val: T): T;
var
  Info: PTypeInfo;
begin
  Info := TypeInfo(T);

  if Info = TypeInfo(Boolean) then
  begin
    PBoolean(@Result)^ := not PBoolean(@Val)^;
    Exit;
  end;

  case GetTypeKind(T) of
    tkInteger:
    begin
      case GetTypeData(Info)^.OrdType of
        otSByte: PShortInt(@Result)^ := Ord(PShortInt(@Val)^ = 0);
        otUByte: PByte(@Result)^ := Ord(PByte(@Val)^ = 0);
        otSWord: PSmallInt(@Result)^ := Ord(PSmallInt(@Val)^ = 0);
        otUWord: PWord(@Result)^ := Ord(PWord(@Val)^ = 0);
        otSLong: PInteger(@Result)^ := Ord(PInteger(@Val)^ = 0);
        otULong: PCardinal(@Result)^ := Ord(PCardinal(@Val)^ = 0);
        else raise EInvalidCast.Create('Unsupported integer type');
      end;

      Exit;
    end;
  end;

  raise EInvalidCast.CreateFmt('Toggle<T> does not support type %s', [Info.Name]);
end;

