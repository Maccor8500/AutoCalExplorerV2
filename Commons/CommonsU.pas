function ByteToHex(const B : Byte; Chars : Byte = 2) : String;
var
  I : integer;
begin
  I := B;
  Result := IntToHex(I, Chars);
end;

procedure DumpHex(const f : String; var HexOut : TStrings);
var
  R, c: Integer;
  FS : TFileStream;
  B : Byte;
  S : String;
begin
  if not FileExists(f) then Exit;

  with HexOut do
  begin
    c := 0;
    FS := TFileStream.Create(f, fmOpenRead + fmShareDenyNone);

    try
      FS.Seek(0, soFromBeginning);
      repeat
        S := '';
        if C >= 16 then C := 0;
        R := FS.Read(B, SizeOf(Byte));
        S := IntToHex(B, 2);

        if (C = 7) or (R = 0) then S := format('%s ', [S])
        else if C = 15 then S := format('%s', [S]) +#13
        else S := format('%s:', [S]);

        HexOut.Append(S);
        Inc(C);
      until R = 0;

      HexOut.Append(#10#13);
    finally
      FreeAndNil(FS);
    end;
  end;
end;

function IntToBinEx(const IntVal: UInt64; width: Byte): String;
var
  i: Byte;
begin
  Result := '';
  for i := Width -1 downto 0 do
    Result := Result +StrTernary((IntVal and (1 shl i)) <> 0, '1', '0');

  { little-endiann }
  //Result := ReverseString(Result);
end;

procedure IntToBinEx(const IntVal: UInt64; var Bin: String; width : TBinaryWidth);
var
  i: Byte;
begin
  Bin := '';
  for i := SizeOf(Integer) * 8 - 1 downto 0 do
    Bin := Bin + IntToStr((IntVal shr i) and 1);
end;

function IntToBin(const IntVal: Int64; width : TBinaryWidth = bwDefault) : String;
  function IntToBinByte(Value: Byte): String;
  var
    i: Integer;
    pStr: PChar;
  begin
    SetLength(Result, 8);
    pStr := PChar(Pointer(Result));
    for i := 7 downto 0 do begin
      pStr[i] := Char(Ord('0') + ((Value shr (7 - i)) and 1));
    end;
  end;
begin
  Result := '';

  if IntVal = 0 then
  begin
    case Width of
      bwDefault: Result := '0';
      bw8: PadStr(Result, 8, '0', spRight);
      bw16: PadStr(Result, 16, '0', spRight);
      bw32: PadStr(Result, 32, '0', spRight);
      bw64: PadStr(Result, 64, '0', spRight);
      bw128: PadStr(Result, 128, '0', spRight);
    end;

    Exit;
  end;

  case width of
    bwDefault: ;
    bw8: Result := IntToBinByte(IntVal);
    bw16:
    begin
      Result := IntToBinByte(IntVal shr 8);
      Result := Result + IntToBinByte(IntVal and $FF);
    end;
    bw32: ;
    bw64: ;
    bw128: ;
  end;
end;

function BinStrToInt(const S: String) : Integer;
var
  i,x, L: Integer;
begin
  Result := 0;
  L := Length(S);
  if L <= 0 then Exit;

  for i := 1 to L do
  begin
    if S[i] = '0' then continue;

    x := StrToInt(S[i]);
    Result := Result +(x *Round(Power(2, (i -1))));
  end;
end;

function ByteArrToStr(const BArr: Array of Byte; delim : Char = ',') : String;
var
  i: Integer;
begin
  Result := '';

  for i := Low(BArr) to High(BArr) do
    if i < High(BArr) then Result := Result + IntToStr(BArr[i]) + delim
    else Result := Result + IntToStr(BArr[i])
end;

procedure ConfigureConsolePrintConstants;
var
  b: Integer;
begin
  for b := 0 to 255 do
    HexPair32[b] :=
      Ord(HexDigits[b shr 4]) or
      (Ord(HexDigits[b and $0F]) shl 16);
  SpaceCrPair := Ord(' ') or (Ord(#13) shl 16);
end;

{ ByteArrToStr => ByteArrToStrFmt }
function ByteArrToStrFmt(const BArr: PByte; Len: Integer; PerLine: Integer = 8): String;
var
  OutLen: Integer;
  Src: PByte;
  Dest: PChar;
  LineCount: Integer;
  n, chunk, t: Integer;
  pair32: Cardinal;
begin
  { nothing! gigo! }
  if (Len <= 0) then Exit('');

  {
    pre-compute exact output length:
    hex: 2*Len; separators: (Len-1) colons
    replaced by " space+CRLF" at each PerLine, adding +2 per full line
  }
  OutLen := Len * 3 - 1 + ((Len - 1) div PerLine) * 2;
  SetLength(Result, OutLen);

  Src := BArr;
  Dest := PChar(Result);
  LineCount := PerLine;
  n := Len;

  while n > 0 do
  begin
    { process up to 8 bytes, but never cross a line boundary or exhaust n  }
    chunk := LineCount;
    if chunk > n then chunk := n;
    if chunk > 8 then chunk := 8;

    { write hex for the chunk (colon between bytes within the chunk) }
    for t := 1 to chunk do
    begin
      pair32 := HexPair32[Src^];
      PCardinal(Dest)^ := pair32;
      Inc(Dest, 2);
      Inc(Src);
      Dec(LineCount);
      Dec(n);

      { within the chunk, put ':' after each byte except the last in the chunk }
      if (t < chunk) then
      begin
        Dest^ := ':'; Inc(Dest);
      end;
    end;

    { after the chunk, decide the separator for the boundary (if more bytes remain) }
    if n > 0 then
    begin
      if LineCount = 0 then
      begin
        { write " space + CR + LF" with 2 stores (packed ' ' + CR, then LF) }
        PCardinal(Dest)^ := SpaceCrPair;
        Inc(Dest, 2);
        Dest^ := #10; Inc(Dest);
        LineCount := PerLine;
      end
      else
      begin
        { still on the same line: single colon }
        Dest^ := ':'; Inc(Dest);
      end;
    end;
  end;
end;

function ArrayToStr(const a: array of AnsiChar): String;
var
  i: Integer;
begin
  Result := '';

  for i := 0 to Length(a) -1 do
    if a[i] <> #0 then
      Result := Result + Char(a[i]);
end;

function TArrayManip<T>.getIndex(const item: T): integer;
var
  i: Integer;
  s1, s2 : TMemoryStream;
begin
  Result := -1;
  s1 := TMemoryStream.Create;
  s2 := TMemoryStream.Create;

  try
    s1.WriteData(@item, SizeOf(item));

    for i := 0 to Length(aDataArr) -1 do
    begin
      s2.WriteData(@aDataArr[i], SizeOf(T));
      if Compare(s1, S2) then
      begin
        Result := i;
        break;
      end;
      s2.Clear;
    end;
  finally
    FreeAndNil(s1);
    FreeAndNil(s2);
  end;
end;

function TArrayManip<T>.insert(const item: T; p : integer = -1) : boolean;
var
  i: Integer;
begin
  Result := false;

  try
    if (getIndex(item) < 0) or aDuplicate then
    begin
      Result := true;

      if p >= 0 then
      begin
        setLength(aDataArr, Length(aDataArr) +1);{increase array by 1}
        for i := (size -1) downto (p +1) do      {move data upwards by 1 until the position of p}
          aDataArr[i] := aDataArr[i -1];

        aDataArr[p] := item;                     {insert new item at position p}
      end
      else
      begin
        SetLength(aDataArr, Length(aDataArr) +1);
        aDataArr[Length(aDataArr) -1] := item;
      end;
    end;

  except
  end;
end;

function TArrayManip<T>.IsEqual(const A, B: T): byte;
begin
  Result := 0;
  if Self.Comparer.Equals(A, B) then
    Result := 1;
end;

function TArrayManip<T>.lastIndex(const item: T): integer;
var
  i: Integer;
  comp : IComparer<T>;
begin
  Result := -1;
  comp := TComparer<T>.Default;

  for i := Length(aDataArr) -1 downto 0 do
  begin
    if Comp.Compare(aDataArr[i], item) = 0 then
    begin
      Result := i;
      break;
    end;
  end;
end;

function TArrayManip<T>.remove(const index: integer): boolean;
var
  LTemp: T;
  i: Integer;
begin
  Result := false;
  if not validIndex(index) then Exit;

  for i := index to size -1 do
    if validIndex(i +1) then
      aDataArr[i] := aDataArr[i +1];

  // Shorten array by 1
  SetLength(aDataArr, size -1);
  Result := true;
end;

function TArrayManip<T>.replace(const item: T; const index: integer): boolean;
begin
  Result := false;
  if not validIndex(index) then Exit;
  aDataArr[index] := item;
  Result := true;
end;

function TArrayManip<T>.replaceAll(const item: T): boolean;
var
  loc : TArray<integer>;
  i: Integer;
begin
  Result := false;

  try
    loc := findAll(item);

    if Length(loc) <> 0 then
      for i := 0 to Length(loc) -1 do
        aDataArr[loc[i]] := item;
  except
    Result := false;
  end;
end;

function TArrayManip<T>.save(const d: string): boolean;
var
  s : string;
  i : Integer;
  fs : TfileStream;
begin
  Result := true;
  s := ChangeFileExt(d, '.arr');
  fs := TFileStream.Create(s, fmCreate);

  case aObjType of
    otRec:
    begin
      try
        try
          fs.Write(aDuplicate, SizeOf(boolean));
          for i := 0 to size -1 do
            fs.Write(aDataArr[i], SizeOf(T));
        except
          Result := false;
        end;
      finally
        fs.Free;
      end;
    end;

    otClass:
    begin
      try
        fs.Write(aDuplicate, SizeOf(boolean));
        i := size; {re-use i}
        fs.Write(i, SizeOf(Integer));
        fs.WriteData(aDataArr, SizeOf(T) *size);
      finally
        fs.Free;
      end;
    end;
  end;

end;

function TArrayManip<T>.load(const s: string): boolean;
var
  fs : TFileStream;
  len : LongWord;
  f : string;
  i: Integer;
begin
  Result := false;
  clear;
  f := ChangeFileExt(s, '.arr');
  if not FileExists(f) then exit;
  fs := TFileStream.Create(f, fmOpenRead + fmShareDenyNone);

  case aObjType of
    otRec:
    begin
      try
        SetLength(aDataArr, (fs.Size - SizeOf(boolean)) div SizeOf(T));
        fs.Read(aDuplicate, SizeOf(boolean));

        for i := 0 to size -1 do
          fs.Read(aDataArr[i], SizeOf(T));
      finally
        fs.Free;
        Result := true;
      end;
    end;

    otClass:
    begin
      try
        fs.Read(aDuplicate, SizeOf(boolean));
        fs.Read(i, SizeOf(Integer)); {re-use i}
        SetLength(aDataArr, i);
        fs.ReadData(@aDataArr[0], SizeOf(T) *size);
      finally
        fs.Free;
      end;
    end;
  end;
end;

function TArrayManip<T>.size: integer;
begin
  Result := Length(aDataArr);
end;

function TArrayManip<T>.swap(const indexA, indexB: integer): boolean;
begin
  Result := switch(indexA, indexB);
end;

function TArrayManip<T>.switch(const indexA, indexB: integer): boolean;
var
  temp : T;
begin
  Result := true;

  try
    temp := aDataArr[indexA];
    aDataArr[indexA] := aDataArr[indexB];
    aDataArr[indexB] := temp;
  except
    Result := false;
  end;
end;

function TArrayManip<T>.update(const item: T): boolean;
var
  idx : Integer;
begin
  idx := indexOf(item);
  replace(item, idx);
  Result := True;
end;

function TArrayManip<T>.validIndex(const index: integer): boolean;
begin
  Result := (index <= size -1) and (index >= 0);
end;

