procedure ToCelcius(var TinF : single);                                      //
begin                                                                        //
{                                                                            //
 TinC = Temperature in Celcius                                               //
 TinF = Temperature in Fahrenheit                                            //
}                                                                            //
  TinF := (TinF - 32) / 1.8;                                                 //
end;                                                                         //
                                                                             //
procedure ToCelcius(const TinF : single; var TinC : single);                 //
begin                                                                        //
