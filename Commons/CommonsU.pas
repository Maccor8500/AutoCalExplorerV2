  begin
    Data.Cal.idSlope := SmallInt(LoWord(Round(X.dis.ISlope /4 *OffsetNorm)));
    Data.Cal.idSlope1 := SmallInt(LoWord(Round(X.dis.ISlope1 /4 *OffsetNorm)));
    Data.Cal.idSlope2 := SmallInt(LoWord(Round(X.dis.ISlope2 /4 *OffsetNorm)));
    Data.Cal.idSlope3 := SmallInt(LoWord(Round(X.dis.ISlope3 /4 *OffsetNorm)));
  end;

  if X.minV >= 0 then Data.V_Zero := 0
  else Data.V_Zero := SmallInt(LoWord(Round(-X.minV /vDiv *$FFFF)));

  Data.XicOffset := n_to_2os(Round(z.eccoffset));
  Data.XicSlope := SmallInt(LoWord(Round(z.eccslope /2 *OffsetNorm)));
  Data.XidOffset := n_to_2os(Round(z.ELCoffset));
  Data.XidSlope := SmallInt(LoWord(Round(z.ELCslope /2 *OffsetNorm)));

  Data.Cal.finalcyc := EndCyc;
  Data.Cal.VGain := VGain;
  Data.Cal.RAttn := RAttn;
  Data.Cal.AbsTRepAlign := AbsTRepAlign;
  Data.Cal.LowCurrentCtrlDelay := X.Chg.LowCurrentCtrlDelay;
  Data.Cal.Add_Relay_Cycle_Time := X.Chg.Add_Relay_Cycle_Time;
end;

