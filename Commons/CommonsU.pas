    try
      { udp socket to build atop! }
      Socket := TUdpSocketEx.Create(DHCP_SERVER_PORT, OnDataRecvd, OnSocketErr);

      if not Assigned(Socket) then
      begin
        HandleEvent(etMessage, format('%s::Socket = NULL!', [FuncName]));
        Exit;
      end;

      if not Socket.GetStatus then
      begin
        HandleEvent(etMessage, format('%s::Socket init. failed!!', [FuncName]));
        Exit;
      end;
    except
      On E: Exception do
        HandleEvent(etMessage, format('%s::Socket', [FuncName]), E);
    end;
  finally
    //StartOK := (not Suspended);
    Suspended := False;
  end;
end;

destructor TDHCPServer.Destroy;
var
  T: UInt64;
begin
  T := GetTickCountEx(3000);
  repeat
    AvoidBusyWait(1);
  until (GetTickCountEx >= T) or ProcExit;

  if Assigned(Socket) then
    FreeAndNil(Socket);
  inherited Destroy;
end;

procedure TDHCPServer.Execute;
begin
  inherited;

  try
    repeat
      case StartOK of
        True:
        begin
          AvoidBusyWait(1);

        end;

        False: AvoidBusyWait;
      end;
    until Terminated;
  finally
    ProcExit := True;
  end;
end;

procedure TDHCPServer.HandleEvent(const EType: TAppEventType; const MsgStr: String; E: Exception; SameLine: Boolean);
begin
  if not Assigned(EventHandler) then Exit;

  try
    with Event do
    begin
      Trace := '';
      Reason := EType;
      Code := Ord(EType);
      if E <> nil then
      begin
        Reason := etAppException;
        Msg := format('%s: %s'#13#10'%s'#13#10, [MsgStr, E.Message, E.StackTrace]);
        Trace := E.StackTrace;
      end
      else Msg := MsgStr;

      Overwrite := SameLine;
    end;
  finally
    EventHandler(@Event);
  end;
end;

