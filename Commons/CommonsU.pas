procedure TDebugMemo.WriteLn(msg : AnsiString = ''; color : TColor = clBlack; bullet : Boolean = true);
begin

  try
    TThread.Queue(nil, { let the ui-thread handle this mess! }
      procedure
      begin
        //Mutex.Enter;

        if Trim(String(msg)) <> '' then
        begin
          if bullet and (not FileOnly) then
          begin
            SelAttributes.Color := BulletColor;
            SelText := BulletStyle + ' ';
          end;
          if TSEnabled and (not FileOnly) then
          begin
            SelAttributes.Color := TSColor;
            SelText := TimeToStr(Now) + ' ';
          end;

          SelAttributes.Color := color;
          if not FileOnly then
          begin
            SelText := String(msg) +#13;
            if Lines.Count >= MaxLinesAllowed then
              Clear;
          end;

          if LogFile <> nil then
          begin
            if not TS then LogFile.Write(msg)
            else LogFile.Write(DateTimeToStr(Now) + #9 + (String(msg) +#13));

            if FileOnly then
              SelText := format('debug re-directed to file: %s'#13, [log]);
          end;
        end;
      end);
  finally
    //busy := false;
    //Mutex.Leave;
  end;
end;

procedure TDebugMemo.WriteLn(msg : TArray<String>; color: TArray<TColor>; bullet : Boolean = true);
begin
  TThread.Queue(nil,
  procedure
  var
    i: Integer;
  begin
    if Bullet and (not FileOnly) then
    begin
      SelAttributes.Color := BulletColor;
      SelText := BulletStyle + ' ';
    end;

    Lines.BeginUpdate;
    for i := Low(Msg) to High(Msg) do
    begin
      if i <= High(color) then SelAttributes.Color := color[i]
      else SelAttributes.Color := clBlack;
      SelText := msg[i];
    end;
    Lines.EndUpdate;

    SelText := #13;
  end);
end;

