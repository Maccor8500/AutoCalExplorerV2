{$REGION ' TWindowMessageEx '}
constructor TWindowMessageEx.Create(const ClassName, Title: String; Events: TWindowMessageEvents);
begin
  Self.Events := Events;
  FClassName := ClassName;
  FillChar(WndClass, SizeOf(WndClass), 0);
  WndClass.cbSize := SizeOf(WndClass);
  WndClass.lpfnWndProc := @TWindowMessageEx.WndProc;
  WndClass.hInstance := HInstance;
  WndClass.lpszClassName := PChar(FClassName);
  WndClass.style := CS_HREDRAW or CS_VREDRAW;
  WndAtom := RegisterClassEx(WndClass);
  if WndAtom = 0 then RaiseLastOSError;
  Wnd := CreateWindowEx(0, PChar(FClassName), PChar(Title), 0, 0, 0, 0, 0,
    HWND_MESSAGE, 0, HInstance, Self);

  if Wnd = 0 then RaiseLastOSError;
  SetWindowLongPtr(Wnd, GWLP_USERDATA, LONG_PTR(Self));
end;

constructor TWindowMessageEx.Create(const ClassName, Title: String; Event: TTWindowMessageOnReceive);
var
  E: TWindowMessageEvents;
begin
  E := Default(TWindowMessageEvents);
  E.OnReceive := Event;
  Create(ClassName, Title, E);
end;

destructor TWindowMessageEx.Destroy;
begin
  if Wnd <> 0 then DestroyWindow(Wnd);
  Windows.UnregisterClass(PChar(WndClass.lpszClassName), HInstance);
  inherited;
end;

function TWindowMessageEx.SendMessage(const ClassName, Title: String; Msg: Pointer; const MsgId: Integer): LongBool;
var
  TargetWnd: HWND;
  Data: TCopyDataStruct;
begin
  if Title <> '' then TargetWnd := FindWindow(PChar(ClassName), PChar(Title))
  else TargetWnd := FindWindow(PChar(ClassName), nil);

  if TargetWnd = 0 then
    raise Exception.CreateFmt('Target window of class "%s" not found%s.',
      [ClassName, IfThen(Title <> '', ' with title "' + Title + '"', '')]);

  Data.dwData := NativeUInt(MsgId);
  Data.cbData := Sizeof(TBuffer);
  Data.lpData := Msg;

  Result := Windows.SendMessage(TargetWnd, WM_COPYDATA, WPARAM(Self), LPARAM(@Data)) <> 0;
end;

class function TWindowMessageEx.WndProc(hWnd: HWND; Msg: UINT; wParam: WPARAM; lParam: LPARAM): LRESULT;
var
  Instance: TWindowMessageEx;
  Data: PCopyDataStruct;
begin
  Instance := TWindowMessageEx(GetWindowLongPtr(hWnd, GWLP_USERDATA));

  if Assigned(Instance) and Assigned(Instance.Events.OnReceive) then
  begin
    case Msg of
      WM_COPYDATA:
      begin
        Data := PCopyDataStruct(lParam);
        Instance.Events.OnReceive(Data^.dwData, PBuffer(Data^.lpData));
        Exit(1);
      end;
    end;
  end;

  Result := DefWindowProc(hWnd, Msg, wParam, lParam);
end;
