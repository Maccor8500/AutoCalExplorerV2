procedure CopyFile_NoBlock(const src, dst : String; const del : boolean);
begin
  TThread.CreateAnonymousThread(
  procedure
  var
    t_src, t_dst : String;
    s_stream, d_stream : TFileStream;
  begin
    t_src := src;
    t_dst := dst;

    // exit if this file is missing
    if not FileExists(t_src) then Exit;

    // load src file to stream, create dst file
    s_stream := TFileStream.Create(t_src, fmOpenRead + fmShareDenyWrite);
    d_stream := TFileStream.Create(t_dst, ((fmCreate or fmOpenWrite) + fmShareDenyNone));

    try
      // seek to byte 0 in both streams
      s_stream.Seek(0, soFromBeginning);
      d_stream.Seek(0, soFromBeginning);

      // copy src stream into dst stream
      d_stream.CopyFrom(s_stream, s_stream.Size);
    finally
      FreeAndNil(s_stream);
      FreeAndNil(d_stream);
    end;

    if del then DeleteFile(t_src);
  end).Start;
end;

