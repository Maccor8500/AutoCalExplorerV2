      [Letter, FSToStr(FS), StrTernary(QuickFormat, '/Q', '')]);
    { trim whitespaces }
    CommandLine := Trim(CommandLine);

    { create a pipe to capture the standard output of the process }
    SecurityAttributes.nLength := SizeOf(TSecurityAttributes);
    SecurityAttributes.bInheritHandle := True;
    SecurityAttributes.lpSecurityDescriptor := nil;

    if CreatePipe(PipeRead, PipeWrite, @SecurityAttributes, 0) then
    begin
      ZeroMemory(@StartupInfo, SizeOf(TStartupInfo));
      StartupInfo.cb := SizeOf(TStartupInfo);
      StartupInfo.dwFlags := STARTF_USESTDHANDLES{STARTF_USESHOWWINDOW};
      StartupInfo.hStdOutput := PipeWrite;

      if CreateProcess(nil, PChar(CommandLine), nil, nil, True, NORMAL_PRIORITY_CLASS, nil, nil, StartupInfo, ProcessInfo) then
      begin
        try
          { finally... }
          WaitForSingleObject(ProcessInfo.hProcess, Timeout);

          { read the output from the pipe }
          if DebugOut <> nil then
          begin
            Buffer := Default(TBuffer);
            if not ReadFile(PipeRead, Buffer.AsChars, SizeOf(Buffer.AsChars), BytesRead, nil) then
            begin
              if GetLastError = ERROR_BROKEN_PIPE then
                DebugOut^.WriteLn(format('ReadFile! %d', [GetLastError]), clSilver);
            end
            else
              DebugOut^.WriteLn(format('ReadFile! %d', [GetLastError]), clSilver);

            if BytesRead > 0 then
              DebugOut^.WriteLn(Buffer.AsChars, clSilver);
          end;
        finally
          { update volume label }
          SetVolumeLabel(PChar(Letter + ':'), PChar(VolumeLabel));

          { clean-up! }
          CloseHandle(ProcessInfo.hProcess);
          CloseHandle(ProcessInfo.hThread);
          CloseHandle(PipeWrite);
          CloseHandle(PipeRead);
        end;
      end
      else
      begin
        if DebugOut <> nil then
          DebugOut^.WriteLn(format('CreateProcess: %s', [SysErrorMessage(GetLastError)]), clRed);
      end;
    end;
  except
    On E: Exception do
    begin
      Result := False;
      if DebugOut <> nil then
        DebugOut.WriteLn(format('Exception! %s', [E.Message]))
    end;
  end;
end;

function Firewall(const Handle : Cardinal;
    const status : TFirewallStat; Confirm : boolean=false) : boolean;
var
  hpath, tfile, ofile, y, cmd : string;
  f : TextFile;
begin
  try
    hpath := IncludeTrailingPathDelimiter(GetHomePath);
    tfile := hpath + 'firewall';
    tfile := ChangeFileExt(tfile, '.cmd');

    //FileClose(FileCreate(tfile)); Sleep(15);
    AssignFile(f, tfile);
    ReWrite(f);
    WriteLn(f, '@echo off');

    case status of
      fsON : cmd := 'netsh advfirewall set public state on';
      fsOFF: cmd := 'netsh advfirewall set public state off';
    end;

    if Confirm then
    begin
      ofile := ExtractFileDrive(hpath) + '\output.txt';
      cmd := cmd + ' > ' + ofile;
    end;

    WriteLn(f, cmd);
    CloseFile(f);
    Result := ShellExecute(Handle, 'runas', PChar(tfile), nil, nil, SW_HIDE) > 32;
    Sleep(500);
    DeleteFile(tfile);

    if Confirm then
    begin
      AssignFile(f, ofile);
      Reset(f);
      ReadLn(f, y);

      Result := Result and (LowerCase(y) = 'ok.');
      CloseFile(f);
      Sleep(500);
      DeleteFile(ofile);
    end;
  except
    Result  := false;
  end;
end;

