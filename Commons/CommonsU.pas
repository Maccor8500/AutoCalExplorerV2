type
  { exposes protected TButtonControl.ClicksDisabled }
  TSilentCheckBox = class(TCheckBox);

{
  single item selection in a groupbox of tcheckboxes
  valid parents:
    - Panel
    - Groupbox
    - any valid container whose only children are checkboxes

  NOTE: must assign unique int :: Tags for this to work
}
procedure EnforceSingleCheckboxSelection(Parent: TControl; Sender: TObject);
var
  i, All: Integer;
  Src, BoxPtr: TCheckBox;

  { Checked write with no OnClick echo:: callers need no re-entrance guard }
  procedure SetSilently(Box: TCheckBox; const Value: Boolean);
  begin
    TSilentCheckBox(Box).ClicksDisabled := True;
    try
      Box.Checked := Value;
    finally
      TSilentCheckBox(Box).ClicksDisabled := False;
    end;
  end;

begin
  Src := TCheckbox(Sender);

  if Src.Checked then
  begin
    { uncheck everyone else }
    for i := 0 to (Src.Parent.ControlCount -1) do
    begin
      if (not (Src.Parent.Controls[i] Is TCheckbox)) then continue;

      BoxPtr := (Src.Parent.Controls[i] As TCheckbox);
      if (BoxPtr.Tag <> Src.Tag) then SetSilently(BoxPtr, False);
    end;
  end

  else
  begin
    All := 0;

    for i := 0 to (Src.Parent.ControlCount -1) do
    begin
      if (not (Src.Parent.Controls[i] Is TCheckbox)) then continue
      else Inc(All);

      BoxPtr := (Src.Parent.Controls[i] As TCheckbox);
      if (not BoxPtr.Checked) then Dec(All);
    end;

    SetSilently(Src, All = 0);
  end;
end;

procedure CheckBoxAtOrder(const BoxOrder: Integer; Parent: TControl);
var
  Control: TWinControl;
  Box: TCheckBox;
begin
  Control := TWinControl(Parent);

  for var i: Integer := 0 to Control.ControlCount -1  do
  begin
    if not (Control.Controls[i] is TCheckBox) then continue;

    Box := TCheckBox(Control.Controls[i]);
    if (Box.TabOrder <> BoxOrder) then continue;

    if not Box.Checked then Box.Checked := True;
    break;
  end;
end;

function HasCheckedBox(const Control: TWinControl): Boolean;
begin
  Result := False;

  for var i: Integer := 0 to Control.ControlCount -1  do
  begin
    if not (Control.Controls[i] is TCheckBox) then continue;

    Result := TCheckBox(Control.Controls[i]).Checked;
    if Result then break;
  end;
end;

