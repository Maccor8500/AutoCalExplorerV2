procedure AutoSizeColumns(Grid: PStringGrid);
var
  Col, Row, CellWidth, MaxWidth: Integer;
  Canvas: TCanvas;
  S: STring;
begin
  Canvas := Grid^.Canvas;
  Canvas.Font := Grid^.Font;
  for Col := 0 to Grid^.ColCount -1 do
  begin
    MaxWidth := Canvas.TextWidth(Grid^.Cells[Col, 0]) +8;
    for Row := 0 to Grid.RowCount -1 do
    begin
      S := Grid^.Cells[Col, Row];
      if Trim(S) = ''  then continue;
      CellWidth := Canvas.TextWidth(S) +8;
      if CellWidth > MaxWidth then
        MaxWidth := CellWidth;
    end;
    Grid.ColWidths[Col] := MaxWidth;  // Apply max width
  end;
end;

function SumOfColumnWidths(const Grid: PStringGrid; Skip: SmallInt): Integer;
var
  i: Integer;
begin
  Result := -1;
  if Grid = nil then Exit;

  with Grid^ do
  begin
    for i := 0 to ColCount -1 do
    begin
      if (i = Skip) then continue;
      Inc(Result, ColWidths[i]);
    end;

    if AlignWithMargins then
      Dec(Result, Left *2);
  end;
end;

function SumOfColumnWidths(const Grid: TStringGrid; SkipCols: TByteSet): Integer;
var
  i: Integer;
begin
  Result := 0;

  for i := 0 to Grid.ColCount -1 do
  begin
    if i in SkipCols then continue;
    Inc(Result, Grid.ColWidths[i]);
  end;
end;

