procedure SaveCANConfigurations;
var
  IniFile: TMemIniFile;
  i: Integer;
  S: String;
begin
  IniFile := TMemIniFile.Create(MacSysPtr^.SysIni);

  IniFile.WriteInteger('CAN', 'Channels', Length(MacSysPtr^.CANBrds));
  with IniFile do
  begin
    for i := Low(MacSysPtr^.CANBrds) to High(MacSysPtr^.CANBrds) do
    begin
      S := FormatFloat('CAN_000', i);
      { for every existing indent(device) dump it! }
      WriteInteger(S, 'Type', MacSysPtr^.CANBrds[i].Id);
      WriteInteger(S, 'CAN_Spec', MacSysPtr^.CANBrds[i].Spec);
      WriteInteger(S, 'Int_Baud_Rate', MacSysPtr^.CANBrds[i].Init_Baud);
      WriteInteger(S, 'CAN_Baud_Rate_K', MacSysPtr^.CANBrds[i].Baud);
      WriteString(S, 'IP', String(MacSysPtr^.CANBrds[i].Addr));
      WriteInteger(S, 'Port', MacSysPtr^.CANBrds[i].Port);
    end;
  end;

  FreeAndNil(IniFile);
end;

