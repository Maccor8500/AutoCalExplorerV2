function GuessInstallPath(const DisplayName: String): String;
var
  PF64, PFx86, Candidate: string;
begin
  Result := '';
  PF64 := GetEnvironmentVariable('ProgramW6432');
  PFx86 := GetEnvironmentVariable('ProgramFiles(x86)');
  Candidate := TPath.Combine(PFx86, DisplayName);
  if TDirectory.Exists(Candidate) then
    Exit(Candidate);
  Candidate := TPath.Combine(PF64, DisplayName);
  if TDirectory.Exists(Candidate) then
    Exit(Candidate);
end;

procedure GetInstalledPrograms(var Programs: TInstalledProgramList);
  procedure EnumUninstall(Root: HKEY; const BaseKey: string; WowFlag: REGSAM);
  var
    Reg: TRegistry;
    SubKeys: TStringList;
    KeyName, KeyPath, Result: string;
    Prog: TInstalledProgram;
    L: Integer;
  begin
    Reg := TRegistry.Create;
    SubKeys := TStringList.Create;
    try
      Reg.RootKey := Root;
      Reg.Access := KEY_READ or WowFlag;
      if not Reg.OpenKeyReadOnly(BaseKey) then
        Exit;
      SubKeys.Clear;
      Reg.GetKeyNames(SubKeys);
      Reg.CloseKey;
      for KeyName in SubKeys do
      begin
        Reg.Access := KEY_READ or WowFlag;
        KeyPath := BaseKey + '\' + KeyName;
        if not Reg.OpenKeyReadOnly(KeyPath) then
          Continue;
        FillChar(Prog, SizeOf(Prog), 0);
        if Reg.ValueExists('DisplayName') then
          Prog.DisplayName := Reg.ReadString('DisplayName');
        if Prog.DisplayName <> '' then
        begin
          if Reg.ValueExists('DisplayVersion') then
            Prog.DisplayVersion := Reg.ReadString('DisplayVersion');
          if Reg.ValueExists('Publisher') then
            Prog.Publisher := Reg.ReadString('Publisher');
          if Reg.ValueExists('InstallDate') then
            case Reg.GetDataType('InstallDate') of
              rdString, rdExpandString: Result := Reg.ReadString('InstallDate');
              rdInteger: Result := IntToStr(Reg.ReadInteger('InstallDate'));
            end;
          if Reg.ValueExists('InstallLocation') then
          begin
            case Reg.GetDataType('InstallLocation') of
              rdString, rdExpandString:
                Prog.InstallLocation := Reg.ReadString('InstallLocation');
            else
              Prog.InstallLocation := '';
            end;
          end
          else
            Prog.InstallLocation := '';
          if Reg.ValueExists('UninstallString') then
            Prog.UninstallString := Reg.ReadString('UninstallString');
          if Reg.ValueExists('QuietUninstallString') then
            Prog.QuietUninstallString := Reg.ReadString('QuietUninstallString');
          if Reg.ValueExists('EstimatedSize') then
            Prog.EstimatedSizeKB := Reg.ReadInteger('EstimatedSize');
          if Reg.ValueExists('InstallSource') then
            Prog.InstallSource := Reg.ReadString('InstallSource');
          if Reg.ValueExists('URLInfoAbout') then
            Prog.URLInfoAbout := Reg.ReadString('URLInfoAbout');
          if Reg.ValueExists('HelpLink') then
            Prog.HelpLink := Reg.ReadString('HelpLink');
          Prog.RegistryKey := BaseKey + '\' + KeyName;
          L := Length(Programs);
          SetLength(Programs, L + 1);
          Programs[L] := Prog;
        end;
        Reg.CloseKey;
      end;
    finally
      SubKeys.Free;
      Reg.Free;
    end;
  end;
const
  UNINSTALL_KEY = 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall';
begin
  SetLength(Programs, 0);
  // HKLM 64-bit view
  EnumUninstall(HKEY_LOCAL_MACHINE, UNINSTALL_KEY, KEY_WOW64_64KEY);
  // HKLM 32-bit view
  EnumUninstall(HKEY_LOCAL_MACHINE, UNINSTALL_KEY, KEY_WOW64_32KEY);
  // HKCU (no WOW64 split needed typically)
  EnumUninstall(HKEY_CURRENT_USER, UNINSTALL_KEY, 0);
end;

procedure GetInstalledApplications(var Programs: TInstalledProgramList);
begin
  GetInstalledPrograms(Programs);
end;

procedure FindInApplications(const Applications: TInstalledProgramList; const Strs: TArray<String>; var Apps: TArray<TInstalledProgram>; MaxCount: Integer);
var
  Count, FindCntr: Integer;
  App: TInstalledProgram;
begin
  Count := 0;
  FindCntr := 0;

  for var I := Low(Applications) to High(Applications) do
  begin
    App := Applications[i];
    var Desc: String := App.DisplayName;
    if FindStrs(Desc, Strs) then
    begin
      TUtils.AppendArray<TInstalledProgram>(App, Apps, Count);

      if (MaxCount > 0) then
      begin
        Inc(FindCntr);
        if (FindCntr >= MaxCount) then
          break;
      end;
    end;
  end;

  SetLength(Apps, Count);
end;

