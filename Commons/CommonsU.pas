function SplitDate(const d : TDateTime) : TDateProps;
var
  t_arr : TArray<String>;
begin
  with Result do
  begin
    DateTime := d;
    t_fmt := FormatDateTime('hh:mm:ss.zzz', DateTime);
    d_fmt_s := FormatDateTime('DDD/MMM/YYYY', DateTime);
    d_fmt_i := FormatDateTime('DD/MM/YYYY', DateTime);

    { time }
    SplitStr(t_fmt, '.', t_arr);
    if Length(t_arr) = 2 then
    begin
      SplitStr(t_arr[0], ':', time);
      SetLength(time, Length(time) +1);
      time[Length(time) -1] := t_arr[1];
    end;

    { date}
    SplitStr(d_fmt_s, '/', date_str);
    SplitStr(d_fmt_i, '/', date_int);
  end;
end;

