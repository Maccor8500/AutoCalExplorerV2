procedure TMemoMsgBox.ProcessQueue;
var
  msg : TMsgRec;
begin
  TThread.CreateAnonymousThread(
  procedure
  begin
    while Alive do
    begin
      TThread.Sleep(1);
      if Queue.Count <= 0 then continue;
      {get next!}
      msg := Queue.Dequeue;
      try
        if msg.Pause then
          {put it back}
          if  GetTickCount -msg.T0 < MsgDelay then
          begin
            Queue.Enqueue(msg);
            continue;
          end;

        SelAttributes.Color := BulletColor;
        SelText := BulletStyle + ' ';

        SelAttributes.Color := msg.Color;
        SelText := Msg.Content;

        if LogFile <> nil then
        begin
          if not TS then LogFile.Write(msg.Content)
          else LogFile.Write(DateTimeToStr(Now) + sTab + msg.Content);
        end;

      except
        On E: Exception do
        begin
          SelAttributes.Color := clRed;
          SelText := E.Message;
        end;
      end;
    end;
  end).Start;
end;

