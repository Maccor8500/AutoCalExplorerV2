  best called from FormPaint(Sender: TObject); or better after Application.CreateForm(TAppUI, AppUI);
  also automatically triggered by TMonitorWatcher event loop when windows update settgings
}

class procedure TUtils.UpdateStyle(Style: String; Renderer: Pointer);
var
  i, ThemeIndex: Integer;
  Themes: TArray<String>;
  T0: UInt64;
begin
  if (Style = '') then Style := GetCurrentStyle;
  if Style = ActiveStyle then Exit;
  T0 := GetTickCountEx(ONE_SEC);
  repeat
    ProcessMsgs(WAIT_50MS);
  until Assigned(DelphiStyles) or (GetTickCountEx > T0);

  try
    SetLength(Themes, 0);

    for i := 0 to DelphiStyles.Count -1 do
      if (Pos(Style, DelphiStyles.Strings[i]) > 0) and (Pos(StrTernary(WindowsVersion = wvWin10, 'Windows10', 'Windows11'), DelphiStyles.Strings[i]) > 0) then
        Themes := Themes +[DelphiStyles.Strings[i]];

    if High(Themes) < 0 then
    begin
      SetStyle('Windows');
      Exit;
    end;

    case WindowsVersion of
      wvWin10:
      begin
        for i := Low(Themes) to High(Themes) do
        begin
          if Pos(Style, Themes[i]) <= 0 then continue;

          SetStyle(Themes[i]);
          break;
        end;
      end;

      wvWin11:
      begin
        for i := Low(Themes) to High(Themes) do
        begin
          if Pos(Style, Themes[i]) <= 0 then continue;

          SetStyle(Themes[i]);
          break;
        end;
      end;
    end;
  finally
    ActiveStyle := Style;
  end;
end;

