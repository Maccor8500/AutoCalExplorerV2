end;

function TUdpSocketEx.SendData(const Buf; const Len: Integer; Respond: PBoolean; RespTimeout: Word): Boolean;
var
  SentBytes: Integer;
  T0: UInt64;
begin
  Result := False;
  GotResponse := Result;
  WantResponse := (Respond <> nil);

  try
    { let data go }
    SentBytes := Winsock2.SendTo(Sock, Buf, Len, 0,
      WinSock2.PSockAddr(@Peer.Sock), AddrLen);

    { how'd it go?! }
    Result := (SentBytes = Len);
    { good? }
    if not Result then AlertSocketError

    { wait for response? }
    else
    begin
      if WantResponse then
      begin
        T0 := GetTickCountEx +RespTimeout;
        repeat
          TThread.Sleep(1);
        until GotResponse or (GetTickCountEx >= T0);
      end;
    end;
  except
    On E: Exception do AlertSocketException(E);
  end;
end;

function TUdpSocketEx.SendData(const DataStr: AnsiString): Boolean;
var
  Len: Integer;
begin
  Result := False;
  Len := Length(DataStr);
  if Len <= 0 then Exit;
  Result := SendData(DataStr[1], Len);
end;

function TUdpSocketEx.AsyncSendData(const DataStr: AnsiString): Boolean;
var
  Buffer: WSABUF;
  BytesSent: DWORD;
  ResultCode: Integer;
  Overlapped: WSAOVERLAPPED;
begin
  Result := False;
  Buffer.Len := Length(DataStr);
  if Buffer.Len <= 0 then Exit;

  Buffer.buf := PAnsiChar(DataStr);
  ZeroMemory(@Overlapped, SizeOf(Overlapped));
  ResultCode := WSASendTo(Sock, @Buffer, 1, @BytesSent, 0, TSockAddr(Peer.Sock), SizeOf(TSockAddrIn), @Overlapped, nil);

 Result := ((ResultCode <> SOCKET_ERROR) and (WSAGetLastError = WSA_IO_PENDING)) or (ResultCode = 0);
end;

