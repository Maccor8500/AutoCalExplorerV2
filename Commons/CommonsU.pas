procedure AdjustGridColForVScroll(Grid: PStringGrid; const Padding: Integer);
var
  LastColRect: TRect;
  TotalWidth, i, VScrollBarWidth, Dpi: Integer;
  NeedsScroll: Boolean;
begin
  Dpi := GetDpiForWindow(Grid^.Handle);
  VScrollBarWidth := GetSystemMetricsForDpi(SM_CXVSCROLL, Dpi);

  LastColRect := Grid^.CellRect(Grid^.ColCount -1, 0);
  if LastColRect.Right > (Grid^.ClientWidth - VScrollBarWidth) then
  begin
    NeedsScroll := Grid^.DefaultRowHeight *Grid^.RowCount > Grid^.ClientHeight;
    TotalWidth := 0;
    for i := 0 to Grid^.ColCount -2 do Inc(TotalWidth, Grid^.ColWidths[i]);
    if NeedsScroll then Grid^.ColWidths[Grid^.ColCount -1] := Grid^.ClientWidth -TotalWidth -VScrollBarWidth -Padding
    else Grid^.ColWidths[Grid^.ColCount -1] := Grid^.ClientWidth -TotalWidth -Padding;
  end;
end;

procedure ClearGrid(var Grid : TStringGrid; ResetRows: Boolean = false);
var
  i, j: Integer;
begin
  if Grid = nil then Exit;
  for i := 1 to Grid.RowCount -1 do
    for j := 0 to Grid.ColCount -1 do
      Grid.Cells[j, i] := '';

  Grid.Invalidate;
  {
    leave at least one vacant row. RowCount := 2 does NOT raise <verified
    2026-08-04>; it forces the selection and fires the form's OnSelectCell
    twice, so an exception seen here is that handler's — see the
    SkipRows|SkipCols overload for the full finding.
  }
  if ResetRows then Grid.RowCount := 2;
end;

procedure ClearGrid(var Grid : PStringGrid; ResetRows: Boolean = false);
begin
  if Grid <> nil then
    ClearGrid(Grid^, ResetRows);
end;

procedure ClearGrid(var Grid : TStringGrid; const StartRow, StartCol: Integer; ResetRows: Boolean; ResetStr: String; ResetStrExcept: TByteSet);
var
  i, j: Integer;
begin
  if Grid = nil then Exit;

  for i := StartRow to Grid.RowCount -1 do
    for j := StartCol to Grid.ColCount -1 do
      if not (j in ResetStrExcept) then
        Grid.Cells[j, i] := ResetStr;

  Grid.Invalidate;
  {
    leave at least one vacant row. RowCount := 2 does NOT raise <verified
    2026-08-04>; it forces the selection and fires the form's OnSelectCell
    twice, so an exception seen here is that handler's — see the
    SkipRows|SkipCols overload for the full finding.
  }
  if ResetRows then Grid.RowCount := 2;
end;

procedure ClearGrid(var Grid : TStringGrid; const StartRow, StartCol: Integer; SkipRows, SkipCols: TByteSet; ResetRows: Boolean = False);
var
  i, j: Integer;
begin
  if Grid = nil then Exit;

  for i := StartRow to Grid.RowCount -1 do
  begin
    if (i in SkipRows) then continue;

    {
      begin..end is LOAD-BEARING here :: without it the <if..continue> WAS
      the entire loop body, so the inner loop spun doing nothing and the
      clear below ran ONCE per row with j at its undefined post-loop value.
      SkipCols therefore never skipped anything and the cells it was meant
      to spare were the only ones untouched. indentation is not scope.
    }
    for j := StartCol to Grid.ColCount -1 do
    begin
      if (j in SkipCols) then continue;
      Grid.Cells[j, i] := '';
    end;
  end;

  {
    leave at least one vacant row. RowCount := 2 does NOT raise — verified
    2026-08-04 against this compiler, parented|unparented|mid-edit|
    FixedRows 2 <the setter demotes FixedRows itself>. what it DOES do is
    force the selection and fire the form's OnSelectCell TWICE <old row,
    then row 1>, so an exception observed here belongs to that handler
    <e.g. a SetFocus on a not-yet-visible form>, never to this line.
  }
  if ResetRows then Grid.RowCount := 2;
  Grid.Invalidate;
end;

procedure ClearGrid(var Grid : TStringGrid; Rows: Integer); overload;
begin
