  ExecInfo.lpVerb := 'runas';
  ExecInfo.lpFile := PChar('cmd.exe');

  ExecInfo.nShow := IntTernary(HideCMD, SW_HIDE, SW_SHOWNORMAL);
  case ExecInfo.nShow of
    SW_HIDE: ExecInfo.lpParameters := PChar(format('/c %s', [cmd]));
    SW_SHOWNORMAL: ExecInfo.lpParameters := PChar(format('/k %s', [cmd]));
