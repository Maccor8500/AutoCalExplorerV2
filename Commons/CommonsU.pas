{ TSetList - unlocked cores }
procedure TSetList.EnsureData;
begin
  if FData = nil then
    SetLength(FData, MAXBYTE +1);
end;

function TSetList.DoContains(const Value: Byte): Boolean;
begin
  Result := (Value in FMembers);
end;

function TSetList.DoInsert(const Value: Byte): Boolean;
begin
  Result := not (Value in FMembers);
  if not Result then Exit;
  Include(FMembers, Value);
  Inc(FCount);
end;

function TSetList.DoInsertData(const Value: Byte; const Buf; const Size: NativeUInt): Boolean;
begin
  if Size = 0 then Exit(False);
  DoInsert(Value); { duplicate insert replaces the payload }
  EnsureData;
  { fresh array each time - payloads are immutable, so a returned TBytes stays
    valid past the lock }
  SetLength(FData[Value], NativeInt(Size));
  Move(Buf, FData[Value][0], NativeInt(Size));
  Result := True;
end;

function TSetList.DoRemove(const Value: Byte): Boolean;
begin
  Result := (Value in FMembers);
  if not Result then Exit;
  Exclude(FMembers, Value);
  if FData <> nil then FData[Value] := nil;
  Dec(FCount);
end;

function TSetList.DoGetData(const Value: Byte): TBytes;
begin
  Result := nil;
  if FData <> nil then Result := FData[Value];
end;

function TSetList.DoIndexOf(const Buf; const Size: NativeUInt; const From: Integer): Integer;
var
  V, Start: Integer;
begin
  Result := -1;
  if (FData = nil) or (Size = 0) then Exit;

  Start := From;
  if Start < 0 then Start := 0;
  for V := Start to MAXBYTE do
    if (Length(FData[V]) = NativeInt(Size)) and CompareMem(@FData[V][0], @Buf, Size) then
      Exit(V);
end;

function TSetList.DoLastIndexOf(const Buf; const Size: NativeUInt): Integer;
var
  V: Integer;
begin
  Result := -1;
  if (FData = nil) or (Size = 0) then Exit;

  for V := MAXBYTE downto 0 do
    if (Length(FData[V]) = NativeInt(Size)) and CompareMem(@FData[V][0], @Buf, Size) then
      Exit(V);
end;

{ TSetList - locked shells }
function TSetList.Empty: Boolean;
begin
  FLock.BeginRead;
  try
    Result := (FCount = 0);
  finally
    FLock.EndRead;
  end;
end;

function TSetList.Full: Boolean;
begin
  FLock.BeginRead;
  try
    Result := (FCount > MAXBYTE);
  finally
    FLock.EndRead;
  end;
end;

function TSetList.Count: Integer;
begin
  FLock.BeginRead;
  try
    Result := FCount;
  finally
    FLock.EndRead;
  end;
end;

function TSetList.Contains(const Value: Byte): Boolean;
begin
  FLock.BeginRead;
  try
    Result := DoContains(Value);
  finally
    FLock.EndRead;
  end;
end;

function TSetList.HasData(const Value: Byte): Boolean;
begin
  FLock.BeginRead;
  try
    Result := (FData <> nil) and (FData[Value] <> nil);
  finally
    FLock.EndRead;
  end;
end;

function TSetList.Insert(const Value: Byte): Boolean;
begin
  FLock.BeginWrite;
  try
    Result := DoInsert(Value);
  finally
    FLock.EndWrite;
  end;
end;

function TSetList.Insert(const Value: Byte; const Buf; const Size: NativeUInt): Boolean;
begin
  FLock.BeginWrite;
  try
    Result := DoInsertData(Value, Buf, Size);
  finally
    FLock.EndWrite;
  end;
end;

function TSetList.InsertIfAbsent(const Value: Byte; const Buf; const Size: NativeUInt): Boolean;
begin
  FLock.BeginWrite;
  try
    Result := not DoContains(Value);
    if Result then Result := DoInsertData(Value, Buf, Size);
  finally
    FLock.EndWrite;
  end;
end;

function TSetList.Remove(const Value: Byte): Boolean;
begin
  FLock.BeginWrite;
  try
    Result := DoRemove(Value);
  finally
    FLock.EndWrite;
  end;
end;

function TSetList.GetData(const Value: Byte): TBytes;
begin
  FLock.BeginRead;
  try
    Result := DoGetData(Value);
  finally
    FLock.EndRead;
  end;
end;

function TSetList.GetDataAsStr(const Value: Byte): String;
var
  Data: TBytes;
begin
  FLock.BeginRead;
  try
    Data := DoGetData(Value);
  finally
    FLock.EndRead;
  end;

  Result := '';
  if Data <> nil then Result := ByteArrToStr(PByte(Data), Length(Data));
end;

function TSetList.GetValues: TArray<Byte>;
var
  Value, Index: Integer;
begin
  FLock.BeginRead;
  try
    SetLength(Result, FCount);
    Index := 0;
    for Value := 0 to MAXBYTE do
      if Value in FMembers then
      begin
        Result[Index] := Value;
        Inc(Index);
      end;
  finally
    FLock.EndRead;
  end;
end;

function TSetList.IndexOf(const Buf; const Size: NativeUInt; const From: Integer): Integer;
begin
  FLock.BeginRead;
  try
    Result := DoIndexOf(Buf, Size, From);
  finally
    FLock.EndRead;
  end;
end;

function TSetList.LastIndexOf(const Buf; const Size: NativeUInt): Integer;
begin
  FLock.BeginRead;
  try
    Result := DoLastIndexOf(Buf, Size);
  finally
    FLock.EndRead;
  end;
end;

procedure TSetList.Clear;
begin
  FLock.BeginWrite;
  try
    FMembers := [];
    FData := nil; { payloads are refcounted - dropping the slots releases them }
    FCount := 0;
  finally
    FLock.EndWrite;
  end;
end;

{ TSetListEx - unlocked cores }
function TSetListEx.Page(const Key: Integer; const Grow: Boolean): PSetList;
var
  Index: Integer;
begin
  Result := nil;
  if Key < 0 then Exit;

  Index := Key shr 8;
  if Index > High(FPages) then
  begin
    if not Grow then Exit;
    SetLength(FPages, Index +1);
  end;

  Result := @FPages[Index];
end;

function TSetListEx.DoInsert(const Key: Integer; const Buf; const Size: NativeUInt): Boolean;
var
  P: PSetList;
  IsNew: Boolean;
begin
  Result := False;
  P := Page(Key, True);
  if P = nil then Exit;

  IsNew := not P^.DoContains(Key and $FF);
  Result := P^.DoInsertData(Key and $FF, Buf, Size);
  if not Result then Exit;

  if IsNew then Inc(FCount);
  { keep Append clear of explicitly inserted keys }
  if Key >= FNext then FNext := Key +1;
end;

function TSetListEx.DoAppend(const Buf; const Size: NativeUInt): Integer;
begin
  Result := FNext;
  if not DoInsert(Result, Buf, Size) then Result := -1;
end;

function TSetListEx.DoIndexOf(const Buf; const Size: NativeUInt): Integer;
var
  P, Slot: Integer;
begin
  Result := -1;
  for P := 0 to High(FPages) do
  begin
    Slot := FPages[P].DoIndexOf(Buf, Size, 0);
    if Slot >= 0 then Exit((P shl 8) or Slot);
  end;
end;

{ TSetListEx - locked shells }
function TSetListEx.Count: Integer;
begin
  FLock.BeginRead;
  try
    Result := FCount;
  finally
    FLock.EndRead;
  end;
end;

function TSetListEx.Insert(const Key: Integer; const Buf; const Size: NativeUInt): Boolean;
begin
  FLock.BeginWrite;
  try
    Result := DoInsert(Key, Buf, Size);
  finally
    FLock.EndWrite;
  end;
end;

function TSetListEx.InsertIfAbsent(const Key: Integer; const Buf; const Size: NativeUInt): Boolean;
var
  P: PSetList;
begin
  FLock.BeginWrite;
  try
    P := Page(Key, False);
    Result := (P = nil) or not P^.DoContains(Key and $FF);
    if Result then Result := DoInsert(Key, Buf, Size);
  finally
    FLock.EndWrite;
  end;
end;

function TSetListEx.Append(const Buf; const Size: NativeUInt): Integer;
begin
  FLock.BeginWrite;
  try
    Result := DoAppend(Buf, Size);
  finally
    FLock.EndWrite;
  end;
end;

function TSetListEx.AppendUnique(const Buf; const Size: NativeUInt): Integer;
begin
  FLock.BeginWrite;
  try
    Result := DoIndexOf(Buf, Size);
    if Result < 0 then Result := DoAppend(Buf, Size);
  finally
    FLock.EndWrite;
  end;
end;

function TSetListEx.Remove(const Key: Integer): Boolean;
var
  P: PSetList;
begin
  FLock.BeginWrite;
  try
    P := Page(Key, False);
    Result := (P <> nil) and P^.DoRemove(Key and $FF);
    if Result then Dec(FCount);
  finally
    FLock.EndWrite;
  end;
end;

function TSetListEx.Contains(const Key: Integer): Boolean;
var
  P: PSetList;
begin
  FLock.BeginRead;
  try
    P := Page(Key, False);
    Result := (P <> nil) and P^.DoContains(Key and $FF);
  finally
    FLock.EndRead;
  end;
end;

function TSetListEx.GetData(const Key: Integer): TBytes;
var
  P: PSetList;
begin
  FLock.BeginRead;
  try
    P := Page(Key, False);
    if P <> nil then Result := P^.DoGetData(Key and $FF)
    else Result := nil;
  finally
    FLock.EndRead;
  end;
end;

function TSetListEx.GetKeys: TArray<Integer>;
var
  P, V, N: Integer;
begin
  FLock.BeginRead;
  try
    SetLength(Result, FCount);
    N := 0;
    for P := 0 to High(FPages) do
      for V := 0 to MAXBYTE do
        if FPages[P].DoContains(V) then
        begin
          Result[N] := (P shl 8) or V;
          Inc(N);
        end;
    SetLength(Result, N);
  finally
    FLock.EndRead;
  end;
end;

function TSetListEx.IndexOf(const Buf; const Size: NativeUInt): Integer;
begin
  FLock.BeginRead;
  try
    Result := DoIndexOf(Buf, Size);
  finally
    FLock.EndRead;
  end;
end;

function TSetListEx.IndexOf(const S: String): Integer;
var
  B: TBytes;
begin
  Result := -1;
  B := WideBytesOf(S);
  if Length(B) > 0 then Result := IndexOf(B[0], Length(B));
end;

function TSetListEx.LastIndexOf(const Buf; const Size: NativeUInt): Integer;
var
  P, Slot: Integer;
begin
  Result := -1;

  FLock.BeginRead;
  try
    for P := High(FPages) downto 0 do
    begin
      Slot := FPages[P].DoLastIndexOf(Buf, Size);
      if Slot >= 0 then Exit((P shl 8) or Slot);
    end;
  finally
    FLock.EndRead;
  end;
end;

function TSetListEx.LastIndexOf(const S: String): Integer;
var
  B: TBytes;
begin
  Result := -1;
  B := WideBytesOf(S);
  if Length(B) > 0 then Result := LastIndexOf(B[0], Length(B));
end;

function TSetListEx.KeysOf(const Buf; const Size: NativeUInt): TArray<Integer>;
var
  P, Slot, N: Integer;
begin
  Result := nil;
  N := 0;

  FLock.BeginRead;
  try
    for P := 0 to High(FPages) do
    begin
      Slot := FPages[P].DoIndexOf(Buf, Size, 0);
      while Slot >= 0 do
      begin
        if N = Length(Result) then
          SetLength(Result, N * 2 + 4);
        Result[N] := (P shl 8) or Slot;
        Inc(N);
        Slot := FPages[P].DoIndexOf(Buf, Size, Slot +1);
      end;
    end;
  finally
    FLock.EndRead;
  end;

  SetLength(Result, N);
end;

function TSetListEx.KeysOf(const S: String): TArray<Integer>;
var
  B: TBytes;
begin
  Result := nil;
  B := WideBytesOf(S);
  if Length(B) > 0 then Result := KeysOf(B[0], Length(B));
end;

procedure TSetListEx.Clear;
begin
  FLock.BeginWrite;
  try
    FPages := nil;
    FCount := 0;
    FNext := 0;
  finally
    FLock.EndWrite;
  end;
end;

{ TMemoryPoolEx }
{
  ItemSize: Individual item size + [Optional extra for linear mem-alloc]
  Memory: Minimum RAM requirement
  Capacity: Initial capacity <# of item-size> on initialization
  GrowSize: Grow capacity by (GrowSize) upon initial and subsequent allocation exhaustion
  MaxCapacity: Limit before GrowSize stops being applied. Items = MaxCapacity!

  Ex:
  Create(SizeOf(TSomeRec), BYTES_IN_ONE_GB, 1000, 1000);
  Create(SizeOf(TSomeRec) +SomeMore_Bytes, BYTES_IN_ONE_GB, 1000, 1000);
}
constructor TMemoryPoolEx.Create(const ItemSize: Integer; Memory: Integer; Capacity: Integer; GrowSize: Integer; MaxCapacity: Integer);
var
  Ptr: Pointer;
begin
  CriticalSectionOK := False;
  if ItemSize <= 0 then raise Exception.Create('invalid item size!');
  Self.ItemSize := ItemSize;

  Roof := MaxCapacity;
  Self.GrowSize := GrowSize;

  FIdleMs := 60000;
  FLowPct := 20;
  FHighPct := 60;

  Floor := Capacity;
  RAM := Memory;
  Pool := TQueueEx<Pointer>.Create(Floor);
  Pool.Clear;

  repeat
    GetMem(Ptr, ItemSize);
    if Ptr <> nil then
    begin
      Pool.Enqueue(Ptr);
      Inc(Allocated);
    end;
    { whichever comes first! }
  until (GetAvailableRAM <= RAM) or (Pool.Count >= Capacity);

  try
    InitializeCriticalSection(CriticalSection);
    CriticalSectionOK := (CriticalSection.DebugInfo <> nil);
  except
    on E: Exception do
      CriticalSectionOK := False;
  end;
end;

destructor TMemoryPoolEx.Destroy;
begin
  {
    FIRST :: the blocking delete waits out a running Trim, which takes Lock and
    walks Pool. nothing below may be freed before it returns, and it must never
    be called while holding Lock <Trim would wait on us>.
  }
  if Timer <> 0 then
  begin
    FAutoTrim := False;
    DeleteTimerQueueTimer(0, Timer, INVALID_HANDLE_VALUE);
    Timer := 0;
  end;

  if Pool <> nil then
  begin
    try
      { waste what's unused! }
      while Pool.Count > 0 do
      begin
        try
          FreeMem(Pool.Dequeue);
        except
          On E: Exception do
            {$ifdef release} continue;
            {$else} break;{$endif}
        end;
      end;
    finally
      FreeAndNil(Pool);
    end;
  end;

  if CriticalSectionOK then DeleteCriticalSection(CriticalSection);
  inherited Destroy;
end;

function TMemoryPoolEx.Grow(Dequeue: Boolean): Pointer;
var
  AvailableRAM: UInt64;
  Ptr: Pointer;
  Count: Integer;
begin
  Result := nil;
  Lock;

  try
    try
      Count := 0;
      if Pool.Count > 0 then Exit(Pool.Dequeue);

      {
        we've exhausted our initial allocation... make more
         check RAM is available, even if we have a roof
      }
      repeat
        { what the PC has }
        AvailableRAM := GetAvailableRAM;

        if (AvailableRAM > RAM) then
        begin
          { set roof? }
          if (Roof <= 0) or (Pool.Count < Roof) then
          begin
            try
              GetMem(Ptr, ItemSize);
              Pool.Enqueue(Ptr);
              Inc(Allocated);
            except
              On E: Exception do
              begin
                HandleEvent(etAppException, 'GetMEM failed to acquire new memory!', GetLastError, E.StackTrace);
                Exit(nil);
              end;
            end;
          end

          else
          begin
            HandleEvent(etMessage, 'maximum (set) allocation reached!');
            Exit(nil);
          end;
        end

        else
        begin
          HandleEvent(etMessage, 'insufficient RAM');
          Exit(nil);
        end;

        Inc(Count);
      until (Ptr = nil) or (Count >= GrowSize);

      Observe;
      if Assigned(OnRoofChange) then OnRoofChange(Allocated);

      { need one?! }
      if (not Dequeue) then Exit(nil);

      { return a valid pointer }
      Pool.TryDequeue(Result);
    finally
      UnLock;
    end;
  except
    on E: Exception do
      HandleEvent(etAppException, E.Message, GetLastError, E.StackTrace);
  end;
end;

function TMemoryPoolEx.Acquire: Pointer;
begin
  Result := nil;

  Lock;
  try
    try
      { yet to exhaust initial allocation, get one from the queue }
      if Pool.TryDequeue(Result) then
      begin
        Peak := Max(Peak, Allocated -Pool.Count);
        Exit;
      end;
      if ItemSize = 0 then Exit(nil);
    finally
      UnLock;
    end;

    { make more, if possible... }
    Exit(Grow);
  except
    on E: Exception do
      HandleEvent(etAppException, E.Message, GetLastError, E.StackTrace);
  end;
end;

procedure TMemoryPoolEx.HandleEvent(const Id: TAppEventType; const Msg: String; Code: Integer; Trace: String);
var
  Event: TAppEvent;
begin
  if not Assigned(OnEvents) then Exit;

  Event := Default(TAppEvent);
  Event.TimeStamp := Now;   { was never stamped :: the log showed a zero date }
  Event.Reason := Id;
  Event.Code := Code;
  { the sink renders Msg :: the trace rides inside it, Trace kept for callers }
  Event.Msg := StrTernary(Trace = EmptyString, Msg,
    format('%s'#13#10'%s'#13#10, [Msg, Trace]));
  Event.Trace := Trace;

  {
    the record is a LOCAL, so the pointer dies with this frame and the
    consumer has already copied :: nothing to wait for <the 10ms here was the
    same band-aid the shared-record emitters carried>.
  }
  OnEvents(@Event);
end;

procedure TMemoryPoolEx.Lock;
begin
  if CriticalSectionOK then
    EnterCriticalSection(CriticalSection);
end;

procedure TMemoryPoolEx.UnLock;
begin
  if CriticalSectionOK then
    LeaveCriticalSection(CriticalSection);
end;

function TMemoryPoolEx.PoolCount: Integer;
begin
  Result := Pool.Count;
end;

function TMemoryPoolEx.PoolMax: Integer;
begin
  Result := Allocated;
end;

{
  AUTO-TRIM :: hands idle blocks back to the heap.

  a block is idle when it sits in Pool <free list>. in-use = Allocated -Pool.Count.
  Peak is the most in-use seen over the current window <Acquire raises it>.

  start  :: Peak stayed <= LowPct of Allocated for a full IdleMs since the last
            growth. anything above that holds.
  run    :: each step frees half the excess down to Keep = Peak / HighPct <so the
            peak would then use HighPct of what remains = burst headroom>, never
            below Floor. stops at Keep, or when Peak climbs.
  sleep  :: at Allocated <= Floor, or switched off. Grow wakes it via Observe.

  runs on a timer-queue thread. everything shared is touched under Lock only;
  blocks are freed AFTER unlocking so Acquire <the receive thread> never waits
  on the heap.
}
procedure TrimThunk(Ctx: Pointer; Fired: Boolean); stdcall;
begin
  TMemoryPoolEx(Ctx).Trim;
end;

function TMemoryPoolEx.StepMs: Integer;
begin
  Result := Max(FIdleMs div 6, 100);
end;

{ caller holds Lock :: restart the observation window and (re)arm the timer }
procedure TMemoryPoolEx.Observe;
begin
  if not FAutoTrim then Exit;

  WindowStart := GetTickCountEx;
  Peak := Allocated -Pool.Count;
  { pessimistic until one full window has been measured :: forbids a start }
  LastPeak := Allocated;
  Trimming := False;

  if Timer = 0 then
  begin
    if not CreateTimerQueueTimer(Timer, 0, @TrimThunk, Self, StepMs, StepMs, WT_EXECUTEDEFAULT) then
    begin
      Timer := 0;
      FAutoTrim := False;
      HandleEvent(etAppError, 'auto-trim timer failed to start!', GetLastError);
    end;
  end
  else ChangeTimerQueueTimer(0, Timer, StepMs, StepMs);
end;

procedure TMemoryPoolEx.Trim;
const
  DORMANT = $7FFFFFFF;
var
  Doomed: TArray<Pointer>;
  Seen, Keep, Drop, i, Remaining: Integer;
  Ticks: UInt64;
begin
  try
    Remaining := 0;
    Lock;
    try
      if (not FAutoTrim) or (Allocated <= Floor) then
      begin
        { periodic timer :: park it far out, Observe pulls it back in }
        Trimming := False;
        ChangeTimerQueueTimer(0, Timer, DORMANT, DORMANT);
        Exit;
      end;

      Ticks := GetTickCountEx;
      if (Ticks -WindowStart) >= UInt64(FIdleMs) then
      begin
        LastPeak := Peak;
        Peak := Allocated -Pool.Count;
        WindowStart := Ticks;
      end;

      Seen := Max(LastPeak, Peak);
      if not Trimming then
        Trimming := (Int64(Seen) *100) <= (Int64(Allocated) *FLowPct);

      if Trimming then
      begin
        Keep := Max(Floor, Integer((Int64(Seen) *100 +Max(FHighPct, 1) -1) div Max(FHighPct, 1)));
        Drop := Min((Allocated -Keep +1) div 2, Pool.Count);
        Trimming := (Drop > 0);

        if Trimming then
        begin
          SetLength(Doomed, Drop);
          for i := 0 to Drop -1 do
            Pool.TryDequeue(Doomed[i]);

          Dec(Allocated, Drop);
          Inc(Freed, Drop);
          Remaining := Allocated;
        end;
      end;
    finally
      UnLock;
    end;

    for i := 0 to High(Doomed) do
      FreeMem(Doomed[i]);

    if (Length(Doomed) > 0) and Assigned(OnRoofChange) then
      OnRoofChange(Remaining);
  except
    { foreign thread :: nothing above us to catch this }
    on E: Exception do
      HandleEvent(etAppException, 'auto-trim: ' +E.Message, GetLastError, E.StackTrace);
  end;
end;

procedure TMemoryPoolEx.SetAutoTrim(const Value: Boolean);
begin
  { without the lock nothing here is safe :: stay off }
  if not CriticalSectionOK then Exit;

  Lock;
  try
    FAutoTrim := Value;
    Trimming := False;
    if Value and (Allocated > Floor) then Observe;
  finally
    UnLock;
  end;
end;

procedure TMemoryPoolEx.SetIdleMs(const Value: Integer);
begin
  Lock;
  try
    FIdleMs := Max(Value, 600);
    if FAutoTrim and (Allocated > Floor) then Observe;
  finally
    UnLock;
  end;
end;

{ fills the pool-owned fields only :: Size/Used/Mem* stay with the owner }
procedure TMemoryPoolEx.Snapshot(var S: TSocketMemoryStat);
begin
  Lock;
  try
    S.Peak := Max(LastPeak, Peak);
    S.Trimming := Trimming;
    S.Freed := Freed;
    S.WindowMs := UInt32(Min(GetTickCountEx -WindowStart, UInt64(FIdleMs)));
  finally
    UnLock;
  end;
end;

procedure TMemoryPoolEx.Return(var Items: TThreadedQueue<Pointer>);
var
  Item: Pointer;
begin
  Lock;
  try
    while Items.PopItem(Item) = wrSignaled do
      Pool.Enqueue(Item);
  finally
    Unlock;
  end;
end;

procedure TMemoryPoolEx.Return(var Items: TQueueEx<Pointer>);
var
  I: Integer;
  Ptr: Pointer;
begin
  if Items.Count <= 0 then Exit;

  Lock;
  try
    for i := 0 to Items.Count -1 do
    begin
      if Items.TryDequeue(Ptr) then
        Pool.Enqueue(Ptr);
    end;
  finally
    Unlock;
  end;
end;

procedure TMemoryPoolEx.Return(const Item: Pointer);
begin
  if Item = nil then Exit;

  Lock;
  try
    Pool.Enqueue(Item);
  finally
    UnLock;
  end;
end;

