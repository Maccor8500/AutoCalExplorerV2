function ExecuteCommand(const Cmd: String; Params: String; HideCMD: Boolean; Direct: Byte; Admin: Boolean; Handle: PNativeInt): Boolean;
var
  ExecInfo: TShellExecuteInfo;
  ParamStr, CmdStr: String;
begin
  ParamStr := '';
  FillChar(ExecInfo, SizeOf(TShellExecuteInfo), 0);
  ExecInfo.cbSize := SizeOf(TShellExecuteInfo);
  ExecInfo.fMask  := SEE_MASK_NOCLOSEPROCESS;

  if Assigned(Handle) then Handle^ := 0;
  if Admin then ExecInfo.lpVerb := 'runas'
  else ExecInfo.lpVerb := nil;

  case Direct of
    0:
    begin
      ExecInfo.lpFile := PChar('cmd');
      ParamStr := format('%s %s %s', [StrTernary(HideCMD, '/c', '/k'), cmd, Params]);
    end;

    1:
    begin
      CmdStr := QuoteStr(Cmd);
      ExecInfo.lpFile := PChar(Cmd);
      ParamStr := format(' %s', [Params]);
    end;

    else
    begin
      ShowDialog(dtError,
        format('ExecuteCommand(...), invalid "Direct: [0, 1]", argument = [!%d]', [Direct]));
      Exit(False);
    end;
  end;

  ExecInfo.nShow := IntTernary(HideCMD, SW_HIDE, SW_SHOWNORMAL);
  ExecInfo.lpParameters := PChar(ParamStr);
  Result := ShellExecuteEx(@ExecInfo);

  if Result and (Handle <> nil) then
    Handle^ := ExecInfo.hProcess;
end;


function ExecuteCommand(const cmd: String; AsAdmin: Boolean; HideCMD: Boolean): Boolean; overload;
var
  ExecInfo: TShellExecuteInfo;
begin
  FillChar(ExecInfo, SizeOf(TShellExecuteInfo), 0);
