{
  firmware file for a raw ethernet board <wire index :: controllers first, aux after>,
  full path, '' when the system has none. same map as MacTest32Cal <DownloadROM>.
}
class function TMaccorSystem.GetFirmwareBin(const Brd: Integer): String;
var
  Cfg: PVBBrdTypeStruct;
begin
  Result := '';
  if (Brd >= MacSysPtr^.SysCfg.CtlrBrds) then Exit(MacSysPtr^.Base +'\' +FW_AI);

  case MacSysPtr^.SysId of
    tLabSystem:
    begin
      Result := FW_CNTL1;

      { single range boards run cntl1, multi channel and hyper switch boards cntl8 }
      for var Chan := 0 to Min(MacSysPtr^.MaxChan, High(MacSysPtr^.ExtDataNorm)) do
        if (MacSysPtr^.ExtDataNorm[Chan].BrdNr = Brd) then
        begin
          Cfg := nil;
          if (Brd <= High(MacSysPtr^.BrdData)) then GetBoardConfig(Chan, Cfg);

          if Assigned(Cfg) and (NonZeroValue(Cfg^.ActiveChan)
            or (TMaccorSpecialRange(Cfg^.SpecialRange) = srHyperSwitch)) then Result := FW_CNTL8;
          Break;
        end;
    end;

    tFormation, tUnTyped: Result := FW_CN256;
    t50msPrimaryHV: Result := FW_CTL32;
    t8500Legacy_4: Result := FW_8500;
    t8500Legacy_5: Result := FW_8500M;
    t8500Legacy_6: Result := FW_CNTL8;
  end;

  if (Result <> '') then Result := MacSysPtr^.Base +'\' +Result;
end;

