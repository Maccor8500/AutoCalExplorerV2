function ResetSysChanConfig : Boolean;
var
  i: Integer;
begin
  Result := True;
  try
    for i := Low(MacSys.ChanData) to High(MacSys.ChanData) do
    begin
      {current}
      MacSys.ChanData[i].chg.Islope3 := 1;
      MacSys.ChanData[i].chg.Ioffset3 := 0;
      MacSys.ChanData[i].dis.Islope3 := 1;
      MacSys.ChanData[i].dis.Ioffset3 := 0;

      {voltage}
      MacSys.ChanData[i].chg.Vslope := 1;
      MacSys.ChanData[i].chg.Voffset := 0;
      MacSys.ChanData[i].dis.Vslope := 1;
      MacSys.ChanData[i].dis.Voffset := 0;
    end;
  except
    On E:Exception do
      Result := False;
  end;
end;

function SysChanConfigChanged: Boolean;
