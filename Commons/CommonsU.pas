  end;
end;

function TimeStrToSecs(const TimeStr : String) : Int64;
var
  Arr : TArray<String>;
  Len : Integer;
begin
  Result := 0;

  SplitStr(TimeStr, ':', Arr);
  Len := Length(Arr);

  case Len of
    1: Result := StrToInt(Arr[0]);
    2: Result := (StrToInt(Arr[0]) *SecsPerMin) + StrToInt(Arr[1]);
    3: Result := (StrToInt(Arr[0]) *SecsPerHour) + (StrToInt(Arr[1]) *SecsPerMin) + StrToInt(Arr[2]);
    4: Result := (StrToInt(Arr[0]) *SecsPerDay) + (StrToInt(Arr[1]) *SecsPerHour) + (StrToInt(Arr[2]) *SecsPerMin) + StrToInt(Arr[3]);
  end;
end;

