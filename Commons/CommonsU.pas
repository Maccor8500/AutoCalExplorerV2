{ this treats array as zero-indexed... always! }
procedure StrToCharArr(const S : String; var A : Array of AnsiChar; ZeroIndexed : Boolean = false);
var
  i, LS, LA, Len, Head : Integer;
begin
  LA := Length(A);
  LS := Length(S);
  if LA <= 0 then Exit;

  { clear array }
  Fill(@A, 0, Length(A));
  { where to start }
  Head := IntTernary(ZeroIndexed, 0, 1);
  { how many characters to copy }
  Len := IntTernary(LA < LS, LA, LS) -1;

  { copy }
  for i := Head to Len do
  begin
    if ZeroIndexed then A[i] := AnsiChar(S[i +1])
    else A[i] := AnsiChar(S[i]);
  end;
end;

