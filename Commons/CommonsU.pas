class procedure TUtils.Sum<T>(const Data: TArray<T>; var Value: UInt64);
var
  Item: T;
begin
  Value := 0;
  for Item in Data do Value := Value +TValue.From<T>(Item).AsType<Word>;
end;

class function TUtils.Sum<T>(const Data: TArray<T>): Double;
var
  Item: T;
begin
  Result := 0.0;
  for Item in Data do Result := Result +TValue.From<T>(Item).AsType<Double>;
end;

class function TUtils.Sum<T>(const Data: Array of T): Double;
var
  Item: T;
begin
  Result := 0.0;
  for Item in Data do Result := Result +TValue.From<T>(Item).AsType<Double>;
end;

class function TUtils.Sum<T>(const Data: array of T; Len: Integer): Double;
var
  Item: T;
  Index: Integer;
begin
  Result := 0.0;
  Index := 0;

  for Item in Data do
  begin
    if (Len > 0) and (Index >= Len) then break;
    Result := Result +TValue.From<T>(Item).AsType<Double>;
    Inc(Index);
  end;
end;

class function TUtils.Min<T>(const Data: array of T): T;
var
  I: Integer;
  Cmp: IComparer<T>;
begin
  Result := Default(T);
  if High(Data) < 0 then
    Exit;

  Cmp := TComparer<T>.Default;

  Result := Data[0];
  for I := 1 to High(Data) do
    if Cmp.Compare(Data[I], Result) < 0 then
      Result := Data[I];
end;

class function TUtils.Max<T>(const Data: array of T): T;
var
  I: Integer;
  Cmp: IComparer<T>;
begin
  Result := Default(T);
  if High(Data) < 0 then
    Exit;

  Cmp := TComparer<T>.Default;

  Result := Data[0];
  for I := 1 to High(Data) do
    if Cmp.Compare(Data[I], Result) > 0 then
      Result := Data[I];
end;

