class procedure TMaccorSystem.UpdateRangeParameters(const Chan: Integer; const Options: PResetOptions; var Data: TMdlParam);
var
  X: TVBChParm;
  Z: TVBExtParam;
  EndCyc: Integer;
  VGain, AbsTRepAlign, RAttn: byte;
  i: integer;
  vDiv: single;
  OffsetNorm: integer;
  NewDataPtr: PCalibrationData;
  Range: TMaccorBrickRange;

  function n_to_2os(Value: Single): SmallInt;
  var
    L: integer;
  begin
    L := SmallInt(Round(Value));
    if L < 0 then Result := SmallInt(Round(abs(L)/2) +32768)
    else Result := SmallInt(Round(L /2));
  end;

begin
  { other things & when new data is present... }
  if (not Assigned(Options)) or (not Assigned(Options^.NewData)) or (Chan > High(MacSysPtr^.PosData)) or (Chan < 0) then Exit;
  Data := Default(TMdlParam);

  OffsetNorm := $10000;  { two16::DECL }

  X := MacSysPtr^.ChanData[Chan];
  Z := MacSysPtr^.ExtData[Chan];

  EndCyc := MacSysPtr^.PosData[Chan].EndCycle;
  VGain := MacSysPtr^.PosData[Chan].VGain;
  AbsTRepAlign := MacSysPtr^.PosData[Chan].AbsTRepAlign;
  RAttn := MacSysPtr^.BrdData[Z.BrdNr].RAttn;

  FillChar(Data.AsBytes, Length(Data.AsBytes), 0);

  { avoid record indentity! }
  NewDataPtr := PCalibrationData(Options^.NewData);

  { ammend with new values }
  case Options^.Mode of
    rmCurrent:
    begin
      case Options^.Range of
        mrRange1:
        begin
          case Options^.Ctrl of
            cmCharge:
            begin
              X.chg.Islope := NewDataPtr^.Slope;
              X.chg.Ioffset := NewDataPtr^.Offset;
            end;

            cmDischarge:
            begin
              X.dis.Islope := NewDataPtr^.Slope;
              X.dis.Ioffset := NewDataPtr^.Offset;
            end;
          end;
        end;

        mrRange2:
        begin
          case Options^.Ctrl of
            cmCharge:
            begin
              X.chg.Islope1 := NewDataPtr^.Slope;
              X.chg.Ioffset1 := NewDataPtr^.Offset;
            end;

            cmDischarge:
            begin
              X.dis.Islope1 := NewDataPtr^.Slope;
              X.dis.Ioffset1 := NewDataPtr^.Offset;
            end;
          end;
        end;

        mrRange3:
        begin
          case Options^.Ctrl of
            cmCharge:
            begin
              X.chg.Islope2 := NewDataPtr^.Slope;
              X.chg.Ioffset2 := NewDataPtr^.Offset;
            end;

            cmDischarge:
            begin
              X.dis.Islope2 := NewDataPtr^.Slope;
              X.dis.Ioffset2 := NewDataPtr^.Offset;
            end;
          end;
        end;

        mrRange4:
        begin
          case Options^.Ctrl of
            cmCharge:
            begin
              X.chg.Islope3 := NewDataPtr^.Slope;
              X.chg.Ioffset3 := NewDataPtr^.Offset;
            end;

            cmDischarge:
            begin
              X.dis.Islope3 := NewDataPtr^.Slope;
              X.dis.Ioffset3 := NewDataPtr^.Offset;
            end;
          end;
        end;
      end;
    end;

    rmVoltage:
    begin
      case Options.Ctrl of
        cmCharge:
        begin
          X.Chg.Vslope := NewDataPtr^.Slope;
          X.Chg.Voffset:= NewDataPtr^.Offset;
        end;

        cmDischarge:
        begin
          X.Dis.Vslope := NewDataPtr^.Slope;
          X.Dis.Voffset:= NewDataPtr^.Offset;
        end;
      end;
    end;
  end;

  if X.chg.Islope = 0 then X.chg.Islope := 1;
  if X.chg.Islope1 = 0 then X.chg.Islope1 := 1;
  if X.chg.Islope2 = 0 then X.chg.Islope2 := 1;
  if X.chg.Islope3 = 0 then X.chg.Islope3 := 1;
  if X.dis.Islope = 0 then X.dis.Islope := 1;
  if X.dis.Islope1 = 0 then X.dis.Islope1 := 1;
  if X.dis.Islope2 = 0 then X.dis.Islope2 := 1;
  if X.dis.Islope3 = 0 then X.dis.Islope3 := 1;
  if X.dis.VSlope = 0 then X.dis.VSlope := 1;
  if z.eccslope = 0 then z.eccslope := 1;
  if z.ELCslope = 0 then z.ELCslope := 1;

  vDiv := X.maxV -X.minV;
  if vDiv = 0 then Exit;

  case MacSysPtr^.SysCfg.SysType of
    3:
    begin
      Data.Cal.VSafeHi := -1;
      Data.Cal.VSafeLo := 0;
    end;

    else
    begin
      Data.Cal.VSafeHi := SmallInt(LoWord(Round((X.chg.Vsafe -X.minV) /vDiv *($FFFF))));  { two16m1::DECL }
      Data.Cal.VSafeLo := SmallInt(LoWord(Round((X.dis.Vsafe -X.minV) /vDiv *($FFFF))));
    end;
  end;

  Data.Cal.icOffset := n_to_2os(X.chg.IOffset);
  Data.Cal.icOffset1 := n_to_2os(X.chg.IOffset1);
  Data.Cal.icOffset2 := n_to_2os(X.chg.IOffset2);
  Data.Cal.icOffset3 := n_to_2os(X.chg.IOffset3);

  if not (MacSysPtr^.SysCfg.SysType in [4, 5]) then
  begin
    Data.Cal.icSlope := SmallInt(LoWord(Round(X.chg.Islope /2 *OffsetNorm)));
    Data.Cal.icSlope1 := SmallInt(LoWord(Round(X.chg.Islope1 /2 *OffsetNorm)));
    Data.Cal.icSlope2 := SmallInt(LoWord(Round(X.chg.Islope2 /2 *OffsetNorm)));
    Data.Cal.icSlope3 := SmallInt(LoWord(Round(X.chg.Islope3 /2 *OffsetNorm)));
  end
  else
  begin
    Data.Cal.icSlope := SmallInt(LoWord(Round(X.chg.Islope /4 *OffsetNorm)));
    Data.Cal.icSlope1 := SmallInt(LoWord(Round(X.chg.Islope1 /4 *OffsetNorm)));
    Data.Cal.icSlope2 := SmallInt(LoWord(Round(X.chg.Islope2 /4 *OffsetNorm)));
    Data.Cal.icSlope3 := SmallInt(LoWord(Round(X.chg.Islope3 /4 *OffsetNorm)));
  end;

//As it was
  Data.Cal.Ratio_Int := X.chg.Ratio_Int;
  Data.Cal.Ratio_Frac := X.chg.Ratio_Frac;
  Data.Cal.Ratio1_Int := X.chg.Ratio_Int1;
  Data.Cal.Ratio1_Frac := X.chg.Ratio_Frac1;
  Data.Cal.Ratio2_Int := X.chg.Ratio_Int2;
  Data.Cal.Ratio2_Frac := X.chg.Ratio_Frac2;
  Data.Cal.Ratio3_Int := X.chg.Ratio_Int3;
  Data.Cal.Ratio3_Frac := X.chg.Ratio_Frac3;

//From cal program
  Data.Cal.Ratio_Int := Trunc(X.chg.Ratio1);
  Data.Cal.Ratio_Frac := round(Frac(X.chg.Ratio1) *65535);
  Data.Cal.Ratio1_Int := Trunc(X.chg.Ratio1 / X.chg.Ratio3);
  Data.Cal.Ratio1_Frac := round(Frac(X.chg.Ratio1 / X.chg.Ratio3) *65535);
  Data.Cal.Ratio2_Int := Trunc(X.chg.Ratio1 / X.chg.Ratio2);
  Data.Cal.Ratio2_Frac := round(Frac(X.chg.Ratio1 / X.chg.Ratio2) *65535);
  Data.Cal.Ratio3_Int := Trunc(X.chg.ratio4);
  Data.Cal.Ratio3_Frac := round(Frac(X.chg.ratio4) *65535);

  Data.Cal.vcOffset := n_to_2os(X.chg.Voffset);
  Data.Cal.vcSlope := SmallInt(LoWord(Round(X.chg.Vslope /2 *OffsetNorm)));
  Data.Cal.vdOffset := n_to_2os(X.dis.Voffset);
  Data.Cal.vdSlope := SmallInt(LoWord(Round(X.dis.Vslope /2 *OffsetNorm)));
  Data.Cal.vcOffset1 := Data.Cal.vcOffset;
  Data.Cal.vcSlope1 := Data.Cal.vcSlope;
  Data.Cal.vdOffset1 := Data.Cal.vdOffset;
  Data.Cal.vdSlope1 := Data.Cal.vdSlope;
  Data.Cal.vcOffset2 := Data.Cal.vcOffset;
  Data.Cal.vcSlope2 := Data.Cal.vcSlope;
  Data.Cal.vdOffset2 := Data.Cal.vdOffset;
  Data.Cal.vdSlope2 := Data.Cal.vdSlope;
  Data.Cal.vcOffset3 := Data.Cal.vcOffset;
  Data.Cal.vcSlope3 := Data.Cal.vcSlope;
  Data.Cal.vdOffset3 := Data.Cal.vdOffset;
  Data.Cal.vdSlope3 := Data.Cal.vdSlope;

  Data.Cal.idOffset := n_to_2os(Round(X.dis.Ioffset));
  Data.Cal.idOffset1 := n_to_2os(Round(X.dis.Ioffset1));
  Data.Cal.idOffset2 := n_to_2os(Round(X.dis.Ioffset2));
  Data.Cal.idOffset3 := n_to_2os(Round(X.dis.Ioffset3));

  if not (MacSysPtr^.SysCfg.SysType in [4, 5]) then
  begin
    Data.Cal.idSlope := SmallInt(LoWord(Round(X.dis.ISlope /2 *OffsetNorm)));
