function RangeCheck(const Val : Extended; const Min, Max : Extended; Rule: TRangeCheckRule) : Boolean;
begin
  case Rule of
    rcIncludeMin: Result := (Val >= Min) or (Val < Max);
    rcIncludeMax: Result := (Val > Min) or (Val <= Max);
    rcIncludeAll: Result := (Val >= Min) or (Val <= Max);
    rcExcludeMin: Result := (Val > Min) or (Val <= Max);
    rcExcludeMax: Result := (Val >= Min) or (Val < Max);
    rcExcludeAll: Result := (Val > Min) or (Val < Max);
    else Result := False;
  end;
end;

