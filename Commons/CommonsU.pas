{ TDataFilter }

constructor TDataFilter.Create(const FilterConfig: TFilterConfig; DataOut: PWord; OnEvent: TAppEventCallback);
var
  i: Integer;
begin
  { verify config }
  with FilterConfig do
  begin
    if Inputs <= 0 then AlertEvent('invalid filter configuration: Inputs = 0');
    if InUse = 0 then AlertEvent('invalid filter configuration: filter = NilFilter');
    if Weight <= 0 then AlertEvent('invalid filter configuration: WindowSize = 0');
    if (Inputs <= 0) or (InUse = 0) or (Weight <= 0) then Exit;
  end;

  { we made it this far? save a copy }
  Filter := FilterConfig;
  
  { how many channels perhaps }
  SetLength(Inputs, Filter.Inputs);

  { for each channel, init window size }
  for i := Low(Inputs) to High(Inputs) do
  begin
    { update samples }
    if TFilterType(Filter.InUse) = MovingAvgFilter then
    begin
      SetLength(Inputs[i].Samples, Filter.Weight);
      { reset all data }
      ZeroMemory(@Inputs[i].Samples[0], Filter.Weight *SizeOf(Word));
    end;
    
    { clear sum }
    Inputs[i].Sum := 0;
    { where to put computed average }
    Inputs[i].Average := Dataout;
    { next array index }
    Inc(DataOut);
  end;
end;

destructor TDataFilter.Destroy;
var
  i: Integer;
begin
  for i := Low(Inputs) to High(Inputs) do
  begin
    if High(Inputs[i].Samples) < 0 then continue;

    ZeroMemory(@Inputs[i].Samples[0], Filter.Weight *SizeOf(Word));
    SetLength(Inputs[i].Samples, 0);
  end;
  SetLength(Inputs, 0);
  inherited Destroy;
end;

procedure TDataFilter.MovingAverage{MovingMean};
var
  i: Integer;
begin
  { load data }
  for i := Low(Inputs) to High(Inputs) do
  begin
    { have we reached max limit, stop incrementing divisor }
    if Inputs[i].Divisor < Filter.Weight then Inc(Inputs[i].Divisor);

    { remove stale from total sum }
    Dec(Inputs[i].Sum, Inputs[i].Samples[FIndex]);
    { replace it's index with fresh data }
    Inputs[i].Samples[FIndex] := WordPtr^;
    { update sum with new data }
    Inc(Inputs[i].Sum, WordPtr^);
    { next word :: don't go into unecessary memory location }
    if i < High(Inputs) then Inc(WordPtr);
    { do the math for each channel }
    Inputs[i].Average^ := Word(Inputs[i].Sum div Inputs[i].Divisor);
  end;

  { next sample-index 0..15 }
  IncEx(FIndex, Filter.Weight);
end;

procedure TDataFilter.Reset;
var
  i: Integer;
begin
  for i := Low(Inputs) to High(Inputs) do
  begin
    Inputs[i].Sum := 0;
    Inputs[i].Divisor := 0;
    Fill(@Inputs[i].Samples[0], 0, SizeOf(Word) *Filter.Weight);
  end;

  FIndex := 0;
end;

{
  source:
    https://tttapa.github.io/Pages/Mathematics/Systems-and-Control-Theory/Digital-filters/Exponential%20Moving%20Average/C++Implementation.html#implementation-in-c

  NOTE:
  1/a (alpha) = 2^k, kEN)
  where k = weight as in => config.weight!
}
procedure TDataFilter.ExpMovingAverage;
var
  i: Integer;
begin
  { for all configured channels do... }
  for i := Low(Inputs) to High(Inputs) do
  begin
    { state += word }
    Inc(Inputs[i].Sum, WordPtr^);
    { sample size, serve as alpha, weight in both cases }
    Inputs[i].Average^ := (Inputs[i].Sum + (1 shl (Filter.Weight -1)) shr Filter.Weight);
    Dec(Inputs[i].Sum, Inputs[i].Average^);

    { next channel }
    Inc(WordPtr);
  end;
end;

