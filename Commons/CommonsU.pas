function GetFileBytes(const F: String; Buffer: PByte; var BufSize: UInt64): Boolean;
var
  Handle: THandle;
  CopySize: UInt64;
begin
  Result := False;
  if not FileExists(F) then Exit;

  Handle := FileOpen(F, fmOpenRead + fmShareDenyNone);
  if Handle <> INVALID_HANDLE_VALUE then
  begin
    try
      CopySize := Min(BufSize, FileSeek(Handle, 0, soFromEnd));
      FileSeek(Handle, 0, soFromBeginning);
      Result := FileRead(Handle, Buffer^, CopySize) = CopySize;
      BufSize := IntTernary(Result, CopySize, 0);
    finally
      FileClose(Handle);
    end;
  end;
end;

function GetFileBytes(const F: String; var Buffer: TBytes): Boolean;
var
  Stream: TFileStream;
begin
  Result := False;
  if not FileExists(F) then Exit;

  Stream := TFileStream.Create(F, fmOpenRead +fmShareDenyWrite);
  try
    if Stream.Size <= 0 then Exit;

    Stream.Seek(0, soFromBeginning);
    SetLength(Buffer, Stream.Size);
    Stream.ReadBuffer(Buffer[0], Stream.Size);
    Result := True;
  finally
    FreeAndNil(Stream);
  end;
end;

function GetFileBytes(const F: String): TBytes;
var
  FS: TFileStream;
begin
  if not FileExists(F) then Exit;

  FS := TFileStream.Create(F, fmOpenRead or fmShareDenyNone);
  try
    SetLength(Result, FS.Size);
    if FS.Size > 0 then
      FS.ReadBuffer(Result[0], FS.Size);
  finally
    FreeAndNil(FS);
  end;
end;

