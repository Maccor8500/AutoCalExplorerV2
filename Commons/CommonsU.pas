constructor TCheckboxGroup.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  ColCount := 1;
  Scrollbox := TScrollbox.Create(Self);
  Scrollbox.VertScrollBar.Visible := True;
  Scrollbox.HorzScrollBar.Visible := False;
  Scrollbox.Align := alClient;
  Scrollbox.AlignWithMargins := True;
  Scrollbox.StyleName := 'Windows';
  Scrollbox.Color := clBtnFace;
  Self.Invalidate;
end;

destructor TCheckboxGroup.Destroy;
begin
  { auto frees checkboxes as it owns it }
  inherited;
end;

function TCheckboxGroup.GetColumns: Integer;
begin
  Result := ColCount;
end;

procedure TCheckboxGroup.Add(const Item: String);
var
  Index, Len: Integer;
begin
  Index := Count;
  Len := (Index +1);
  SetLength(Checkboxes, Len);

  Checkboxes[Index] := TCheckbox.Create(Self);
  Checkboxes[Index].Caption := Item;
  Checkboxes[Index].Color := clBtnFace;
  Checkboxes[Index].StyleName := CHECKBOX_STYLE;
  Checkboxes[Index].Checked := False;
  Checkboxes[Index].OnClick := FOnClicked;
  Checkboxes[Index].Parent := Scrollbox;
  ResortBoxes;
end;

procedure TCheckboxGroup.Add(const Items: TStrings);
var
  i: Integer;
begin
  for i := 0 to (Items.Count -1) do
    Add(Items[i]);
end;

procedure TCheckboxGroup.Check(const Index: Integer);
begin
  if Index >= Count then Exit;
  Checkboxes[Index].Checked := True;
  if Assigned(FOnChecked) then
    FOnChecked(Checkboxes[Index]);
end;

procedure TCheckboxGroup.CheckAll;
var
  i: Integer;
begin
  for i := Low(Checkboxes) to High(CheckBoxes) do
    Checkboxes[i].Checked := True;
end;

procedure TCheckboxGroup.UncheckAll;
var
  i: Integer;
begin
  for i := Low(Checkboxes) to High(CheckBoxes) do
    Checkboxes[i].Checked := False;
end;

function TCheckboxGroup.Checked(const Index: Integer): Boolean;
begin
  if Index >= Count then Exit(False);
  Result := Checkboxes[Index].Checked;
end;

function TCheckboxGroup.ItemCount: Integer;
begin
  Result := Length(Checkboxes);
end;

procedure TCheckboxGroup.ResortBoxes;
var
  i, Col, Row: Integer;
  ItemsPerColumn: Integer;
  MaxRows: Integer;
begin
  if Length(Checkboxes) = 0 then
    Exit;

  { calculate items per column }
  ItemsPerColumn := (Length(Checkboxes) +ColCount -1) div ColCount;

  for i := 0 to High(Checkboxes) do
  begin
    Col := i div ItemsPerColumn;
    Row := i mod ItemsPerColumn;

    Checkboxes[i].Left := Col *ColumnWidth +8;
    Checkboxes[i].Top := Row *ItemHeight +4;
    Checkboxes[i].Width := ColumnWidth -12;
    Checkboxes[i].Height := ItemHeight;
  end;

  { adjust scrollbox content height }
  MaxRows := ItemsPerColumn;
  ScrollBox.VertScrollBar.Range := MaxRows *ItemHeight +8;
end;

procedure TCheckboxGroup.SetColumns(const ColCount: Integer);
begin
  if ColCount = ColCount then
    Exit;

  Enabled := False;
  try
    ResortBoxes;
  finally
    Enabled := True;
  end;
end;

