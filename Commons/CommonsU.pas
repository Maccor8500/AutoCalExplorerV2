procedure GetNetworkAddresses(var List : TStrings);
var
  AdapterInfo, AdapterInfoX: PIP_ADAPTER_INFO;
  AdapterInfoSize: ULONG;
  ErrorCode: DWORD;
begin
  if List = nil then Exit;
  List.Clear;

  { first, obtain the required size of the buffer }
  AdapterInfoSize := 0;
  GetAdaptersInfo(nil, AdapterInfoSize);

  { allocate memory for the adapter information }
  GetMem(AdapterInfo, AdapterInfoSize);
  try
    { get the adapter information }
    ErrorCode := GetAdaptersInfo(AdapterInfo, AdapterInfoSize);
    if ErrorCode = ERROR_SUCCESS then
    begin
      AdapterInfoX := AdapterInfo;
      { iterate through the adapter information to find the matching IP address }
      while Assigned(AdapterInfoX) do
      begin
        { add address to list }
        List.Append(String(AdapterInfoX^.IpAddressList.IpAddress.S));
        AdapterInfoX := AdapterInfoX^.Next;
      end;
    end;
  finally
    FreeMem(AdapterInfo);
  end;
end;

procedure GetAdapters(var Adapters : TArray<TAdapterInfo>);
var
  pAdapterInfo: PIP_ADAPTER_INFO;
  pAdapter: PIP_ADAPTER_INFO;
  MIBIfRow: TMIBIfRow;
  dwBufLen: DWORD;
  dwRetVal: DWORD;
  ErrCode: DWORD;
  Addrs : PIP_ADDR_STRING;
  L : SmallInt;
  S : ShortString;
begin
  SetLength(Adapters, 0);
  dwBufLen := SizeOf(IP_ADAPTER_INFO);
  pAdapterInfo := AllocMem(dwBufLen);

  try
    { obtain the required buffer size }
    dwRetVal := GetAdaptersInfo(pAdapterInfo, dwBufLen);
    if dwRetVal = ERROR_BUFFER_OVERFLOW then
    begin
      { size is now correctly set in dwBufLen, so reallocate the buffer }
      ReallocMem(pAdapterInfo, dwBufLen);
      { retrieve the adapter information }
      dwRetVal := GetAdaptersInfo(pAdapterInfo, dwBufLen);
    end;

    if dwRetVal = NO_ERROR then
    begin
      { process the adapter information }
      pAdapter := pAdapterInfo;
      while (pAdapter <> nil) do
      begin
        L := Length(Adapters);
        SetLength(Adapters, L +1);
        Adapters[L] := Default(TAdapterInfo);

        Adapters[L].Name := ShortString(pAdapter^.AdapterName);
        Adapters[L].Desc := ShortString(pAdapter^.Description);
        Adapters[L].IP := ShortString(pAdapter^.IpAddressList.IpAddress.S);
        //Adapters[L].Subnet := ShortString(pAdapter^.
        Adapters[L].MAC := ShortString(Format('%.2x:%.2x:%.2x:%.2x:%.2x:%.2x',
          [pAdapter^.Address[0], pAdapter^.Address[1], pAdapter^.Address[2],
            pAdapter^.Address[3], pAdapter^.Address[4], pAdapter^.Address[5]]));
        Adapters[L].DHCPEnabled := (pAdapter^.DhcpEnabled <> 0);

        { may need further tweaks }
        FillChar(MIBIfRow, SizeOf(TMIBIfRow), 0);
        MIBIfRow.dwIndex := pAdapter^.ComboIndex;
        ErrCode := GetIfEntry(@MIBIfRow);
        if (ErrCode = NO_ERROR) then Adapters[L].Enabled :=
          (TIfOperStatus(MIBIfRow.dwOperStatus) in
            [IfOperStatusUp, IfOperStatusTesting, IfOperStatusDormant]);

        Adapters[L].GWCount := 0;
        Addrs := @pAdapter^.GatewayList;
        while Addrs <> nil do
        begin
          S := ShortString(Addrs^.IpAddress.S);
          if S <> '' then
          begin
            Adapters[L].Gateway[Adapters[L].GWCount] := S;
            Adapters[L].PCAPName := ShortString(format('\Device\NPF_%s', [Adapters[L].Name]));
            Inc(Adapters[L].GWCount);
          end;

          { next! }
          Addrs := Addrs^.Next;
        end;

        { collect all address associated with this interface/adapter }
        Adapters[L].IPCount := 0;
        Addrs := @pAdapter^.IpAddressList;
        while Addrs <> nil do
        begin
          S := ShortString(Trim(String(Addrs^.IpAddress.S)));
          if S <> '' then
          begin
            Adapters[L].AssociatedIPs[Adapters[L].IPCount].Addr := S;
            Adapters[L].AssociatedIPs[Adapters[L].IPCount].Mask := ShortString(Addrs^.IpMask.S);
            Inc(Adapters[L].IPCount);
          end;

          { next addr }
          Addrs := Addrs^.Next;
        end;

        { get next! }
        pAdapter := pAdapter^.Next;
      end;
    end;
  finally
    FreeMem(pAdapterInfo);
  end;
end;

procedure GetAdaptersEx(var Adapters : TArray<TAdapterInfo>);
var
  pAddresses: PIP_ADAPTER_ADDRESSES;
  pCurrAddresses: PIP_ADAPTER_ADDRESSES;
  ErrCode, Mask: DWORD;
  MaskArray: array[0..3] of Byte;
  L, I: Integer;
  dwBufLen: ULONG;
begin
  SetLength(Adapters, 0);
  dwBufLen := 0;

  { get the required buffer size }
  ErrCode := GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_INCLUDE_PREFIX, nil, nil, @dwBufLen);

  if ErrCode = ERROR_BUFFER_OVERFLOW then
  begin
    GetMem(pAddresses, dwBufLen);
    try
      { call to get the actual adapter addresses }
      ErrCode := GetAdaptersAddresses(AF_INET, GAA_FLAG_INCLUDE_PREFIX, nil, pAddresses, @dwBufLen);

      if ErrCode = NO_ERROR then
      begin
        pCurrAddresses := pAddresses;
        while pCurrAddresses <> nil do
        begin
          L := Length(Adapters);
          SetLength(Adapters, L + 1);
          Adapters[L] := Default(TAdapterInfo);

          Adapters[L].Name := ShortString(pCurrAddresses^.AdapterName);
          Adapters[L].FriendlyName := ShortString(WideString(pCurrAddresses^.FriendlyName));
          Adapters[L].Desc := ShortString(WideString(pCurrAddresses^.Description));
          Adapters[L].PCAPName := ShortString(format('\Device\Packet_%s', [Adapters[L].Name]));

          { convert PhysicalAddress to a hexadecimal string }
          Adapters[L].MAC := ShortString(Format('%.2x:%.2x:%.2x:%.2x:%.2x:%.2x',
            [pCurrAddresses^.PhysicalAddress[0], pCurrAddresses^.PhysicalAddress[1],
             pCurrAddresses^.PhysicalAddress[2], pCurrAddresses^.PhysicalAddress[3],
             pCurrAddresses^.PhysicalAddress[4], pCurrAddresses^.PhysicalAddress[5]]));

          if pCurrAddresses^.FirstUnicastAddress <> nil then
          begin
            case pCurrAddresses^.FirstUnicastAddress^.Address.lpSockaddr.sin_family of
            {$REGION ' IPv6 [no implementation] '}
              AF_INET6:
              begin
                // sockaddr_in6 := PSOCKADDR_IN6(pCurrAddresses^.FirstUnicastAddress^.Address.lpSockaddr);
                // ipAddressStr := string(AnsiString(InetNtop(AF_INET6, @sockaddr_in6^.sin6_addr, nil, 0)));
                // Adapters[L].IP := ShortString(inet_ntop(AF_INET6, PInAddr(pCurrAddresses^.FirstUnicastAddress^.Address.lpSockaddr)^, nil, 0));
              end
            {$ENDREGION}
              else
              begin
                { ip-address }
                Adapters[L].IP := ShortString(inet_ntoa(PSOCKADDR_IN(pCurrAddresses^.FirstUnicastAddress^.Address.lpSockaddr)^.sin_addr));
                { net-mask }
                Mask := $FFFFFFFF shl (32 - pCurrAddresses^.FirstUnicastAddress^.OnLinkPrefixLength);
                for i := 0 to 3 do MaskArray[i] := Byte(Mask shr (i *8) and $FF);
                Adapters[L].AssociatedIPs[0].Mask := ShortString(format('%d.%d.%d.%d', [MaskArray[3], MaskArray[2], MaskArray[1], MaskArray[0]]));
                Adapters[L].AssociatedIPs[0].Addr := Adapters[L].IP;
                Inc(Adapters[L].IPCount);
              end;
            end;
          end;

          Adapters[L].DHCPEnabled := (pCurrAddresses^.Flags and IP_ADAPTER_DHCP_ENABLED) <> 0;
          Adapters[L].Enabled := (pCurrAddresses^.OperStatus = IfOperStatusUp);

          { next! }
          pCurrAddresses := pCurrAddresses^.Next;
        end;
      end;
    finally
      FreeMem(pAddresses);
    end;
  end
end;

{ caution... works best when only 1 is present/active! }
function GetLocalIPAddress: string;
var
  HostInfo: PHostEnt;
  HostName: array[0..255] of AnsiChar;
begin
  Result := '';

  if GetHostName(HostName, SizeOf(HostName)) = 0 then
  begin
    { host information based on the host name }
    HostInfo := GetHostByName(HostName);
    if Assigned(HostInfo) then
      { the first IP address to string }
      Result := string(inet_ntoa(PInAddr(HostInfo^.h_addr_list^)^));
  end;
end;

function CRC16_IBM(const Buf; const Size : Integer): Word;
var
  DataPtr: PByte;
  CRC: Word;
  i, Bit: Integer;
begin
  { initialize CRC to 0xFFFF }
  CRC := $FFFF;

  { get a pointer to the data buffer }
  DataPtr := @Buf;

  { iterate through each byte in the buffer }
  for i := 0 to Size - 1 do
  begin
    CRC := CRC xor Word(DataPtr^);

    { process each bit in the byte }
    for Bit := 0 to 7 do
    begin
      if (CRC and 1) <> 0 then CRC := (CRC shr 1) xor $A001
      else CRC := CRC shr 1;
    end;

    { move to the next byte in the buffer }
    Inc(DataPtr);
  end;

  Result := CRC;
end;

function CRC16_ModBUS(const Buf; const Size : Integer): Word;
begin
  Result := CRC16_IBM(Buf, Size);
end;

function CRC16_ANSI(const Buf; const Size : Integer): Word;
begin
  Result := CRC16_IBM(Buf, Size);
end;

function CRC16_CCITT(const Buf; const Size: Integer): Word;
var
  DataPtr: PByte;
  CRC: Cardinal;
  i, j: Integer;
begin
  CRC := $FFFF {65535};
  DataPtr := @Buf;

  for i := 0 to Size -1 do
  begin
    CRC := CRC xor (Word(Byte(DataPtr^)) shl 8);
    for j := 0 to 7 do
    begin
      if (CRC and $8000) <> 0 then CRC := (CRC shl 1) xor $1021
      else CRC := CRC shl 1;
    end;
    Inc(DataPtr);
  end;

  Result := Word(CRC);
end;

function CalculateCRC32(const Buf; const Size: Integer): UInt32;
begin
  Result := 0;
end;

procedure AddCRC32(var Bytes: TArray<Byte>; var Len: Integer);
var
  I, J, CRC: UInt32;
begin
  CRC := $FFFFFFFF;

  SetLength(Bytes, Len +SizeOf(DWORD));

  for I := 0 to (Len -1) do
  begin
    CRC := CRC xor Bytes[i];

    for J := 0 to 7 do
    begin
      if ((CRC and 1) <> 0) then CRC := (CRC SHR 1) xor $EDB88320
      else CRC := (CRC SHR 1);
    end;
  end;

  CRC := not CRC;
  Move(CRC, Bytes[Len], SizeOf(DWORD));
  Len := Length(Bytes);
end;

function ExtractFiles(const Src: String; Dst : String = ''): Boolean;
var
  S, D : String;
begin
  Result := False;
  S := Trim(Src);
  D := Trim(Dst);

  if S = '' then Exit;
  if not DirectoryExists(D) then ForceDirectories(D);

  try
    with TZipFile do
    begin
      if D <> '' then ExtractZipFile(S, D)
      else ExtractZipFile(S, ExtractFileDir(S));
      Result := True;
    end;
  except
    on E: Exception do
      ShowDialog(dtInfo, 'Error extracting zip file: ' +E.Message);
  end;
end;

procedure ApplicationInstanceControl(const MutexName : String; AppCtrl : TInstanceControl);
var
  MutexHandle: DWord;
begin
  MutexHandle := CreateMutex(nil, False, PChar(MutexName));

  if (MutexHandle <> 0) and (GetLastError = ERROR_ALREADY_EXISTS) then
  begin
    case AppCtrl of
      { one instance: existing by default }
      inst_existing,
      inst_single:
      begin
        ShowMessage('Another instance of the application is already running.');
        { kill it! }
        PostQuitMessage(0);
        Halt;
      end;

      { use the new one : unreliable (fix before use) }
      inst_recent:
      begin
        { kill old application }
        Mutexhandle := FindWindowByTitle('GPIB configurator');
        KillProcessByID(Mutexhandle);
      end;

      { nothing to do. allow all }
      inst_multiple:;
    end;
  end;
end;

function GetApplicationHandle(const MutexName : String) : THandle;
begin
  Result := OpenMutex(MUTEX_ALL_ACCESS, False, PChar(MutexName));
end;

