function EnumerateResourceNames: AnsiString;
var
  ExecutableHandle: HMODULE;
  ResourcesList: TStringList;
begin
  Result := '';
  ExecutableHandle := LoadLibrary(PChar(Application.ExeName));
  try
    ResourcesList := TStringList.Create;
    try
      EnumResourceNames(ExecutableHandle, RT_RCDATA, @EnumRCDataProc, NativeInt(ResourcesList));
      Result := AnsiString(ResourcesList.Text);
    finally
      ResourcesList.Free;
    end;
  finally
    FreeLibrary(ExecutableHandle);
  end;
end;

procedure EnumerateResourceNames(var List: TStrList);
var
  L: String;
  S: AnsiString;
  SArr: TArray<String>;
begin
  if List = nil then Exit;
  List.Clear;
  S := EnumerateResourceNames;
  L := Trim(String(S));

  if L <> ''  then
  begin
    SplitStr(L, #13#10, SArr);
    List.AddRange(SArr);
  end;
end;

