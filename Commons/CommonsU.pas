procedure TTCPClientEx.Connect(Timeout: Integer; Attempt: Byte);
var
  Time: TTimeVal;
  FDSet: TFDSet;
  ErrorCode, Len, Tries: Integer;
begin
  if ClientConnected then Exit;
  Tries := 0;

  repeat
    CreateSocket;
    WinSock2.Connect(ClientSock, WinSock2.SockAddr(ServerAddress), SizeOf(ServerAddress));
    ErrorCode := WSAGetLastError();
    ClientConnected := (ErrorCode = 0) or (ErrorCode = WSAEISCONN);

    if ErrorCode = WSAEWOULDBLOCK then
    begin
      FD_ZERO(FDSet); _FD_SET(ClientSock, FDSet);
      Time.tv_sec := Timeout div ONE_SEC;
      Time.tv_usec := (Timeout mod ONE_SEC) *ONE_SEC;
      if WinSock2.select(0, nil, @FDSet, nil, @Time) > 0 then
      begin
        Len := SizeOf(ErrorCode);
        GetSockOpt(ClientSock, SOL_SOCKET, SO_ERROR, @ErrorCode, Len);
        ClientConnected := (ErrorCode = 0);
      end;
    end
    else if ErrorCode = WSAEADDRNOTAVAIL then
      raise Exception.Create('Invalid address or network configuration.');

    if ClientConnected then break;
    closesocket(ClientSock);
    Sleep(500);
  until ClientConnected or (Tries >= Attempt);

  if not ClientConnected then
    raise Exception.Create('Connection timed out.');
end;

procedure TTCPClientEx.CreateSocket;
const
  FIONBIO_ = Int32(Winsock2.FIONBIO);

var
  WSAData : TWSAData;
  ReUseSock: Integer;
  NoBlock: Cardinal;
begin
  try
    { one|object! }
    if not WSAOK then WSAOK := (WSAStartup(MakeWord($02, $02), WSAData) = 0);
    ReUseSock := 1;
    NoBlock := 1;

    if WSAOK then
    begin
      { create socket }
      ClientSock := WinSock2.socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
      { is it good? }
      SocketOK := (ClientSock <> INVALID_SOCKET);
      { yes? }
      if SocketOK then
      begin
        { sok re-use? }
        SocketOK := SetSockOpt(ClientSock, SOL_SOCKET, SO_REUSEADDR, @ReUseSock, SizeOf(ReUseSock)) <> SOCKET_ERROR;

        { configure destination:server address }
        if SocketOK then
        begin
          FillChar(ServerAddress, SizeOf(ServerAddress), 0);
          ServerAddress.sin_family := AF_INET;
          ServerAddress.sin_port := htons(ServerPort);
          ServerAddress.sin_addr.S_addr := inet_addr(PAnsiChar(AnsiString(ServerAddr)));
          { basic socket information }
          GetSocketInfo(ClientSock, @ClientData);

          { Set the socket to non-blocking mode }
          SocketOK := ioctlsocket(ClientSock, FIONBIO_, NoBlock) <> SOCKET_ERROR;
        end;
      end;

      if not SocketOK then
        AlertSocketError;
      { cleanup after failure }
    end

    else
      WSACleanup;

  except
    On E: Exception do
      AlertException(E);
  end;
end;

procedure TTCPClientEx.Connect(Timeout: Integer);
var
  T0: Int64;
  Remaining: Int64;
  FdSet: TFDSet;
  Tv: TTimeVal;
  ResultCode: Integer;
  ErrorCode: Integer;
  Len: Integer;
begin
  if ClientConnected then Exit;

  CreateSocket;
  ResultCode := WinSock2.Connect(ClientSock, Winsock2.SockAddr(ServerAddress),
    SizeOf(ServerAddress));

  if (ResultCode <> 0) and (WSAGetLastError <> WSAEWOULDBLOCK) then
  begin
    AlertSocketError;
    Exit;
  end;


  FD_ZERO(FdSet);
  _FD_SET(ClientSock, FdSet);
  T0 := GetTickCountEx(Timeout);

  repeat
    Remaining := (T0 -Int64(GetTickCountEx));
    ProcessMsgs;

    if Remaining > 0 then
    begin
      Tv.tv_sec  := Remaining div 1000;
      Tv.tv_usec := (Remaining mod 1000) *1000;

      ResultCode := WinSock2.select(0, nil, @FdSet, nil, @Tv);
      if (ResultCode <> SOCKET_ERROR) then
      begin
        if ResultCode > 0 then
        begin
          Len := SizeOf(ErrorCode);
          ResultCode := WinSock2.getsockopt(ClientSock, SOL_SOCKET, SO_ERROR,
            PAnsiChar(@ErrorCode), Len);

          ClientConnected := (ResultCode = 0) and (ErrorCode = 0);
        end;
      end;
    end;
  until ClientConnected or (Remaining <= 0);
end;

procedure TTCPClientEx.Connect(Timeout: Integer; Status: PBoolean);
begin

end;

procedure TTCPClientEx.Disconnect;
begin
  { should we bother? }
  if (not WSAOK) or (not SocketOK) or (not Connected) then Exit;

  try
    { graceful shutdown }
    if (Winsock2.Shutdown(ClientSock, SD_SEND) <> SOCKET_ERROR) then
      ClientConnected := False;
    { close socket }
    if (Winsock2.CloseSocket(ClientSock) <> SOCKET_ERROR) then
      ClientConnected := False;
  except
    On E: Exception do
      AlertException(E);
  end;
end;

procedure TTCPClientEx.Execute;
var
  Payload : TSocketPayload;
begin
  inherited;

  { house keep, remote config init! }
  ZeroMemory(@Payload, SizeOf(TSocketPayload));
  Payload.Remote.Addr := ServerAddr;
  Payload.Remote.Port := ServerPort;
  Payload.Remote.Pack;

  repeat
    try
      { dont worry about the blocking nature of this for now }
      Payload.Size := Recv(ClientSock, Payload.AsBytes,
        Length(Payload.AsBytes), 0);

      { check recvd data }
      case Payload.Size of
        0: AlertSocketError; { server left! }

        SOCKET_ERROR:
        begin
          { check the error code }
          case WSAGetLastError of
            WSAECONNRESET:
            begin
              if ClientConnected then
              begin
                ClientConnected := False;
                { announce it! would ya?! }
                AlertSocketError;
              end;
            end;
            WSAEWOULDBLOCK: { dont care! };
          end;
        end;

        { actual data:hopefully! }
        else
        begin
          { pass it on! }
          if Assigned(OnDataRecvd) then
          begin
            Payload.Timestamp := Now;
            OnDataRecvd(@Payload);
            ZeroMemory(@Payload.AsBytes[0], Payload.Size);
          end;
        end;
      end;

    except
      On E: Exception do
        AlertException(E);
    end;

    AvoidBusyWait(1);
  until Terminated;
end;

