(**
  @summary: copy character array into a string var
  @params:
  Arr: <const::pointer to char> source
  Len: <const::integer> size of Arr
  Str: <var::string> destination
*)
procedure PackStr(const Arr: Pointer; const Len: Integer; var Str: String; Src: Byte);
type
  TSrcType = (AsChar, AsAnsiChar);

begin
  Str := '';
  if (Arr = nil) or (Len <= 0) then Exit;

  case TSrcType(Src) of
    AsChar: SetString(Str, PChar(Arr), Len);
    AsAnsiChar: SetString(Str, PAnsiChar(Arr), Len);
  end;
  
  Str := Trim(Str);
end;

