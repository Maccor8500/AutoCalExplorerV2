procedure TBufferEx.Append(const S: String);
var
  L, Ls, Roof, CopyLen: Integer;
  AStr: AnsiString;
begin
  Ls := Length(S);
  if Ls = 0 then Exit;

  AStr := AnsiString(S);
  L := Length(AsString(False)) +Ls;
  Roof := High(Data.AsChars);
  if L > Roof then Exit;

  Dec(L, Ls);
  CopyLen := Min(Ls, Roof -L);

  Move(AStr[1], Data.AsChars[L], CopyLen);
  if L +CopyLen <= Roof then Data.AsChars[L +CopyLen] := #0;
end;


function TBufferEx.AsFloatStr(Round: Byte): String;
