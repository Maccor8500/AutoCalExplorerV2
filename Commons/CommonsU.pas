end;

procedure DecimalsOnly(Sender: TObject; var Key: Char; DPCount : Byte = 1);
var
  i, Len, DP: Integer;
begin
  DP := 0;

  // #8 is Backspace
  if not CharInSet(Key, [#8, '.', '0'..'9']) then
  begin
    // Discard the key
    Key := #0;
  end;

  with Sender As TEdit do
  begin
    if (Tag = DPCount) and (Key = '.') then
    begin
      Key := #0;
      Exit;
    end;

    Len := Length(Text);

    if Len > 0 then
    begin
      for i := 1 to Len do
      begin
        if Text[i] = '.' then Inc(DP);

        if DP = DPCount then Tag := DPCount;
      end;
    end;
  end;

end;

