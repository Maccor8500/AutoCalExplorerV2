{ lightweight TByteStream of sort }
type
  PRawBuffer = ^TRawBuffer;
  TRawBuffer = record
    Size: Integer;
    Bytes: TArray<Byte>;
    RByte: Byte;
    Handle: PByte;
    Position: Integer;

    procedure Init(const Len: Integer; ResetByte: Byte = 0);
    procedure Update(const Len: Integer);
    procedure Write(const Data: PByte; const Len: Integer);
    procedure Read(var Buf; Len: Integer = 0);
    procedure Reset(Deallocate: Boolean = False);
    procedure Seek(ToByte: Integer = 1);
    procedure ResetPosition;
  end;

{
  dynamic sibling of TBuffer/TBufferEx: exact-size allocation, no object.
    Buffer := TRawBufferEx(64);   // 64-byte zeroed buffer
  assignment copies the reference (both records share the bytes) -- use
  Clone for an independent copy. Data is a function, never cache its
  result across a Size change: SetLength may relocate the array.
}
type
  PRawBufferEx = ^TRawBufferEx;
  TRawBufferEx = record
  private
    FBytes: TBytes;
    function  GetByte(Index: Integer): Byte; inline;
    procedure SetByte(Index: Integer; const Value: Byte); inline;
    function  GetSize: Integer; inline;
    procedure SetSize(const Value: Integer);

  public
    constructor Create(const Len: Integer; const FillByte: Byte = 0);

    class operator Explicit(const Len: Integer): TRawBufferEx;
    class operator Implicit(const B: TBytes): TRawBufferEx;
    class operator Implicit(const B: TRawBufferEx): TBytes;

    procedure Fill(const Value: Byte = 0);
    procedure Reset(Deallocate: Boolean = False);
    function  Clone: TRawBufferEx;
    function  Data: PByte; inline;
    function  AsChars: PAnsiChar; inline;
    function  AsString(Trm: Boolean = True): String;

    {
      appending writes: land at the current end, grow by exactly Len --
      after a build sequence, Size IS the frame length. Build from
      TRawBufferEx(0); a pre-sized buffer's zeroed bytes are content and
      appends land after them. The PByte overload must not point into
      this buffer's own storage (SetLength may free it mid-write); use
      the TBytes/TRawBufferEx overloads for self-append, they snapshot.
    }
    procedure Write(const Data: PByte; const Len: Integer); overload;
    procedure Write(const B: TBytes); overload;
    procedure Write(const B: TRawBufferEx); overload;
    procedure Write(const S: AnsiString); overload;               { raw ANSI bytes, no #0 }
    procedure Write(const S: String; const Encoding: TEncoding); overload;

    { width-explicit scalar appends -- named so wire width is never inferred }
    procedure WriteU8(const V: Byte);
    procedure WriteU16(const V: Word);
    procedure WriteU32(const V: Cardinal);
    procedure WriteU64(const V: UInt64);

    {
      positional patch: writes within existing bounds only, never grows.
      all-or-nothing -- returns Len when the patch landed, 0 when refused
      (out of bounds / nil / Len <= 0). A half-patched field is worse than
      an unpatched one, so it never clips. The appending Writes above need
      no such return: they grow by exactly Len, truncation cannot happen.
    }
    function WriteAt(const Offset: Integer; const Data: PByte; const Len: Integer): Integer;

    property Size: Integer read GetSize write SetSize;
    property Bytes[Index: Integer]: Byte read GetByte write SetByte; default;
  end;

