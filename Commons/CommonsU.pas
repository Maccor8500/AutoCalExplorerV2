  I, L : SmallInt;
  T : ShortString;
begin
  with TEdit(Sender) do
  begin
    T := ShortString(Trim(Text));
    L := Length(T);
    if L <= 0 then Exit;

    if T[L] = '.' then

    for i := 1 to L -1 do
    begin
      if T[i] = '.' then
