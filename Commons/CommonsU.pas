procedure AppendFile(const filename : String; const list : TStrings);
var
  f : TFileStream;
begin
  if FileExists(filename) then
    f := TFileStream.Create(filename, fmOpenWrite)
  else
    f := TFileStream.Create(filename, fmcreate);

  try
    f.Seek(0, soFromEnd);
    list.SaveToStream(f);
  finally
    FreeAndNil(f);
  end;
end;

procedure AppendFileEx(const filename : String; var list : TStrings);
var
  s : TFileStream;
  i : Integer;
  buffer : UTF8String;   {char buffer}
  buffer_len : Cardinal; {char buffer length}
begin
  WriteStat := wsStart;

  if not FileExists(filename) then
    s := TFileStream.Create(filename, fmCreate + fmShareDenyNone)
  else
    s := TFileStream.Create(filename, fmOpenWrite + fmShareDenyNone);

  try
    try
      s.Seek(0, SoFromEnd);               {Go to the end of the file}
      for i := 0 to list.Count -1 do         {Write individual lines to stream}
      begin
        buffer := UTF8String(Trim(list.Strings[i]) +sLineBreak);
        buffer_len := Length(buffer);
        if buffer_len > 0 then
          s.WriteBuffer(buffer[1], buffer_len);  {Write here}
      end;

      list.Clear;
    finally
      FreeAndNil(s);                      {Release mem}
    end;
  except
  end;                                    {Trap exceptions}

  WriteStat := wsDone;
end;

procedure AppendFileEx(const filename : String; var list : TStrings; var FSz : Single);
var
  s : TFileStream;
  i : Integer;
  buffer : UTF8String;   {char buffer}
  buffer_len : Cardinal; {char buffer length}
begin
  WriteStat := wsStart;

  if not FileExists(filename) then
    s := TFileStream.Create(filename, fmCreate + fmShareDenyNone)
  else
    s := TFileStream.Create(filename, fmOpenWrite + fmShareDenyNone);

  try
    try
      s.Seek(0, SoFromEnd);               {Go to the end of the file}
      for i := 0 to list.Count -1 do         {Write individual lines to stream}
      begin
        buffer := UTF8String(Trim(list.Strings[i]) +sLineBreak);
        buffer_len := Length(buffer);
        if buffer_len > 0 then
          s.WriteBuffer(buffer[1], buffer_len);  {Write here}
      end;

      list.Clear;
      s.Seek(0, SoFromBeginning);
      FSz := s.Seek(0, SoFromEnd) /1000;
    finally
      if Assigned(s) then
        FreeAndNil(s);                      {Release mem}
    end;
  except
  end;                                    {Trap exceptions}

  WriteStat := wsDone;
end;

procedure AppendFile(const filename : String; const Str : String);
var
  f : TFileStream;
begin
  if FileExists(filename) then
    f := TFileStream.Create(filename, fmOpenWrite + fmShareDenyWrite)
  else
    f := TFileStream.Create(filename, fmcreate + fmShareDenyNone);

  try
    try
      f.Seek(0, soFromEnd);
      f.Write(PAnsiChar(@Str[1])^, Length(Str));
    finally
      FreeAndNil(f);
    end;
  except
  end;
end;

function ShowDialog(const dialogType : TDialogType; const Msg : String) : integer;
begin
  Result := 0;

  case dialogType of
    dtError  : messageDlg(Msg, mtError, [mbOK], 0);
    dtInfo   : messageDlg(Msg, mtInformation, [mbOK], 0);
    dtWarning: Result := messageDlg(Msg, mtWarning, mbOkCancel, 0);
    dtQuery  : Result := Application.MessageBox(PChar(Msg), PChar(Application.Title), MB_YESNO  or MB_ICONQUESTION or MB_DEFBUTTON2);  {Y:6, N:7}
    dtYesNo  : Result := messagedlg(Msg, mtCustom, [mbYes, mbNo], 0);
  end;
end;

function ShowDialog(const AOwner: TForm; const dialogType : TDialogType; const Msg : String; Buttons: TMsgDlgButtons; Title: String; DefBtn: TMsgDlgBtn) : Integer;
const
  { the buttons as MessageDlg builds them for its task dialog: same captions, same modal results }
  BtnCaptions: array[TMsgDlgBtn] of String = (SMsgDlgYes, SMsgDlgNo, SMsgDlgOK, SMsgDlgCancel, SMsgDlgAbort,
    SMsgDlgRetry, SMsgDlgIgnore, SMsgDlgAll, SMsgDlgNoToAll, SMsgDlgYesToAll, SMsgDlgHelp, SMsgDlgClose);
  BtnResults: array[TMsgDlgBtn] of Integer = (mrYes, mrNo, mrOk, mrCancel, mrAbort, mrRetry, mrIgnore, mrAll,
    mrNoToAll, mrYesToAll, mrHelp, mrClose);
  IconMap: array[TMsgDlgIcon] of TTaskDialogIcon = (tdiNone, tdiWarning, tdiError, tdiInformation, tdiShield);
var
  DlgType: TMsgDlgType;
  DlgCaption: String;
  TD: TTaskDialog;
  B: TMsgDlgBtn;
  Shown: Boolean;
begin
  Result := 0;

  case dialogType of
    dtError: DlgType := mtError;
    dtInfo: DlgType := mtInformation;
    dtWarning: DlgType := mtWarning;
    dtConfirm: DlgType := mtConfirmation;
    dtQuery: DlgType := mtConfirmation;   { dummy really! }
    dtCustom: DlgType := mtCustom;
    else DlgType := mtInformation;
  end;

  DlgCaption := StrTernary(Trim(Title) = '', StrTernary((AOwner <> nil), AOwner.Caption, 'Message'), Title);

  { the same appearance as MessageDlg: the native task dialog whenever MessageDlg itself would use one (Vista+,
    UseLatestCommonDialogs, and no VCL style hooking the dialogs), centred on the owner by the OS }
  if TOSVersion.Check(6) and UseLatestCommonDialogs and
     not ((shDialogs in TStyleManager.SystemHooks) and (AOwner <> nil) and not StyleServices(AOwner).IsSystemStyle) then
  begin
    Application.ModalStarted;
    TD := TTaskDialog.Create(nil);
    try
      TD.Caption := DlgCaption;
      TD.Text := Msg;
      TD.CommonButtons := [];
      TD.MainIcon := IconMap[MsgDlgIcons[DlgType]];
      TD.Flags := TD.Flags + [tfPositionRelativeToWindow];
      if Application.UseRightToLeftReading then TD.Flags := TD.Flags + [tfRtlLayout];
      for B := Low(TMsgDlgBtn) to High(TMsgDlgBtn) do
        if B in Buttons then
          with TD.Buttons.Add do
          begin
            Caption := BtnCaptions[B];
            ModalResult := BtnResults[B];
            Default := B = DefBtn;
          end;

      Result := mrNone;
      if AOwner <> nil then Shown := TD.Execute(AOwner.Handle) else Shown := TD.Execute;
      if Shown then Result := TD.ModalResult;
    finally
      TD.Free;
      Application.ModalFinished;
    end;
    Exit;
  end;

  try
    if DlgType in [mtError, mtInformation, mtWarning, mtConfirmation, mtCustom] then
    begin
      with CreateMessageDialog(Msg, DlgType, Buttons, DefBtn) do
      begin
        Application.ProcessMessages;

        try
          { owner's center! }
          if AOwner <> nil then
          begin
            StyleName := AOwner.StyleName;
            Left := AOwner.Left + (AOwner.Width - Width) div 2;
            Top := AOwner.Top + (AOwner.Height - Height) div 2;
            Font.Name := 'Segoe UI';
            Font.Size := 9;
          end

          { screen center }
          else Position := poMainFormCenter;
          Caption := DlgCaption;
          Result := ShowModal;
        finally
          Free;
        end
      end;
    end;
  except
    On E: Exception do
      ShowMessage(format('%s'#13#10'%s', [Msg, E.Message]));
  end;
end;

function ShowDialog(const AOwner: TForm; const Title: String; const Prompt: String; const Options: TArray<String>; DefaultOpt: Integer): TDialogOptionEx;
var
  Dialog: TForm;
  Option: TRadioGroup;
  PromptLbl: TLabel;
  Img: TImage;
  IconBitmap: TBitmap;
  LIcon: HICON;
  RGWidth, RGHeight, i, DPI, IconSize: Integer;
  TempLabel: TLabel;
  OKBtn: TSpeedButton;
  CallbackHelper: TCallBackHelper;
begin
  Result := Default(TDialogOptionEx);
  Result.Index := -1;
  Result.Items := Length(Options);
  Dialog := TForm.Create(nil);
  Dialog.ScaleForPPI(96);
  RGWidth := 0;
  RGHeight:= 0;

  try
    CallbackHelper := TCallbackHelper.Create;

    with Dialog do
    begin
      if AOwner <> nil then
        StyleName := AOwner.StyleName;

      DPI := CurrentPPI;
      IconSize := MulDiv(32, DPI, 96);

      Width := MulDiv(450, DPI, 96);;
      Height:= MulDiv(200, DPI, 96);
      Caption := Title;
      BorderStyle := bsDialog;
      DoubleBuffered := True;

      { load standard warning icon }
      LIcon := LoadIcon(0, IDI_QUESTION);

      if LIcon <> 0 then
      begin
        { add a TImage to hold the icon }
        Img := TImage.Create(Dialog);
        Img.Parent := Dialog;
        Img.SetBounds(MulDiv(20, DPI, 96), MulDiv(20, DPI, 96), IconSize, IconSize);

        IconBitmap := TBitmap.Create;
        try
          IconBitmap.SetSize(IconSize, IconSize);
          IconBitmap.Canvas.Brush.Color := clWindow;
          IconBitmap.Canvas.FillRect(Rect(0, 0, IconSize, IconSize));
          DrawIconEx(IconBitmap.Canvas.Handle, 0, 0, LIcon, IconSize, IconSize, 0, 0, DI_NORMAL);
          Img.Picture.Assign(IconBitmap);
          Img.Transparent := True;
        finally
          IconBitmap.Free;
        end;

        PromptLbl := TLabel.Create(Dialog);
        PromptLbl.Caption := Prompt;
        PromptLbl.Parent := Dialog;
        PromptLbl.WordWrap := True;
        PromptLbl.AutoSize := False;
          PromptLbl.Left := Img.Left +Img.Width +MulDiv(12, DPI, 96);
          PromptLbl.Top := Img.Top;
        PromptLbl.Width := Width - PromptLbl.Left -MulDiv(20, DPI, 96);
        PromptLbl.Height := IconSize;
        PromptLbl.Font.Style := PromptLbl.Font.Style +[fsBold];
        PromptLbl.Caption := Prompt;
        if Screen.PixelsPerInch <> 96 then
          PromptLbl.Font.Size := Round(PromptLbl.Font.Size* ((Screen.PixelsPerInch /96) -0.5));

        Option := TRadioGroup.Create(Dialog);
        Option.Parent := Dialog;
        Option.Top := PromptLbl.Height +20;
        Option.Columns := 1;
        Option.Height := 0;
        Option.Left := 30;
        Option.Top := PromptLbl.Top + PromptLbl.Height +10;
        Option.RadioTabStop := True;
        Option.ShowFrame := True;
        Option.Caption := ' Options ';
        if Screen.PixelsPerInch <> 96 then
          Option.Font.Size := Round(Option.Font.Size* ((Screen.PixelsPerInch /96) -0.5));
      end;

      TempLabel := TLabel.Create(Dialog);

      try
        TempLabel.Font := Option.Font;
        TempLabel.Parent := Dialog;
        TempLabel.Caption := Title;
        TempLabel.AutoSize := True;
        RGWidth := Max(RGWidth, TempLabel.Canvas.TextWidth(Title));

        for i := Low(Options) to High(Options) do
        begin
          Option.Items.Add(Options[i]);
          TempLabel.Caption := Options[i];
          Inc(RGHeight, 30);
          RGWidth := Max(RGWidth, TempLabel.Canvas.TextWidth(Options[i]));
        end;
      finally
        TempLabel.Free;
      end;

      Option.Width := RGWidth +50;
      Option.Height:= RGHeight;

      Option.Invalidate;
      Dialog.Width := Max(Dialog.Width, (Option.Left +Option.Width) +Option.Left);
      Dialog.Height := (Option.Top +Option.Height) +100;

      Option.Left := (Option.Parent.ClientWidth -Option.Width) div 2;
      Application.ProcessMessages;

      { owner's center! }
      if AOwner <> nil then
      begin
        Dialog.Position := poDesigned;
        Dialog.Left := AOwner.Left + (AOwner.Width - Dialog.Width) div 2;
        Dialog.Top  := AOwner.Top + (AOwner.Height - Dialog.Height) div 2;
      end
      { screen center }
      else Position := poMainFormCenter;

      OKBtn := TSpeedButton.Create(Dialog);
      OKBtn.Parent := Dialog;
      OKBtn.Caption := 'OK';
      OKBtn.Height := 25;
      OKBtn.Width := 65;
      OKBtn.Top := (Option.Top +Option.Height) +20;
      OkBtn.Left := (Option.Left +Option.Width) -OKBtn.Width;
      OkBtn.Enabled := False;
      if Screen.PixelsPerInch <> 96 then
        OkBtn.Font.Size := Round(OkBtn.Font.Size* ((Screen.PixelsPerInch /96) -0.5));

      CallbackHelper.DialogForm := @Dialog;
      CallbackHelper.DialogBtn := @OKBtn;
      CallbackHelper.DialogResult := @Result.Index;
      CallbackHelper.DialogOptions := @Option;

      OnCloseQuery := CallbackHelper.ShowDialogClose;
      OKBtn.OnClick:= CallbackHelper.ShowDialogOKClick;
      Option.OnClick := CallbackHelper.ShowDialogOptionClick;
      Option.ItemIndex := DefaultOpt;
      Application.ProcessMessages;

      ShowModal;
      Result.Valid := (Result.Index >= 0) and (Result.Index <= High(Options));
      if Result.Valid then Result.Value := Options[Result.Index];
    end;
  finally
    FreeAndNil(CallbackHelper);
    FreeAndNil(Dialog);
  end;
end;

{ when called from anonymous threads or free-running tasks alike... use TThread.Sync }
function ShowDialog(const AOwner: TForm; const Title: String; const Prompt: String; const Queries: TArray<String>; var Entries: TArray<ShortString>; DataType: TDialogEntryType; const StyleName: String): Boolean;
var
  Dialog: TForm;
  PromptLabel: TLabel;
  CallbackHelper: TCallbackHelper;
  OkBtn: TSpeedButton;
  Editors: TArray<record
      EntryId: TLabel;
      Entry: TEdit;
    end>;
  I, LastTop, MaxLeft, MaxHeight, MaxWidth, MaxWidthQ: SmallInt;
  DataPtr: TArray<PShortString>;
begin
  Dialog := TForm.Create(nil);
  CallbackHelper := TCallbackHelper.Create;
  { caller's style wins <'Windows' for native prompts>, else the owner's }
  if StyleName <> '' then Dialog.StyleName := StyleName
  else if AOwner <> nil then Dialog.StyleName := AOwner.StyleName;

  try
    with Dialog do
    begin
      Caption := Title;
      BorderStyle := bsDialog;
      DoubleBuffered := True;
      Color := clBtnFace;
      Ctl3D := True;
      FormStyle := fsNormal;
      MaxWidthQ := 0;
      PrintScale := poProportional;

      { prompt }
      PromptLabel := TLabel.Create(Dialog);
      with PromptLabel do
      begin
        Parent := Dialog;
        Margins.Top := 5;
        Align := alTop;
        Ctl3D := True;
        AlignWithMargins := True;
        Alignment := taCenter;
        Font.Style := [fsBold];
        WordWrap := True;
        Caption := Prompt;
        Canvas.Font := Font;
        MaxWidth := 0;
        var PromptLines: TArray<String> := Prompt.Split([#13#10, #13, #10], TStringSplitOptions.None);
        for var Line: String in PromptLines do
          MaxWidth := Max(MaxWidth, Canvas.TextWidth(Line));

        LastTop := Canvas.TextHeight('A') *Length(PromptLines) +15;
        MaxHeight := LastTop;
        Stylename := Parent.StyleName;
      end;

      { entries }
      SetLength(Editors, Length(Queries));
      MaxLeft := 0;

      for i := Low(Editors) to High(Editors) do
      begin
        { #31 prefix on a query masks that entry, as InputBox does :: the caption drops it }
        var Masked := (Queries[i] <> '') and (Queries[i][1] = #31);
        Editors[i].EntryId := TLabel.Create(Dialog);
        with Editors[i].EntryId do
        begin
          Parent := Dialog;
          WordWrap := False;
          AutoSize := False;
          if Masked then Caption := Copy(Queries[i], 2, MaxInt) else Caption := Queries[i];
          Left := 25;
          Top := LastTop +Margins.Top;
          Width := Canvas.TextWidth(Caption);
          Alignment := taRightJustify;
          MaxWidthQ := Max(MaxWidthQ, Width);
          Stylename := Parent.StyleName;
        end;

        Editors[i].Entry := TEdit.Create(Dialog);
        with Editors[i].Entry do
        begin
          Parent := Dialog;
          Stylename := Parent.StyleName;
          Top := LastTop;
          Left := Editors[i].EntryId.Left +Editors[i].EntryId.Width +25;
          BevelOuter := bvNone;
          BevelKind := bkNone;
          BevelInner := bvNone;
          BorderStyle := bsSingle;
          BevelWidth := 1;
          Color := clInactiveBorder;
          Ctl3D := True;
          Alignment := taCenter;
          DoubleBuffered := True;
          if (i <= High(Entries)) then Text := Trim(String(Entries[i]));
          Inc(LastTop, Height +Margins.Top);
          Width := 250;
          Color := clCream;
          MaxLeft := Math.Max(MaxLeft, Left);
          MaxWidth := Max(MaxWidth, (Left +Width));
          Tag := i;
          OnChange := CallbackHelper.ShowDialogEntryChanged;

          case DataType of
            detAlphaNumerical: ;
            detNumerical: OnKeyPress := CallbackHelper.NumbersOnly;
            detNumericalRange: OnKeyPress := CallbackHelper.NumbersOnlyRange;
            detAlpha: ;
            detPassword: PasswordChar := '*';
          end;
          if Masked then PasswordChar := '*';
        end;
      end;

      { adjust entries array, clear 'em }
      SetLength(Entries, Length(Editors));
      SetLength(DataPtr, Length(Entries));

      { adjust editor lefts }
      for i := Low(Editors) to High(Editors) do
      begin
        Editors[i].Entry.Left := MaxLeft;
        Editors[i].EntryId.Width := MaxWidthQ;
        DataPtr[i] := @Entries[i];
      end;

      { manage form's height & width and show it! "dont move this!" }
      Height := LastTop +100{some padding};
      Width := MaxWidth +50 {some padding};

      { final finesse! }
      MaxWidth {general-left} := Editors[High(Editors)].EntryId.Left;
      MaxWidthQ{general-width}:= MaxWidth +(Editors[High(Editors)].Entry.Left +Editors[High(Editors)].Entry.Width);
      MaxLeft := (Width - MaxWidthQ) div 2;
      { update all editor positions }
      for i := Low(Editors) to High(Editors) do
      begin
        { shift, as the entry below :: setting it dropped the label's own margin and doubled the gap }
        Editors[i].EntryId.Left := MaxLeft +Editors[i].EntryId.Left;
        Editors[i].Entry.Left := MaxLeft +Editors[i].Entry.Left;
      end;

      { buttons }
      OkBtn := TSpeedButton.Create(Dialog);
      with OkBtn do
      begin
        Caption := 'OK';
        Width := 65;
        Height := 25;
        Parent := Dialog;
        StyleName := Dialog.StyleName;
        Dialog.Repaint;
        Left := (Editors[High(Editors)].Entry.Width +Editors[High(Editors)].Entry.Left) - (Width);
        Top := (LastTop +Margins.Top) +10{fudge!};
        OnClick := CallbackHelper.ShowDialogOKClick;
      end;

      { callback! }
      CallbackHelper.DialogForm := @Dialog;
      CallbackHelper.DialogBtn := @OkBtn;
      OnCloseQuery := CallbackHelper.ShowDialogClose;
      KeyPreview := True;
      OnKeyPress := CallbackHelper.ShowDialogKeyPress;
      CallbackHelper.ShowDialogEntries(DataPtr);

      { show it! }
      if AOwner = nil then Position := poScreenCenter
      else
      begin
        Left := AOwner.Left +(AOWner.Width -Width) div 2;
        Top := AOwner.Top +(AOWner.Height -Height) div 2;
      end;

      Invalidate;
      ShowModal;
      Result := (OkBtn.Tag > 0);
    end;
  finally
    FreeAndNil(CallbackHelper);
    FreeAndNil(Dialog);
  end;
end;

