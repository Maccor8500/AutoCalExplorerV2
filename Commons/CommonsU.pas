class procedure TMaccorSystem.UpdateCalibration(const Chan: Integer; const Signal: TMaccorRunMode; const Mode: TMaccorControlMode; const Range: TMaccorBrickRange; const CalData: PCalibrationData);
begin
  if Chan > High(ChanDataNorm) then Exit;

  { direct update these! }
  var ChanData: PChParm := @ChanDataNorm[Chan];

  { quick resolve! }
  var Slope: Single := CalData^.Slope;
  var Offset:Single := CalData^.Offset;
  var DSlope: Single:= CalData^.DAC.Slope;
  var DOffset: Single:= CalData^.DAC.Offset;

  case Signal of
    rmCurrent:
    begin
      case Mode of
        cmCharge:
        begin
          case Range of
            mrRange1:
            begin
              ChanData^.chg.Islope := Slope;
              ChanData^.chg.Ioffset:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.chg.IoutSlope1 := DSlope;
                ChanData^.chg.IoutOffset1 := DOffset;
              end;
            end;

            mrRange2:
            begin
              ChanData^.chg.Islope1 := Slope;
              ChanData^.chg.Ioffset1:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.chg.IoutSlope2 := DSlope;
                ChanData^.chg.IoutOffset2 := DOffset;
              end;
            end;

            mrRange3:
            begin
              ChanData^.chg.Islope2 := Slope;
              ChanData^.chg.Ioffset2:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.chg.IoutSlope3 := DSlope;
                ChanData^.chg.IoutOffset3 := DOffset;
              end;
            end;

            mrRange4:
            begin
              ChanData^.chg.Islope3 := Slope;
              ChanData^.chg.Ioffset3:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.chg.IoutSlope4 := DSlope;
                ChanData^.chg.IoutOffset4 := DOffset;
              end;
            end;
          end;
        end;

        cmDischarge:
        begin
          case Range of
            mrRange1:
            begin
              ChanData^.Dis.Islope := Slope;
              ChanData^.Dis.Ioffset:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.Dis.IoutSlope1 := DSlope;
                ChanData^.Dis.IoutOffset1 := DOffset;
              end;
            end;

            mrRange2:
            begin
              ChanData^.Dis.Islope1 := Slope;
              ChanData^.Dis.Ioffset1:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.Dis.IoutSlope2 := DSlope;
                ChanData^.Dis.IoutOffset2 := DOffset;
              end;
            end;

            mrRange3:
            begin
              ChanData^.Dis.Islope2 := Slope;
              ChanData^.Dis.Ioffset2:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.Dis.IoutSlope3 := DSlope;
                ChanData^.Dis.IoutOffset3 := DOffset;
              end;
            end;

            mrRange4:
            begin
              ChanData^.Dis.Islope3 := Slope;
              ChanData^.Dis.Ioffset3:= Offset;

              if MacSysPtr^.SysId = tLabSystem then
              begin
                ChanData^.Dis.IoutSlope4 := DSlope;
                ChanData^.Dis.IoutOffset4 := DOffset;
              end;
            end;
          end;
        end;
      end;
    end;

    rmVoltage:
    begin
      case Mode of
        cmCharge:
        begin
          ChanData^.chg.Vslope := Slope;
          ChanData^.chg.Voffset := Offset;
        end;

        cmDischarge:
        begin
          ChanData^.Dis.Vslope := Slope;
          ChanData^.Dis.Voffset := Offset;
        end;
      end;
    end;
  end;
end;

procedure GetEXE_DLL_Info(var MacEnv : TMaccorSystem);
var
  VerInfoSize: dword;
  VerInfo: pointer;
  VerValueSize: dword;
  VerValue: PVSFixedFileInfo;
  V1, V2, V4: word;
  Dummy: dword;
  ExeVer : DWord;
  ExeDT, DllDt : TDateTime;
  SearchRec: TSearchRec;
  p1, p2 : Boolean;
begin
  p1 := true;
  p2 := true;
  ExeDT := Default(TDateTime);
  DllDt := ExeDT;
  ExeVer:= 0;

  try
    if FileExists(MacEnv.EXEPath) then
    begin
      VerInfoSize:=GetFileVersionInfoSize(PChar(MacEnv.EXEPath), Dummy);
      GetMem(VerInfo, VerInfoSize);
      GetFileVersionInfo(PChar(MacEnv.EXEPath),0,VerInfoSize,VerInfo);
      VerQueryValue(VerInfo,'\',Pointer(VerValue),VerValueSize);
      with VerValue^ do
      begin
        V1:=dwFileVersionMS SHR 16;
        V2:=dwFileVersionMS and $FFFF;
        //V3:=dwFileVersionLS SHR 16;
        V4:=dwFileVersionLS and $FFFF;
      end;
      FreeMem(VerInfo,VerInfoSize);
      ExeVer:=(V1 shl 24)+(V2 shl 16) +V4;
    end;
  except
    p1 := false;
  end;

  try
    if FileExists(MacEnv.EXEPath) then
    begin
      FindFirst(MacEnv.EXEPath, faAnyFile, SearchRec);
      ExeDt := SearchRec.TimeStamp;
      FindClose(SearchRec);
    end;

    if FileExists(MacEnv.DLLPath) then
    begin
      FindFirst(MacEnv.DLLPath, faAnyFile, SearchRec);
      DllDt := SearchRec.TimeStamp;
      FindClose(SearchRec);
    end;
  except
    p2 := false;
  end;

  if p1 then
  begin
     V1:=(ExeVer shr 24) and $FF;
     V2:=(ExeVer shr 16) and $FF;
     V4:=ExeVer and $FFFF;
     MacEnv.SW_Info.EXE_Ver := Format('%d.%d.%d', [V1, V2, V4]);
  end;

  if p2 then
  begin
    MacEnv.SW_Info.Exe_Date := Format('%s', [DateToStr(ExeDt)]);
    MacEnv.SW_Info.DLL_Date:= Format('%s', [DateToStr(DllDt)]);
  end;
end;

class procedure TMaccorSystem.ConversionDAC(const Chan: Integer; const Run: TMaccorRunMode; const Mode: TMaccorControlMode; const Range: TMaccorBrickRange; const DigitalValue: Word; var AnalogValue: Double);
var
  Config: PMaccorChannelConfig;
begin
  MacSysPtr^.GetChannelConfig(Chan, Config);
  AnalogValue := 0;
  if Config = nil then Exit;

  var Limits: PMaccorChannelRangeSpec := @Config^.Range[Ord(Range)];

  case Run of
    rmCurrent:
    begin
      case Mode of
        cmCharge:    AnalogValue := ((DigitalValue *Limits^.Charge) /MAXWORD);
        cmDischarge: AnalogValue := ((DigitalValue *Limits^.Discharge) /MAXWORD);
      end;
    end;

    rmVoltage:
    begin
      var Norm: Double := (DigitalValue /MAXWORD);
      AnalogValue := (Config^.Voltage.Min +(Norm *Config^.Voltage.Span));
    end;
  end;
end;

class procedure TMaccorSystem.ConversionADC(const Chan: Integer; const Run: TMaccorRunMode; const Mode: TMaccorControlMode; const Range: TMaccorBrickRange; const AnalogValue: Double; var DigitalValue: Double{can be -ve});
var
  Config: PMaccorChannelConfig;
  Limits: PMaccorChannelRangeSpec;
begin
  MacSysPtr^.GetChannelConfig(Chan, Config);
  if Config = nil then Exit;

  Limits := @Config^.Range[Ord(Range)];

  case Run of
    rmCurrent:
    begin
      case Mode of
        cmCharge:    DigitalValue := Round(AnalogValue /Limits^.Charge *MAXWORD);
        cmDischarge: DigitalValue := Round(AnalogValue /Limits^.Discharge *MAXWORD);
      end;
    end;

    rmVoltage:
    begin
      var Norm: Double := (AnalogValue -Config^.Voltage.Min) /Config^.Voltage.Span;
      DigitalValue := Round(Norm *MAXWORD);
    end;
  end;
end;

class procedure TMaccorSystem.ConversionADC(const Chan: Integer; const Run: TMaccorRunMode; const Mode: TMaccorControlMode; const Range: TMaccorBrickRange; const AnalogValue: Double; var DigitalValue: Word);
var
  Config: PMaccorChannelConfig;
  Limits: PMaccorChannelRangeSpec;
begin
  MacSysPtr^.GetChannelConfig(Chan, Config);
  if Config = nil then Exit;

  Limits := @Config^.Range[Ord(Range)];

  { check limits against conversion ask!? }
  case Run of
    rmCurrent:
    begin
      case Mode of
        cmCharge: if AnalogValue > Limits^.Charge then Exit;
        cmDischarge: if AnalogValue > Limits^.Discharge then Exit;
      end;
    end;

    rmVoltage:
      if AnalogValue > Config^.Voltage.Span then Exit;
  end;

  { do the conversion! }
  case Run of
    rmCurrent:
    begin
      case Mode of
        cmCharge:    DigitalValue := Round(AnalogValue / Limits^.Charge * MAXWORD);
        cmDischarge: DigitalValue := Round(AnalogValue / Limits^.Discharge * MAXWORD);
      end;
    end;

    rmVoltage:
    begin
      var Norm: Double := (AnalogValue -Config^.Voltage.Min) /Config^.Voltage.Span;
      if Norm < 0 then Norm := 0
      else if Norm > 1 then Norm := 1;
      DigitalValue := Round(Norm *MAXWORD);
      // lone statement DigitalValue := Round(AnalogValue /Config^.Voltage.Span *MAXWORD);
    end;
  end;
end;

