procedure MoveFolder(const src, dst : String);
var
  files : TArray<String>;
  i: Integer;
  pid : TPathIdentity;
begin
  GetFiles(src, files);

  for i := 0 to Length(files) -1 do
  begin
    pid := IdentifyPath(files[i]);

    case pid of
      piNone: ;
      piFolder: MoveFolder(files[i], format('%s\%s', [dst, files[i]]));
      piFile:
      begin
        if CopyFile(PWideChar(src), PWideChar(dst), false) then
          DeleteFile(src);
      end;
    end;
  end;
end;

procedure FileOperations(const src, dst : String; const Flag : Integer);
begin
  TThread.CreateAnonymousThread(
  procedure
  begin
    try
      case IdentifyPath(src) of
        piFile:
          case Flag of
            FO_DELETE: DeleteFile(src);
            FO_MOVE:
            begin
              if CopyFile(PWideChar(src), PWideChar(dst), false) then
                DeleteFile(src);
            end;
          end;

        piFolder:
        begin
          case Flag of
            FO_DELETE: DeleteFolder(src);
            FO_MOVE: MoveFolder(src, dst);
          end;
        end;

        piNone: {nothing...};
      end;
    except
    end;
  end).Start;
end;

function IdentifyPath(const path : String) : TPathIdentity;
var
  p : String;
begin
  Result := piNone;
  p := Trim(path);

  if FileExists(p) then Result := piFile
  else if DirectoryExists(p) then Result := piFolder;
end;

procedure DeleteOnReboot(const f : string);
