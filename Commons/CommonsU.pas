procedure TTCPServerEx.GetSocketInfo(const iDescr: TSocket; SocketInfo: PSocketInfo);
begin
  { careful! }
  if SocketInfo = nil then Exit;
  { addr size }
  SocketInfo^.Size := SizeOf(SocketInfo^.Addr);

  try
    { get the remote client's address and port }
    if Winsock2.GetPeerName(iDescr, Winsock2.PSockAddr(@SocketInfo^.Addr)^, SocketInfo^.Size) = 0 then
    begin
      { convert the IP address from binary to string format }
      SocketInfo^.AddrStr := winsock2.inet_ntoa(SocketInfo^.Addr.sin_addr);
      { extract the port number (in network byte order) }
      SocketInfo^.Port := winsock2.ntohs(SocketInfo^.Addr.sin_port);
    end

    { fail! }
    else SocketInfo^ := Default(TSocketInfo);
  except
    On E: Exception do
      if Assigned(OnErrorEvent) then
      begin
        BuildSocketError(@E);
        OnErrorEvent(@Error);
      end;
  end;
end;

function TTCPServerEx.SendData(const Client: TSocket; const StrData: AnsiString) : Boolean;
var
  Len : Integer;
  T0 : UInt64;
  Session : PClientSession;
begin
  Result := False;
  Len := Length(StrData);
  if (Len <= 0) or (Client = INVALID_SOCKET) then Exit;

  try
    T0 := GetTickCountEx;
    repeat
      {
        easy wait! should have no-effect on main-application-ui if waiting
        server is it's own process ;=)
      }
      TThread.Sleep(1);
    until CanWrite(Client, 100{ms}) or ((GetTickCountEx -T0) >2000);

    { use xxtea cipher }
    if Cipher <> nil then
    begin
    end
    else
      Result := (Send(Client, (@StrData[1])^, Len, 0) = Len);

    { count tx }
    if Result and UseStats then
    begin
      Session := GetSession(Client);
      if Session <> nil then
        AtomicExchange(Session^.Stats.Sent, Session^.Stats.Sent +1);
    end;

  except
    On E: Exception do
    begin
      if Assigned(OnErrorEvent) then
      begin
        BuildSocketError(@E);
        OnErrorEvent(@Error);
      end;
    end;
  end;
end;

function TTCPServerEx.SendData(const Client: TSocket; const StrData: String): Boolean;
begin
  Result := SendData(Client, AnsiString(StrData));
end;

function TTCPServerEx.SendData(const Client : TSocket; const Data : PBuffer; const Len : Integer): Boolean;
var
  Session : PClientSession;
begin
  Result := False;
  if Len <= 0 then Exit;

  try
    Result := (Send(Client, Data^.AsBytes, Len, 0) = Len);

    { count tx }
    if Result and UseStats then
    begin
      Session := GetSession(Client);
      if Session <> nil then
        AtomicExchange(Session^.Stats.Sent, Session^.Stats.Sent +1);
    end;

  except
    On E: Exception do
      if Assigned(OnErrorEvent) then
      begin
        BuildSocketError(@E);
        OnErrorEvent(@Error);
      end;
  end;
end;

