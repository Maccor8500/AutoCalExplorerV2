{ ---- cipher :: SHA-256 CTR keystream, RTL-only ---- }

function MapKeyVerifierFor(const Key: String): String;
begin
  Result := THashSHA2.GetHashString(MAP_KEY_SALT + Key).ToLower;
end;

function MapKeyVerified(const Key: String): Boolean;
begin
  Result := SameText(MapKeyVerifierFor(Key), MAP_KEY_VERIFIER);
end;

procedure MapCryptXor(var Data: TBytes; const Key: String; const Nonce: UInt64);
var
  H: THashSHA2;
  Seed, Block: TBytes;
  Counter: UInt64;
  Offset, i: Integer;
begin
  Seed := TEncoding.UTF8.GetBytes(MAP_KEY_SALT + Key);
  Counter := 0;
  Offset := 0;

  while Offset < Length(Data) do
  begin
    H := THashSHA2.Create(THashSHA2.TSHA2Version.SHA256);
    H.Update(Seed);
    H.Update(Nonce, SizeOf(Nonce));
    H.Update(Counter, SizeOf(Counter));
    Block := H.HashAsBytes;

    for i := 0 to High(Block) do
    begin
      if Offset > High(Data) then Break;
      Data[Offset] := Data[Offset] xor Block[i];
      Inc(Offset);
    end;

    Inc(Counter);
  end;
end;

function MapPlainHash(const Data: TBytes): UInt32;
var
  H: THashSHA2;
  Digest: TBytes;
begin
  H := THashSHA2.Create(THashSHA2.TSHA2Version.SHA256);
  H.Update(Data);
  Digest := H.HashAsBytes;
  Move(Digest[0], Result, SizeOf(Result));
end;

function ZPack(const Src: TBytes; const Compress: Boolean): TBytes;
var
  SrcStream, Dest: TBytesStream;
  Z: TStream;
  Buf: TBytes;
  N: Integer;
begin
  SrcStream := TBytesStream.Create(Src);
  Dest := TBytesStream.Create;
  try
    if Compress then
    begin
      Z := TZCompressionStream.Create(Dest, zcMax, 15);
      try
        Z.CopyFrom(SrcStream, 0);
      finally
        Z.Free;
      end;
    end

    else
    begin
      { inflate streams have no Size :: chunked read to exhaustion }
      Z := TZDecompressionStream.Create(SrcStream);
      try
        SetLength(Buf, 65536);
        repeat
          N := Z.Read(Buf[0], Length(Buf));
          if N > 0 then Dest.WriteBuffer(Buf[0], N);
        until N = 0;
      finally
        Z.Free;
      end;
    end;

    Result := Copy(Dest.Bytes, 0, Dest.Size);
  finally
    Dest.Free;
    SrcStream.Free;
  end;
end;

{ ---- blob I/O :: the PE tail carries its own map ---- }

function ReadMapFooter(const Stream: TStream; out Footer: TMapBlobFooter): Boolean;
begin
  Result := False;
  if Stream.Size < SizeOf(Footer) then Exit;

  Stream.Position := Stream.Size -SizeOf(Footer);
  Stream.ReadBuffer(Footer, SizeOf(Footer));

  Result := CompareMem(@Footer.Magic, @MAP_BLOB_MAGIC, SizeOf(MAP_BLOB_MAGIC))
    and (Footer.FmtVersion = MAP_BLOB_VERSION)
    and (Footer.BlobSize > 0)
    and (Int64(Footer.BlobSize) +SizeOf(Footer) <= Stream.Size);
end;

procedure AppendMapBlobToFile(const BinaryPath, MapFilePath, Key: String);
var
  Stream: TFileStream;
  Footer, Old: TMapBlobFooter;
  Plain, Blob, Digest: TBytes;
  H: THashSHA2;
begin
  if not MapKeyVerified(Key) then
    raise Exception.Create('MapPack: key does not match the compiled verifier');

  Plain := TFile.ReadAllBytes(MapFilePath);

  Footer := Default(TMapBlobFooter);
  Move(MAP_BLOB_MAGIC, Footer.Magic, SizeOf(MAP_BLOB_MAGIC));
  Footer.FmtVersion := MAP_BLOB_VERSION;
  Footer.PlainSize := Length(Plain);
  Footer.PlainHash := MapPlainHash(Plain);

  { deterministic nonce :: same map + key packs to identical bytes, and the
    shared code path stays free of Date/Random }
  H := THashSHA2.Create(THashSHA2.TSHA2Version.SHA256);
  H.Update(TEncoding.UTF8.GetBytes(Key + '::nonce'));
  Digest := H.HashAsBytes;
  Move(Digest[8], Footer.Nonce, SizeOf(Footer.Nonce));
  Footer.Nonce := Footer.Nonce xor Footer.PlainHash;

  Blob := ZPack(Plain, True);
  MapCryptXor(Blob, Key, Footer.Nonce);
  Footer.BlobSize := Length(Blob);

  Stream := TFileStream.Create(BinaryPath, fmOpenReadWrite or fmShareExclusive);
  try
    { re-pack :: strip a previous blob before appending the fresh one }
    if ReadMapFooter(Stream, Old) then
      Stream.Size := Stream.Size -SizeOf(Old) -Old.BlobSize;

    Stream.Position := Stream.Size;
    Stream.WriteBuffer(Blob[0], Length(Blob));
    Stream.WriteBuffer(Footer, SizeOf(Footer));
  finally
    Stream.Free;
  end;
end;

function TryReadEmbeddedMap(const BinaryPath, Key: String; out MapText: String): Boolean;
var
  Stream: TFileStream;
  Footer: TMapBlobFooter;
  Blob, Plain: TBytes;
begin
  Result := False;
  MapText := EmptyString;
  if not FileExists(BinaryPath) then Exit;

  try
    Stream := TFileStream.Create(BinaryPath, fmOpenRead or fmShareDenyNone);
    try
      if not ReadMapFooter(Stream, Footer) then Exit;

      Stream.Position := Stream.Size -SizeOf(Footer) -Footer.BlobSize;
      SetLength(Blob, Footer.BlobSize);
      Stream.ReadBuffer(Blob[0], Footer.BlobSize);
    finally
      Stream.Free;
    end;

    MapCryptXor(Blob, Key, Footer.Nonce);
    Plain := ZPack(Blob, False);

    { a wrong key never yields garbage :: it fails the hash and reports no map }
    if (UInt32(Length(Plain)) <> Footer.PlainSize)
      or (MapPlainHash(Plain) <> Footer.PlainHash) then Exit;

    MapText := TEncoding.UTF8.GetString(Plain);
    Result := True;
  except
    { a truncated or foreign tail reads as <no map>, never as a crash }
    Result := False;
  end;
end;

{ ---- TMapResolver ---- }

procedure TMapResolver.TModuleMap.Parse(const MapText: String);
var
  Publist: TList<TMapPublic>;
  LineList: TList<TMapLineRec>;
  UnitList: TList<String>;
  InPublics: Boolean;
  CurUnit: Integer;
begin
  Publist := TList<TMapPublic>.Create;
  LineList := TList<TMapLineRec>.Create;
  UnitList := TList<String>.Create;
  try
    InPublics := False;
    CurUnit := -1;

    { NO regex in this loop :: static TRegEx.Match recompiles its pattern on
      every call, and a detailed map runs to ~400k lines — that was a ~10s
      freeze at first resolution. manual prefix/token parsing is <1s }
    for var Raw in MapText.Split([#10]) do
    begin
      var S := Raw.TrimRight([#13]);
      var Addr: Int64;

      if S.Contains('Publics by Value') then
      begin
        InPublics := True;
        Continue;
      end;

      if S.StartsWith('Line numbers for ') then
      begin
        InPublics := False;
        { 'Line numbers for <Unit>(<file>) segment .text' }
        var Cut := S.IndexOf('(');
        if Cut > 17 then CurUnit := UnitList.Add(S.Substring(17, Cut -17))
        else CurUnit := UnitList.Add(S.Substring(17));
        Continue;
      end;

      if InPublics then
      begin
        { ' 0001:<hex>       <name>' :: public names carry no spaces }
        if S.StartsWith(' 0001:') then
        begin
          var Sp := S.IndexOf(' ', 6);
          if (Sp > 6) and TryStrToInt64('$' +S.Substring(6, Sp -6), Addr) then
          begin
            var P: TMapPublic;
            P.Addr := UInt64(Addr);
            P.Name := S.Substring(Sp).Trim;
            if P.Name <> EmptyString then Publist.Add(P);
          end;
        end;
      end

      else if (CurUnit >= 0) and (S <> EmptyString) then
      begin
        { '  9626 0001:<hex>  9627 0001:<hex> ...' :: line/address token pairs }
        var Tok := S.Split([' '], TStringSplitOptions.ExcludeEmpty);
        var i := 0;
        while i < Length(Tok) -1 do
        begin
          var LineNo: Integer;
          if TryStrToInt(Tok[i], LineNo) and Tok[i +1].StartsWith('0001:')
            and TryStrToInt64('$' +Tok[i +1].Substring(5), Addr) then
          begin
            var L: TMapLineRec;
            L.Line := LineNo;
            L.Addr := UInt64(Addr);
            L.UnitIdx := CurUnit;
            LineList.Add(L);
            Inc(i, 2);
          end
          else Inc(i);
        end;
      end;
    end;

    Publics := Publist.ToArray;
    TArray.Sort<TMapPublic>(Publics, TComparer<TMapPublic>.Construct(
      function(const A, B: TMapPublic): Integer
      begin
        Result := CompareValue(A.Addr, B.Addr);
      end));

    Lines := LineList.ToArray;
    TArray.Sort<TMapLineRec>(Lines, TComparer<TMapLineRec>.Construct(
      function(const A, B: TMapLineRec): Integer
      begin
        Result := CompareValue(A.Addr, B.Addr);
      end));

    Units := UnitList.ToArray;
  finally
    UnitList.Free;
    LineList.Free;
    Publist.Free;
  end;
end;

constructor TMapResolver.Create(const AMapDir, ATraceDir, AKey: String);
begin
  inherited Create;
  MapDir := AMapDir;
  TraceDir := ATraceDir;
  Key := AKey;
  Maps := TObjectDictionary<String, TModuleMap>.Create([doOwnsValues]);
end;

destructor TMapResolver.Destroy;
begin
  FreeAndNil(Maps);
  inherited;
end;

function TMapResolver.MapFor(const ModuleName: String): TModuleMap;
var
  MapText, Dir, Candidate: String;
  Dirs: TArray<String>;
  Handle: HMODULE;
  ModPath: array[0..MAX_PATH] of Char;
begin
  var Id := ModuleName.ToLower;
  if Maps.TryGetValue(Id, Result) then Exit;

  MapText := EmptyString;
  Result := TModuleMap.Create;
  Result.Source := '<no map>';

  { candidate directories :: override first, the module's own home when it is
    loaded in THIS process, then the host exe's home, then the dump folder }
  Dirs := [MapDir];
  Handle := GetModuleHandle(PChar(ModuleName));
  if (Handle <> 0) and (GetModuleFileName(Handle, ModPath, MAX_PATH) > 0) then
    Dirs := Dirs + [ExtractFilePath(ModPath)];
  Dirs := Dirs + [ExtractFilePath(ParamStr(0)), TraceDir];

  { tiers 1 + 2 :: plaintext .map }
  for Dir in Dirs do
  begin
    if Dir = EmptyString then Continue;
    Candidate := IncludeTrailingPathDelimiter(Dir) +ChangeFileExt(ModuleName, '.map');

    if FileExists(Candidate) then
    begin
      MapText := TFile.ReadAllText(Candidate);
      Result.Source := StrTernary(SameText(Dir, MapDir), 'override', 'beside module');
      Break;
    end;
  end;

  { tier 3 :: embedded blob in the module file itself }
  if MapText = EmptyString then
    for Dir in Dirs do
    begin
      if Dir = EmptyString then Continue;
      Candidate := IncludeTrailingPathDelimiter(Dir) +ModuleName;

      if FileExists(Candidate) and TryReadEmbeddedMap(Candidate, Key, MapText) then
      begin
        Result.Source := 'embedded';
        Break;
      end;
    end;

  if MapText <> EmptyString then Result.Parse(MapText);
  Maps.Add(Id, Result);
end;

function TMapResolver.Resolve(const ModuleName: String; const RVA: UInt64;
  out Text, Source: String): Boolean;
var
  Map: TModuleMap;
  Target: UInt64;
  Lo, Hi, Mid, Best: Integer;
begin
  Result := False;
  Text := EmptyString;

  Map := MapFor(ModuleName);
  Source := Map.Source;
  if (Length(Map.Publics) = 0) or (RVA < $1000) then Exit;

  { map "Address" column = RVA -$1000 <first code segment> }
  Target := RVA -$1000;

  Best := -1;
  Lo := 0;
  Hi := High(Map.Publics);
  while Lo <= Hi do
  begin
    Mid := (Lo +Hi) div 2;
    if Map.Publics[Mid].Addr <= Target then
    begin
      Best := Mid;
      Lo := Mid +1;
    end
    else Hi := Mid -1;
  end;
  if Best < 0 then Exit;

  Text := format('%s +$%x', [Map.Publics[Best].Name, Target -Map.Publics[Best].Addr]);

  Best := -1;
  Lo := 0;
  Hi := High(Map.Lines);
  while Lo <= Hi do
  begin
    Mid := (Lo +Hi) div 2;
    if Map.Lines[Mid].Addr <= Target then
    begin
      Best := Mid;
      Lo := Mid +1;
    end
    else Hi := Mid -1;
  end;
  if Best >= 0 then
    Text := Text +format(' : %d', [Map.Lines[Best].Line]);

  Result := True;
end;

{ ---- the card form :: TListBox lbOwnerDrawVariable per the approved boards ---- }

type
  TTraceCard = record
    FileName, TimeStr, CallSite, Summary, BuildStr, MapSource: String;
    Body: TArray<String>;
    Resolved: TArray<String>;
    HasResolved: Boolean;
    DelRect: TRect;
  end;

  {
    cards live in a single-column TDrawGrid, NOT a TListBox :: listbox item
    heights are capped at 255px <LB_SETITEMHEIGHT>, which a real trace card
    exceeds — grid RowHeights are true integers and re-layout is exact
  }
  TTraceExplorerForm = class(TForm)
    private const
      COLLAPSED_H = 58;   { empty-folder placeholder + DefaultRowHeight only }
      LINE_H = 17;
      HEADER_H = 34;      { stamp + Delete row :: the sub-card sits 6px below the chip }
      SUM_PAD = 3;        { sub-card inner vertical pad }
      FOOT_H = 7;         { card bottom pad below the last panel }

    private
      List: TDrawGrid;
      StatusLbl: TLabel;
      Cards: TArray<TTraceCard>;
      Expanded: Integer;
      {
        the open card's details panel is a VIEWPORT, not the whole trace ::
        DetailOfs is the first frame drawn, DetailShown what actually fit.
        DetailShown is written by the paint and read by the wheel - paint
        always runs first, so the wheel never acts on a stale count.

        GridWndProc :: TControl.OnMouseWheel is PROTECTED, so the wheel is
        taken by intercepting the grid's WindowProc instead of a descendant
      }
      DetailOfs, DetailShown: Integer;
      GridWndProc: TWndMethod;
      Resolver: TMapResolver;
      TracePath: String;
      { directory watcher :: a new dump refreshes without collapsing the
        card being read; single-shot Watch + re-arm loop on a worker }
      WatchThread: TThread;
      WatchStop: Boolean;
      { card palette :: bound to the ACTIVE style, dark-aware — the chrome is
        styled by the VCL, the canvas needs its own answers }
      Pal: record
        Ground, CardBack, CardOpen, CardBorder,
        TextMain, TextDim, Accent, Danger, ChipBack, ChipBorder: TColor;
      end;

      procedure LoadCards;
      procedure EnsureResolved(var Card: TTraceCard);
      function WrappedHeight(const Line: String; const W: Integer): Integer;
      function Headline(const Index: Integer): String;
      function SummaryHeight(const Index: Integer): Integer;
      function CollapsedHeight(const Index: Integer): Integer;
      function ExpandedHeight(const Index: Integer): Integer;
      procedure Relayout;
      procedure SetExpanded(const Index: Integer);
      procedure ListDraw(Sender: TObject; ACol, ARow: Longint; Rect: TRect; State: TGridDrawState);
      procedure ListMouseDown(Sender: TObject; Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
      procedure ListMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Integer);
      procedure GridProc(var Msg: TMessage);
      procedure ListResize(Sender: TObject);
      procedure RefreshClick(Sender: TObject);
      procedure DeleteCard(const Index: Integer);
      procedure RefreshKeepingCard;

    public
      constructor CreateExplorer(const ATracePath: String; const AResolver: TMapResolver; Title: String = ''; Style: String = 'Windows');
      destructor Destroy; override;
  end;

constructor TTraceExplorerForm.CreateExplorer(const ATracePath: String; const AResolver: TMapResolver; Title, Style: String);
var
  Bottom: TPanel;
  RefreshBtn: TSpeedButton;
begin
  inherited CreateNew(nil);
  TracePath := ATracePath;
  Resolver := AResolver;
  Expanded := -1;
  if Title <> EmptyString then Caption := format('[%s]', [Title]);
  Caption := Trim(format('%s StackTrace Explorer | %s', [Caption, AbbreviateFilePath(TracePath, 1)]));
  Position := poScreenCenter;
  ClientWidth := 520;
  ClientHeight := 650;
  Font.Name := 'Segoe UI';
  Font.Size := 9;
  FormStyle := TFormStyle.fsNormal;
  BorderStyle := TFormBorderStyle.bsDialog;
  StyleName := Style;

  Bottom := TPanel.Create(Self);
  Bottom.Parent := Self;
  Bottom.Align := alBottom;
  Bottom.Height := 35;
  Bottom.Font.Name := 'Consolas';
  Bottom.Font.Size := 9;
  Bottom.Font.Color := clTeal;
  Bottom.BevelOuter := bvNone;
  Bottom.BorderStyle := bsNone;
  Bottom.ParentBackground := True;
  Bottom.StyleName := Style;

  RefreshBtn := TSpeedButton.Create(Self);
  RefreshBtn.Parent := Bottom;
  RefreshBtn.Caption := 'Refresh';
  RefreshBtn.Width := 65;
  RefreshBtn.Height := 25;
  RefreshBtn.Anchors := [akRight, akTop];
  RefreshBtn.Left := Bottom.ClientWidth -RefreshBtn.Width -3;
  RefreshBtn.Top := 3;
  RefreshBtn.Font.Color := clBlack;
  RefreshBtn.StyleName := Style;
  RefreshBtn.OnClick := RefreshClick;

  StatusLbl := TLabel.Create(Self);
  StatusLbl.Parent := Bottom;
  StatusLbl.Left := 10;
  StatusLbl.Top := 11;
  StatusLbl.Caption := EmptyString;
  StatusLbl.StyleName := Style;

  List := TDrawGrid.Create(Self);
  List.Parent := Self;
  List.Align := alClient;
  List.AlignWithMargins := True;
  List.Margins.SetBounds(3, 3, 3, 3);
  List.BorderStyle := bsSingle;
  List.ColCount := 1;
  List.FixedCols := 0;
  List.FixedRows := 0;
  List.Ctl3D := True;
  List.Color := clInactiveBorder;
  List.DefaultRowHeight := COLLAPSED_H;
  List.DefaultDrawing := False;
  List.Options := [goThumbTracking];
  List.ScrollBars := ssVertical;
  List.StyleName := Style;
  List.OnDrawCell := ListDraw;
  List.OnMouseDown := ListMouseDown;
  List.OnMouseMove := ListMouseMove;
  GridWndProc := List.WindowProc;
  List.WindowProc := GridProc;
  {
    grids keep OnResize protected :: the client-aligned grid tracks the form.
    OnShow too — the constructor-time ClientWidth predates the real layout
    pass, so first paint used a stale column width until a manual refresh
  }
  OnResize := ListResize;
  OnShow := ListResize;

  LoadCards;

  WatchStop := False;
  WatchThread := TThread.CreateAnonymousThread(
    procedure
    begin
      while not WatchStop do
        if Watch(TracePath, FILE_NOTIFY_CHANGE_FILE_NAME, False, 1000) then
          TThread.Queue(WatchThread, RefreshKeepingCard);
    end);
  WatchThread.FreeOnTerminate := False;
  WatchThread.Start;
end;

destructor TTraceExplorerForm.Destroy;
begin
  if Assigned(WatchThread) then
  begin
    WatchStop := True;
    { Watch returns within its 1s timeout; purge any refresh still queued }
    WatchThread.WaitFor;
    TThread.RemoveQueuedEvents(WatchThread);
    FreeAndNil(WatchThread);
  end;
  { unhook before the grid goes :: a late message must not reach a dying form }
  if Assigned(GridWndProc) then List.WindowProc := GridWndProc;
  inherited;
end;

procedure TTraceExplorerForm.RefreshKeepingCard;
var
  Keep: String;
begin
  Keep := EmptyString;
  if (Expanded >= 0) and (Expanded <= High(Cards)) then
    Keep := Cards[Expanded].FileName;

  LoadCards;

  if Keep <> EmptyString then
    for var i := 0 to High(Cards) do
      if Cards[i].FileName = Keep then
      begin
        SetExpanded(i);
        Break;
      end;
end;

procedure TTraceExplorerForm.ListResize(Sender: TObject);
begin
  Relayout;
end;

procedure TTraceExplorerForm.LoadCards;
var
  Files: TArray<String>;
  Card: TTraceCard;
begin
  Expanded := -1;
  SetLength(Cards, 0);

    if TDirectory.Exists(TracePath) then
    begin
      Files := TDirectory.GetFiles(TracePath, 'Exc_*.txt');
      TArray.Sort<String>(Files);

      { newest first :: names sort chronologically }
      for var i := High(Files) downto Low(Files) do
      begin
        Card := Default(TTraceCard);
        Card.FileName := ExtractFileName(Files[i]);

        { Exc_yyyymmdd_hhnnss_zzz_seq.txt }
        var M := TRegEx.Match(Card.FileName, '^Exc_(\d{4})(\d{2})(\d{2})_(\d{2})(\d{2})(\d{2})_(\d{3})');
        if M.Success then
          Card.TimeStr := format('%s-%s-%s %s:%s:%s.%s', [M.Groups[1].Value,
            M.Groups[2].Value, M.Groups[3].Value, M.Groups[4].Value,
            M.Groups[5].Value, M.Groups[6].Value, M.Groups[7].Value]);

        var Lines := TFile.ReadAllLines(Files[i], TEncoding.UTF8);
        var Start := 0;

        if (Length(Lines) > 0) and Lines[0].StartsWith('build:: ') then
        begin
          Card.BuildStr := Lines[0].Substring(8);
          Start := 1;
        end;

        if Start < Length(Lines) then
        begin
          var Head := Lines[Start];
          var Sep := Head.IndexOf(':');
          if Sep > 0 then
          begin
            Card.CallSite := Head.Substring(0, Sep).TrimRight([':']);
            Card.Summary := Head.Substring(Sep +1).TrimLeft([':', ' ']);
          end
          else Card.Summary := Head;
        end;

        Card.Body := Copy(Lines, Start, Length(Lines));
        Cards := Cards + [Card];
      end;
    end;

  { grids hold at least one row :: an empty folder shows one blank cell }
  List.RowCount := Max(Length(Cards), 1);
  List.RowHeights[0] := COLLAPSED_H;   { the placeholder, when Cards is empty }
  Relayout;

  StatusLbl.Caption := format('%d dumps · newest first', [Length(Cards)]);
  List.Invalidate;
end;

procedure TTraceExplorerForm.EnsureResolved(var Card: TTraceCard);
var
  Text, Source: String;
begin
  if Card.HasResolved then Exit;
  Card.HasResolved := True;
  Card.MapSource := EmptyString;
  Card.Resolved := nil;

  { Body[0] is the headline :: it lives in the header summary now, so the
    well starts at the frames — leading blanks fold away with it }
  var First := 1;
  while (First <= High(Card.Body)) and (Card.Body[First].Trim = EmptyString) do
    Inc(First);

  for var Line in Copy(Card.Body, First, Length(Card.Body)) do
  begin
    var M := TRegEx.Match(Line.Trim, '^(\S+\.(?:exe|dll|EXE|DLL)) \+ \$([0-9A-Fa-f]+)$');

    if M.Success and (Resolver <> nil) then
    begin
      var Display := Line.Trim;
      if Resolver.Resolve(M.Groups[1].Value,
        UInt64(StrToInt64('$' + M.Groups[2].Value)), Text, Source) then
          Display := Display +'  →  ' +Text;
      if (Card.MapSource = EmptyString) and (Source <> EmptyString) then
        Card.MapSource := Source;
      Card.Resolved := Card.Resolved + [Display];
    end

    else Card.Resolved := Card.Resolved + [Line];
  end;
end;

function TTraceExplorerForm.WrappedHeight(const Line: String; const W: Integer): Integer;
var
  R: TRect;
begin
  if Line = EmptyString then Exit(LINE_H);

  R := TRect.Create(0, 0, W, 0);
  { measure with the SAME flags and font the draw uses — they must agree }
  DrawText(List.Canvas.Handle, PChar(Line), Length(Line), R,
    DT_CALCRECT or DT_WORDBREAK or DT_NOPREFIX);
  Result := Max(R.Height +2, LINE_H);
end;

function TTraceExplorerForm.Headline(const Index: Integer): String;
begin
  Result := Trim(Cards[Index].CallSite
    +StrTernary(Cards[Index].CallSite = EmptyString, '', ':: ')
    +Cards[Index].Summary);
  if (Result = EmptyString) and (Length(Cards[Index].Body) > 0) then
    Result := Cards[Index].Body[0];
end;

function TTraceExplorerForm.SummaryHeight(const Index: Integer): Integer;
begin
  { the font the sub-card is DRAWN with :: the wrap points must agree.
    -43 is its inner width <15/8 card insets, 6/6 text pads> }
  List.Canvas.Font.Name := 'Consolas';
  List.Canvas.Font.Size := 9;
  List.Canvas.Font.Style := [];
  Result := WrappedHeight(Headline(Index), List.ColWidths[0] -43) +(2 *SUM_PAD);
end;

function TTraceExplorerForm.CollapsedHeight(const Index: Integer): Integer;
begin
  { 6 = the row-to-card inflate <3 top, 3 bottom> }
  Result := 6 +HEADER_H +SummaryHeight(Index) +FOOT_H;
end;

function TTraceExplorerForm.ExpandedHeight(const Index: Integer): Integer;
begin
  EnsureResolved(Cards[Index]);

  { the sub-card is untouched by opening :: collapsed geometry, then a 5px gap
    and the details panel <8/8 inner pads> where the bottom pad was.
    SummaryHeight leaves the body font current, which the frame widths need }
  Result := 6 +HEADER_H +SummaryHeight(Index) +6 +16 +FOOT_H;
  for var Line in Cards[Index].Resolved do
    Inc(Result, WrappedHeight(Line, List.ColWidths[0] -45));

  Result := Min(Result, List.ClientHeight -12);
  if Result < CollapsedHeight(Index) then Result := CollapsedHeight(Index);
end;

procedure TTraceExplorerForm.Relayout;
begin
  {
    row heights are wrap-measured against the column, and a height change can
    summon or retire the vertical scrollbar - which moves ClientWidth under
    those very measurements. a second pass settles it.

    if/else, NOT IntTernary :: both arms would evaluate, and ExpandedHeight
    resolves maps - every dump in the folder would pay that on load
  }
  for var Pass := 1 to 2 do
  begin
    var W := List.ClientWidth;
    List.ColWidths[0] := W;

    for var i := 0 to High(Cards) do
      if i = Expanded then List.RowHeights[i] := ExpandedHeight(i)
      else List.RowHeights[i] := CollapsedHeight(i);

    if List.ClientWidth = W then Break;
  end;
end;

procedure TTraceExplorerForm.SetExpanded(const Index: Integer);
begin
  if Index = Expanded then Expanded := -1
  else
  begin
    { a different card starts at its first frame }
    DetailOfs := 0;
    Expanded := Index;
  end;

  { every row re-measures :: Relayout owns column width and heights together }
  Relayout;

  if Expanded >= 0 then
  begin
    { the opened card ALWAYS comes to the top of the view :: an expanded card
      is usually taller than the viewport, so conditional scrolling guessed
      wrong — deterministic beats clever here }
    List.TopRow := Expanded;

    var Card := Cards[Expanded];
    StatusLbl.Caption := format('%d dumps · %s · map: %s',
      [Length(Cards), Card.FileName, StrTernary(Card.MapSource = EmptyString,
        '<no map>', Card.MapSource)]);
  end
  else StatusLbl.Caption := format('%d dumps · newest first', [Length(Cards)]);

  List.Invalidate;
end;

procedure TTraceExplorerForm.ListDraw(Sender: TObject; ACol, ARow: Longint;
  Rect: TRect; State: TGridDrawState);
var
  R, Chip: TRect;
  Index: Integer;
  IsExpanded: Boolean;

  { web-style chip :: flat white, hairline grey border, centered label }
  procedure DrawChip(const Dest: TRect; const Caption: String; const Danger: Boolean);
  begin
    with List.Canvas do
    begin
      Brush.Style := bsSolid;
      Brush.Color := clWindow;
      { chips share the card's border color :: one hairline tone everywhere }
      Pen.Color := TColor($E3E3E3);
      RoundRect(Dest.Left, Dest.Top, Dest.Right, Dest.Bottom, 6, 6);

      Brush.Style := bsClear;
      Font.Name := 'Segoe UI';
      Font.Style := [];
      Font.Color := IntTernary(Danger, TColor($3A3AC8), TColor($1A1A1A));
      TextOut(Dest.Left +((Dest.Width -TextWidth(Caption)) div 2),
        Dest.Top +((Dest.Height -TextHeight(Caption)) div 2), Caption);
    end;
  end;

begin
  Index := ARow;
  if (Index < 0) or (Index > High(Cards)) then
  begin
    { the empty-folder placeholder row }
    List.Canvas.Brush.Color := clWindow;
    List.Canvas.FillRect(Rect);
    Exit;
  end;
  IsExpanded := (Index = Expanded);

  with List.Canvas do
  begin
    { listbox ground shows through the rounded corners }
    Brush.Color := clWindow;
    FillRect(Rect);

    R := Rect;
    R.Inflate(-4, -3);

    { one cool ground, open and closed alike :: state reads from the border
      and the spine now, not the fill }
    Brush.Color := TColor($FCF9F6);
    Pen.Color := IntTernary(IsExpanded, clNavy, TColor($E3E3E3));
    RoundRect(R.Left, R.Top, R.Right, R.Bottom, 12, 12);

    { spine :: exception red collapsed, navy when open }
    Brush.Color := IntTernary(IsExpanded, clNavy, TColor($0000C0));
    Pen.Color := Brush.Color;
    RoundRect(R.Left, R.Top, R.Left +7, R.Bottom, 6, 6);
    FillRect(TRect.Create(R.Left +4, R.Top +1, R.Left +7, R.Bottom -1));

    Brush.Style := bsClear;

    { line 1 :: stamp, build key, Delete - IDENTICAL in both states, so
      opening a card moves nothing }
    Font.Name := 'Consolas';
    Font.Size := 9;
    Font.Style := [fsBold];
    Font.Color := clNavy;
    TextOut(R.Left +16, R.Top +7, Cards[Index].TimeStr);
    var KeyX := R.Left +16 +TextWidth(Cards[Index].TimeStr) +14;  { measured BOLD }

    Chip := TRect.Create(R.Right -8 -66, R.Top +6, R.Right -8, R.Top +28);
    DrawChip(Chip, 'Delete', True);
    Cards[Index].DelRect := Chip;

    { build key :: the archive selector - shown closed too, so a folder of
      dumps reveals its build boundaries without opening anything.
      DrawChip left Segoe UI current, hence the font restatement }
    Font.Name := 'Consolas';
    Font.Style := [];
    var PillR := Min(KeyX +TextWidth(Cards[Index].BuildStr) +12, Chip.Left -10);
    if (Cards[Index].BuildStr <> EmptyString) and (PillR > KeyX +14) then
    begin
      { quiet neutral :: a second tinted pill here would fight the sub-card }
      var Pill := TRect.Create(KeyX, R.Top +6, PillR, R.Top +24);
      Brush.Style := bsSolid;
      Brush.Color := TColor($F2F2F2);
      Pen.Color := TColor($E3E3E3);
      RoundRect(Pill.Left, Pill.Top, Pill.Right, Pill.Bottom, 6, 6);
      Brush.Style := bsClear;

      Font.Color := clGrayText;
      var PillTxt := TRect.Create(Pill.Left +6, Pill.Top +1, Pill.Right -4, Pill.Bottom -1);
      TextRect(PillTxt, PillTxt.Left, PillTxt.Top, Cards[Index].BuildStr);
    end;

    { summary sub-card :: wrapped, full width, unchanged by opening - this is
      what sizes a closed card }
    var Sum := TRect.Create(R.Left +15, R.Top +HEADER_H, R.Right -8,
                            R.Top +HEADER_H +SummaryHeight(Index));
    Brush.Style := bsSolid;
    Brush.Color := TColor($EBEBFD);
    Pen.Color := TColor($EBEBFD);
    RoundRect(Sum.Left, Sum.Top, Sum.Right, Sum.Bottom, 6, 6);
    Brush.Style := bsClear;

    Font.Color := TColor($3A3AC8);
    var SumTxt := TRect.Create(Sum.Left +6, Sum.Top +SUM_PAD, Sum.Right -6, Sum.Bottom);
    DrawText(Handle, PChar(Headline(Index)), -1, SumTxt, DT_WORDBREAK or DT_NOPREFIX);

    if IsExpanded then
    begin
      { details :: Body[0] is the headline and lives in the sub-card above, so
        EnsureResolved already starts at the frames - nothing repeats here }
      var Panel := TRect.Create(R.Left +15, Sum.Bottom +6, R.Right -8, R.Bottom -FOOT_H);
      Brush.Style := bsSolid;
      Brush.Color := clWindow;
      Pen.Color := TColor($E3E3E3);
      RoundRect(Panel.Left, Panel.Top, Panel.Right, Panel.Bottom, 6, 6);
      Brush.Style := bsClear;

      { measure the whole trace first :: the note line only earns its 16px
        when frames actually fall outside the viewport }
      var FrameW := R.Right -16 -(R.Left +21);
      var Avail := Panel.Height -16;
      var TotalH := 0;
      for var Line in Cards[Index].Resolved do
        Inc(TotalH, WrappedHeight(Line, FrameW));

      var Overflows := TotalH > Avail;
      if Overflows then Dec(Avail, 16);

      Font.Color := TColor($1A1A1A);
      var Y := Panel.Top +8;
      var Limit := Panel.Top +8 +Avail;
      DetailShown := 0;
      for var i := DetailOfs to High(Cards[Index].Resolved) do
      begin
        var Line := Cards[Index].Resolved[i];
        var H := WrappedHeight(Line, FrameW);
        if Y +H > Limit then Break;

        if Line <> EmptyString then
        begin
          var TxtRect := TRect.Create(R.Left +21, Y, R.Right -16, Y +H);
          DrawText(Handle, PChar(Line), Length(Line), TxtRect,
            DT_WORDBREAK or DT_NOPREFIX);
        end;
        Inc(Y, H);
        Inc(DetailShown);
      end;

      { a truncated trace must never read as a complete one }
      if Overflows then
      begin
        Font.Color := clGrayText;
        var Note := format('%d-%d of %d frames · scroll',
          [DetailOfs +1, DetailOfs +DetailShown, Length(Cards[Index].Resolved)]);
        var NoteR := TRect.Create(R.Left +21, Panel.Bottom -24, R.Right -16, Panel.Bottom -8);
        DrawText(Handle, PChar(Note), -1, NoteR,
          DT_RIGHT or DT_SINGLELINE or DT_VCENTER or DT_NOPREFIX);
      end;

    end;

    Brush.Style := bsSolid;
  end;
end;

procedure TTraceExplorerForm.ListMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  Col, Row: Integer;
  P: TPoint;
begin
  if Button <> mbLeft then Exit;
  P := Point(X, Y);
  List.MouseToCell(X, Y, Col, Row);
  if (Row < 0) or (Row > High(Cards)) then Exit;

  if Cards[Row].DelRect.Contains(P) then DeleteCard(Row)
  else SetExpanded(Row);  { the card body is the only toggle now }
end;

procedure TTraceExplorerForm.ListMouseMove(Sender: TObject; Shift: TShiftState;
  X, Y: Integer);
var
  Col, Row: Integer;
begin
  List.MouseToCell(X, Y, Col, Row);
  { every chip that used to toggle is gone :: the card body is the affordance }
  if (Row >= 0) and (Row <= High(Cards)) then List.Cursor := crHandPoint
  else List.Cursor := crDefault;
end;

procedure TTraceExplorerForm.GridProc(var Msg: TMessage);
var
  Col, Row: Integer;
begin
  if (Msg.Msg = WM_MOUSEWHEEL) and (Expanded >= 0) and (Expanded <= High(Cards)) then
  begin
    { lParam carries SCREEN coords, wParam's high word the delta :: unpacked by
      hand, since a TMessage cast to TWMMouseWheel is not layout-safe on Win64 }
    var P := List.ScreenToClient(Point(SmallInt(Cardinal(Msg.LParam) and $FFFF),
                                      SmallInt(Cardinal(Msg.LParam) shr 16)));
    List.MouseToCell(P.X, P.Y, Col, Row);

    if Row = Expanded then
    begin
      var Moved := False;

      {
        claim the wheel ONLY while the open card can actually move :: at either
        end it falls through to the grid, so the list keeps scrolling and the
        wheel never feels hijacked
      }
      if SmallInt(Cardinal(Msg.WParam) shr 16) < 0 then
      begin
        if DetailOfs +DetailShown < Length(Cards[Expanded].Resolved) then
        begin
          DetailOfs := Min(DetailOfs +3, High(Cards[Expanded].Resolved));
          Moved := True;
        end;
      end

      else if DetailOfs > 0 then
      begin
        DetailOfs := Max(DetailOfs -3, 0);
        Moved := True;
      end;

      if Moved then
      begin
        List.Invalidate;
        Msg.Result := 1;
        Exit;
      end;
    end;
  end;

  GridWndProc(Msg);
end;

procedure TTraceExplorerForm.DeleteCard(const Index: Integer);
begin
  if MessageDlg(format('Delete %s from disk?', [Cards[Index].FileName]),
    mtConfirmation, [mbYes, mbNo], 0, mbNo) <> mrYes then Exit;

  TFile.Delete(IncludeTrailingPathDelimiter(TracePath) +Cards[Index].FileName);
  LoadCards;
end;

procedure TTraceExplorerForm.RefreshClick(Sender: TObject);
begin
  LoadCards;
end;

{ ---- TStackTraceExplorer :: gate, then the form ---- }

constructor TStackTraceExplorer.Create(const ATracePath, AMapPath: String);
begin
  inherited Create;
  TracePath := ATracePath;
  if TracePath = EmptyString then
    TracePath := ExtractFilePath(ParamStr(0)) +'StackTrace';
  MapPath := AMapPath;
end;

procedure TStackTraceExplorer.Execute;
const
  REG_PATH = 'Software\Maccor\StackTraceExplorer';
  MAX_TRIES = 10;
  DENY_MINUTES = 30;
var
  Reg: TRegistry;
  DenyUntil: TDateTime;
  Key: String;
  Verified: Boolean;
  Form: TTraceExplorerForm;
  Resolver: TMapResolver;
begin
  {$IFDEF DEBUG}
  { IDE builds walk in :: plaintext maps beside the exe, nothing to decrypt —
    the gate is a property of RELEASE binaries, not of call sites }
  Key := EmptyString;
  {$ELSE}
  Reg := TRegistry.Create(KEY_READ or KEY_WRITE);
  try
    Reg.RootKey := HKEY_CURRENT_USER;
    if not Reg.OpenKey(REG_PATH, True) then Exit;

    DenyUntil := 0;
    if Reg.ValueExists('DenyUntil') then
      DenyUntil := StrToFloatDef(Reg.ReadString('DenyUntil'), 0);

    if Now < DenyUntil then
    begin
      MessageDlg(format('StackTrace Explorer is locked until %s.',
        [FormatDateTime('hh:nn', DenyUntil)]), mtWarning, [mbOK], 0);
      Exit;
    end;

    Verified := False;
    var Entries: TArray<ShortString>;
    for var Attempt := 1 to MAX_TRIES do
    begin
      Entries := nil;
      if not ShowDialog(Application.MainForm, 'StackTrace Explorer', 'Enter the encryption key',
        ['Passkey:'], Entries, detPassword, 'Windows') then Exit;
      Key := String(Entries[0]);

      Verified := MapKeyVerified(Key);
      if Verified then Break;

      if Attempt < MAX_TRIES then
        MessageDlg(format('Invalid key. %d attempt(s) remaining.',
          [MAX_TRIES -Attempt]), mtError, [mbOK], 0);
    end;

    if not Verified then
    begin
      Reg.WriteString('DenyUntil', FloatToStr(Now +(DENY_MINUTES /MinsPerDay)));
      MessageDlg(format('Too many invalid keys. Locked for %d minutes.',
        [DENY_MINUTES]), mtWarning, [mbOK], 0);
      Exit;
    end;

    Reg.DeleteValue('DenyUntil');
  finally
    Reg.Free;
  end;
  {$ENDIF}

  Resolver := TMapResolver.Create(MapPath, TracePath, Key);
  try
    Form := TTraceExplorerForm.CreateExplorer(TracePath, Resolver, Title, Style);

    try
      Form.ShowModal;
    finally
      Form.Free;
    end;
  finally
    Resolver.Free;
  end;
end;

procedure TStackTraceExplorer.SetTitle(const Title: String);
begin
  Self.Title := Title;
end;

procedure TStackTraceExplorer.StyleName(const Name: String);
begin
  Style := Name;
end;

{$ENDREGION}

Initialization
begin
  { NO_MACSYS_AUTOLOAD :: defined by projects (e.g. MacEVcontroller) that must
    not read/rewrite the system configuration at unit init. They call
    GetMaccorEnv(MacSys) themselves when it is actually needed.
    (GetMaccorEnv rewrites System.ini via UpdateFile; when MacTest32 launched
    MacEVcontroller while writing System.ini itself, MacTest32 failed with
    EIniFileException "Unable to write to ...System.ini".) }
  {$IFNDEF NO_MACSYS_AUTOLOAD}
  GetMaccorEnv(MacSys);
  {$ENDIF}
  ConfigureConsolePrintConstants;

  HighResTimerAvailable := QueryPerformanceFrequency(PerformanceFrequency)
    and (PerformanceFrequency <> 0);

  {$ifdef DEBUG8500}
  if DirectoryExists(MacSys.SysPath) then
    if not DirectoryExists(MacSys.TempPath) then
    begin
      ForceDirectories(MacSys.TempPath);
      HideDirectory(MacSys.TempPath);
    end;
  {$endif}

  GetStyleNames;
  GlobalWaitEvent := TEvent.Create(nil, False, False, '');
  InstallRtlExceptionStackTrace;
  UnhandledReporter := TUnhandledExceptionReporter.Create;
  Application.OnException := UnhandledReporter.HandleException;
end;

Finalization
begin
  {$ifdef DEBUG8500}
  if DirectoryExists(MacSys.TempPath) then
    DeleteFolder(MacSys.TempPath);
  {$endif}

  {$ifdef MACTEST32} {$undef MACTEST32} {$endif}

  FreeStyleList;
  FreeMemoLocks;
  FreeAndNil(GlobalWaitEvent);
  { unhook before teardown :: a late exception must not call into a freed reporter }
  if Assigned(Application) then Application.OnException := nil;
  FreeAndNil(UnhandledReporter);
end;

end.
