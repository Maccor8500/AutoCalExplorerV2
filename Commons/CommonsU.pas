function isValidIP(const Addr: string): boolean;
var
  octets : TArray<string>;
  i, octet: Integer;
begin
  Result := false;
  octets := Addr.Split(['.']);
  if Length(octets) < 4 then Exit;

  case Length(octets) of
    0..3: Result := false;
    else
    begin
      for i := 0 to Length(octets) -1 do
      begin
        Result := TryStrToInt(octets[i], octet);
        Result := Result and ((octet >= 0) and (octet <= 255));

        if not Result then
          break;
      end;
    end;
  end;
end;

