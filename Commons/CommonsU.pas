end;

procedure TRegistryReaderEx.CountValues(const Path: String; var Entries: NativeUInt);
var
  Names: TStrings;
begin
  Entries := 0;
  SetPath(Path);

  if R.OpenKey(RegPath, False) then
  begin
    Names := TStringList.Create;
    try
      try
        R.GetValueNames(Names);
        Entries := Names.Count;
      finally
        R.CloseKey;
      end;
    finally
      FreeAndNil(Names);
    end;
  end;
end;

function TRegistryReaderEx.Read(const Key, Path: String; var Data: TBytes): Boolean;
var
  Size, Rx: NativeUInt;
begin
  Size := 0; Rx := 0;
  SetPath(Path);
  SetLength(Data, 0);

  try
    if R.OpenKey(RegPath, False) then
    begin
      try
        try
          Size := NativeUInt(R.GetDataSize(Key));
          if Size <= 0 then Exit;

          SetLength(Data, Size);
          Rx := R.ReadBinaryData(Key, Data[0], Size);
        finally
          R.CloseKey;
        end;
      except
        On E: Exception do
          ShowDialog(dtInfo, E.Message);
      end;
    end;
  finally
    Result := (Size = Rx) and (Size <> 0);
  end;
end;

procedure TRegistryReaderEx.Read(const Path, Key: String; var Buf; const Len: UInt32; Size: PNativeUInt);
begin
  SetPath(Path);
  if R.OpenKey(RegPath, False) then
  begin
    try
      try
        var Rx: NativeUInt := R.ReadBinaryData(Key, Buf, Len);
        if Size <> nil then Size^ := Rx;
      finally
        R.CloseKey;
      end;
    except
      On E: Exception do
        ShowDialog(dtInfo, E.Message);
    end;
  end;
end;

procedure TRegistryReaderEx.Read(Key: String; var Buf; const Len: UInt32; Size: PNativeUInt);
begin
  if Trim(RegPath) = '' then SetPath(BasePath, False);

  if R.OpenKey(RegPath, True) then
  begin
    try
      try
        var Rx: NativeUInt := R.ReadBinaryData(Key, Buf, Len);
        if Size <> nil then Size^ := Rx;
      finally
        R.CloseKey;
      end;
    except
      On E: Exception do
        ShowDialog(dtInfo, E.Message);
    end;
  end;
end;

procedure TRegistryReaderEx.SetPath(const Path: String; UpdateBase: Boolean);
var
  NewPath : String;
begin
  if Trim(Path) = '' then Exit;

  { over-write current path }
  if (not UpdateBase) then NewPath := format('%s\%s', [BasePath, Path])
  { path gets deeper/different }
  else
  begin
    if RegPath = '' then NewPath := Path
    else NewPath := format('%s\%s', [RegPath, Path]);
  end;
  RegPath := NewPath;
end;

