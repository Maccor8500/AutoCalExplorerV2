function Compare(const s1, s2 : TMemoryStream) : boolean;
const blk_sz = 64;

var
  b1, b2 : array[0.. blk_sz] of byte;
  len : integer;  x : boolean;
begin
  Result := false;
  if (s1 = nil) or (s2 = nil) then Exit;
  if s1.Size <> s2.Size then Exit;
  s1.Position := 0; s2.Position := 0;

  while (s1.Position < s1.Size)  do
  begin
    len := s1.Read(b1, blk_sz);
    s2.Read(b2, blk_sz);

    x := CompareMem(@b1, @b2, len);
    if not x then
      Exit;
  end;

  Result := true;
end;

