function TUSBDeviceManagerEx.GetLastErrorCode: SmallInt;
begin
  Result := ErrorCode;
end;

function TUSBDeviceManagerEx.GetLastRefreshTime: TDateTime;
begin
  Result := LastRefresh;
end;

function TUSBDeviceManagerEx.InitUSB: TLIBUSBError;
begin
  Result := LIBUSB_INVALID_CTX;
  HandleEvent(format(#13#10'initializing.... [@%s]'#13#10, [USB_INIT]));
  if not Assigned(libusb_init) then
  begin
    HandleEvent(format('invalid handle [%s]'#13#10, [USB_INIT]));
    Exit;
  end;

  try
    try
      ErrorCode := libusb_init(Context);
      Result := IntToLibUSBError(ErrorCode);
    finally
      HandleEvent(format('call exited with: %s'#13#10, [LibUSBErrToStr(Result)]));
    end;
  except
    On E: Exception do HandleEvent(format('%s'#13#10'%s'#13#10,
      [E.Message, E.StackTrace]), GetLastError, etAppException);
  end;
end;

function TUSBDeviceManagerEx.ExitUSB: TLIBUSBError;
begin
  Result := LIBUSB_INVALID_CTX;
  if Context = nil then Exit;

  if Assigned(libusb_exit) then
  begin
    try
      libusb_exit(Context);
    finally
      Result := LIBUSB_OK;
    end;
  end;
end;

function TUSBDeviceManagerEx.GetDevices(var Devices: PPlibusb_device; var Count: Integer): TLIBUSBError;
begin
  Result := LIBUSB_OK;
  HandleEvent(format('getting device list.... [@%s]'#13#10, [USB_GET_LIST]));
  if (Context = nil) then
  begin
    HandleEvent('context not initialized!'#13#10);
    Result := LIBUSB_INVALID_CTX;
    Exit;
  end;

  if not Assigned(libusb_get_device_list) then
  begin
    HandleEvent(format('invalid handle [%s]'#13#10, [USB_GET_LIST]));
    Exit;
  end;

  try
    try
      Count := libusb_get_device_list(Context, Devices);
    finally
      Result := TLIBUSBError(Count);
      HandleEvent(format('call exited with: %s'#13#10, [LibUSBErrToStr(Result)]));
    end;
  except
    On E: Exception do
      ReportException(E);
  end;
end;

function TUSBDeviceManagerEx.IntToLibUSBError(const ErrInt: integer): TLIBUSBError;
begin
  Result := TLIBUSBError(Abs(ErrInt));
end;

function TUSBDeviceManagerEx.LibUSBErrToStr(const USBErr: TLIBUSBError): String;
begin
  case USBErr of
    LIBUSB_OK: Result := 'OK';
    LIBUSB_ERROR_IO: Result := 'I|O error.';
    LIBUSB_ERROR_INVALID_PARAM: Result := 'Invalid parameter passed to function.';
    LIBUSB_ERROR_ACCESS: Result := 'Access denied (insufficient permissions).';
    LIBUSB_ERROR_NO_DEVICE: Result := 'No such device (could not find a suitable device).';
    LIBUSB_ERROR_NOT_FOUND: Result := 'Entity not found.';
    LIBUSB_ERROR_BUSY: Result := 'Resource busy (device or resource is busy).';
    LIBUSB_ERROR_TIMEOUT: Result := 'Operation timed out.';
    LIBUSB_ERROR_OVERFLOW: Result := 'Overflow error.';
    LIBUSB_ERROR_PIPE: Result := 'Pipe error.';
    LIBUSB_INVALID_CTX: Result := 'Invalid context!';

    else Result := 'Unknown Calamity!';
  end;
end;

procedure TUSBDeviceManagerEx.RefreshInterval(const Secs: Integer);
begin
  Interval := Secs;
  RefreshList;
end;

procedure TUSBDeviceManagerEx.RefreshList;
var
  DeviceInfoSet: HDEVINFO;
  DeviceInfoData: SP_DEVINFO_DATA;
  DeviceId: array[0..511] of WideChar;
  DeviceDesc: array[0..255] of WideChar;
  RequiredSize: DWORD;
  PropertyRegDataType: DWORD;
  i, L: Integer;
  LDevices: TArray<TUSBDevice>;

  Devs: TArray<Plibusb_device>;
  DevList: PPlibusb_device;
  Count: Integer;
begin
  try
    { guard this pot! }
    if Busy then Exit;

    { use last list until interval expires }
    Busy := (SecondsBetween(Now, LastRefresh) >= Interval) or (ForceRefresh);
    if (not Busy) then Exit;
    { clear dummy list! }
    SetLength(LDevices, 0);

    case Access of
      USB_WINDOWS:
      begin
        { get the device info set for USB devices }
        DeviceInfoSet := SetupDiGetClassDevsW(nil, nil, 0, DIGCF_ALLCLASSES or DIGCF_PRESENT);
        if DeviceInfoSet = INVALID_HANDLE_VALUE then
          Exit;

        try
          DeviceInfoData.cbSize := SizeOf(SP_DEVINFO_DATA);
          for i := 0 to MaxInt do
          begin
            if not SetupDiEnumDeviceInfo(DeviceInfoSet, i, DeviceInfoData) then
              Break;
            { get the device ID }
            if SetupDiGetDeviceInstanceIdW(DeviceInfoSet, DeviceInfoData, DeviceId, SizeOf(DeviceId) div SizeOf(WideChar), RequiredSize) then
            begin
              { get the device description }
              if SetupDiGetDeviceRegistryPropertyW(DeviceInfoSet, DeviceInfoData, SPDRP_DEVICEDESC, PropertyRegDataType, PByte(@DeviceDesc[0]), SizeOf(DeviceDesc), RequiredSize) then
              begin
                L := Length(LDevices);
                SetLength(LDevices, L +1);
                LDevices[L].DeviceInfoSet := DeviceInfoSet;
                LDevices[L].DeviceInfoData := DeviceInfoData;
                LDevices[L].DeviceDesc := String(DeviceDesc);
                LDevices[L].DeviceId := String(DeviceId);
                LDevices[L].PropertyRegDataType := PropertyRegDataType;
              end;
            end;
          end;
        finally
          SetupDiDestroyDeviceInfoList(DeviceInfoSet);
          LastRefresh := Now;
        end;
      end;

      USB_LIBUSB:
      begin
        { query usb devices list }
        if Assigned(libusb_get_device_list) then
        begin
          Count := libusb_get_device_list(Context, DevList);

          if (DevList <> nil) and (Count > 0) then
          begin
            SetLength(Devs, Count);
            SetLength(libusbDevs, Count);

            try
              for i := 0 to (Count -1) do
              begin
                Devs[i] := Plibusb_device(PPlibusb_device_array(DevList)^[i]);
                libusbDevs[i] := Default(Tlibusb_device);
                GetDevicePath(Devs[i], @libusbDevs[i]);
                libusb_get_device_descriptor(Devs[i], @libusbDevs[i].Descriptor);
                //L := libusb_open(PPlibusb_device_array(DevList)^[i], libusbDevs[i].Handle);
              end;
            finally
              libusb_free_device_list(DevList, 1);
            end;
          end;
        end;

        LastRefresh := Now;
      end;
    end;

    { copy it over for safer access if anything? }
    if High(LDevices) < 0 then Exit;

    EnterCriticalSection(CriticalSection);
    try
      SetLength(Devices, Length(LDevices));
      for L := Low(Devices) to High(Devices) do
      begin
        Devices[L].DeviceInfoSet := LDevices[L].DeviceInfoSet;
        Devices[L].DeviceInfoData := LDevices[L].DeviceInfoData;
        Devices[L].DeviceDesc := LDevices[L].DeviceDesc;
        Devices[L].DeviceId := LDevices[L].DeviceId;
        Devices[L].PropertyRegDataType := LDevices[L].PropertyRegDataType;
      end;
    finally
      LeaveCriticalSection(CriticalSection);
    end;
  finally
    Busy := False;
  end;
end;

procedure TUSBDeviceManagerEx.Test;
var
  Devs: TArray<Plibusb_device>;
  DevList: PPlibusb_device;
  Count, I: Integer;
begin
  Count := libusb_get_device_list(Context, DevList);

  if (DevList <> nil) and (Count > 0) then
  begin
    SetLength(Devs, Count);

    try
      for i := 0 to (Count -1) do
      begin
        Devs[i] := Plibusb_device(PPointerArray(DevList)^[i]);
      end;
    finally
      libusb_free_device_list(DevList, 1);
    end;
  end;
end;

procedure TUSBDeviceManagerEx.ReportException(const E: Exception);
begin
  if not Assigned(EventCallback) then Exit;
  { PackException(E, GetLastError,  ); }

  try
    with Event do
    begin
      Code := ErrorCode;
      Reason := etAppException;
      Msg := (E.Message);
      Overwrite := False;
    end;
  finally
    EventCallback(@Event);
  end;
end;

function TUSBDeviceManagerEx.ResetDevice(USB: PUSBDevice; out ConfigRet: DWORD; ParentLevels: Integer; DelayMs: Cardinal): Boolean;
var
  DevInst: DWORD;
  ParentInst: DWORD;
  I: Integer;
begin
  Result := False;
  ConfigRet := $FFFFFFFF;
  if Usb = nil then
    Exit;
  DevInst := Usb^.DeviceInfoData.DevInst;
  if ParentLevels < 0 then
    ParentLevels := 0;
  for I := 1 to ParentLevels do
  begin
    ConfigRet := CM_Get_Parent(ParentInst, DevInst, 0);
    if ConfigRet <> CFG_CR_SUCCESS then
      Exit;
    DevInst := ParentInst;
  end;
  ConfigRet := CM_Disable_DevNode(DevInst, CFG_CM_DISABLE_UI_NOT_OK);
  if ConfigRet <> CFG_CR_SUCCESS then
    Exit;
  Sleep(DelayMs);
  ConfigRet := CM_Enable_DevNode(DevInst, 0);
  if ConfigRet <> CFG_CR_SUCCESS then
    Exit;
  Result := True;
end;

procedure TUSBDeviceManagerEx.ResetDevice(const VID, PID: Integer);
var
  i: Integer;
begin
  if High(libusbDevs) < 0 then Exit;

  for i := Low(libusbDevs) to High(libusbDevs) do
  begin
    if (libusbDevs[i].Descriptor.VendorID <> VID) or (libusbDevs[i].Descriptor.ProductID <> PID) then
      continue;

    { attempt a fix! }
    if (libusbDevs[i].Handle = nil) then
      libusbDevs[i].Handle := libusb_open_device_with_vid_pid(Context, VID, PID);

    if Assigned(libusbDevs[i].Handle) then libusb_reset_device(libusbDevs[i].Handle)
    else HandleEvent('invalid (nil) handle!'#13#10);
    break;
  end;
end;

procedure TUSBDeviceManagerEx.HandleEvent(const M: String; ErrCode: Cardinal;
  const Reason: TAppEventType);
begin
  if not Assigned(EventCallback) then Exit;

  try
    with Event do
    begin
      Code := ErrCode;
      Event.Reason := Reason;
      Msg := (M);
      Overwrite := False;
    end;
  finally
    EventCallback(@Event);
  end;
end;

{ TThreadPoolEx }
constructor TThreadPoolEx.Create(Size: Word);
var
  i: Integer;
begin
  try
    { <mutex> race condition prevention }
    Lock := TCriticalSection.Create;

    { init. queue }
    TaskQueue := TQueue<TTaskItem>.Create;
    TaskQueue.Capacity := 50;
    TaskQueue.Clear;

    { init. thread-pool }
    ThreadCount := Size;
    SetLength(Threads, Size);
    for i := Low(Threads) to High(Threads) do
      Threads[i] := TTaskWrapper.Create(TaskHandler, i,
        format('task-handle (%2.2d)', [i +1]));

    { termination, event : defaults }
    Terminated := False;
    TaskExitCount := 0;
    TerminateEvent := TEvent.Create(nil, True, False, 'pool-termination');
    Randomize;
  finally
    PoolReady := True;
  end;
end;

destructor TThreadPoolEx.Destroy;
begin
  { ensure all threads exited }
  TerminateTasks;
  { tasks::queue }
  TaskQueue.Clear;
  FreeAndNil(TaskQueue);
  { critical-section }
  FreeAndNil(Lock);
  inherited;
end;

procedure TThreadPoolEx.TaskHandler(Id: Integer; Alias : String);
var
  Task: TTaskItem;
  GotLock : Boolean;
begin
  { pace! }
  Sleep(RandomRange(10, 25));

  { try acquire lock! }
  GotLock := Lock.TryEnter;

  try
    { check LOCK }
    if GotLock then
    begin
      { check QUEUE }
      if (QueueCount > 0) then
      begin
        { get next task }
        Task := TaskQueue.Dequeue;
        { clear lock flag }
        GotLock := False;
        { release lock asap }
        Lock.Release;
        { what itask did it?! }
        Task.Info.Id := Id;
        Task.Info.Alias := Alias;
        Task.Info.Exec.WaitTime := (GetTickCountEx -Task.Info.Exec.WaitTime);
        { go run the task }
        Run(@Task);
      end
      else Yield;
    end;
  finally
    { in case of failed lock-acquire }
    if GotLock then Lock.Release;
  end;
  { spin-wait }
  Sleep(1);

  { exit! }
  if Terminated then
  begin
    { wait some }
    Sleep(RandomRange(50, 250));
    { get! }
    SignalTaskExit;
  end;
end;

procedure TThreadPoolEx.Run(TaskPtr: PTaskItem);
var
  T0 : UInt64;
begin
  { validate }
  if TaskPtr = nil then Exit;

  { start timer }
  T0 := GetTickCountEx;

  try
    { @task-starting... }
    TaskPtr^.Info.Exec.Status := TTaskStatus.Running;
    if Assigned(StartCallback) then StartCallback(TaskPtr^.Info);
    try
      try
        { go execute task(s) with params }
        if Assigned(TaskPtr^.TaskWithParams) then
          TaskPtr^.TaskWithParams(TaskPtr^.Params)
        { without parameters }
        else if Assigned(TaskPtr^.TaskWithoutParams) then TaskPtr^.TaskWithoutParams();
      finally
        { calculate runtime }
        TaskPtr^.Info.Exec.RunTime := (GetTickCountEx -T0);
      end;

    finally
      if Assigned(CompleteCallback) then
        CompleteCallback(TaskPtr^.Info);

      { reset }
      TaskPtr^ := Default(TTaskItem);
    end;

  except
    On E: Exception do
    begin
      TaskPtr^.Info.Exec.Status := TTaskStatus.Exception;
      if Assigned(FailCallback) then FailCallback(TaskPtr^.Info);
      if Assigned(ExceptionCallback) then ExceptionCallback(E);
    end;
  end;
end;

procedure TThreadPoolEx.SignalTaskExit;
begin
  { increment exit counter! }
  AtomicExchange(TaskExitCount, TaskExitCount +1);

  { attempt to set event }
  if TaskExitCount >= ThreadCount then
    TerminateEvent.SetEvent;
end;

procedure TThreadPoolEx.TerminateTasks;
var
  i: Integer;
begin
  { terminate }
  Terminated := True;
  { wait for all }
  TerminateEvent.WaitFor(INFINITE);
  { clean all }
  for i := Low(Threads) to High(Threads) do FreeAndNil(Threads[i]);
  FreeAndNil(TerminateEvent);
end;

procedure TThreadPoolEx.QueueTask(const Task: TTaskWithoutParams);
var
  TaskItem: TTaskItem;
begin
  { reset }
  TaskItem := Default(TTaskItem);
  { initialize }
  TaskItem.TaskWithoutParams := Task;
  SetLength(TaskItem.Params, 0);

  { submit this task to queue }
  QueueTask(@TaskItem);
end;

procedure TThreadPoolEx.QueueTask(const Task: TTaskWithParams; const Args: TArray<TVarRec>);
var
  TaskItem : TTaskItem;
  I : Integer;
begin
  { reset }
  TaskItem := Default(TTaskItem);
  { initialize }
  TaskItem.TaskWithParams := Task;
  SetLength(TaskItem.Params, Length(Args));

  { sort argument list }
  for I := Low(Args) to High(Args) do TaskItem.Params[I] := Args[I];

  { submit this task to queue }
  QueueTask(@TaskItem);
end;

procedure TThreadPoolEx.QueueTask(Task: TTaskItem);
begin
  { update status to waiting... }
  Task.Info.Exec.Status := TTaskStatus.WaitingToRun;
  QueueTask(@Task);
end;

procedure TThreadPoolEx.QueueTask(Task: PTaskItem);
begin
  { gate-keep! }
  if Task = nil then Exit;

  { insert in queue }
  Lock.Acquire;
  try
    { time at queue }
    Task^.Info.Exec.WaitTime := GetTickCountEx;
    TaskQueue.Enqueue(Task^);
  finally
    Lock.Release;
  end;
end;

function TThreadPoolEx.QueueCount: Integer;
begin
  Result := TaskQueue.Count;
end;

{ TBinFileWriter }
procedure TBinFileWriterEx.Close;
begin
  if FHandle <> INVALID_HANDLE_VALUE then
  begin
    FileClose(FHandle);
    FHandle := INVALID_HANDLE_VALUE;
  end;
end;

constructor TBinFileWriterEx.Create(const path : String; const Rights : Word; Locked: Boolean);
begin
  {create a new file}
  FHandle := FileCreate(path, Rights);
  {check valid handle}
  FReady := FHandle <> INVALID_HANDLE_VALUE;
  { lock it? prevents deletion, until released! }
  if Locked then LockFile(FHandle, 0, 0, $FFFFFFFF, $FFFFFFFF);
end;

destructor TBinFileWriterEx.Destroy;
begin
  Close;
  inherited;
end;

function TBinFileWriterEx.Write(var Buf; const Size: UInt64): UInt64;
begin
  if not Ready then Exit(0);
  Result := FileWrite(FHandle, Buf, Size);
end;

function TBinFileWriterEx.Write(Buf: Pointer; Size: UInt64): UInt64;
begin
  if not Ready then Exit(0);
  Result := FileWrite(FHandle, Buf, Size);
end;

function TBinFileWriterEx.WriteHeader(var Buf; const Size: UInt64): UInt64;
begin
  FileSeek(FHandle, 0, soFromBeginning);
  try
    Result := FileWrite(FHandle, Buf, Size);
  finally
    FileSeek(FHandle, 0, soFromEnd);
  end;
end;

{ TBinFileWriterEx }
constructor TBinFileReaderEx.Create(const path : String);
var
  p : String;
begin
  { clean path}
  p := Trim(Path);

  if FileExists(P) then
  begin
    {create a new file}
    FHandle := FileOpen(P, fmOpenRead);
    {check valid handle}
    FReady := FHandle <> INVALID_HANDLE_VALUE;
  end;
end;

function TBinFileReaderEx.Read(var Buf; const Size: Word): Integer;
begin
  Result := 0;
  if not FReady then Exit;
  Result := FileRead(FHandle, Buf, Size);
end;

function TBinFileReaderEx.Read(Buf: Pointer; Size: Word): Integer;
begin
  Result := 0;
  if not FReady then Exit;
  FileRead(FHandle, Buf, Size);
end;

procedure TBinFileReaderEx.Seek(const Pos: Int64);
begin
  if not FReady then Exit;
  SetFilePointerEx(FHandle, Pos, nil, FILE_BEGIN);
end;

procedure TBinFileReaderEx.Close;
begin
  if not FReady then Exit;
  FReady := false;
  FileClose(FHandle);
end;

destructor TBinFileReaderEx.Destroy;
begin
  inherited;
  if FReady then Close;
end;

procedure TBinFileReaderEx.GetHeader(var Buf; const Size: Integer);
var
  LastPos: integer;
begin
  if (Size = 0) then Exit;

  LastPos := FileSeek(FHandle, 0, soFromCurrent);

  try
    FileSeek(FHandle, 0, soFromBeginning);
    FileRead(FHandle, Buf, Size);
  finally
    if LastPos > 0 then
      FileSeek(FHandle, LastPos, soFromBeginning);
  end;
end;

{ TBinFileReader }

procedure TBinFileReader.Close;
begin
  if FActive then
  begin
    FStream.Free;
    FActive := false;
  end;
end;

constructor TBinFileReader.Create(const f: String; const mode: Word; MinSize: Integer);
begin
  if not FileExists(f) then Exit;
  
  FStream := TFileStream.Create(f, mode);
  if FStream <> nil then
  begin
    FActive := true;
    FSize := FStream.Size;
    FStream.Seek(0, SoFromBeginning);
    RSize := MinSize;
    BSize := MinSize;

    if MinSize > 0  then FActive := FSize >= MinSize
    else BSize := $FFFF;
  end;
end;

destructor TBinFileReader.Destroy;
begin
  Close;
  inherited;
end;

function TBinFileReader.FHasNext: Boolean;
begin
  if BSize = $FFFF then
    Result := FStream.Position < FSize
  else
    Result := (FSize - FStream.Position) >= BSize;
end;

function TBinFileReader.Read(var Buf; Size: Integer) : Integer;
begin
  if not FActive then Exit(-1);
  Result := FStream.Read(Buf, size);
end;

function TBinFileReader.GetNext(Data: Pointer): byte;
begin
  Result := 1;
  if not FActive then Exit;
  if BSize = $FFFF then
    BSize := SizeOf(Data^);
  if not StreamHasNext(BSize) then Exit;
  if FStream.Read(Data^, BSize) <> 0 then
    Result := 0;
end;

function TBinFileReader.GetNext(Data: Pointer; Sz: SmallInt): byte;
begin
  Result := 1;
  if not FActive then Exit;
  if not StreamHasNext(Sz) then Exit;
  if FStream.Read(Data^, Sz) <> 0 then
    Result := 0;
end;

function TBinFileReader.GetNext(Data: Pointer; var RecNum: Integer): byte;
begin
  {Be-Careful, make sure to change RSize before calling this to read a size
   not same as previous read, other-wise may give you unexpected block with
   a 0 result}
  Result := 1;
  if not FActive then Exit;
  if BSize = $FFFF then
    BSize := SizeOf(Data^);

  if FStream.Read(Data^, BSize) <> 0 then
  begin
    Inc(RecNum);
    Result := 0;
  end;
end;

function TBinFileReader.GetNext(Data: Pointer; const Size: Word;
  var RecNum: Integer): byte;
begin
  Result := 1;
  if not FActive then Exit;
  if not StreamHasNext then Exit;
  if FStream.Read(Data^, Size) <> 0 then
  begin
    Inc(RecNum);
    Result := 0;
  end;
end;

function TBinFileReader.Size: UInt64;
begin
  Result := IntTernary(FActive and (FStream <> nil), FStream.Size, 0);
end;

function TBinFileReader.StreamHasNext(const BlkSz : Word = 0) : Boolean;
begin
  if not FActive then Exit(False);
  if BlkSz <> 0 then Result := FStream.Position < FSize
  else Result := (FSize - FStream.Position) >= BlkSz;
end;

function FileExistsLongFileNames(const FileName: WideString): Boolean;
begin
  if Length(FileName) < 2 then
  begin
    Result := False;
    Exit;
  end;
  if CompareMem(@FileName[1], @WideString('\\')[1], 2) then
    Result := (GetFileAttributesW(PWideChar(FileName)) and FILE_ATTRIBUTE_DIRECTORY = 0)
  else
    Result := (GetFileAttributesW(PWideChar(WideString('\\?\' + FileName))) and FILE_ATTRIBUTE_DIRECTORY = 0)
end;

{ TMappedFile }
constructor TMappedFile.Create(const AFileName: WideString);
begin
  inherited Create;
  if FileExistsLongFileNames(AFileName) then
    MapFile(AFileName)
  else
    raise Exception.Create('File "' + AFileName + '" does not exists.');
end;

destructor TMappedFile.Destroy;
begin
  if Assigned(FContent) then
  begin
    UnmapViewOfFile(FContent);
    CloseHandle(FMapping);
  end;
  inherited;
end;

procedure TMappedFile.MapFile(const AFileName: WideString);
var
  FileHandle: THandle;
begin
  if CompareMem(@(AFileName[1]), @('\\'[1]), 2) then
    { Allready an UNC path }
    FileHandle := CreateFileW(PWideChar(AFileName), GENERIC_READ, FILE_SHARE_READ or
      FILE_SHARE_WRITE, nil, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
  else
    FileHandle := CreateFileW(PWideChar(WideString('\\?\' + AFileName)), GENERIC_READ, FILE_SHARE_READ or
      FILE_SHARE_WRITE, nil, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0);
  if FileHandle <> 0 then
  try
    FSize := Windows.GetFileSize(FileHandle, nil);
    if FSize <> 0 then
    begin
      FMapping := CreateFileMappingW(FileHandle, nil, PAGE_READONLY, 0, 0, nil);
      //Win32Check(FMapping <> 0);
    end;
  finally
    CloseHandle(FileHandle);
  end;
  if FSize = 0 then
    FContent := nil
  else
    FContent := MapViewOfFile(FMapping, FILE_MAP_READ, 0, 0, 0);
  //Win32Check(FContent <> nil);
end;

