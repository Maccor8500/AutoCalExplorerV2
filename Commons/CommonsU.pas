procedure GetLocalPaths(Paths : PLocalPaths);
var
  S, SysName: String;
  IniFile: TMemIniFile;
begin
  with Paths^ do
  begin
    { user document path }
    Document := GetDocumentPath;
    { drive }
    LocalDrive := ShortString(ExtractFileDrive(Document));
    { application path }
    MaccorAppBase := GetEnvironmentVariable('ProgramW6432') +'\Maccor';
    { config path }
    MaccorCfgBase := GetEnvironmentVariable('LOCALAPPDATA') + '\Maccor';
    MaccorProfile := format('%s\ActiveProfile.ini', [MaccorCfgBase]);

    if FileExists(MaccorProfile) then
    begin
      IniFile := TMemIniFile.Create(MaccorProfile);
      if Assigned(IniFile) then
      begin
        with IniFile do
        begin
          try
            S := 'Maccor';
            SysName := ReadString(S, 'SystemID', '');

            { ... }
          finally
            Free;
          end;
        end;
      end;
    end;

    MaccorSysConfig := format('%s\%s', [MaccorCfgBase, SysName]);
    MaccorSysIni := format('%s\%s\SystemSettings.ini', [MaccorCfgBase, SysName]);
    { maccor data }
    MaccorDataBase := format('%s\Maccor Data\%s', [String(LocalDrive), SysName]);
  end;
end;

