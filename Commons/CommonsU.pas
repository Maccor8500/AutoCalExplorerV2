procedure AbortMacTest32(Form: TForm; Force: Boolean);
var
  Id: Cardinal;
begin
  if not ProcessExists('MacTest32.exe', Id, 1) then Exit;

  if not Force then
  begin
    repeat
      ShowDialog(Form, dtWarning, 'Please exit MacTest32'#13#10'Then click "OK" button to continue', [mbOK], '[warning] MacTest32!');
