{Image processing... 11:48 5/4/2019}
procedure NEF_ToJPEG(const nef : string; var jpg : TJPEGImage);
var
  raw : TWICImage;
  bmp : TBitmap;
begin

  raw := TWICImage.Create;
  try
    raw.LoadFromFile(nef);
    raw.ImageFormat := wifOther;
    if raw.Empty then Exit;

    bmp := TBitmap.Create;
    try
      bmp.Assign(raw);

      if jpg = nil then
        jpg := TJPEGImage.Create;
      jpg.Assign(bmp);

    finally
      bmp.Free;
    end;
  finally
    raw.Free;
  end;
end;

procedure ResizeJPG(const jpeg : string; const by, qual : byte; var jpg : TJPEGImage);
var
  bmp: TBitmap;
begin
  if jpg = nil then
    jpg := TJpegImage.Create;

  try
    jpg.LoadFromFile(jpeg);
    bmp := TBitmap.Create;

    bmp.Width := Round(jpg.Width * by /100);
    bmp.Height:= Round(jpg.Height * by /100);
    jpg.CompressionQuality := qual;
    jpg.Assign(bmp);
  finally
  end;
end;

procedure ColorIntToRGB(const Color: Integer; out R, G, B: Byte);
begin
  R := Color and $FF;
  G := (Color shr 8) and $FF;
  B := (Color shr 16) and $FF;
end;

function RGBToColorInt(const R, G, B: Byte): Integer;
begin
  Result := R or (G shl 8) or (B shl 16);
end;

function LightenColor(Color: TColor; Factor: Double): TColor;
var
  R, G, B: Byte;
begin
  Color := ColorToRGB(Color);
  R := GetRValue(Color);
  G := GetGValue(Color);
  B := GetBValue(Color);

  R := Round(R + (255 - R) * Factor);
  G := Round(G + (255 - G) * Factor);
  B := Round(B + (255 - B) * Factor);

  Result := RGB(R, G, B);
end;

function DarkenColor(Color: TColor; Factor: Double): TColor;
var
  R, G, B: Byte;
begin
  Color := ColorToRGB(Color);
  R := GetRValue(Color);
  G := GetGValue(Color);
  B := GetBValue(Color);

  R := Round(R * (1 - Factor));
  G := Round(G * (1 - Factor));
  B := Round(B * (1 - Factor));

  Result := RGB(R, G, B);
end;


