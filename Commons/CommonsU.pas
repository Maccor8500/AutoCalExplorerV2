function TUdpSocketEx.SetReceiveBuffer(Buffer: PByte; const Size: Integer): Boolean;
var
  T: UInt64;
begin
  Result := False;
  WSAEventSelect(Sock, WSAEvent, 0);
  T := GetTickCountEx(50);
  while (SocketActive) or (GetTickCountEx < T) do;

  try
    AltBufferSize := Size;
    AltRxBuffer := (Size > 0) and (Size > 0) and (Buffer <> nil);
    if not AltRxBuffer then Exit;

    AltBufferPtr := Buffer;
    Fill(AltBufferPtr, 0, AltBufferSize);
    Result := AltRxBuffer;
  finally
    WSAEventSelect(Sock, WSAEvent, SocketEventFlags);
  end;
end;

procedure TUdpSocketEx.EnableSynchronization(BaseThread : Pointer = nil; SyncOption: TSyncType = stSyncronize);
var
  T: UInt64;
begin
  if SyncType = stAsync then Exit;
  
  WSAEventSelect(Sock, WSAEvent, 0);
  T := GetTickCountEx(50);
  while (SocketActive) or (GetTickCountEx < T) do;

  try
    SyncType := SyncOption;
    UseSync := True;
    SyncThread := BaseThread;
  finally
    WSAEventSelect(Sock, WSAEvent, SocketEventFlags);
  end;
end;

