begin

end;

procedure TDataFilter.Update(const Datapoint: PWord; Index: PInteger);
begin
  if (Datapoint = nil) then Exit;

  { handle to data }
  WordPtr := Datapoint;

  { apply filter! }
  case TFilterType(Filter.InUse) of
    MovingAvgFilter: MovingAverage;
    ExpMovingAvgFilter: ExpMovingAverage;
    SavitzkyGolayFilter: SavitzkyGolay;
  end;

  { if caller wants current index }
  if Assigned(Index) then Index^ := FIndex;
end;

