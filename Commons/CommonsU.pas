  Result := False;
  if Length(MacSysPtr^.ChanDataBackup) = 0 then Exit;

  try
    if FileExists(MacSysPtr^.ChCfgFile) then
    begin
      var Data: TBytes := GetFileBytes(MacSysPtr^.ChCfgFile);
      Result := not CompareMem(@MacSysPtr^.ChanDataBackup[0], Data, Length(Data));
