function PingChecksum(buf: PWord; len: Integer) : Word;
var
  sum: Cardinal;
  oddbyte: Word;
begin
  sum := 0;

  while len > 1 do
  begin
    Inc(sum, buf^);
    Inc(buf);
    Dec(len, 2);
  end;

  if len = 1 then
  begin
    oddbyte := 0;
    PByte(@oddbyte)^ := PByte(buf)^;
    Inc(sum, oddbyte);
  end;

  sum := (sum shr 16) + (sum and $FFFF);
  sum := sum + (sum shr 16);
  Result := not Word(sum);
end;

{ untested! }
function PingEx(const Addr: String; Timeout: UInt32) : Boolean;
const
  ICMP_MAX_PAYLOAD = 64;
  ICMP_ECHOREPLY = 0;
  ICMP_ECHO = 8;
var
  dest: sockaddr_in;
  addr_len : Integer;
  buf: array[0..ICMP_MAX_PAYLOAD - 1] of Byte;
  rx_len: ssize_t;
  icmp_sock: TSocket;
  addrAnsi: AnsiString;
  T0: Cardinal;

  icmp_hdr: TICMPHeader;
  icmp_resp : PICMPHeader;
begin
  icmp_resp := nil;

  if Length(addr) <= 0 then Exit(False);
  addrAnsi := AnsiString(addr);

  icmp_sock := Winsock2.socket(AF_INET, SOCK_RAW, IPPROTO_ICMP);
  try
    if icmp_sock = INVALID_SOCKET then
      Exit(False);

    dest.sin_family := AF_INET;
    dest.sin_port := htons(0);
    dest.sin_addr.s_addr := inet_addr(PAnsiChar(addrAnsi));

    FillChar(icmp_hdr, SizeOf(TICMPHeader), 0);
    icmp_hdr.icmp_type := 8;
    icmp_hdr.icmp_code := 0;
    icmp_hdr.icmp_id := GetCurrentProcessId;
    icmp_hdr.icmp_seq := 1;
    icmp_hdr.icmp_cksum := PingChecksum(PWord(@icmp_hdr), SizeOf(TICMPHeader));

    Winsock2.sendto(icmp_sock, icmp_hdr, SizeOf(TICMPHeader), 0, @dest, SizeOf(dest));

    T0 := GetTickCountEx;
    addr_len := sizeof(dest);

    repeat
      rx_len := recvfrom(icmp_sock, buf, Length(buf), {MSG_DONTWAIT} 40, Winsock2.sockaddr(dest), addr_len);
      Sleep(50);
    until (rx_len <= 0) or ((GetTickCount -T0) >= Timeout);

    { DEBUG }
    Result := ((rx_len > 0) and (icmp_resp^.icmp_type in [ICMP_ECHO, ICMP_ECHOREPLY]));
  finally
    closesocket(icmp_sock);
  end;
end;

