  FillChar(SHFileOpStruct, SizeOf(SHFileOpStruct), 0);
  SHFileOpStruct.Wnd := 0;
  SHFileOpStruct.wFunc := FO_DELETE;
  SHFileOpStruct.pFrom := PChar(RecycleBinFolder + #0#0);
  SHFileOpStruct.pTo := nil;
