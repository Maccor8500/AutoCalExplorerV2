function LegacyAuxTypeToMaccorAuxType(const Legacy: TMaccorLegacyAuxPanel): TMaccorAuxType;
begin
  {
    explicit map :: ordinals 4 and 6 differ between the two enums, and the
    legacy 7..9 have no equivalent at all — a hard cast would misread them!
    <Therm_T and the 8500-IGBT part are thermistor families; smart-battery
    is a digital device with no analog cal path :: unused here>
  }
  case Legacy of
    laVoltage:          Result := maVoltage;
    laThermocouple:     Result := maThermocouple;
    laThermistor:       Result := maThermistor;
    laPressure:         Result := maPressure;
    laResistance:       Result := maResistance;
    laTherm_T:          Result := maThermistor;
    laIGBT8500Thermi:   Result := maThermistor;

    { laUnused, laUnusedSpare, laSmartBattery }
    else Result := maUnused;
  end;
end;

