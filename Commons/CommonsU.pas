{$REGION ' TUtils '}
class procedure TUtils.FillArray<T>(var Arr: array of T; const Value: T);
var
  i: Integer;
begin
  for i := 0 to High(Arr) do Arr[i] := Value;
end;

class procedure TUtils.AddErrorStr(const NewErrStr: String; var BaseErrStr: String; EnableCounter: Boolean);
var
  ErrCnt: SmallInt;
begin
  if BaseErrStr = '' then ErrCnt := 1
  else ErrCnt := Length(Trim(BaseErrStr).Split([#13#10])) +1;

  if Trim(BaseErrStr) <> '' then BaseErrStr := format('%s%d. %s'#13#10, [BaseErrStr, ErrCnt, NewErrStr])
  else BaseErrStr := format('%d. %s'#13#10, [ErrCnt, NewErrStr]);
end;

class procedure TUtils.AppendArray<T>(const Item: T; var Target: TArray<T>);
begin
  Target := Target +[Item];
end;

class function TUtils.AddressOf(const Ptr: Pointer): String;
begin
  Result := StrTernary(Assigned(Ptr), format('$%p', [Ptr]), 'Invalid Pointer');
end;

class procedure TUtils.AppendArray<T>(const Item: T; var Target: TArray<T>; var Count: Integer; EndValue: Integer);
begin
  if (Count < 0) or (Count > Length(Target)) then
    raise Exception.Create('AppendArray: Count out of range');

  if Count = Length(Target) then SetLength(Target, Math.Max(Count *2, 512));
  Target[Count] := Item;
  Inc(Count);

  if (EndValue <> INVALID_TOKEN) and(Count = EndValue) then
    SetLength(Target, Count);
end;

class procedure TUtils.AppendArray<T>(const Items: array of T; var Target: TArray<T>; AllowDuplicate: Boolean);
var
  Item, Offset: Integer;
begin
  Offset := Length(Target);
  SetLength(Target, Offset +Length(Items));

  { the DEFAULT :: it is an array — duplicates append unless the caller opts out }
  if AllowDuplicate then
  begin
    for Item := 0 to High(Items) do Target[Offset +Item] := Items[Item];
    Exit;
  end;

  {
    duplicate-free append :: T has no '=' — equality comes from the type's
    default comparer. the scan runs to Kept, not Offset, so duplicates
    WITHIN Items are skipped too, then the final size is what survived.
  }
  var Comparer: IEqualityComparer<T> := TEqualityComparer<T>.Default;
  var Kept: Integer := Offset;
  for Item := 0 to High(Items) do
  begin
    var Exists: Boolean := False;
    for var Scan: Integer := 0 to Kept -1 do
    begin
      Exists := Comparer.Equals(Target[Scan], Items[Item]);
      if Exists then break;
    end;

    if Exists then Continue;
    Target[Kept] := Items[Item];
    Inc(Kept);
  end;

  if Kept <> Length(Target) then SetLength(Target, Kept);
end;

class procedure TUtils.AppendShortString(var Str: array of AnsiChar; const Value: Integer; Separator: String);
begin
  var Data: AnsiString := AnsiString(Str);
  if Length(Data) = Length(Str) -1 then  Exit;

  if Separator <> '' then
  begin
    if Data <> '' then Data := Data +AnsiString(Separator) +' ' +AnsiString(IntToStr(Value))
    else Data := AnsiString(IntToStr(Value));
  end
  else Data := Data +AnsiString(IntToStr(Value));

  UnpackAnsiStr(Data, Str);
end;

class function TUtils.Average<T>(const Data: TArray<T>; Len: Integer): Double;
begin
  var ActualLen: Integer := IntTernary((Len <> 0), Len, Length(Data));
  Result := Sum(Data, ActualLen) /ActualLen;
end;

class function TUtils.Average<T>(const Data: array of T; Len: Integer): Double;
begin
  Result := Sum(Data, Len) /Len;
end;

class function TUtils.GetString(const Arr: array of AnsiChar): String;
var
  S: AnsiString;
  L: Integer;
begin
  Result := '';
  S := AnsiString(Arr);
  L := Length(S);
  if (L = 0)  or (L > Length(Arr)) or (S = '') then Exit;
  Result := String(S);
end;

class function TUtils.GetStrLength(const Str: PAnsiChar): Byte;
var
  S: TAdvShortString;
begin
  S.Clear;
  S.Update(AnsiString(Str));
  Result := S.Len;
end;

class procedure TUtils.SetToArray(const S: TByteSet; var Arr: TArray<Byte>);
var
  I: Integer;
  L: Integer;
begin
  L := 0;
  SetLength(Arr, 0);

  for I := 0 to MAXBYTE do
    if I in S then
    begin
      SetLength(Arr, L + 1);
      Arr[L] := I;
      Inc(L);
    end;
end;

class procedure TUtils.GetSetItem(const S: TByteSet; const Index: Byte; var Item: SmallInt);
begin
  Item := -1;
  var SetArr: TArray<Byte>;
  SetToArray(S, SetArr);

  if Index > High(SetArr) then Exit;
  Item := SetArr[Index];
end;

class procedure TUtils.CommaSeparatedString(var Str: String; const AStr: String);
begin
  if (AStr = '') then Exit;
  if Str = '' then Str := AStr
  else Str := Str +', ' +AStr;
end;

class function TUtils.CountSet(const S: TByteSet): Byte;
begin
  var SetArr: TArray<Byte>;
  SetToArray(S, SetArr);
  Result := Length(SetArr);
end;

class function TUtils.CountSet<T>(const S: T): Integer;
var
  PSet: PByte;
  I, j: Integer;
  ByteValue: Byte;
  SetSize: Integer;
begin
  Result := 0;
  PSet := @S;
  SetSize := SizeOf(T);
  for I := 0 to SetSize -1 do
  begin
    ByteValue := PSet^;
    for J := 0 to 7 do
      if (ByteValue and (1 shl J)) <> 0 then
        Inc(Result);
    Inc(PSet);
  end;
end;

class procedure TUtils.DumpEthernetFrame(const Buffer: PRawSocketBuffer; const Memo: TCustomMemo);
begin
  Memo.SelStart := Memo.GetTextLen;
  Memo.SelLength := 0;
  Memo.SelText := EthernetFrameToStr(Buffer);
end;

class procedure TUtils.EjectFromArray<T>(const Item: T; var Target: TArray<T>; const Sorted: Boolean);
var
  Index: Integer;
begin
  {
    O(log n) :: opt-in, valid ONLY while Target is ordered by
    TComparer<T>.Default <caller's promise — on an unsorted array binary
    search will silently miss items!>. with duplicates, ejects an arbitrary
    match, not necessarily the first.
  }
  if Sorted then
  begin
    if TArray.BinarySearch<T>(Target, Item, Index) then
      Delete(Target, Index, 1);
    Exit;
  end;

  {
    O(n) :: optimal for the general <unsorted> contract. eject the FIRST
    match only, order of the remainder is preserved
  }
  for var i: Integer := Low(Target) to High(Target) do
  begin
    if Equals<T>(Item, Target[i]) then
    begin
      Delete(Target, i, 1);
      Exit;
    end;
  end;
end;

{ by-index variant :: Target leads so calls stay unambiguous when T = Integer }
class procedure TUtils.EjectFromArray<T>(var Target: TArray<T>; const Index: Integer);
begin
  { out-of-range :: silent no-op, consistent with the by-item overload }
  if (Index < Low(Target)) or (Index > High(Target)) then Exit;
  Delete(Target, Index, 1);
end;

class function TUtils.EmptyArray<T>: TArray<T>;
begin
  Result := [];
end;

class procedure TUtils.Include<T>(var SetData: TByteSet; const Data: TArray<T>);
var
  Ordinal: Int64;
begin
  for var Item: T in Data do
  begin
    {
      ordinal of the item :: non-ordinal T <records, floats...> and values
      outside Byte <negative or > 255> collapse to 0 by contract
    }
    if not TValue.From<T>(Item).TryAsOrdinal(Ordinal) then Ordinal := 0;
    if (Ordinal < Low(Byte)) or (Ordinal > High(Byte)) then Ordinal := 0;

    { union form :: the Include intrinsic is shadowed by this method's name }
    SetData := SetData + [Byte(Ordinal)];
  end;
end;

class function TUtils.InitArray<T>(const Size: Integer): TArray<T>;
begin
  { Result may alias the caller's variable :: start from nil so SetLength zero-fills, which is Default(T) }
  Result := nil;
  SetLength(Result, Math.Max(0, Size));
end;

class procedure TUtils.Enable_Maccor_Environment;
begin
  {$define LOAD_MACCOR_CONFIG}
end;

class function TUtils.Equals<T>(const Left, Right: T): Boolean;
begin
  Result := TEqualityComparer<T>.Default.Equals(Left, Right);
end;

{ inclusive both ends, mirrors Math.InRange }
class function TUtils.InRange<T>(const Value, Min, Max: T): Boolean;
var
  Cmp: IComparer<T>;
begin
  Cmp := TComparer<T>.Default;
  Result := (Cmp.Compare(Value, Min) >= 0) and (Cmp.Compare(Value, Max) <= 0);
end;

class function TUtils.EthernetFrameToStr(const Buffer: PRawSocketBuffer): String;
begin
  Result := 'Bad Packet';
  if not (Assigned(Buffer)) then
    Exit;

  { deal with it! }
  try
    with Buffer^ do
    begin
      { print frame details }
      Result := format('ts: %s, size[frame: %d, payload: %d], Src: %s, Dest: %s'#13#10'[Data: 0x%s]'#13#10'%s'#13#10,
        [TimeStampToTimeStr(Header.TimeStamp), Header.CaptureLength,
          Payload.Size, AddrToStr(EtherHeader.Source), AddrToStr(EtherHeader.Destination),
            IntToHex(HTONS(EtherHeader.EthType), 4), ByteArrToStrFmt(Payload.Handle, Payload.Size, 16)]);
    end;
  except
    On E: Exception do
      Result := E.Message + #13#10;
  end;
end;

class function TUtils.GetLength(const Value: NativeInt): Byte;
var
  Str: String;
begin
  Result := $FF;

  if TryIntToStr(Value, Str) then
    Result := Length(Str);
end;

class procedure TUtils.GetSetItem<T>(const S: T; const Index: Byte; var Item: Byte);
var
  PSet: PByte;
  I, J: Integer;
  SetSize: Integer;
  ByteValue: Byte;
  CurrentIndex: Integer;
  BitPosition: Integer;
begin
  Item := 0;
  CurrentIndex := 0;
  PSet := @S;
  SetSize := SizeOf(T);
  for I := 0 to SetSize - 1 do
  begin
    ByteValue := PSet^;
    for J := 0 to 7 do
    begin
      if (ByteValue and (1 shl J)) <> 0 then
      begin
        if CurrentIndex = Index then
        begin
          BitPosition := (I * 8) + J;
          Item := BitPosition;
          break
        end;
        Inc(CurrentIndex);
      end;
    end;
    if Item > 0 then break;
    Inc(PSet);
  end;
end;

class function TUtils.GetSum(const Data: array of Word): Int64;
var
  Ptr: PWord;
  i: Integer;
begin
  Result := 0;
  if Length(Data) <= 0 then Exit;

  Ptr := @Data[0];

  for i := 0 to High(Data) do
  begin
    Inc(Result, Ptr^);
    Inc(Ptr);
  end;
end;

class procedure TUtils.HandleEvent(const EventId: TAppEventType; const EvtStr: String; const EvtCode: Integer; const EventHandler: TAppEventCallback; CheckConsumed: TEventStateCheck);
var
  ErrStr: String;
  Handler: TAppEventCallback;
  Code: Integer;
  Evt: TAppEvent;
begin
  if IgnoreEvents then Exit;

  if (Assigned(EventHandler)) then Handler := EventHandler
  else if Assigned(LocalEventHandler) then Handler := LocalEventHandler
  else Exit;

  {
    the event is a LOCAL :: it was a shared class var <LocalEvent> whose
    address we handed to the callback, which is the whole reason this routine
    used to need a spin lock AND a 50ms wait — the lock stopped a second
    producer overwriting the record mid-publish, and the wait hoped the
    consumer was done with our pointer before we reused it. neither is
    needed once the record lives on THIS call's stack: the pointer is valid
    for exactly the duration of the call, no producer can collide with
    another, and a nested emit gets its own frame instead of clobbering ours.
    every consumer already copies within the call <TEventForm serialises
    via WriteToBuffer, or takes PublishEvent's by-value parameter>, and
    TRawSocket.HandleEvent has always emitted this way — this makes the rule
    uniform instead of exceptional.
  }
  Evt := Default(TAppEvent);
  Evt.TimeStamp := Now;
  ErrStr := '';
  Code := EvtCode;

  {
    CONSUME BEFORE TRANSIT :: the caller's intent when it asks for
    esEnforceCheck — do not return until the event has actually been taken,
    so the log cannot lag behind the operation it describes.

    Urgent IS that mechanism :: it is the only one that delivers
    SYNCHRONOUSLY <TEventForm.HandleEvent publishes an urgent event under
    TThread.Synchronize instead of queueing a copy>. the Consumed flag and
    this parameter were a SECOND design for the same idea and were never
    wired — and Consumed cannot serve the queued path at all, because that
    path serialises the event into a BUFFER, leaving the producer nothing to
    observe. so the two ideas collapse into this one line.

    the default stays esIgnoreCheck, so every existing call is unchanged.
  }
  Evt.Urgent := (CheckConsumed = esEnforceCheck);

  case EventId of
    etAppException:
    begin
      Code := IntTernary(EvtCode <> 0, EvtCode, GetLastError);
      {
        translate the code we just RESOLVED :: this read Evt.Code, which is
        still 0 here <the record was just defaulted and Code lands below>, so
        every exception event described error 0 — "the operation completed
        successfully" — instead of the real GetLastError.
      }
      TranslateErrorCode(Code, ErrStr);
    end;
  end;

  Evt.Reason := EventId;
  Evt.Code := Code;
  if (ErrStr <> '') then Evt.Msg := format('%s'#13#10'%s'#13#10, [EvtStr, ErrStr])
  else Evt.Msg := EvtStr;

  { no wait :: the pointer dies with this frame, and the consumer has already
    taken its copy. see the local-record note above. }
  Handler(@Evt);
end;

class procedure TUtils.QuickEvent(const EventId: TAppEventType; const EvtStr: String; const EvtCode: Integer; const EventHandler: TAppEventCallback);
var
  ErrStr: String;
  Handler: TAppEventCallback;
  Code: Integer;
  Evt: TAppEvent;
begin
  if IgnoreEvents then Exit;
  if (Assigned(EventHandler)) then Handler := EventHandler
  else if Assigned(LocalEventHandler) then Handler := LocalEventHandler
  else Exit;

  { LOCAL, for the reasons spelled out in HandleEvent :: no shared record, so
    no lock and no wait. Urgent is this routine's whole point — QuickEvent
    means "publish it before I continue", which is delivered synchronously. }
  Evt := Default(TAppEvent);
  Evt.TimeStamp := Now;
  ErrStr := '';
  Code := EvtCode;
  Evt.Urgent := True;

  case EventId of
    etAppException:
    begin
      Code := IntTernary(EvtCode <> 0, EvtCode, GetLastError);
      { the RESOLVED code, not the record's still-zero field — see HandleEvent }
      TranslateErrorCode(Code, ErrStr);
    end;
  end;

  Evt.Reason := EventId;
  Evt.Code := Code;
  if (ErrStr <> '') then Evt.Msg := format('%s'#13#10'%s'#13#10, [EvtStr, ErrStr])
  else Evt.Msg := EvtStr;

  Handler(@Evt);
end;

{ frames pre-formatted art between full-width rules as a single event. the
  stamped first line stays empty; rules and art are all continuation lines so
  they share one hanging indent. non-ANSI art needs the memo font on
  DEFAULT_CHARSET or fallback glyph widths break columns. art < RULE_W }
class procedure TUtils.PublishArt(const Art: String; const EvtCode: Integer; const Width: Integer; const EventHandler: TAppEventCallback);
const
  RULE_W = 80;
var
  Block: String;
  Pad, W: Integer;
begin
  { Width = the target's visible columns (EventForm.VisibleColumns) }
  W := IntTernary(Width > 0, Width, RULE_W);
  Block := ' '#13#10;

  for var Line in Art.Split([#13#10]) do
  begin
    Pad := (W -Line.Length) div 2;
    if Pad < 0 then Pad := 0;
    Block := Block +StringOfChar(' ', Pad) +Line +#13#10;
  end;

  QuickEvent(etMessage, Block +#13#10, EvtCode, EventHandler);
end;

class function TUtils.MillisToTimeStr(Milliseconds: Int64): String;
var
  TotalSeconds, Hours, Minutes, Seconds, MSecs: Int64;
begin
  TotalSeconds := Milliseconds div 1000;
  MSecs := Milliseconds mod 1000;

  Hours   := TotalSeconds div 3600;
  Minutes := (TotalSeconds mod 3600) div 60;
  Seconds := TotalSeconds mod 60;

  Result := Format('%.2d:%.2d:%.2d.%.3d', [Hours, Minutes, Seconds, MSecs]);
end;

class function TUtils.PackResourceItem(const Name, Ext: String; const Id: PWideChar): TResourceId;
begin
  Result.Name := Name;
  Result.Ext := Ext;
  Result.Id := Id;
end;

class procedure TUtils.PackResources(const Items: TArray<TResourceId>);
var
  i, n: Integer;
  ResItem: PResourceId;
  ItemPtr: PResourceItem;
  SkipItem: Boolean;
begin
  if (High(Items) < 0) then Exit;

  for i := Low(Items) to High(Items) do
  begin
    ResItem := @Items[i];
    SkipItem := False;

    for n := Low(Resources) to High(Resources) do
    begin
      ItemPtr := @Resources[n];
      SkipItem := SameText(ItemPtr^.Name.Text, ResItem^.Name);
      if SkipItem then break;
    end;

    if SkipItem then continue;

    { assign it }
    Resources := Resources +[Default(TResourceItem)];
    ItemPtr := @Resources[High(Resources)];
    ItemPtr^.Name.Update(@ResItem^.Name);
    ItemPtr^.Extension.Update(@ResItem^.Ext);
    ItemPtr^.Id := ResItem^.Id;
  end;
end;

class procedure TUtils.PostMessage(const EvtStrs: TArray<String>; const Paints: TArray<Integer>);
var
  i, Paint: Integer;
begin
  if IgnoreEvents then Exit;
  var ERoof := High(EvtStrs);
  var PRoof := High(Paints);

  for i := Low(EvtStrs) to High(EvtStrs) do
  begin
    Paint := IntTernary(i <= PRoof, Paints[i], GREEN);
    QuickEvent(etMessage, StrTernary((i < ERoof), EvtStrs[i], EvtStrs[i] +#13#10), Paint);
  end;
end;

class procedure TUtils.UpdateJSONValue(const JSONObject: TJSONObject; const Key: string; const Value: TJSONValue);
begin
  if (JSONObject = nil) or (Value = nil) or Key.IsEmpty then
  begin
    if value <> nil then
      Value.Free;
    Exit;
  end;

  if JSONObject.Values[Key] = Value then
    Exit;

  JSONObject.RemovePair(Key).Free;
  JSONObject.AddPair(Key, Value);
end;

