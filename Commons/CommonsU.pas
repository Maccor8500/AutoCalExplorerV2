procedure InsertComboInGrid(var Combo : TComboBox; var Grid : TStringGrid; Const Col, Row : Integer; HasParent : Boolean = false);
var
  R : TRect;
begin
  try
    R := Grid.CellRect(Col, Row);

    if HasParent then
    begin
      R.Left := R.Left + Grid.Left - Grid.Parent.Left;
      R.Right := R.Right + Grid.Left - Grid.Parent.Left;
      R.Top := R.Top + Grid.Top - Grid.Parent.Top;
      R.Bottom := R.Bottom + Grid.Top;
    end
    else
    begin
      R.Left := R.Left + Grid.Left;
      R.Right := R.Right + Grid.Left;
      R.Top := R.Top + Grid.Top;
    end;

    with Combo do
    begin
      Left := R.Left +4;
      Top := R.Top +4;
      Width := R.Width; //(R.Right +1) - R.Left;
      Height := R.Height; //(R.Bottom +1) - R.Top;
      ItemHeight := Grid.DefaultRowHeight;
      Show;
    end;
  except
    On E: Exception do
      Sleep(5);
  end;
end;

procedure InsertObjectInGrid(var Grid : TStringGrid; var Obj : TObject;
  const Col, Row : Integer; OAlign : TAlign = alClient);
var
  R : TRect;
begin
  try
    R := Grid.CellRect(Col, Row);
    R.Left := R.Left + Grid.Left;
    R.Right := R.Right + Grid.Left;
    R.Top := R.Top + Grid.Top;
    R.Bottom := R.Bottom + Grid.Top;
    R.Width := Grid.ColWidths[Col] -3;

    if Obj is TEdit then
    begin
      with Obj as TEdit do
      begin
        AutoSize := false;
        Left := R.Left;
        BorderStyle := bsSingle;
        Top := R.Top;
        Width := R.Width +2; //(R.Right +1) - R.Left;
        Height := Grid.DefaultRowHeight +2; //(R.Bottom +1) - R.Top;
        BringtoFront;
      end;
    end
    else if Obj is TPanel then
    begin
      with Obj as TPanel do
      begin
        Left := R.Left;
        Top := R.Top;
        Width := R.Width;
        Height := R.Height;
        BorderStyle := bsNone;
        Show;
        BringtoFront;
        Parent := Grid;
      end
    end
    else if Obj is TButton then
    begin
      with Obj as TButton do
      begin
        if IsSeattle then
        begin
          Left := R.Left -3;
          Top := R.Top -3;
        end
        else
        begin
          Top := R.Top;
        end;


        case OAlign of
          alNone: ;
          alTop: ;
          alBottom: ;
          alLeft: ;
          alRight:
          begin
            Left := R.Left + (R.Width - Width)+3;
          end;
          alClient:
          begin
            Left := R.Left +1;
            Width := R.Width +3;
          end;

          alCustom: ;
        end;

        Height := R.Height;
        Show;
        BringtoFront;
        Parent := Grid;
      end
    end

    else if Obj is TSpinEdit then
    begin
      R := Grid.CellRect(Col, Row);
      with (Obj As TSpinEdit) do
      begin
        Parent := Grid;
        AutoSize := False;
        SetBounds(R.Left, R.Top, R.Width -1, R.Height -1);
      end;

      SetWindowLongPtr(Grid.Handle, GWL_STYLE, GetWindowLongPtr(Grid.Handle, GWL_STYLE) or WS_CLIPCHILDREN);
    end;
  except
  end;
end;

procedure GetSocketInfo(const iDescr: TSocket; SocketInfo: PSocketInfo);
begin
  { careful! }
  if SocketInfo = nil then Exit;
  SocketInfo^ := Default(TSocketInfo);
  { addr size }
  SocketInfo^.Size := SizeOf(SocketInfo^.Addr);

  { get the remote client's address and port }
  if Winsock2.GetPeerName(iDescr, Winsock2.PSockAddr(@SocketInfo^.Addr)^, SocketInfo^.Size) = 0 then
  begin
    { convert the IP address from binary to string format }
    SocketInfo^.AddrStr := winsock2.inet_ntoa(SocketInfo^.Addr.sin_addr);
    { extract the port number (in network byte order) }
    SocketInfo^.Port := winsock2.ntohs(SocketInfo^.Addr.sin_port);
  end

  { fail! }
  else SocketInfo^ := Default(TSocketInfo);
end;

