{ Error/ Event handling... leanup required}
procedure PackSocketError(const Error: Integer; var ErrPtr: TSocketError);
var
  Buffer: PChar;
begin
  ErrPtr.Code := Error;

  try
    FormatMessage(FORMAT_MESSAGE_ALLOCATE_BUFFER or FORMAT_MESSAGE_FROM_SYSTEM
      or FORMAT_MESSAGE_IGNORE_INSERTS, nil, ErrPtr.Code, 0, @Buffer, 0, nil);

    { remove trailing CRLF, if any }
    if StrLen(Buffer) >= 2 then
      if (Buffer[StrLen(Buffer) - 2] = #13) and (Buffer[StrLen(Buffer) - 1] = #10) then
        Buffer[StrLen(Buffer) - 2] := #0;

    ErrPtr.Info := Format('Code: %d, Msg: %s',[Error, Buffer]);
  finally
    LocalFree(HLOCAL(Buffer));
  end;
end;

procedure PackException(const E: Exception; const LastError: DWord; var ExcPtr: TAppException);
begin
  ExcPtr.Code := LastError;
  ExcPtr.Msg := E.Message;
  ExcPtr.Trace := E.StackTrace;
  TranslateErrorCode(ExcPtr.Code, ExcPtr.Desc);
end;

procedure PackSocketException(const E: Exception; const LastError: DWord; var ExcPtr: TSocketException);
begin
  ExcPtr.Code := LastError;
  ExcPtr.Msg := E.Message;
  ExcPtr.Trace := E.StackTrace;
end;

procedure TranslateErrorCode(const Code: Integer; var ErrStr: String);
var
  Buffer: PWideChar;
  Return: UInt32;
begin
  Buffer := nil;

  try
    Return := FormatMessageW(FORMAT_MESSAGE_ALLOCATE_BUFFER or FORMAT_MESSAGE_FROM_SYSTEM
      or FORMAT_MESSAGE_IGNORE_INSERTS, nil, Code, 0, @Buffer, 0, nil);
    if Return = 0 then Exit;


    if (Buffer <> nil) then
    begin
      try
        { remove trailing CRLF, if any }
        if StrLen(Buffer) >= 2 then
          if (Buffer[StrLen(Buffer) - 2] = #13) and (Buffer[StrLen(Buffer) - 1] = #10) then
            Buffer[StrLen(Buffer) - 2] := #0;

        ErrStr := Format('Error Code: %d'#13#10'Message: %s', [Code, Buffer]);
      finally
        LocalFree(HLOCAL(Buffer));
      end;
    end;
  except
    On E: Exception do
      DoNothing;
  end;
end;

procedure DoNothing;
begin
  { doing nothing... }
  Sleep(1);
end;

