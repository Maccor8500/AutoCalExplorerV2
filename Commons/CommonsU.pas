procedure CalculateSteinhart_Coeffs(Steinhart: PSteinhartDataEx; const SteinhartCoffs: TSteinhartCoeffCount);
type
  T4Doubles = array[0..3] of Double;

var
  R, T: T4Doubles;
  SinglePtr: PSingle;
  S: String;
  i, Zeros: Integer;

  { 3Coeff Steinhart vars: }
  X1, X2, B20, B18, B21, B19, B22, B23 : double;

{$REGION ' L1: CalculateCoefficients(const Temperatures, Resistances: T4Doubles; out A, B, C, D: Single) '}
  procedure CalculateCoefficients(const Temperatures, Resistances: T4Doubles; out A, B, C, D: Single);
  const
    DebugFile = 'steinhart_debug.txt';

  var
    Matrix, Inverse: Array [0..3] of T4Doubles;
    Vectors: T4Doubles;
    i: Integer;
    j: Integer;
    F: TextFile;

    { supporting procedures, functions for L1 (CalculateCoefficients) }
    {$REGION ' L2: SolveLinearSystem(var A: array of T4Doubles; var B: T4Doubles; out X: T4Doubles) '}
    procedure SolveLinearSystem(var A: array of T4Doubles; var B: T4Doubles; out X: T4Doubles);
    var
      N, I, J, K: Integer;
      Factor, Temp: Double;
    begin
      N := Length(B);
      { gaussian elimination }
      for I := 0 to (N -1) do
      begin
        { find pivot }
        for J := (I +1) to (N -1) do
        begin
          if Abs(A[J][I]) > Abs(A[I][I]) then
          begin
            { swap rows }
            for K := 0 to (N -1) do
            begin
              Temp := A[I][K];
              A[I][K] := A[J][K];
              A[J][K] := Temp;
            end;
            Temp := B[I];
            B[I] := B[J];
            B[J] := Temp;
          end;
        end;

        { eliminate }
        for J := (I +1) to (N -1) do
        begin
          Factor := A[J][I] /A[I][I];
          for K := I to N -1 do A[J][K] := A[J][K] -Factor *A[I][K];
          B[J] := B[J] -Factor *B[I];
        end;
      end;

      { back substitution }
      for I := (N -1) downto 0 do
      begin
        X[I] := B[I];
        for J := (I +1) to (N -1) do X[I] := X[I] -A[I][J] *X[J];
        X[I] := X[I] /A[I][I];
      end;
    end;
    {$ENDREGION}
    {$REGION ' L2: InverseMatrix(const Matrix: array of T4Doubles; out Inverse: array of T4Doubles) '}
    procedure InverseMatrix(const Matrix: array of T4Doubles; out Inverse: array of T4Doubles);
    var
      Augmented: array[0..3, 0..7] of Double;
      Row, Col, I, J: Integer;
      Scale: Double;
    begin
      { initialize the augmented matrix with the identity matrix }
      for Row := 0 to 3 do
      begin
        for Col := 0 to 7 do
        begin
          if Col < 4 then Augmented[Row, Col] := Matrix[Row, Col]
          else if Col - 4 = Row then Augmented[Row, Col] := 1
          else Augmented[Row, Col] := 0;
        end;
      end;

      { perform Gaussian elimination }
      for Col := 0 to 3 do
      begin
         { find the pivot row and swap if necessary }
        Row := Col;
        for I := Col + 1 to 3 do
          if Abs(Augmented[I, Col]) > Abs(Augmented[Row, Col]) then
            Row := I;

        if Augmented[Row, Col] = 0 then
          raise Exception.Create('Matrix is singular and cannot be inverted');

        { swap rows }
        for J := 0 to 7 do
        begin
          Scale := Augmented[Row, J];
          Augmented[Row, J] := Augmented[Col, J];
          Augmented[Col, J] := Scale;
        end;

        { scale the pivot row }
        Scale := Augmented[Col, Col];
        for J := 0 to 7 do Augmented[Col, J] := Augmented[Col, J] /Scale;

        { eliminate the current column from all other rows }
        for I := 0 to 3 do
        begin
          if I <> Col then
          begin
            Scale := Augmented[I, Col];
            for J := 0 to 7 do Augmented[I, J] := Augmented[I, J] -Scale *Augmented[Col, J];
          end;
        end;
      end;

      { extract the inverse matrix from the augmented matrix }
      for Row := 0 to 3 do
        for Col := 0 to 3 do
          Inverse[Row, Col] := Augmented[Row, Col +4];
    end;
    {$ENDREGION}
    {$REGION ' L2: CalcCoeffs(const Inverse: array of T4Doubles; const Vectors: T4Doubles; var A, B, C, D: Single) '}
    procedure CalcCoeffs(const Inverse: array of T4Doubles; const Vectors: T4Doubles; var A, B, C, D: Single);
    var
      i, j: Integer;
      Coefficients: T4Doubles;
    begin
      { initialize coefficients to zero }
      for i := 0 to 3 do
        Coefficients[i] := 0.0;

      { multiply the inverse matrix with the vector }
      for i := 0 to 3 do
        for j := 0 to 3 do
          Coefficients[i] := Coefficients[i] +Inverse[i, j] *Vectors[j];

      { assign the calculated coefficients }
      A := Coefficients[0];
      B := Coefficients[1];
      C := Coefficients[2];
      D := Coefficients[3];
    end;
    {$ENDREGION}

  { calculate coefficients... }
  begin
    { first column is all 1s: check apples prescribed spreadsheet! }
    Matrix[0, 0] := 1;
    Matrix[1, 0] := 1;
    Matrix[2, 0] := 1;
    Matrix[3, 0] := 1;

    { fill the rest! }
    Matrix[0, 1] := Ln(Resistances[0]);
    Matrix[0, 2] := Power(Matrix[0, 1], 2);
    Matrix[0, 3] := Power(Matrix[0, 1], 3);

    Matrix[1, 1] := Ln(Resistances[1]);
    Matrix[1, 2] := Power(Matrix[1, 1], 2);
    Matrix[1, 3] := Power(Matrix[1, 1], 3);

    Matrix[2, 1] := Ln(Resistances[2]);
    Matrix[2, 2] := Power(Matrix[2, 1], 2);
    Matrix[2, 3] := Power(Matrix[2, 1], 3);

    Matrix[3, 1] := Ln(Resistances[3]);
    Matrix[3, 2] := Power(Matrix[3, 1], 2);
    Matrix[3, 3] := Power(Matrix[3, 1], 3);

    { multiplicative-inverse of kelvin-fied values of preset temperatures }
    Vectors[0] := 1 /(273.15 +Temperatures[0]);
    Vectors[1] := 1 /(273.15 +Temperatures[1]);
    Vectors[2] := 1 /(273.15 +Temperatures[2]);
    Vectors[3] := 1 /(273.15 +Temperatures[3]);

    {$ifdef debug}
    AssignFile(F, DebugFile);
    if FileExists(DebugFile) then Append(F)
    else ReWrite(F);

    WriteLn(F, DateTimeToStr(Now));
    for i := 0 to 3 do
      for j := 0 to 3 do
      begin
        S := format('%2.3f    ', [Matrix[i, j]]);

        if j < 3 then Write(F, S)
        else Write(F, format('%s    %.6f'#13#10, [Trim(S), Vectors[i]]));
      end;
    {$endif}

    InverseMatrix(Matrix, Inverse);
    {$ifdef debug}
      WriteLn(F, '');

      for i := 0 to 3 do
        for j := 0 to 3 do
        begin
          S := format('%2.3f    ', [Inverse[i, j]]);

          if j < 3 then Write(F, S)
          else Write(F, format('%s    %.6f'#13#10, [Trim(S), Vectors[i]]));
        end;
      CloseFile(F);   { the trace file stayed open; the second 4-term solve in a process raised I/O 103 }
    {$endif}

    CalcCoeffs(Inverse, Vectors, A, B, C, D);
  end;
{$ENDREGION}
{
  CalculateSteinhart_Coeffs...

  this abomination was created by me and copied over from Cal::SetThermistorU.
  it shall be reviewed and restructured in the foreseeable future... assuming,
  of course, that the return of the son-of-man tarries!
}
begin
  if Steinhart = nil then Exit;

  Zeros := 0;
  { all resistance data is zero? bail! }
  if Zeros = Length(R) then raise Exception.Create('All Resistance values can''t be zero!!!');

  Fill(@R[0], 0, SizeOf(T4Doubles));
  Fill(@T[0], 0, SizeOf(T4Doubles));

  case SteinhartCoffs of
    sh3Coeffs:
    begin
      { dump values... }
      with Steinhart^ do
      begin
        T[0] := T1 +273.15;
        T[1] := T2 +273.15;
        T[2] := T3 +273.15;
        R[0] := R1;
        R[1] := R2;
        R[2] := R3;

        B20 := (1 /T[0]) -(1/T[1]);
        B18 := (LN(R[0]) -LN(R[1]));
        B21 := (1 /T[0]) -(1/T[2]);
        B19 := (LN(R[0]) -LN(R[2]));
        B22 := Power(LN(R[0]), 3) -Power(LN(R[1]), 3);
        B23 := Power(LN(R[0]), 3) -Power(LN(R[2]), 3);

        X1 := B20 -(B18 *B21 /B19);
        X2 := B22 -(B18 *B23 /B19);

        Coeffs.D := 0.000;
        Coeffs.C := X1 /X2;
        Coeffs.B := (B20 -(Coeffs.C *B22)) /B18;
        Coeffs.A := (1/T[0]) -(Coeffs.C *Power(LN(R[0]), 3)) -Coeffs.B *LN(R[0]);
      end;
    end;

    sh4Coeffs:
    begin
      { check all R[] value isn't 0s }
      SinglePtr := @Steinhart^.R1;
      Zeros := 0;

      { check all Rs }
      for i := 0 to 3 do
      begin
        if SinglePtr^ = 0.0 then Inc(Zeros);
        Inc(SinglePtr);
      end;

      { all resistance data is zero? bail! }
      if Zeros = Length(R) then raise Exception.Create('All Resistance values can''t be zero!!!');

      { dump data as received }
      with Steinhart^ do
      begin
        R[0] := R1;
        R[1] := R2;
        R[2] := R3;
        R[3] := R4;

        T[0] := T1;
        T[1] := T2;
        T[2] := T3;
        T[3] := T4;

        try
          { calculate coefficients }
          CalculateCoefficients(T, R, Coeffs.A, Coeffs.B, Coeffs.C, Coeffs.D);
        except
          On E: Exception do
            ShowDialog(dtWarning, E.Message);
        end;
      end;
    end;
  end;
end;

