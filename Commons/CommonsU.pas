function StackBytesToStr(const Value: UInt64): String;
const
  KB = 1024;
  MB = KB *1024;
  GB = MB *1024;
begin
  if Value >= GB then
    Result := Format('%.2f GB', [Value /GB])
  else if Value >= MB then
    Result := Format('%.2f MB', [Value /MB])
  else if Value >= KB then
    Result := Format('%.2f KB', [Value /KB])
  else
    Result := Format('%d B', [Value]);
end;

function GetCurrentThreadStackUsage(var Usage: TThreadStackUsage): Boolean;
type
  TGetCurrentThreadStackLimitsProc = procedure(var LowLimit, HighLimit: NativeUInt); stdcall;
var
  LocalByte: Byte;
  Kernel: HMODULE;
  GetCurrentThreadStackLimitsProc: TGetCurrentThreadStackLimitsProc;
begin
  Result := False;
  Usage := Default(TThreadStackUsage);
  Kernel := GetModuleHandle('kernel32.dll');
  if Kernel = 0 then Exit;
  @GetCurrentThreadStackLimitsProc := GetProcAddress(Kernel, 'GetCurrentThreadStackLimits');
  if not Assigned(GetCurrentThreadStackLimitsProc) then Exit;
  GetCurrentThreadStackLimitsProc(Usage.LowLimit, Usage.HighLimit);
  Usage.StackPtr := NativeUInt(@LocalByte);
  Usage.TotalBytes := Usage.HighLimit -Usage.LowLimit;
  if (Usage.TotalBytes = 0) or (Usage.StackPtr < Usage.LowLimit) or (Usage.StackPtr > Usage.HighLimit) then Exit;
  Usage.UsedBytes := Usage.HighLimit -Usage.StackPtr;
  Usage.FreeBytes := Usage.StackPtr -Usage.LowLimit;
  Usage.UsedPercent := (Usage.UsedBytes /Usage.TotalBytes) *100;
  Result := True;
end;

function ThreadStackUsageToStr(const Usage: TThreadStackUsage): String;
begin
  Result := Format('%s / %s (%.1f%%)',
    [StackBytesToStr(Usage.UsedBytes), StackBytesToStr(Usage.TotalBytes), Usage.UsedPercent]);
end;

procedure DebugThreadStackUsage(var Stats: String; const Source: String = '');
var
  Usage: TThreadStackUsage;
begin
  if not GetCurrentThreadStackUsage(Usage) then
    Exit;

  Stats := Format('StackUsage%s: %s',
    [StrTernary(Source <> '', '[' +Source +']', ''), ThreadStackUsageToStr(Usage)]);
end;

procedure ProcessMsgs(Time: Integer);
var
  T0: UInt64;
begin
  if Time <= 0 then Time := 1;
  T0 := GetTickCountEx(Time);

  repeat
    Application.ProcessMessages;
    if (Time >= 500) then Sleep(QTR_SEC)
    else Sleep(Time);
  until (GetTickCountEx >= T0);
end;

