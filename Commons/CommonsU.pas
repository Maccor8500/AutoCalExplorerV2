function StringProgress(const val : Single; const mode : byte = 0) : String;
  function Val2PercentStr(v : Single) : String;
  var
    i, x: Integer;
  begin
    if (v < 5) then Result := '----------'
    else if ((v > 5) and (v < 10)) then Result := '▏---------'
    else
    begin
      x := 0;
      for i := 0 to Round(v /10) -1 do
      begin
        Result := Result + '█';
        Inc(x);
      end;

      for i := 0 to (9 -x) do Result := Result + '-';
    end;
  end;

  function ValToStr(v : Single) : String;
  begin
    if (V > 0) and (v < 10) then
      Result := Result + '█'
  end;
begin
  case mode of
    0: Result := Val2PercentStr(val);
    1: Result := format('{%s}', [Val2PercentStr(val)]);
    2: Result := format('[%s]', [Val2PercentStr(val)]);
    3: Result := format('<%s>', [Val2PercentStr(val)]);
    4: Result := Val2PercentStr(val /100);
    5: Result := format('{%s}', [Val2PercentStr(val /100)]);
    6: Result := format('[%s]', [Val2PercentStr(val /100)]);
    7: Result := format('<%s>', [Val2PercentStr(val /100)]);
  end;
end;

procedure ChangeFileExtEx(var Filename: String; const Ext : String);
var
  I: Integer;
begin
  I := FileName.LastDelimiter('.' + PathDelim + DriveDelim);
  if (I < 0) or (FileName.Chars[I] <> '.') then I := MaxInt;
  Filename := FileName.SubString(0, I) + Ext;
end;

function FastCopy(const src, dst : string; const handle : THandle) : boolean;
var
  p : PCopyEx;
  id: Cardinal;
begin
  if FileExists(dst) then DeleteFile(dst);
  CancelCopy := false;
  New(p);
  p.aSrc := ShortString(src);
  p.aDst := ShortString(dst);
  p.aHdl := handle;

  Result := Closehandle(BeginThread(nil, 0, @CopyExHelper, p, 0, id));
end;

