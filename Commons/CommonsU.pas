class procedure TMaccorSystem.GetCalibrationData(const Chan: Integer; const Signal: TMaccorRunMode; Mode: TMaccorControlMode; const Range: TMaccorBrickRange; var Data: TCalibrationData);
var
  ChanData: PChParm;
begin
  Data := Default(TCalibrationData);
  MacSysPtr^.GetChannelDataNormal(Chan, ChanData);
  if not Assigned(ChanData) then Exit;

  case Signal of
    rmCurrent:
    begin
      case Range of
        mrRange1:
        begin
          case Mode of
            cmCharge:
            begin
              Data.Slope := ChanData^.chg.Islope;
              Data.Offset := ChanData^.chg.IOffset;
              Data.DAC.Slope := ChanData^.chg.IoutSlope1;
              Data.DAC.Offset := ChanData^.chg.IoutOffset1;
            end;

            cmDischarge:
            begin
              Data.Slope := ChanData^.Dis.Islope;
              Data.Offset := ChanData^.Dis.IOffset;
              Data.DAC.Slope := ChanData^.Dis.IoutSlope1;
              Data.DAC.Offset := ChanData^.Dis.IoutOffset1;
            end;
          end;
        end;

        mrRange2:
        begin
          case Mode of
            cmCharge:
            begin
              Data.Slope := ChanData^.chg.Islope1;
              Data.Offset := ChanData^.chg.IOffset1;
              Data.DAC.Slope := ChanData^.chg.IoutSlope2;
              Data.DAC.Offset := ChanData^.chg.IoutOffset2;
            end;

            cmDischarge:
            begin
              Data.Slope := ChanData^.Dis.Islope1;
              Data.Offset := ChanData^.Dis.IOffset1;
              Data.DAC.Slope := ChanData^.Dis.IoutSlope2;
              Data.DAC.Offset := ChanData^.Dis.IoutOffset2;
            end;
          end;
        end;

        mrRange3:
        begin
          case Mode of
            cmCharge:
            begin
              Data.Slope := ChanData^.chg.Islope2;
              Data.Offset := ChanData^.chg.IOffset2;
              Data.DAC.Slope := ChanData^.chg.IoutSlope3;
              Data.DAC.Offset := ChanData^.chg.IoutOffset3;
            end;

            cmDischarge:
            begin
              Data.Slope := ChanData^.Dis.Islope2;
              Data.Offset := ChanData^.Dis.IOffset2;
              Data.DAC.Slope := ChanData^.Dis.IoutSlope3;
              Data.DAC.Offset := ChanData^.Dis.IoutOffset3;
            end;
          end;
        end;

        mrRange4:
        begin
          case Mode of
            cmCharge:
            begin
              Data.Slope := ChanData^.chg.Islope3;
              Data.Offset := ChanData^.chg.IOffset3;
              Data.DAC.Slope := ChanData^.chg.IoutSlope4;
              Data.DAC.Offset := ChanData^.chg.IoutOffset4;
            end;

            cmDischarge:
            begin
              Data.Slope := ChanData^.Dis.Islope3;
