end;

{ more complete ping }
function Ping(const HostName: AnsiString; out RTT: Cardinal; out StatusMsg: string; TimeoutMS: Cardinal): Boolean;
const
  ReplyBufSize = SizeOf(TICMP_ECHO_REPLY) + 64;
var
  WSAData: TWSAData;
  HostEnt: PHostEnt;
  Addr: PInAddr;
  Handle: THandle;
  DataStr: String;
  ReplyBuf: array[0..ReplyBufSize - 1] of Byte;
  Reply: PEchoReply;
  IPOpt: TIPOptionInformation;
  ReplyCount: DWORD;
begin
  Result := False;
  RTT := 0;

  if Trim(String(HostName)) = '' then
  begin
    StatusMsg := 'No host specified';
    Exit;
  end;

  if WSAStartup($0101, WSAData) <> 0 then
  begin
    StatusMsg := 'WSAStartup failed';
    Exit;
  end;

  try
    HostEnt := gethostbyname(PAnsiChar(HostName));
    if HostEnt = nil then
    begin
      StatusMsg := Format('Unable to resolve host "%s" (WSA Error %d)', [HostName, WSAGetLastError]);
      Exit;
    end;

    if HostEnt.h_addrtype <> AF_INET then
    begin
      StatusMsg := 'Host does not resolve to IPv4';
      Exit;
    end;

    Addr := PInAddr(HostEnt^.h_addr_list^);

    Handle := IcmpCreateFile;
    if Handle = INVALID_HANDLE_VALUE then
    begin
      StatusMsg := 'IcmpCreateFile failed';
      Exit;
    end;

    try
      FillChar(IPOpt, SizeOf(IPOpt), 0);
      IPOpt.Ttl := 128;

      DataStr := FormatDateTime('yyyymmddhhnnsszzz', Now);
      FillChar(ReplyBuf, SizeOf(ReplyBuf), 0);

      ReplyCount := IcmpSendEcho(
        Handle,
        Addr^,
        PAnsiChar(AnsiString(DataStr)),
        Length(DataStr),
        @IPOpt,
        @ReplyBuf,
        SizeOf(ReplyBuf),
        TimeoutMS
      );

      if ReplyCount > 0 then
      begin
        Reply := PEchoReply(@ReplyBuf);
        RTT := Reply^.RoundTripTime;
        Result := (Reply^.Status = 0);

        case Reply^.Status of
          0: StatusMsg := Format('Reply from %s: time=%dms TTL=%d', [HostName, RTT, Reply.Options.Ttl]);
          11001: StatusMsg := 'Buffer too small';
          11002: StatusMsg := 'Destination unreachable';
          11003: StatusMsg := 'Timeout';
          else StatusMsg := Format('Ping failed with status %d', [Reply^.Status]);
        end;
      end
      else
        StatusMsg := Format('IcmpSendEcho failed (error: %d)', [GetLastError]);
    finally
      IcmpCloseHandle(Handle);
    end;

  finally
    WSACleanup;
  end;
end;

procedure Ping(const Addr: TIPv4AddrBytes; PingStatus: PBoolean; TimeoutMS: Cardinal);
begin
  TThread.CreateAnonymousThread(
    procedure
    var
      Dest: String;
    begin
      AddrToStr(Addr, Dest);
      try
        if not ValidAddress(Dest) then PingStatus^ := False
        else
        begin
          if Assigned(PingStatus) then
            PingStatus^ := Ping(AnsiString(Dest), TimeoutMS);
        end;
      except
        On E: Exception do;
      end;
    end).Start;
end;

function Ping(const HostName: AnsiString; TimeoutMS: Cardinal): boolean;
const
  rSize = $400;
var
  e: PHostEnt;
  a: PInAddr;
  h: THandle;
  d: string;
  r: array [0 .. rSize - 1] of byte;
  i: cardinal;

  WSAData: TWSAData;
begin
  Result := false;
  if Trim(String(Hostname)) = '' then Exit;

  if WSAStartup($0101, WSAData) <> 0 then
    raise Exception.Create('WSAStartup');

  e := gethostbyname(PAnsiChar(HostName));
  if e = nil then
    RaiseLastOSError;
  if e.h_addrtype = AF_INET then
    Pointer(a) := e.h_addr^
  else
    raise Exception.Create('Name doesn''t resolve to an IPv4 address');

  d := FormatDateTime('yyyymmddhhnnsszzz', Now);

  h := IcmpCreateFile;
  if h = INVALID_HANDLE_VALUE then
    RaiseLastOSError;
  try
    i := IcmpSendEcho(h, a^, PChar(d), Length(d), nil, @r[0], rSize, TimeoutMS);
    Result := (i <> 0) and (PEchoReply(@r[0]).Status = 0);
  finally
    IcmpCloseHandle(h);
  end;

  if WSACleanup <> 0 then
    raise Exception.Create('WSACleanup');
end;

