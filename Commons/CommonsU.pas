function CopyExHelper(p : PCopyEx) : Integer;
var
  Source, Dest: String;
  Handle: THandle;
  Cancel : PBool;
begin
  Source := string(p.aSrc);
  Dest := string(p.aDst);
  Handle := p.aHdl;
  Cancel := PBOOL(False);
  CopyFileEx(PChar(Source), PChar(Dest), @CopyFileProgress, Pointer(Handle), Cancel, 0);
  Dispose(p);
  result := 0;
end;

function RecursiveDirAction(const Src, Dst : String; Flag : Integer) : boolean;
var
   shellinfo: TSHFileOpStruct;
begin
  if Trim(Src) = '' then Exit(False);
  if Flag in [FO_COPY, FO_MOVE] then if Trim(Dst) = '' then Exit(False);

  // clear record
   FillChar(shellinfo, sizeof(shellinfo), 0);

   // configure it
   with shellinfo do
   begin
     wnd   := Application.Handle;
     wFunc := Flag; //FO_MOVE, FO_COPY, FO_DELETE or FO_RENAME
     pFrom := PChar(Src);
     if Flag in [FO_DELETE] then pTo := nil
     else pTo := PChar(Dst);
   end;

   Result := SHFileOperation(shellinfo) = 0;
end;

