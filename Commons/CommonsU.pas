procedure StrToDtFmt(const dStr, tStr: string; var dt : TDateTime);
var
  S : TArray<String>;
  Sd, St, Sdt: String;
  i: Integer;
  FS: TFormatSettings;
begin
  dt := -1;
  Sd := Trim(dStr);
  st := Trim(tStr);
  //FS:= TFormatSettings.Create;
  FS.DateSeparator := '/';
  FS.ShortDateFormat := 'dd/mm/yyyy';
  FS.ShortTimeFormat := 'hh:nn:ss';

  for i := 1 to Length(Sd) do
    if(not IsNumber(Sd[i])) then
      break;

  Sd := StringReplace(Sd, Sd[i], '/', [rfReplaceAll]);
  S := Sd.Split(['/']);
  Sd := Format('%s/%s/%s', [S[2], S[1], S[0]]);
  S := St.Split([':']);
  S[0] := Format('%d', [StrToInt(S[0]) mod 12]);
  St := Format('%s:%s:%s', [S[0], S[1], S[2]]);
  Sdt := Format('%s %s', [Sd,  St]);
  dt := StrToDateTime(Sdt, FS);
end;

