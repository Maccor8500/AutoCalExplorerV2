procedure ParseEntry(const Entry : TStrings; var expressions : TArray<String>);
var
  i, L: Integer;
  Line: String;
  comment_start, comment_end : Boolean;
  CEntry : TStringList;
begin
  SetLength(expressions, 0);
  if Entry.Count <= 0 then Exit;
  CEntry := TStringList.Create;

  try
    i := 0;
    comment_start := false;
    comment_end := false;

    repeat
      Line := Trim(Entry.Strings[i]);

      { next line iter }
      Inc(i);

      // blacks and single line comments
      if (Trim(Line) = '') or (Pos('//', Line) > 0) then
        continue;

      // multi-line comment
      if not comment_start then
        comment_start := (Line[1] = '{') or (Pos('(*', Line) <> 0);
      // check for end!
      if comment_start then
        comment_end := (Pos('}', Line) <> 0) or (Pos('*)', Line) <> 0);

      // found end?
      if (comment_end and comment_start) then
      begin
        comment_start := false;
        comment_end := false;
        continue;
      end;

      if (not comment_start) and (not comment_end) then
      begin
        L := Length(expressions);
        SetLength(expressions, L +1);
        expressions[L] := Line;
      end;
    until (i >= Entry.Count);
  finally
    CEntry.Free;
  end;
end;

