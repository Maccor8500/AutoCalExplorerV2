function TTickCount.Stop: Double;
begin
  Result := 0;
  QueryPerformanceCounter(FT1);
  FTDiff := (FT1 -FT0);

  case FUnit of
    tuMillis: MultiFloat(FTDiff, 1E3);
    tuSeconds: MultiFloat(FTDiff, 1E6);
  end;

  if FTDiff <> 0 then Result := Result /FFreq;
end;

