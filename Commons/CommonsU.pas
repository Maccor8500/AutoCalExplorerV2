function SaveResourceToFile(const Instance: HINST; const ResName : String; const SaveTo: String): Boolean;
var
  rs : TResourceStream;
  Timeout: Boolean;
  T: UInt64;
begin
  GenErr := '';
  Result := False;

  if FileExists(SaveTo) then
  begin
    DeleteFile(SaveTo);
    while FileExists(SaveTo) do; { unsafe! }
  end;

  try
    rs := nil;
    rs := TResourceStream.Create(Instance, ResName, RT_RCDATA);

    try
      if Assigned(rs) and (rs.Size > 0) then
      begin
        T := GetTickCountEx(ONE_SEC *2);
        rs.SaveToFile(SaveTo);

        repeat
          Sleep(50);
          Result := FileExists(SaveTo);
          Timeout := (GetTickCountEx >= T);
        until (Result or Timeout);
      end;
    finally
      FreeAndNil(rs);
    end;

  except
    On E: Exception do
      GenErr := E.Message;
  end
end;

