{TSpinLock}
constructor TSpinLock.Create;
begin
  SetLength(Locks, 0);
end;

destructor TSpinLock.Destroy;
begin
  inherited Destroy;
end;

procedure TSpinLock.Lock(const index: Integer);
begin
  if (index > High(Locks)) or (Index < 0) then Exit;
  AtomicLock(Locks[index]);
end;

procedure TSpinLock.UnLock(const index: Integer);
begin
  if (index > High(Locks)) or (Index < 0) then Exit;
  AtomicUnLock(Locks[index]);
end;

procedure TSpinLock.AtomicLock(var index: Integer);
var
  Backoff: Integer;
begin
  Backoff := 0;
  while TInterlocked.CompareExchange(Locks[index], 1, 0) <> 0 do
  begin
    { short spinning phase }
    if Backoff < 10 then Inc(Backoff)
    else Sleep(1);

    YieldProcessor;
  end;
end;

procedure TSpinLock.AtomicUnLock(var index: Integer);
begin
  if (index > High(Locks)) or (Index < 0) then Exit;
  AtomicDecrement(Locks[index]);
end;

procedure TSpinLock.ConfigureLock(var index: Integer);
begin
  Spin.Lock;
  try
    index := Length(Locks);
    SetLength(Locks, index +1);
    Locks[index] := 0;
  finally
    Spin.Unlock;
  end;
end;

{ TScopedSpin RAII-style locking: the lock is acquired on creation and released on destruction }
constructor TScopedSpin.Create(ALock: PSpinLockEx);
begin
  FLock := ALock;
  if Assigned(FLock) then
  begin
    FLock^.Lock;
    Active := True;
  end;
end;

procedure TScopedSpin.Release;
begin
  FLock^.Unlock;
  Active := False;
end;

destructor TScopedSpin.Destroy;
begin
  if Active then Release;
  inherited;
end;

