class function TUtils.GetApplicationBuildTime(Path: String; Fmt: String): String;
var
  LI: TLoadedImage;
  {$IF CompilerVersion >= 26.0}
  m: TMarshaller;
  {$ENDIF}
  timeStamp: Cardinal;
  utcTime: TDateTime;
begin
  if Path = EmptyString then Path := ParamStr(0);
  if not FileExists(Path) then Exit('');

  if Fmt = '' then Fmt := DT_FMT_STYLES[5];
  {$IF CompilerVersion >= 26.0}
  Win32Check(MapAndLoad(PAnsiChar(m.AsAnsi(Path).ToPointer), nil, @LI, False, True));
  {$ELSE}
  Win32Check(MapAndLoad(PAnsiChar(AnsiString(Path)), nil, @LI, False, True));
  {$ENDIF}
  timeStamp := LI.FileHeader.FileHeader.TimeDateStamp;
  UnMapAndLoad(@LI);

  utcTime := UnixToDateTime(timeStamp);
  Result := FormatDateTime(fmt, TTimeZone.Local.ToLocalTime(utcTime));
end;

{ one StringFileInfo key; the language pair comes from the resource's own
  translation table, so nothing about the locale is hardcoded }
class function TUtils.VersionKey(const FileName, Key: String): String;
var
  Size, Wnd: DWORD;
  Len: UINT;
  Buf: Pointer;
  Trans: PDWORD;
  Value: PChar;
begin
  Result := '';
  Size := GetFileVersionInfoSize(PChar(FileName), Wnd);
  if Size = 0 then Exit;

  GetMem(Buf, Size);
  try
    if GetFileVersionInfo(PChar(FileName), Wnd, Size, Buf)
      and VerQueryValue(Buf, '\VarFileInfo\Translation', Pointer(Trans), Len)
        and (Len >= SizeOf(DWORD))
          and VerQueryValue(Buf, PChar(format('\StringFileInfo\%.4x%.4x\%s',
            [LoWord(Trans^), HiWord(Trans^), Key])), Pointer(Value), Len)
    then Result := Value;
  finally
    FreeMem(Buf);
  end;
end;

