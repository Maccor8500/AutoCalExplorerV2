procedure TUdpSocketEx.AlertSocketError;
begin
  if not Assigned(OnErrorCallback) then Exit;
  try
    { fill }
    PackSocketError(GetLastError, Err);

    {$ifdef debug}
      Err.Info := format('%s: %s', [DebugName, Err.Info]);
    {$endif}
    { send it }
    OnErrorCallback(@Err);
  finally
    Self.Sleep(25);
  end;
end;

procedure TUdpSocketEx.AlertSocketException(const E: Exception);
var
  Exc: TSocketException;
begin
  if Assigned(OnExceptionCallback) then
  begin
    PackSocketException(E, WSAGetLastError, Exc);
    OnExceptionCallback(@Exc);
  end

  else if Assigned(OnSocketEvent) then
  begin
    Event.Code := GetLastError;
    Event.Reason := etAppException;
    Event.Msg := E.Message;
    OnSocketEvent(@Event);
  end;
end;

procedure TUdpSocketEx.HandleSocketError(const msg: String);
begin
  if not Assigned(OnErrorCallback) then Exit;
  try
    Err.Info := (Msg);
    OnErrorCallback(@Err);
  finally
    Sleep(25);
  end;
end;

