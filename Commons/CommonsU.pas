{
  byte-keyed set with optional per-key payload. the value is its own slot, so
  membership, payload and removal are all O(1); payload search is a linear scan.
  all public methods are internally synchronized (SRW read/write lock, zero-init
  valid). locking cannot heal copy divergence: threads must share ONE instance
  (field/global), and an instance in concurrent use must never be copied.
}
type
  PSetList = ^TSetList;
  TSetList = record
    private
      FLock: TLightweightMREW;   { unlocked state = all-zero, so Default() inits it }
      FMembers: TByteSet;
      FCount: Word;              { Word: a full set holds 256 }
      FData: array of TBytes;    { 256 slots, lazily allocated; FData[Value] is the payload }
      procedure EnsureData; inline;
      { unlocked cores hold all logic; public shells only add the lock.
        TSetListEx drives its pages exclusively through these, under its own
        top-level lock - page FLocks stay zero, so page relocation is safe }
      function DoInsert(const Value: Byte): Boolean;
      function DoInsertData(const Value: Byte; const Buf; const Size: NativeUInt): Boolean;
      function DoRemove(const Value: Byte): Boolean;
      function DoContains(const Value: Byte): Boolean; inline;
      function DoGetData(const Value: Byte): TBytes;
      function DoIndexOf(const Buf; const Size: NativeUInt; const From: Integer): Integer;
      function DoLastIndexOf(const Buf; const Size: NativeUInt): Integer;

    public
      function Empty: Boolean;
      function Full: Boolean;
      function Count: Integer;

      function Insert(const Value: Byte): Boolean; overload;
      function Insert(const Value: Byte; const Buf; const Size: NativeUInt): Boolean; overload;
      function InsertIfAbsent(const Value: Byte; const Buf; const Size: NativeUInt): Boolean;
      function Remove(const Value: Byte): Boolean;
      function Contains(const Value: Byte): Boolean;
      function HasData(const Value: Byte): Boolean;
      function GetData(const Value: Byte): TBytes;
      function GetDataAsStr(const Value: Byte): String;
      function GetValues: TArray<Byte>;
      function IndexOf(const Buf; const Size: NativeUInt; const From: Integer = 0): Integer;
      function LastIndexOf(const Buf; const Size: NativeUInt): Integer;
      procedure Clear;
  end;

{
  TSetList paged beyond the byte limit: Key shr 8 picks the page, Key and $FF
  the slot within it. the fixed radix keeps every key's address stable while
  the page array grows. Append assigns sequence keys; removed keys never return.
  one top-level lock synchronizes everything (same sharing law as TSetList).
  payload search (IndexOf/LastIndexOf/KeysOf) is a linear scan; string forms
  match the UTF-16 payload contract of GetDataAsStr. AppendUnique = the atomic
  dedup guard: existing key if the payload is already present, else Append.
}
type
  PSetListEx = ^TSetListEx;
  TSetListEx = record
    private
      FLock: TLightweightMREW;
      FPages: array of TSetList;  { page i owns keys [i*256 .. i*256+255] }
      FCount: Integer;            { live entries }
      FNext: Integer;             { append high-water }
      function Page(const Key: Integer; const Grow: Boolean): PSetList;
      function DoInsert(const Key: Integer; const Buf; const Size: NativeUInt): Boolean;
      function DoAppend(const Buf; const Size: NativeUInt): Integer;
      function DoIndexOf(const Buf; const Size: NativeUInt): Integer;

    public
      function Count: Integer;

      function Insert(const Key: Integer; const Buf; const Size: NativeUInt): Boolean;
      function InsertIfAbsent(const Key: Integer; const Buf; const Size: NativeUInt): Boolean;
      function Append(const Buf; const Size: NativeUInt): Integer;
      function AppendUnique(const Buf; const Size: NativeUInt): Integer;
      function Remove(const Key: Integer): Boolean;
      function Contains(const Key: Integer): Boolean;
      function GetData(const Key: Integer): TBytes;
      function GetKeys: TArray<Integer>;
      function IndexOf(const Buf; const Size: NativeUInt): Integer; overload;
      function IndexOf(const S: String): Integer; overload;
      function LastIndexOf(const Buf; const Size: NativeUInt): Integer; overload;
      function LastIndexOf(const S: String): Integer; overload;
      function KeysOf(const Buf; const Size: NativeUInt): TArray<Integer>; overload;
      function KeysOf(const S: String): TArray<Integer>; overload;
      procedure Clear;
  end;

