constructor TRecentFiles.Create(const FilePath : String; const Max : Byte);
begin
  Paths := TStringList.Create;
  Paths.Clear;
  Self.Max := Max;
  if FileExists(FilePath) then
    Paths.LoadFromFile(FilePath);
end;

destructor TRecentFiles.Destroy;
begin
  Paths.Clear;
  FreeAndNil(Paths);
  inherited;
end;

procedure TRecentFiles.GetList(var l: TMenuItem);
var
  i: Integer;
  M : TMenuItem;
begin
  for i := 0 to Paths.Count -1 do
  begin
    M := TMenuItem.Create(l);
    M.Caption := Paths.Strings[i];
    M.Add(M);
  end;
end;

procedure TRecentFiles.Update(const f: String);
var
  Index : Integer;
begin
  { find it! index >= 0 }
  Index := Paths.IndexOf(f);
  { do we have it already? Delete it }
  if Index >= 0 then
    Paths.Delete(Index);
  { This is now the top file}
  Paths.Insert(0, f);
  { are we at or past max allowed, delete bottom }
  if Paths.Count >= Max then
    Paths.Delete(Max -1);
  { save new list to file }
  Paths.SaveToFile(f, TEncoding.ASCII);
end;

