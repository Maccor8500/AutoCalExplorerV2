procedure NumbersOnly(Sender: TObject; var Key: Char; WantsMorePoints: Boolean);
begin
  if Sender is TEdit then
  begin
    with TEdit(Sender) do
    begin
      if not CharInSet(Key, ['0'..'9', '.', #8]) then
      begin
        Key := #0;
        Exit;
      end;

      if (Key = '.') and ((Pos('.', Text) > 0) and (not WantsMorePoints)) then
        Key := #0;
    end;
  end

  else if Sender is TStringGrid then
  begin
    with TStringGrid(Sender) do
    begin
      var Text := Cells[Col, Row];

      if not CharInSet(Key, ['0'..'9', '.', #8]) then
      begin
        Key := #0;
        Exit;
      end;

      if (Key = '.') and ((Pos('.', Text) > 0) and (not WantsMorePoints)) then
        Key := #0;
    end;
  end;
end;

