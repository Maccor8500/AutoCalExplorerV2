procedure RichEditScrollToEnd(var e : TRichEdit);
begin
  e.SetFocus;
  e.SelStart := e.GetTextLen;
  e.Perform(EM_SCROLLCARET, 0, 0);
end;

function StringInSet(const S: String;
  const StringSet: array of String; var Index : Integer): Boolean;
var
  I: Integer;
begin
  Result := False;
  index := -1;

  for I := Low(StringSet) to High(StringSet) do
    if S = StringSet[I] then
    begin
      Result := True;
      Index := I;
      Break;
    end;
end;

function IsAtBottom(RichEdit: TRichEdit): Boolean;
var
  SI: TScrollInfo;
begin
  FillChar(SI, SizeOf(SI), 0);
  SI.cbSize := SizeOf(TScrollInfo);
  SI.fMask := SIF_RANGE or SIF_PAGE or SIF_POS;

  if not GetScrollInfo(RichEdit.Handle, SB_VERT, SI) then
    Exit(True); // No scrollbar = always at "bottom"

  Result := SI.nPos >= (SI.nMax -Integer(SI.nPage) -1);
end;

function GetMemoScrollPosition(Control: TWinControl): Integer;
var
  SI: TScrollInfo;
begin
  Result := 0;
  if (Control = nil) or not Control.HandleAllocated then
    Exit;

  SI.cbSize := SizeOf(SI);
  SI.fMask  := SIF_POS;

  if GetScrollInfo(Control.Handle, SB_VERT, SI) then
    Result := SI.nPos;
end;

function MemoShowingLastLine(Control: TCustomMemo): Boolean;
var
  FirstVisibleLine: Integer;
  VisibleLines: Integer;
  TotalDisplayLines: Integer;
begin
  FirstVisibleLine := SendMessage(Control.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  { how many display lines exist (wrapped-aware) }
  TotalDisplayLines := SendMessage(Control.Handle, EM_GETLINECOUNT, 0, 0);
  { how many lines fit in the viewport }
  VisibleLines := Control.ClientHeight div Abs(TRichEdit(Control).Font.Height);

  Result :=
    (FirstVisibleLine + VisibleLines) >= TotalDisplayLines;
end;


