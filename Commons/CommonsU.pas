function IdenticalStreams(const s1, s2 : TFileStream) : boolean;
const
  blk_size = 4096;
var
  buf1 : array[0..blk_size -1] of byte;
  buf2 : array[0..blk_size -1] of byte;
  len : integer;
  f1Age, f2Age : string;
  {takes more time, as it compares all blocks in stream}
begin
  Result := false;

  f1Age := DateTimeToStr(FileDateToDateTime(FileGetDate(s1.Handle)));
  f2Age := DateTimeToStr(FileDateToDateTime(FileGetDate(s2.Handle)));
  {if f1Age <> f2Age then
    Exit;}

  if s1.Size <> s2.Size then  {best case}
    Exit;

  s1.Position := 0;
  s2.Position := 0;

  while s1.Position < s1.Size do
  begin
    len := s1.Read(buf1, blk_size);
    s2.Read(buf2, blk_size);

    Result := CompareMem(@buf1, @buf2, len);
    if not Result then
      break;
  end;
end;

function IdenticalStreamsEx(const s1, s2 : TFileStream) : boolean;
const
  blk_size = 4096;

var
  buf1 : array[0..blk_size -1] of byte;
  buf2 : array[0..blk_size -1] of byte;
  len : integer;
  {faster... compares 3 points... head, mid and tail}
begin
  Result := false;

  if s1.Size <> s2.Size then  {best case}
    Exit;

  s1.Seek(0, soFromBeginning);
  s2.Seek(0, soFromBeginning);

  len := s1.Read(buf1, blk_size);
  s2.Read(buf2, blk_size);
  {compare read memory, if same go to middle of file and do same}
  Result := CompareMem(@buf1, @buf2, len);
  if Result then
  begin
    s1.Position := Trunc(s1.Size /2);
    s2.Position := Trunc(s2.Size /2);
    len := s1.Read(buf1, blk_size);
    s2.Read(buf2, blk_size);

    {compare this blk again, if same go to the end}
    Result := CompareMem(@buf1, @buf2, len);
    if Result then
    begin
//      s1.Position := s1.Size -blk_size;
//      s2.Position := s2.Size -blk_size;
      if s1.Size > blk_size then
      begin
        s1.Seek(blk_size, soFromEnd);
        s2.Seek(blk_size, soFromEnd);
        len := s1.Read(buf1, blk_size);
        s2.Read(buf2, blk_size);

        {Finally}
        Result := CompareMem(@buf1, @buf2, len);
      end;
    end;
  end;
end;

