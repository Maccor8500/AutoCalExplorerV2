function InstalledApps : TInstalledApplications;
var
  AppList: TStringList;
  MyRegistry: TRegistry;
  i: Integer;
  Str: string;
begin
  MyRegistry := TRegistry.Create;
  AppList := TStringList.Create;

  try
    with MyRegistry do
    begin
      RootKey:=HKEY_LOCAL_MACHINE;
      if OpenKey(
        'Software\Microsoft\Windows\CurrentVersion\Uninstall',
        False)=True then GetKeyNames(AppList);
      CloseKey;

      // prepare result
      SetLength(Result, AppList.Count);

      for i:=0 to AppList.Count-1 do
      begin
        RootKey := HKEY_LOCAL_MACHINE;
        OpenKey('Software\Microsoft\Windows\CurrentVersion\Uninstall\' +
            AppList[i], False);
        Str := ReadString('DisplayName');
        Result[i].App := AppList[i];
        Result[i].DisplayName := Str;
        CloseKey;
      end;
    end;
  except
  end;

  MyRegistry.Free;
  AppList.Free;
end;

function AppInstalled(const app : String) : Boolean;
var
  List : TInstalledApplications;
  i: Integer;
  passed : String;
begin
  Result := false;
  if Trim(app) = '' then Exit;

  passed := LowerCase(app);
  List := InstalledApps;

  for i := Low(List) to High(List) do
  begin
    if (LowerCase(List[i].App) = passed) or (LowerCase(List[i].DisplayName) = passed) then
    begin
      Result := true;
      break;
    end;
  end;
end;

