function CharsBefore(const C: Char; const S: String) : Integer;
var
  i : Integer;
begin
  Result := -1;

  for i := 1 to Length(S) do
  begin
    if S[i] = C then break;
    Inc(Result);
  end;
end;

function FirstIndexOf(const C: Char; const S: String; Trim: Boolean): Integer;
var
  i: Integer;
begin
  Result := -1;

  for i := 1 to Length(S) do
  begin
    if S[i] = C then
    begin
      if not Trim then Result := i
      else Result := (i -1);
      break;
    end;
  end;
end;

function LastIndexOf(const C: Char; const S : String; Trim: Boolean) : Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := Length(S) downto 1 do
  begin
    if S[i] = C then
    begin
      if not Trim then Result := i
      else Result := (i -1);
      break;
    end;
  end;
end;

function FindIndexOf(const C: Char; const S : String; const Offset : Integer) : Integer;
var
  i: Integer;
begin
  Result := -1;

  for i := Offset to Length(S) do
  begin
    if S[i] = C then
    begin
      Result := i;
      break;
    end;
  end;
end;

