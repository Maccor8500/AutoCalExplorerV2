              Data.DAC.Slope := ChanData^.Dis.IoutSlope4;
              Data.DAC.Offset := ChanData^.Dis.IoutOffset4;
            end;
          end;
        end;
      end;
    end;

    rmVoltage:
    begin
      case Mode of
        cmCharge:
        begin
          Data.Slope := ChanData^.chg.Vslope;
          Data.Offset := ChanData^.chg.Voffset;
        end;

        cmDischarge:
        begin
          Data.Slope := ChanData^.Dis.Vslope;
          Data.Offset := ChanData^.Dis.Voffset;
        end;
      end;
    end;
  end;
end;

