{
  what the tester identity still lacks, '' when it is complete :: one predicate
  for the Start gate and the profile pack. blank, the installer's template
  values <anyone / JN / SN>, and a job number equal to the serial number <a
  placeholder typed twice> all count as missing
}
class function TMaccorSystem.TesterIdGaps: String;
var
  Customer, Job, Serial: String;
begin
  Customer := Trim(TUtils.GetString(MacSysPtr^.TesterId.Customer));
  Job := Trim(TUtils.GetString(MacSysPtr^.TesterId.JobNumber));
  Serial := Trim(TUtils.GetString(MacSysPtr^.TesterId.SerialNumber));
  Result := '';

  if (Customer = '') or SameText(Customer, 'anyone') then Result := Result + ', Customer';
  if (Job = '') or SameText(Job, 'JN') then Result := Result + ', Job number';
  if (Serial = '') or SameText(Serial, 'SN') then Result := Result + ', Serial number';
  if (Job <> '') and SameText(Job, Serial) then Result := Result + ', Job and serial numbers must differ';

  Delete(Result, 1, 2);
end;

class procedure TMaccorSystem.SaveTesterIdFile;

  { the aux list begins on the line AFTER the 'Auxiliaries:' prompt, one entry
    per line. This normalizes the prompt line first, so a file previously saved
    (or hand-edited) with an entry stuck on the prompt line is corrected here. }
  procedure WriteAuxiliaries(const Strings: TStrings);
  begin
    for var I: Integer := 0 to Strings.Count -1 do
    begin
      if AnsiPos('Auxiliaries:', Strings[I]) <= 0 then Continue;

      Strings[I] := 'Auxiliaries: ';
      for var J: Integer := 0 to (MacSysPtr^.TesterId.AuxCount -1) do
      begin
        if J > High(MacSysPtr^.TesterId.Auxiliary) then Break;

        var Item: PAuxAggregate := @MacSysPtr^.TesterId.Auxiliary[J];
        Strings.Insert(I +1 +J, #9 +format('%s:'#9'Qty. %d, %s to %s',
          [TUtils.GetString(Item^.IdStr), Item^.Inputs,
            FormatFloat('0.##', Item^.Range.Low), FormatFloat('0.##', Item^.Range.High)]));
      end;

      Break;
    end;
  end;

  { the template's placeholder rows give way to the system's own, in the form ParseSystemDesc reads }
  procedure WriteDescription(const Strings: TStrings);
  begin
    for var I: Integer := 0 to Strings.Count -1 do
    begin
      if AnsiPos('Ch#', Strings[I]) <= 0 then Continue;

      while (I +1 < Strings.Count) and (Trim(Strings[I +1]) <> EmptyString) do
        Strings.Delete(I +1);

      for var J: Integer := 0 to (MacSysPtr^.TesterId.DescCount -1) do
      begin
        if J > High(MacSysPtr^.TesterId.Description) then Break;

        with MacSysPtr^.TesterId.Description[J] do
          Strings.Insert(I +1 +J, format('%d'#9'%d'#9'%d'#9'%smSec'#9'%s'#9'%s'#9'%s'#9'%s'#9'%sA'#9'%sA',
            [Channels, ChansPerBrick, Ranges, FormatFloat('0.##', Speed), FormatFloat('0.##', MinV),
              StrTernary(DPS, 'Y', 'N'), FormatFloat('0.##', MaxV), StrTernary(CPS, 'Y', 'N'),
              FormatFloat('0.##', CCurr), FormatFloat('0.##', DCurr)]));
      end;

      Break;
    end;
  end;

var
  Resource: TResourceStream;
  Strings: TStringList;
  ProductKey: String;
begin
  if not ResourceExists(HInstance, 'TesterIdFile', RT_RCDATA) then Exit;

  GetResource(HInstance, 'TesterIdFile', Resource);
  if not Assigned(Resource) then Exit;

  Strings := TStringList.Create;
  try
    Strings.LoadFromStream(Resource);

    { self-describing tokens }
    Strings.Text := Strings.Text.Replace('[CUSTOMER]', TUtils.GetString(MacSysPtr^.TesterId.Customer));
    Strings.Text := Strings.Text.Replace('[SYS_TYPE]', TUtils.GetString(MacSysPtr^.TesterId.SystemType));
    Strings.Text := Strings.Text.Replace('[JOB_NUMBER]', TUtils.GetString(MacSysPtr^.TesterId.JobNumber));
    Strings.Text := Strings.Text.Replace('[SERIAL_NUMBER]', TUtils.GetString(MacSysPtr^.TesterId.SerialNumber));
    Strings.Text := Strings.Text.Replace('[SOFT_VER]', TUtils.GetString(MacSysPtr^.TesterId.MacTestVersion));
    Strings.Text := Strings.Text.Replace('[EXE_DATE]', TUtils.GetString(MacSysPtr^.TesterId.MacTestDate));
    Strings.Text := Strings.Text.Replace('[DLL_DATE]', TUtils.GetString(MacSysPtr^.TesterId.DLLDate));

    WriteDescription(Strings);

    { auxiliaries: list begins on the line after the 'Auxiliaries:' prompt }
    WriteAuxiliaries(Strings);

    { windows product key: substitute the live OS key for the placeholder }
    ProductKey := String(GetWindowsKey);
    if Trim(ProductKey) <> EmptyString then
      Strings.Text := Strings.Text.Replace('XXXXX-XXXXX-XXXXX-XXXXX-XXXXX', ProductKey);

    Strings.SaveToFile(MacSysPtr^.SysIDFile, TEncoding.UTF8);
  finally
    FreeAndNil(Strings);
    FreeAndNil(Resource);
  end;
end;

class procedure TMaccorSystem.LoadResistanceBoardConfig;
