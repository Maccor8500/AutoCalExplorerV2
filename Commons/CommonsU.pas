{ TCrudeFileWatcher }

constructor TCrudeFileWatcher.Create(PurgeDeletedFile: Boolean; OnModify: TOnModifiedEvent; OnDelete: TOnDeletedEvent);
begin
  inherited Create(True);
  FOnFileDelete := OnDelete;
  FOnFileModify := OnModify;
  FPurgeDeletedFile := PurgeDeletedFile;

  Event := TEvent.Create(nil, True, False, '');
  FileRecords := TStringList.Create;
  Files := TList<TCrudeWatcherFile>.Create;
end;

destructor TCrudeFileWatcher.Destroy;
begin
  FreeAndNil(Event);
  FileRecords.Clear;
  FreeAndNil(FileRecords);
  FreeAndNil(Files);
  inherited;
end;

procedure TCrudeFileWatcher.Execute;
var
  RecPtr: PCrudeWatcherFile;
begin
  inherited;

  repeat
    try
      case Event.WaitFor(10) of
        wrSignaled:
        begin
          CheckIndex := 0;
          continue;
        end;
      end;

      if CheckIndex >= Files.Count then CheckIndex := 0;
      RecPtr := @Files.List[CheckIndex];

      if not FileExists(RecPtr^.Path) then
      begin
        var FIndex := FileRecords.IndexOf(RecPtr^.Path);

        { single event }
        if Assigned(FOnFileDelete) and (FIndex >= 0) then
          FOnFileDelete(RecPtr^.Path);

        if FPurgeDeletedFile and (FIndex >= 0) then
        begin
          FileRecords.Delete(FIndex);
          Files.Delete(Files.IndexOf(RecPtr^));
        end;
      end

      else
      begin
        case High(RecPtr^.Data) of
          -1: RecPtr^.Data := TUtils.GetFileContentAsBytes(RecPtr^.Path);

          else
          begin
            var NewBytes: TBytes := TUtils.GetFileContentAsBytes(RecPtr^.Path);
            var NewLen := Length(NewBytes);
            var OldLen := Length(RecPtr^.Data);
            var Change := (NewLen <> OldLen);

            if not Change then
              Change := not CompareMem(@NewBytes[0], @RecPtr^.Data[0], Length(NewBytes));

            if Change then
            begin
              SetLength(RecPtr^.Data, NewLen);
              Move(NewBytes[0], RecPtr^.Data[0], NewLen);

              if Assigned(FOnFileModify) then
                FOnFileModify(RecPtr^.Path, @RecPtr^.Data[0], NewLen);
            end;
          end;
        end;
      end;
    except
      On E: Exception do
        ;
    end;

    AvoidBusyWait;
  until Terminated;
end;

function TCrudeFileWatcher.Add(const F: String): TFileEvent;
begin
  if not FileExists(F) then
  begin
    Result := feFileNotFound;
    Exit;
  end;

  if FileRecords.IndexOf(F) >= 0 then
  begin
    Result := feDuplicate;
    Exit;
  end;

  var NewData := Default(TCrudeWatcherFile);
  NewData.Path := F;
  NewData.Time := Now;
  Files.Add(NewData);
  Suspended := False;
  Result := feOK;
end;

function TCrudeFileWatcher.Remove(const F: String): TFileEvent;
var
  i, FIndex: Integer;
begin
  try
    FIndex := FileRecords.IndexOf(F);
    if FIndex >= 0 then
    begin
      FileRecords.Delete(FIndex);
      for i := 0 to Files.Count -1 do
      begin
        if not (Files.Items[i].Path = F) then continue;

        Files.Delete(Files.IndexOf(Files.List[i]));
        break;
      end;

      Result := feOK;
    end

    else Result := feNoRecord;
  finally
    Suspended := (Files.Count = 0);
  end;
end;

{ TTimeManager }
procedure TTimeManager.Cancel;
begin
  Estimated := Now;
end;

constructor TTimeManager.Create;
begin
  LastTime := DEFAULT_TASK_TIME;
end;

destructor TTimeManager.Destroy;
begin

  inherited;
end;

procedure TTimeManager.Reset(const Count: Integer; const UpdateTolerance: Byte);
begin
  Tasks := Count;
  Tolerance := UpdateTolerance;
  SpreadMillis := 0;
  StartTime := Now;
end;

procedure TTimeManager.Reset(const TaskItems: TArray<TTimeManageItem>; const UpdateTolerance: Byte);
begin
  Tasks := Length(TaskItems);
  Tolerance := UpdateTolerance;
  SetLength(Items, Tasks);

  { initial time would be rough... perhaps still close, until next estimate }
  for var i := Low(TaskItems) to High(TaskItems) do
  begin
    Items[i] := @TaskItems[i];
    Items[i]^.LastTime := DEFAULT_TASK_TIME;
    Items[i]^.Spread := 0;
  end;

  SpreadMillis := 0;
  StartTime := Now;
end;

function TTimeManager.TaskTime: String;
begin
  var Str: String := MillisToTimeStr(LastTime);
  Result := Copy(Str, 1, LastDelimiter('.', Str) -1);
end;

function TTimeManager.TaskTime(const Id: Integer): String;
var
  i, idIndex: Integer;
begin
  idIndex := -1;

  for i := Low(Items) to High(Items) do
    if Id = Items[i]^.Id then
    begin
      IdIndex := i ;
      break;
    end;

  if IdIndex < 0 then Exit('--,-');

  var Str: String := MillisToTimeStr(Items[IdIndex]^.LastTime);
  Result := Copy(Str, 1, LastDelimiter('.', Str) -1);
end;

procedure TTimeManager.Estimate(const Time: NativeInt; const Index: Integer; const Solo: Boolean = False);
begin
  var EstimatedMillis: NativeInt := 0;

  try
    if High(Items) < 0 then
    begin
      { default! }
      if (Time <= 0) then
        EstimatedMillis := (Tasks *LastTime)
      else
      begin
        if (Time <> LastTime) and (Abs(Time -LastTime) >= Tolerance) then
        begin
          EstimatedMillis := (Time *(Tasks -Index));
          LastTime := Time;
        end;
      end;
    end

    { update:: task specific time update! }
    else
    begin
      { shouldnt happen! }
      if Index > High(Items) then Exit;

      var Item: PTimeManageItem := Items[Index];
      var SpreadSq: Int64 := 0;

      { update time for all matching tasks :: compare per-item, not against
        Items[Index] — the first update would alias the guard off for the rest }
      for var i := Index to High(Items) do
      begin
        if (Items[i]^.Id = Item^.Id) and (Time > 0) and
          (Abs(Time -Items[i]^.LastTime) >= Tolerance) and
          ((not Solo) or (i = Index)) then { retry evidence prices THIS task, not its class }
        begin
          { adopt the first real sample; blend after — one slow StartChannel
            <boot wait, threshold loop> must not re-price every remaining slot }
          if Items[i]^.LastTime = DEFAULT_TASK_TIME then
            Items[i]^.LastTime := Time
          else
          begin
            { spread learns first :: deviation against the pre-blend estimate }
            Items[i]^.Spread := ((Items[i]^.Spread +Abs(Time -Items[i]^.LastTime)) div 2);
            Items[i]^.LastTime := ((Items[i]^.LastTime +Time) div 2);
          end;
        end;

        { update total time }
        Inc(EstimatedMillis, Items[i]^.LastTime);
        { remaining uncertainty combines in quadrature }
        Inc(SpreadSq, Int64(Items[i]^.Spread) *Items[i]^.Spread);
      end;

      SpreadMillis := Round(Sqrt(SpreadSq));
    end;
  finally
    Estimated := IncMilliSecond(Now, EstimatedMillis);
  end;
end;

function TTimeManager.GetElapsedTime: String;
begin
  var A: TDateTime := Now;
  { epoch-absolute millis :: ~4e12 today, 32-bit NativeInt overflows on Win32 }
  var X: Int64 := DateTimeToMilliseconds(A);
  var Y: Int64 := DateTimeToMilliseconds(StartTime);
  var Z: Int64 := DateTimeToMilliseconds(Estimated);

  if (X > Z) then
  begin
    if LastElapsed = EmptyString then Result := MillisToTimeStr(0)
    else Result := LastElapsed;
  end
  else Result := MillisToTimeStr(X -Y);
  LastElapsed := Result;
end;

procedure TTimeManager.Trim;
begin
  Cancel;
end;

procedure TTimeManager.Update(const Time: NativeInt);
begin
  Estimated := IncMilliSecond(Estimated, Time);
end;

function TTimeManager.GetEstimatedTaskTime: String;
begin
  if Estimated <= 0 then Exit('--.--.-');
  Result := DateTimeToStr(Estimated);
end;

function TTimeManager.GetEstimateSpread: String;
const
  { below this the estimate is as good as the clock it prints beside ::
    hides early <nothing learned> and at the finish line <converged> }
  SPREAD_FLOOR_MS = 5000;
begin
  if (Estimated <= 0) or (SpreadMillis < SPREAD_FLOOR_MS) then Exit(EmptyString);
  if SpreadMillis < 60000 then Result := format('±%d s', [Round(SpreadMillis /1000)])
  else Result := format('±%d min', [Round(SpreadMillis /60000)]);
end;

function TTimeManager.GetProgress: Integer;
var
  TotalMS, ElapsedMS: Int64;
begin
  if Estimated <= StartTime then Exit(0);

  TotalMS   := Round((Estimated - StartTime) * 86400000);
  ElapsedMS := Round((Now - StartTime) * 86400000);

  Result := Round((ElapsedMS / TotalMS) * 100);
  if Result < 0 then Result := 0;
  if Result > 100 then Result := 100;
end;

function TTimeManager.GetTimeleft: String;
begin
  if (Estimated = 0) or (Now >= Estimated) then Exit(MillisToTimeStr(0));
  Result := MillisToTimeStr(MilliSecondsBetween(Now, Estimated));
end;

{ TAdvShortString }
procedure TAdvShortString.Update(const Str: AnsiString);
var
  S: String;
begin
  Len := Length(Str);
  FillChar(Data, Length(Data), 0);
  UnpackAnsiStr(Str, @Data, Min(Len, MAXBYTE));
end;

procedure TAdvShortString.Update(const Str: String);
var
  S: String;
begin
  Len := Length(Str);
  FillChar(Data, Length(Data), 0);
  if Len = 0 then Exit;
  UnpackAnsiStr(AnsiString(Str), @Data, Min(Len, MAXBYTE));
end;

function TAdvShortString.Text: String;
begin
  if Len = 0 then Exit('');
  PackAnsiStr(@Data, Len, Result);
end;

procedure TAdvShortString.Update(const Str: PString);
begin
  if Assigned(Str) then
    Update(Str^);
end;

procedure TAdvShortString.Update(const Value: Currency);
var
  S: String;
begin
  Update(CurrToStr(Value));
end;

procedure TAdvShortString.Update(const Value: NativeInt);
var
  S: String;
begin
  if TryIntToStr(Value, S) then
    Update(S);
end;

procedure TAdvShortString.Clear;
begin
  Len := 0;
  Data := Default(ShortStringEx);
end;

{TAppEvent}
procedure TAppEvent.Reset;
begin
  Reason := TAppEventType.etMessage;
  Code := 0;
  Msg := '';
  Trace := '';
  Overwrite := False;
  Append := False;
  Consumed := False;
  {
    Urgent belongs here :: it is a PER-EVENT request <"deliver this one
    synchronously">, and every producer reuses ONE record — the engine keeps
    a single Event field and Resets it per call. omitted, the flag was
    STICKY: one urgent event anywhere would make every later event from that
    producer take TThread.Synchronize, silently converting an async log into
    a synchronous one <and a lock-holder that logs into a deadlock>.
  }
  Urgent := False;
end;

procedure TAppEvent.WriteToBuffer(var Buf: TDynamicBuffer);
var
  MsgBytes, TraceBytes: TBytes;
  MsgLen, TraceLen: Integer;
begin
  Buf.Reset(True);

  Buf.Write(@TimeStamp, SizeOf(TDateTime));
  Buf.Write(@Reason, SizeOf(Reason));
  Buf.Write(@Code, SizeOf(Code));

  MsgBytes := TEncoding.UTF8.GetBytes(Msg);
  TraceBytes := TEncoding.UTF8.GetBytes(Trace);
  MsgLen := Length(MsgBytes);
  TraceLen := Length(TraceBytes);

  Buf.Write(@MsgLen, SizeOf(MsgLen));
  if MsgLen > 0 then Buf.Write(@MsgBytes[0], MsgLen);

  Buf.Write(@TraceLen, SizeOf(TraceLen));
  if TraceLen > 0 then Buf.Write(@TraceBytes[0], TraceLen);

  Buf.Write(@Overwrite, SizeOf(Boolean));
  Buf.Write(@Append, SizeOf(Boolean));
  Buf.Write(@Consumed, SizeOf(Boolean));
  Buf.ResetPosition;
end;

procedure TAppEvent.LoadFromBuffer(const Buf: PDynamicBuffer);
var
  MsgLen, TraceLen: Integer;
  MsgBytes, TraceBytes: TBytes;
begin
  if (Buf = nil) then Exit;

  Buf^.ResetPosition;
  Buf^.Read(TimeStamp, SizeOf(TDateTime));
  Buf^.Read(Reason, SizeOf(Reason));
  Buf^.Read(Code, SizeOf(Code));

  { message and trace }
  Buf^.Read(MsgLen, SizeOf(MsgLen));
  SetLength(MsgBytes, MsgLen);
  if MsgLen > 0 then Buf^.Read(MsgBytes[0], MsgLen);
  Msg := TEncoding.UTF8.GetString(MsgBytes);

  Buf^.Read(TraceLen, SizeOf(TraceLen));
  SetLength(TraceBytes, TraceLen);
  if TraceLen > 0 then Buf^.Read(TraceBytes[0], TraceLen);
  Trace := TEncoding.UTF8.GetString(TraceBytes);

  Buf^.Read(Overwrite, SizeOf(Boolean));
  Buf^.Read(Append, SizeOf(Boolean));
end;

{TRawBuffer}
procedure TRawBuffer.Init(const Len: Integer; ResetByte: Byte);
begin
  if Len <= 0 then Exit;

  RByte := ResetByte;
  Size := Len;
  SetLength(Bytes, Size);
  Handle := @Bytes[0];
  Reset;
end;

procedure TRawBuffer.Update(const Len: Integer);
begin
  Inc(Size, Len);
  SetLength(Bytes, Size);
  Handle := @Bytes[0];
end;

procedure TRawBuffer.Reset(Deallocate: Boolean);
begin
  Position := 0;

  if Deallocate then
  begin
    SetLength(Bytes, 0);
    Size := 0;
    Handle := nil;
  end
  else if Size > 0 then
    FillChar(Bytes[0], Size, RByte);
end;

procedure TRawBuffer.ResetPosition;
begin
  Position := 0;
end;

procedure TRawBuffer.Seek(ToByte: Integer);
begin
  if Position >= Size then Exit;
  Inc(Position, ToByte);
end;

procedure TRawBuffer.Read(var Buf; Len: Integer);
var
  R: Integer;
begin
  if Size <= 0 then Exit;

  R := Min(Len, Size -Position);
  if R <= 0 then Exit;

  Move(Bytes[Position], Buf, R);
  Inc(Position, R);
end;

procedure TRawBuffer.Write(const Data: PByte; const Len: Integer);
begin
  if Len <= 0 then Exit;

  if Handle = nil then Init(Len)
  else if (Position +Len) > Size then Update(Len);

  Move(Data^, Bytes[Position], Len);
  Inc(Position, Len);
end;

{ TRawBufferEx }

constructor TRawBufferEx.Create(const Len: Integer; const FillByte: Byte);
begin
  FBytes := nil;
  if Len <= 0 then Exit;

  SetLength(FBytes, Len);
  FillChar(FBytes[0], Len, FillByte);
end;

class operator TRawBufferEx.Explicit(const Len: Integer): TRawBufferEx;
begin
  Result := TRawBufferEx.Create(Len);
end;

class operator TRawBufferEx.Implicit(const B: TBytes): TRawBufferEx;
begin
  Result.FBytes := B;
end;

class operator TRawBufferEx.Implicit(const B: TRawBufferEx): TBytes;
begin
  Result := B.FBytes;
end;

function TRawBufferEx.GetSize: Integer;
begin
  Result := Length(FBytes);
end;

procedure TRawBufferEx.SetSize(const Value: Integer);
var
  Old: Integer;
begin
  Old := Length(FBytes);
  SetLength(FBytes, Max(Value, 0));

  { grown region starts undefined -- zero it, matching Create }
  if Length(FBytes) > Old then
    FillChar(FBytes[Old], Length(FBytes) -Old, 0);
end;

function TRawBufferEx.GetByte(Index: Integer): Byte;
begin
  Result := FBytes[Index];
end;

procedure TRawBufferEx.SetByte(Index: Integer; const Value: Byte);
begin
  FBytes[Index] := Value;
end;

procedure TRawBufferEx.Fill(const Value: Byte);
begin
  if FBytes = nil then Exit;
  FillChar(FBytes[0], Length(FBytes), Value);
end;

procedure TRawBufferEx.Reset(Deallocate: Boolean);
begin
  if Deallocate then FBytes := nil
  else Fill(0);
end;

function TRawBufferEx.Clone: TRawBufferEx;
begin
  Result.FBytes := Copy(FBytes);
end;

function TRawBufferEx.Data: PByte;
begin
  if FBytes = nil then Exit(nil);
  Result := @FBytes[0];
end;

function TRawBufferEx.AsChars: PAnsiChar;
begin
  Result := PAnsiChar(Data);
end;

function TRawBufferEx.AsString(Trm: Boolean): String;
var
  A: AnsiString;
  Z: Integer;
begin
  Result := '';
  if FBytes = nil then Exit;

  SetString(A, PAnsiChar(@FBytes[0]), Length(FBytes));

  { stop at the first #0, matching CharArrToStr on the fixed buffers }
  Z := Pos(AnsiChar(#0), A);
  if Z > 0 then SetLength(A, Z -1);

  Result := String(A);
  if Trm then Result := Trim(Result);
end;

procedure TRawBufferEx.Write(const Data: PByte; const Len: Integer);
var
  At: Integer;
begin
  if (Data = nil) or (Len <= 0) then Exit;

  At := Length(FBytes);
  SetLength(FBytes, At +Len);
  Move(Data^, FBytes[At], Len);
end;

procedure TRawBufferEx.Write(const B: TBytes);
var
  Src: TBytes;
begin
  if B = nil then Exit;

  { the local strong reference keeps B's storage alive through SetLength,
    so appending a buffer to itself reads the pre-grow bytes safely }
  Src := B;
  Write(@Src[0], Length(Src));
end;

procedure TRawBufferEx.Write(const B: TRawBufferEx);
begin
  Write(B.FBytes);
end;

procedure TRawBufferEx.Write(const S: AnsiString);
begin
  if S = '' then Exit;
  Write(PByte(PAnsiChar(S)), Length(S));
end;

procedure TRawBufferEx.Write(const S: String; const Encoding: TEncoding);
begin
  if (S = '') or (Encoding = nil) then Exit;
  Write(Encoding.GetBytes(S));
end;

procedure TRawBufferEx.WriteU8(const V: Byte);
begin
  Write(@V, SizeOf(V));
end;

procedure TRawBufferEx.WriteU16(const V: Word);
begin
  Write(@V, SizeOf(V));
end;

procedure TRawBufferEx.WriteU32(const V: Cardinal);
begin
  Write(@V, SizeOf(V));
end;

procedure TRawBufferEx.WriteU64(const V: UInt64);
begin
  Write(@V, SizeOf(V));
end;

function TRawBufferEx.WriteAt(const Offset: Integer; const Data: PByte; const Len: Integer): Integer;
begin
  Result := 0;
  if (Data = nil) or (Len <= 0) or (Offset < 0) then Exit;
  if (Offset +Len) > Length(FBytes) then Exit;

  Move(Data^, FBytes[Offset], Len);
  Result := Len;
end;

function TEthFrameHeader.DstEquals(const MAC: PAddressMAC): Boolean;
begin
  if (MAC = nil) then Exit(False);
  Exit(CompareMem(MAC, @Destination, SizeOf(TAddressMAC)));
end;

function TEthFrameHeader.SrcEquals(const MAC: PAddressMAC): Boolean;
begin
  if (MAC = nil) then Exit(False);
  Exit(CompareMem(MAC, @Source, SizeOf(TAddressMAC)));
end;

{ DPIScaler }
constructor TDPIScaler.Create(AForm: TForm);
begin
  inherited Create;
  if not Assigned(AForm) then raise Exception.Create('TDPIScaler requires a valid TForm reference');
  FForm := AForm;
  FCurrentDPI := FForm.CurrentPPI;
  if FCurrentDPI = 0 then FCurrentDPI := Screen.PixelsPerInch;
end;

destructor TDPIScaler.Destroy;
begin
  inherited;
end;

function TDPIScaler.DeviceToLogicalPixels(Value: Integer): Integer;
begin
  Result := MulDiv(Value, 96, FCurrentDPI);
end;

procedure TDPIScaler.HandleDpiChanged(NewDPI: Integer);
begin
  if NewDPI = FCurrentDPI then
    Exit;

  ScaleFormForDPI(NewDPI);
  FCurrentDPI := NewDPI;
end;

function TDPIScaler.LogicalToDevicePixels(Value: Integer): Integer;
begin
  Result := MulDiv(Value, FCurrentDPI, 96);
end;

procedure TDPIScaler.ScaleFormForDPI(NewDPI: Integer);
begin
  if not Assigned(FForm) then Exit;
  if (NewDPI > 0) and (NewDPI <> FCurrentDPI) then
    FForm.ScaleForPPI(NewDPI);
end;

procedure TDPIScaler.WM_DPICHANGED(var Msg: TWM_DPICHANGED);
var
  NewRect: TRect;
begin
  HandleDpiChanged(Msg.YAxisValue);

  if Assigned(Msg.Rect) then
  begin
    NewRect := Msg.Rect^;
    SetWindowPos(FForm.Handle, 0, NewRect.Left, NewRect.Top,
      NewRect.Right - NewRect.Left, NewRect.Bottom - NewRect.Top,
      SWP_NOZORDER or SWP_NOACTIVATE);
  end;

  Msg.Result := 0;
end;

{ TMarqueeText }

constructor TMarqueeText.Create(AOwner: TComponent; bgColor: TColor = clBtnface;  Style: TMarqueeTextStyle = tkTimer);
begin
  inherited Create(AOwner);

  Width := 200;
  Height := 28;
  Color := bgColor;
  ControlStyle := ControlStyle +[csOpaque];
  DoubleBuffered := True;
  FScrollSpeed := 70.0;
  FScrollGap := 50;
  FActive := True;
  FOffset := 0;
  FLastTick := GetTickCount64;
  FStyle := Style;

  case Style of
    tkTimer: InitializeTimer;
    tkThread: InitializeThread;
  end;

  LastState := True;
end;

destructor TMarqueeText.Destroy;
begin
  if Assigned(FTimer) then FreeAndNil(FTimer);
  if Assigned(Task) then Task.Cancel;
  inherited;
end;

procedure TMarqueeText.InitializeThread;
begin
  Task := TTask.Run(
    procedure
    begin
      repeat
        if FActive then
        begin
          TThread.Queue(nil, RunMarquee);
          AvoidBusyWait(10);
        end

        else AvoidBusyWait(QTR_SEC);
      until (Task.Status in [TTaskStatus.Canceled]) or FClosing;

      Visible := False;
    end
  ).Start;
end;

procedure TMarqueeText.InitializeTimer;
begin
  FTimer := TTimer.Create(Self);
  FTimer.Interval := 1;
  FTimer.OnTimer := TimerTick;
  FTimer.Enabled := True;
end;

procedure TMarqueeText.SetActive(const Value: Boolean; Closing: Boolean);
begin
  FClosing := Closing;

  if FActive <> Value then
  begin
    FActive := Value;
    FLastTick := GetTickCount64;
    case FStyle of
      tkTimer: FTimer.Enabled := FActive;
      tkThread: ;
    end;

    Visible := Value;
    LastState := Value;
    Invalidate;
  end;
end;

procedure TMarqueeText.SetScrollSpeed(const Value: Double);
begin
  FScrollSpeed := Value;
end;

procedure TMarqueeText.SetScrollGap(const Value: Integer);
begin
  if FScrollGap <> Value then
  begin
    FScrollGap := Value;
    Invalidate;
  end;
end;

procedure TMarqueeText.CMTextChanged(var Message: TMessage);
begin
  inherited;
  RecalcTextWidth;
  FOffset := 0;
  Invalidate;
end;

procedure TMarqueeText.CMFontChanged(var Message: TMessage);
begin
  inherited;
  RecalcTextWidth;
  Invalidate;
end;

procedure TMarqueeText.Resize;
begin
  inherited;
  Invalidate;
end;

procedure TMarqueeText.RunMarquee;
var
  NowTick: UInt64;
  Delta: Double;
  Period: Integer;
begin
  try
    if (Caption = '') or FClosing then
      Exit;

    NowTick := GetTickCountEx;
    Delta := (NowTick -FLastTick) /1000.0;
    FLastTick := NowTick;
    FOffset := FOffset +FScrollSpeed *Delta;
    Period := FTextWidth +FScrollGap;

    if Period > 0 then
      while FOffset >= Period do
        FOffset := FOffset -Period;
  finally
    Invalidate;
  end;
end;

procedure TMarqueeText.RecalcTextWidth;
begin
  Canvas.Font.Assign(Font);
  FTextWidth := Canvas.TextWidth(Caption);
end;

procedure TMarqueeText.TimerTick(Sender: TObject);
begin
  RunMarquee;
end;

procedure TMarqueeText.UpdateFont(const Name: String; const Size: Integer; const Style: TFontStyle; const Clr: TColor);
begin
  Font.Name := Name;
  Font.Size := Size;
  Font.Style := Font.Style +[Style];
  Font.Color := Clr;
end;

procedure TMarqueeText.UpdateGap(const Gap: Integer);
begin
  FScrollGap := Gap;
end;

procedure TMarqueeText.UpdateSpeed(const Speed: Byte);
begin
  FScrollSpeed := Speed;
end;

procedure TMarqueeText.UpdateText(const Str: String; Colour: TColor);
begin
  Caption := Str;
  Font.Color := Colour;
end;

procedure TMarqueeText.Paint;
var
  X: Integer;
  Y: Integer;
  Period: Integer;
begin
  Canvas.Brush.Color := Color;
  Canvas.FillRect(ClientRect);
  if Caption = '' then
    Exit;
  Canvas.Font.Assign(Font);
  Canvas.Brush.Style := bsClear;
  if FTextWidth <= 0 then
    RecalcTextWidth;
  Y := (ClientHeight - Canvas.TextHeight(Caption)) div 2;
  Period := FTextWidth + FScrollGap;
  if Period <= 0 then
    Exit;
  X := -Round(FOffset);
  while X < ClientWidth do
  begin
    Canvas.TextOut(X, Y, Caption);
    Inc(X, Period);
  end;
end;

{ TMonitorChangeEvent }
constructor TMonitorChangeWatcher.Create(AOwner: TComponent; AForm: TForm; OnMonitorChange: TMonitorChangeEvent; OnDPIScaleChange: TDPIScaleChangeEvent; OnThemeChange: TOSThemeChanged);
begin
  inherited Create(AOwner);

  if not Assigned(AForm) then
    raise Exception.Create('TMonitorChangeWatcher requires a valid TForm reference.');

  FForm := AForm;
  FCurrentMonitor := Screen.MonitorFromWindow(FForm.Handle);

  { hook the form's window procedure }
  FOldWndProc := FForm.WindowProc;
  FForm.WindowProc := WindowProc;

  { callbacks }
  FOnMonitorChanged := OnMonitorChange;
  FOnDPIScaleChanged := OnDPIScaleChange;
  FOnThemeChanged := OnThemeChange;

  { base font :: also available through TUtils.BaseFont }
  FBaseFont := TFont.Create;
  FBaseFont.Assign(Application.DefaultFont);
end;

procedure TMonitorChangeWatcher.WindowProc(var Msg: TMessage);
var
  NewMonitor: TMonitor;
  NewDPI: Integer;
begin
  case Msg.Msg of
    WM_WINDOWPOSCHANGED:
    begin
      NewMonitor := Screen.MonitorFromWindow(FForm.Handle);
      if NewMonitor <> FCurrentMonitor then
      begin
        FCurrentMonitor := NewMonitor;
        MonitorChanged(FCurrentMonitor);
      end;
    end;

    WM_DISPLAYCHANGE:
    begin
      NewMonitor := Screen.MonitorFromWindow(FForm.Handle);
      if NewMonitor <> FCurrentMonitor then
      begin
        FCurrentMonitor := NewMonitor;
        MonitorChanged(FCurrentMonitor);
      end;
    end;

    WM_DPICHANGED:
    begin
      NewDPI := HIWORD(Msg.WParam);
      if NewDPI <> FCurrentDPI then
      begin
        DPIChanged(FCurrentDPI, NewDPI);
        FCurrentDPI := NewDPI;
      end;

      { honor Windows' suggested rectangle }
      if Msg.LParam <> 0 then
        SetWindowPos(
          FForm.Handle,
          0,
          PRect(Msg.LParam)^.Left,
          PRect(Msg.LParam)^.Top,
          PRect(Msg.LParam)^.Width,
          PRect(Msg.LParam)^.Height,
          SWP_NOZORDER or SWP_NOACTIVATE
        );
    end;

    WM_SETTINGCHANGE:
      if FAutoTheme then
      begin
        if not FUsingWebUI then TUtils.UpdateStyle;
        if Assigned(FOnThemeChanged) then FOnThemeChanged(FForm);
      end;
  end;

  FOldWndProc(Msg);
end;

destructor TMonitorChangeWatcher.Destroy;
begin
  FreeAndNil(FBaseFont);
  inherited;
end;

procedure TMonitorChangeWatcher.DPIChanged(const OldDPI, NewDPI: Integer);
var
  Scale: Single;
begin
  if (OldDPI <= 0) or (NewDPI <= 0) then
    Exit;

  if OldDPI = NewDPI then
    Exit;

  Scale := NewDPI / OldDPI;

  if Assigned(FOnDPIScaleChanged) then
    FOnDPIScaleChanged(Self, OldDPI, NewDPI, Scale);
end;

procedure TMonitorChangeWatcher.MonitorChanged(Monitor: TMonitor);
var
  DPI: Integer;
  Scale: Double;
begin
  DPI := 96;
  Scale := 1.0;

  if Assigned(FForm) then
  begin
    if Win32MajorVersion >= 10 then
      DPI := GetDpiForWindow(FForm.Handle);
    Scale := DPI /96;
  end;

  if Assigned(FOnMonitorChanged) then FOnMonitorChanged(Self, Monitor, DPI, Scale);
end;

{ TCallbackHelper }
procedure TCallbackHelper.NumbersOnly(Sender: TObject; var Key: Char);
begin
  with TEdit(Sender) do
  begin
    if not CharInSet(Key, ['0'..'9', '.', '-', '+', #8]) then
    begin
      Key := #0;
      Exit;
    end;

    if (Key = '.') and (Pos('.', Text) > 0) then Key := #0;
    if (Key = '-') and (Pos('-', Text) > 0) then Key := #0;
    if (Key = '+') and (Pos('+', Text) > 0) then Key := #0;
  end;
end;

procedure TCallbackHelper.NumbersOnlyRange(Sender: TObject; var Key: Char);
var
  Str: String;
  StrArr: TArray<String>;
begin
  with TEdit(Sender) do
  begin
    Str := Trim(Text);

    if (Str <> EmptyString) then
    begin
      { check entries for order! no invalid dups }
      if (Text[Length(Str)] = '-') and ((Key = '-') or (Key = ','))  then
        Key := #0;

      if (Text[Length(Str)] = ',') and ((Key = '-') or (Key = ',')) then
        Key := #0;

      if (Key = '-') then
      begin
        if Pos('-', Str, LastDelimiter(',', Str)) > 0 then Key := #0
        else if (Pos(',', Str) <= 0) and (Pos('-', Str) <> 0) then Key := #0;
      end;
    end;

    NumbersOnlyExcept(Sender, Key, [',', '-']);

    { auto control spacing... format entry }
    if Key = ',' then
    begin
      StrArr := Str.Split([',']);
      if High(StrArr) < 0 then Exit;
      Text := EmptyString;
      for Str in StrArr do Text := Text +Trim(Str) +', ';
      SelStart := Length(Text);
      Key := #0;
    end;
  end;
end;

