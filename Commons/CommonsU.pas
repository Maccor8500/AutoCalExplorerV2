procedure TFileWriter.WriteFile(const path: String);
begin
  if not Active then Exit;
  try
    TThread.CreateAnonymousThread(
    procedure
      var
      R : TFileReader;
      S : String;
    begin
      R := TFileReader.Create(path);
      try
        while R.ReadLine(S) do
          Write(S);
      finally
        FreeAndNil(R);
      end;
    end).Start;
  except
    On E: Exception do
      {nothing!}
  end;
end;

