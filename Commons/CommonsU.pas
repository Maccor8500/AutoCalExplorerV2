function PingUSB(const Serial: String; var Msg: string): Boolean;
var
  Locator, WMIService, USBDevices, USBDevice: OLEVariant;
  Enum: IEnumVariant;
  Fetched: Cardinal;
  DeviceSerial: string;
begin
  Result := False;
  Msg := '';
  if Serial = '' then
  begin
    Msg := 'Empty Serial String!';
    Exit;
  end;

  CoInitialize(nil);
  try
    try
      Locator := CreateOleObject('WbemScripting.SWbemLocator');
      WMIService := Locator.ConnectServer('.', 'root\cimv2');

      USBDevices := WMIService.ExecQuery(
        'SELECT * FROM Win32_USBHub', 'WQL', 0);

      Enum := IUnknown(USBDevices._NewEnum) as IEnumVariant;
      while Enum.Next(1, USBDevice, Fetched) = 0 do
      begin
        DeviceSerial := USBDevice.DeviceID;
        if Pos(Serial, DeviceSerial) > 0 then
        begin
          Result := True;
          Msg := 'Found: ' + DeviceSerial;
          Break;
        end;
        USBDevice := Unassigned;
      end;

      if not Result then
        Msg := 'Device not found.';
    except
      on E: Exception do
        Msg := 'Error: ' + E.Message;
    end;
  finally
    CoUninitialize;
  end;
end;

