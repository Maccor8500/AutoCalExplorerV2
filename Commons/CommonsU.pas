procedure PackSystemChannelSpecs;
var
  Chan: Integer;
  ChanSpec: PChParm;
  Config: PMaccorChannelConfig;
begin
  if MacSysPtr = nil then Exit;

  SetLength(MacSysPtr^.Specs, MacSysPtr^.SysCfg.ChanCount);

  for Chan := Low(MacSysPtr^.Specs) to High(MacSysPtr^.Specs) do
  begin
    Config := @MacSysPtr^.Specs[Chan];
    MacSysPtr^.GetChannelDataNormal(Chan, ChanSpec);
    if ChanSpec = nil then break;

    { channel span :: once! not range based -> system-wide! }
    if Config^.Current.Span <= 0 then
    begin
      Config^.Voltage.Min := ChanSpec^.MinV;
      Config^.Voltage.Max := ChanSpec^.MaxV;
      Config^.Voltage.Span := (ChanSpec^.MaxV -ChanSpec^.MinV);
      Config^.Current.Min := ChanSpec^.Chg.ILim;
      Config^.Current.Max := ChanSpec^.Chg.IMax;
      Config^.Current.Span := (ChanSpec^.Chg.IMax +ChanSpec^.Chg.ILim);
    end;

    { range max }
    if ChanSpec^.Chg.Ratio1 <> 0 then
    begin
      Config^.Range[0].Charge := (ChanSpec^.Chg.IMax /ChanSpec^.Chg.Ratio1);
      Config^.Range[0].Discharge := (ChanSpec^.Dis.IMax /ChanSpec^.Chg.Ratio1);
    end
    else
    begin
      Config^.Range[0].Charge := ChanSpec^.Chg.IMax;
      Config^.Range[0].Discharge := ChanSpec^.Dis.IMax;
    end;

    if ChanSpec^.Chg.Ratio2 <> 0 then
    begin
      Config^.Range[1].Charge := (ChanSpec^.Chg.IMax /ChanSpec^.Chg.Ratio2);
      Config^.Range[1].Discharge := (ChanSpec^.Dis.IMax /ChanSpec^.Chg.Ratio2);
    end
    else
    begin
      Config^.Range[1].Charge := ChanSpec^.Chg.IMax;
      Config^.Range[1].Discharge := ChanSpec^.Dis.IMax;
    end;

    if ChanSpec^.Chg.Ratio3 <> 0 then
    begin
      Config^.Range[2].Charge := (ChanSpec^.Chg.IMax /ChanSpec^.Chg.Ratio3);
      Config^.Range[2].Discharge := (ChanSpec^.Dis.IMax /ChanSpec^.Chg.Ratio3);
    end
    else
    begin
      Config^.Range[2].Charge := ChanSpec^.Chg.IMax;
      Config^.Range[2].Discharge := ChanSpec^.Dis.IMax;
    end;

    Config^.Range[3].Charge := ChanSpec^.Chg.IMax;
    Config^.Range[3].Discharge := ChanSpec^.Dis.IMax;
  end;
end;

