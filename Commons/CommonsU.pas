// NEVER free, dispose or whatever.. the result pointer from ReceiveData().!!
// It is maintained by this class.
function THxUdpSocket.ReceiveData( var iSize: integer ): pointer;
var
  iRAlen, iRcvRes: integer;
begin
  result := nil;

  if CanRead then
  begin
    iSize := 0;
    if winsock.ioctlSocket( sktSocket, FIONREAD, iSize )<> 0 then
    begin
      Notify('Ioctl went wrong, message: '+GetSocketLastError );
      exit;
    end;

    if Assigned( pRcvBuf )then
      FreeMem( pRcvBuf );

    pRcvBuf := AllocMem( iSize );

    iRALen := Sizeof( rRcvAddress );
    iRcvRes := UdpRecvFrom( sktSocket, pRcvBuf, iSize, 0, rRcvAddress, iRALen );
    if iRcvRes < 0 then
      Notify( GetSocketLastError )
    else
    begin
      sRcvAddress := String(AnsiString(winsock.Inet_NtoA( rRcvAddress.sin_addr)));
      sRcvPort := IntToStr( NtoHs( rRcvAddress.sin_port ));
    end;

    iSize := iRcvRes;

    if iRcvRes <= 0 then
      result := nil
    else
      result := pRcvBuf;
  end;

end;

function THxUdpSocket.SendData(ptr: pointer; iSize: integer): boolean;
var
  iRes: integer;
begin
  iRes := UdpSendTo( sktSocket, ptr, iSize, 0, rRemoteAddress,
                       Sizeof( rRemoteAddress ));
  result := iRes >= 0;
end;

function THxUdpSocket.BindSocket: boolean;
//var
//  OptVal: DWORD;  //added June 2021 SL
//  Ret : Integer;  //added June 2021 SL
begin
  result := False;
  if sPortNr = UNSET then
    raise Exception.Create('UDP Server-port not set');

  if sktSocket = INVALID_SOCKET then
    sktSocket := Socket( AF_INET, SOCK_STREAM, 0 );

  if sktSocket = INVALID_SOCKET then
  begin
    Notify( GetSocketLastError );
    exit;
  end;

  rServerAddress.sin_family := AF_INET;
  rServerAddress.sin_addr.S_addr := INADDR_ANY;

//  Optval := 1;  //added June 2021 SL
//  Ret := winsock.setsockopt (sktSocket, SOL_SOCKET, SO_REUSEADDR, @OptVal, SizeOf(OptVal));  //added June 2021 SL
//
//  if Ret = Socket_Error then  //added June 2021 SL
//  begin
//    Notify( GetSocketLastError );
//    exit;
//  end;

  if winsock.bind( sktSocket, rServerAddress, Sizeof( rServerAddress ))<> 0 then
  begin
    Notify( GetSocketLastError );
    exit;
  end;
  result := True;
end;


procedure THxUdpSocket.SetListening( bValue: boolean );
begin
  if bValue = bBound then
    exit;

  if bValue then
    bBound := BindSocket
  else
  begin
    CloseSocket;
    bBound := False;
  end;
end;

procedure THxUdpSocket.SetRemoteAddress( sAddress: String );
var
  pHe: PhostEnt;
  iInAdres: Dword;
begin
  sAddress := Trim( sAddress );
  if sAddress = '' then
    exit;

  iInAdres := winsock.Inet_addr(PAnsiChar( AnsiString(sAddress) ));  // submitted as a dotted value.??

  if iInAdres <> winsock.INADDR_NONE then
  begin
    sRemoteAddress := sAddress;
    rRemoteAddress.sin_addr.s_addr := iInAdres;
  end
  else // Try to solve the hostname..
  begin
    pHe := GetHostByName(PAnsiChar( AnsiString(sAddress )));
    if pHe = nil then
       raise Exception.Create('Invalid address: '+sAddress );
    rRemoteAddress.sin_addr := winsock.PInAddr( pHe^.h_addr_list^ )^;
    sRemoteAddress := String(AnsiString(winsock.Inet_NtoA( rRemoteAddress.sin_addr )));
  end;

  rRemoteAddress.sin_family := winsock.AF_INET;
end;

procedure THxUdpSocket.SetRemotePort( sPort: string );
var
  pSe: PServEnt;
begin
  if bConnected then
    Disconnect;

  sPort := Trim( sPort );
  if sPort = '' then
    exit;

  if IsNumber( sPort ) then
  begin
    rRemoteAddress.sin_port := HtoNS( StrToInt( sPort ));
    sRemotePort := sPort;
  end
  else
  begin
    pSe := GetServByName(PAnsiChar( AnsiString(sPort) ), nil );
    if pSe = nil then
       raise Exception.Create('Invalid port: '+sPort );
    rRemoteAddress.sin_port := pSe^.s_port;
    sRemotePort := IntToStr( NtoHS( pSe^.s_port ));
  end;
end;

