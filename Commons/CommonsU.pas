function FileSizeEx(const fpath : string) : int64;
var
{Returns file size in bytes}
  s : TFileStream;
begin
  Result := 0;
  if not FileExists(fpath) then Exit;

  s := TFileStream.Create(fPath, fmOpenRead + fmShareDenyNone);
  try
    s.Seek(0, soFromBeginning);
    Result := s.Size;
  finally
    FreeAndNil(s);
  end;
end;

function FileSizeEx(const fpath : string; const dUnit : TDataUnits) : Single;
var
  s : TFileStream;
begin
  Result := 0;
  if not FileExists(fpath) then Exit;

  s := TFileStream.Create(fPath, fmOpenRead + fmShareDenyNone);
  try
    s.Seek(0, soFromBeginning);
    Result := s.Seek(0, SoFromEnd);

    case dUnit of
      duBits: Result := Result/8;
      duBytes:Result := s.Size;
      duKiloBytes: Result := Result /1000;
      duKibiBytes: Result := Result /Power(2, 10);
      duMegaBytes: Result := Result /Power(2, 20);
      duGigaBytes: Result := Result /Power(2, 30);
      duTeraBytes: Result := Result /Power(2, 40)
    end;
  finally
    FreeAndNil(s);
  end;
end;

function SizeOfFile(const filepath : string; const dUnit : TDataUnits) : Single;
var
  fad: TWin32FileAttributeData;
  sz : Int64;
begin
  if not GetFileAttributesEx(PChar(filepath), GetFileExInfoStandard, @fad) then
    Exit(-1);
  Int64Rec(sz).Lo := fad.nFileSizeLow;
  Int64Rec(sz).Hi := fad.nFileSizeHigh;
  Result := sz;

  case dUnit of
    duBits: Result := Result/8;
    duBytes:Result := Result;
    duKiloBytes: Result := Result /1000;
    duKibiBytes: Result := Result /Power(2, 10);
    duMegaBytes: Result := Result /Power(2, 20);
    duGigaBytes: Result := Result /Power(2, 30);
    duTeraBytes: Result := Result /Power(2, 40)
  end;
end;

