      AddrStr :=
        format('%s:%s:%s:%s:%s:%s:%s:%s',
          [
            IPAddr.AsIPv6Addr.AsRAW[0], IPAddr.AsIPv6Addr.AsRAW[1],
            IPAddr.AsIPv6Addr.AsRAW[2], IPAddr.AsIPv6Addr.AsRAW[3],
            IPAddr.AsIPv6Addr.AsRAW[4], IPAddr.AsIPv6Addr.AsRAW[5],
            IPAddr.AsIPv6Addr.AsRAW[6], IPAddr.AsIPv6Addr.AsRAW[7]
          ]
