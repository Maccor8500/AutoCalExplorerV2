function InitPacketLAN(AdapterName: string): boolean;
  function GetPacketVersion: integer;
  var
    P: PAnsiChar;
    S, S1: string;
    i: integer;
  begin
    P:=PacketGetVersion;
    S:=String(P);
    S1:='0';
    for i:=1 to Length(S) do
    begin
      if not (S[i] in ['0'..'9']) then
        Break;
      S1:=S1+S[i];
    end;
    Result:=StrToInt(S1);
  end;
var
  I: integer;

begin
  if Win32Platform = VER_PLATFORM_WIN32_NT then
  begin
    case GetPacketVersion of
      0..2: PacketIns:='packet_';
      else PacketIns:='NPF_';
    end;
    Delete(AdapterName, Pos('PACKET_',UpperCase(AdapterName)),7);
    Insert(PacketIns, AdapterName, 9);
  end;

//ShowMessage('');
  SendAdapter:=PacketOpenAdapter(PAnsiChar(AdapterName));
  if SendAdapter=nil then
  begin
    Result:=false;
    Exit;
  end;
  Result:=true;
  PacketSetHWFilter(SendAdapter, 32); {NDIS_PACKET_TYPE_PROMISCUOUS = 32}
  PacketSetBuff(SendAdapter, 65536 {1024});
  PacketSetReadTimeout(SendAdapter, -1);
  PacketSetMinToCopy(SendAdapter, 1);

  ReceiveAdapter:=PacketOpenAdapter(PAnsiChar(AdapterName));
  PacketSetHWFilter(ReceiveAdapter, 32);
  PacketSetBuff(ReceiveAdapter, 1048576 {65536} {1024});  //Set the buffer to 1MB
  PacketSetReadTimeout(ReceiveAdapter, -1);
  PacketSetMinToCopy(ReceiveAdapter, 1);

  SendPacket:=PacketAllocatePacket;
  PacketInitPacket(SendPacket, @SendPacketBuffer, Length(SendPacketBuffer.PlainBuff));

  ReceivePacket:=PacketAllocatePacket;
  PacketInitPacket(ReceivePacket, @ReceivePacketBuffer, Length(ReceivePacketBuffer.GiantCharBuf));


//  RxMsgBuffer.Size:=0;
  RxMsgBuffer.WritePtr:=-1;
  RxMsgBuffer.ReadPtr:=-1;
end;

procedure ClosePacketLAN;
begin
  if SendPacket<>nil then
    PacketFreePacket(SendPacket);
  if ReceivePacket<>nil then
    PacketFreePacket(ReceivePacket);
  if SendAdapter<>nil then
    PacketCloseAdapter(SendAdapter);
  if ReceiveAdapter<>nil then
    PacketCloseAdapter(ReceiveAdapter);

  SendPacket:=nil;
  ReceivePacket:=nil;
  SendAdapter:=nil;
  ReceiveAdapter:=nil;
end;

