{$REGION ' JSONARRAY HELPER '}
{TJsonArrayHelper}
class function TJSONArrayHelper<T>.Extract(const JsonArray: TJSONArray): String;
var
  i: Integer;
  Builder: TStringBuilder;
begin
  Builder := TStringBuilder.Create;
  try
    for i := 0 to JsonArray.Count - 1 do
    begin
      if i > 0 then
        Builder.Append(', ');
      Builder.Append(
        TValue.From<T>(JsonArray.Items[i].AsType<T>).ToString
      );
    end;
    Result := Builder.ToString;
  finally
    Builder.Free;
  end;
end;

class function TJSONArrayHelper<T>.PackA(const Values: TArray<T>; const Converter: TJSONConverterA<T>): TJSONArray;
var
  Value: T; JValue: TJSONValue;
  i: Integer;
begin
  Result := TJSONArray.Create;
  for Value in Values do
  begin
    Converter(Value, JValue);
    Result.AddElement(JValue);
  end;
end;

class function TJSONArrayHelper<T>.PackB(const Values: TArray<T>; const Converter: TJSONConverterB<T>): TJSONArray;
var
  Value: T; JValue: TJSONValue;
  i: Integer;
begin
  Result := TJSONArray.Create;
  for Value in Values do
    Result.AddElement(Converter(Value));
end;

class function TJSONArrayHelper<T>.UnpackA(const JsonArray: TJSONArray; const Unpacker: TJSONUnpackerA<T>): TArray<T>;
var
  i: Integer;
  Item: T;
begin
  SetLength(Result, JsonArray.Count);
  for i := 0 to JsonArray.Count - 1 do
  begin
    Unpacker(JsonArray.Items[i], Item);
    Result[i] := Item;
  end;
end;

class function TJSONArrayHelper<T>.UnpackB(const JsonArray: TJSONArray; const Unpacker: TJSONUnpackerB<T>): TArray<T>;
var
  i: Integer;
begin
  SetLength(Result, JsonArray.Count);
  for i := 0 to JsonArray.Count - 1 do
    Result[i] := Unpacker(JsonArray.Items[i]);
end;

class function TJSONArrayHelper<T>.Unpack(const JsonArray: TJSONArray): TArray<T>;
var
  i: Integer;
begin
  SetLength(Result, JsonArray.Count);
  for i := 0 to JsonArray.Count - 1 do
    Result[i] := Worker(JsonArray.Items[i]);
end;

class function TJSONArrayHelper<T>.Worker(const Value: TJSONValue): T;
var
  Kind: TTypeKind;
  Info: PTypeInfo;
  Item: TValue;
begin
  Result := Default(T);
  Info := PTypeInfo(TypeInfo(T));
  Kind := Info^.Kind;
  Item := TValue.Empty;

  case Kind of
    tkInteger:        Item := TValue.From<Integer>(TJSONNumber(Value).AsInt);
    tkChar:           Item := TValue.From<Char>(TJSONNumber(Value).AsType<Char>);
    tkFloat:          Item := TValue.From<Double>(TJSONNumber(Value).AsDouble);
    tkString:         Item := TValue.From<String>(TJSONNumber(Value).AsType<String>);
    tkWChar:          Item := TValue.From<WChar>(TJSONNumber(Value).AsType<WChar>);
    tkVariant:        Item := TValue.From<Variant>(TJSONNumber(Value).AsType<Variant>);
    tkInt64:          Item := TValue.From<Int64>(TJSONNumber(Value).AsType<Int64>);
    tkUString:        Item := TValue.From<UnicodeString>(TJSONNumber(Value).AsType<UnicodeString>);
  end;

  if not Item.IsEmpty then Result := Item.AsType<T>;
end;

class procedure TJSONArrayHelper<T>.UnpackDouble(const Value: TJSONValue; out Item: Double);
begin
  Item := Value.AsType<Integer>;
end;

class procedure TJSONArrayHelper<T>.TryUnpackDouble(const Value: TJSONValue; out Item: T);
begin

end;

