function B64Encode(pInput: pointer; pOutput: pointer; Size: longint): longint;
var
  i, iptr, optr: integer;
  Input, Output: PByteArray;
begin
 Input:= PByteArray(pInput);
 Output:= PByteArray(pOutput);

 iptr:= 0; optr:= 0;
 for i:= 1 to (Size div 3) do
  begin
    Output^[optr+0]:= B64[Input^[iptr] shr 2];
    Output^[optr+1]:= B64[((Input^[iptr] and 3) shl 4) + (Input^[iptr+1] shr 4)];
    Output^[optr+2]:= B64[((Input^[iptr+1] and 15) shl 2) + (Input^[iptr+2] shr 6)];
    Output^[optr+3]:= B64[Input^[iptr+2] and 63];
    Inc(optr,4); Inc(iptr,3);
  end;
case (Size mod 3) of
 1: begin
    Output^[optr+0]:= B64[Input^[iptr] shr 2];
    Output^[optr+1]:= B64[(Input^[iptr] and 3) shl 4];
    Output^[optr+2]:= byte('=');
    Output^[optr+3]:= byte('=');
end;
 2: begin
    Output^[optr+0]:= B64[Input^[iptr] shr 2];
    Output^[optr+1]:= B64[((Input^[iptr] and 3) shl 4) + (Input^[iptr+1] shr 4)];
    Output^[optr+2]:= B64[(Input^[iptr+1] and 15) shl 2];
    Output^[optr+3]:= byte('=');
 end;
end;
 Result:= ((Size+2) div 3) * 4;
end;

function AnsiCopy(const S: string; const StartPos, EndPos: Integer): AnsiString;
var
  CopyLength: Integer;
begin
  { Check if StartPos is within the bounds of the string }
  if (StartPos < 1) or (StartPos > Length(S)) then Exit;
  { Check if EndPos is within the bounds of the string }
  if (EndPos < StartPos) or (EndPos > Length(S)) then Exit;

  { Calculate the length of the substring to copy }
  CopyLength := EndPos - StartPos +1;
  { Initialize the AnsiString with the required length }
  SetLength(Result, CopyLength);
  { Use Move for efficient memory copy }
  Move(S[StartPos], Result[1], CopyLength * SizeOf(AnsiChar));
end;

{$REGION ' ANSIPOS '}
{$if CompilerVersion < 24.0}
function AnsiPos(const SubStr, S: AnsiString): Integer;
var
  SubStrLen, SLen, MaxIndex, SubStrIndex: Integer;
  PSubStr, PS: PAnsiChar;
begin
  Result := 0;
  SubStrLen := Length(SubStr);
  SLen := Length(S);

  if SubStrLen = 0 then Exit(1);

  if SubStrLen > SLen then Exit(0);

  MaxIndex := SLen - SubStrLen +1;
  PSubStr := PAnsiChar(SubStr);
  PS := PAnsiChar(S);

  for Result := 1 to MaxIndex do
  begin
    SubStrIndex := 0;
    while (SubStrIndex < SubStrLen) and (PS[SubStrIndex] = PSubStr[SubStrIndex]) do
      Inc(SubStrIndex);

    if SubStrIndex = SubStrLen then Exit;
    Inc(PS);
  end;
end;
{$endif}
{$ENDREGION}

function FormatAddr(const Addr: String) : String;
var
  S, Sx : TArray<String>;
begin
  Result := Trim(Addr);
  if not ValidAddress(Addr) then Exit;

  SetLength(S, 0);
  SplitStr(Result, ':', S);

  if Length(S) > 1 then
  begin
    SplitStr(S[0], '.', Sx);
    if Length(Sx) = 4 then
      Result := format('%s.%s.%s.%s:%s', [FormatFloat('000', StrToInt(Sx[0])),
        FormatFloat('000', StrToInt(Sx[1])), FormatFloat('000', StrToInt(Sx[2])),
          FormatFloat('000', StrToInt(Sx[3])), S[1]]);
  end

  else
  begin
    SplitStr(Result, '.', S);
    Result := format('%s.%s.%s.%s', [FormatFloat('000', StrToInt(S[0])),
      FormatFloat('000', StrToInt(S[1])), FormatFloat('000', StrToInt(S[2])),
        FormatFloat('000', StrToInt(S[3]))]);
  end;
end;

procedure ParseAddr(const Addr: String; var IP: String; var Port : String);
var
  S, Sx : TArray<String>;
begin
  IP := '';
  Port := '';

  SplitStr(Addr, ':', S);

  { save port }
  if Length(S) > 1 then Port := S[1];
  { address }
  SplitStr(S[0], '.', Sx);
  IP := format('%d.%d.%d.%d', [StrToInt(Sx[0]), StrToInt(Sx[1]),
    StrToInt(Sx[2]), StrToInt(Sx[3])]);
end;

