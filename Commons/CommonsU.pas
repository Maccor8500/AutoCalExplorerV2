  ListenPort := IntToStr(LPort);

  try
    Comm := TUDPSocket.Create;
    Comm.DestinationAddress := FAddr;
    Comm.ListeningPort:= ListenPort;
    Comm.DestinationPort:= '69';
    Comm.OnDataAvailable := HandleAriadneData;
    Comm.Synchronized:=false;
    Comm.Suspended := false;
  except
    FConnected := false;
  end;
end;

procedure TAriadne.Stop;
begin
  FConnected := false;

  if Assigned(Comm) or (Comm <> nil) then
    FreeAndNil(Comm);
end;

procedure TAriadne.AddStoMsg(AnsiS : String);
var
  j: integer;
begin
  for j := 1 to Length(AnsiS) do
  begin
    TxMsg.AsASCII[TxLength] := AnsiChar(AnsiS[j]);
    Inc(TxLength);
  end;
  TxMsg.AsBytes[TxLength] := 0;
  Inc(TxLength);
end;

procedure TAriadne.Upload;
begin
  TThread.CreateAnonymousThread(
  procedure
    var
      AnsiS: String;
      SizeOfFile: Int64;
      T0, T1, TDiff : Integer;
  begin
    try
      if not FileExists(FFile) then
      begin
        //raise Exception.Create(Format('File Error: %s', [FFile]));
        Err := format('file [%s] does not exist!', [FFile]);
        Exit;
      end;

      if  Ping(AnsiString(FAddr)) and Ping(AnsiString(FAddr)) then
      begin
        TxMsg.AsBytes[0] := 0;
        TxMsg.AsBytes[1] := 2;  //Opcode 2 Write request
        TxLength := 2;
        AnsiS:=FBinID;
        AddStoMsg(AnsiS);

        AnsiS:='octet';
        AddStoMsg(AnsiS);

        FStream := TFileStream.Create(FFile, fmOpenRead or fmShareDenyNone);
        try
          AnsiS := 'tsize';
          AddStoMsg(AnsiS);
          SizeOfFile := FStream.Size;
          AnsiS := IntToStr(SizeOfFile);
          AddStoMsg(AnsiS);

          GotData := false;
          // Send TFTP write request
          if Comm.DestinationAddress <> FAddr then Comm.DestinationAddress := FAddr;
          if Comm.ListeningPort <> ListenPort then Comm.ListeningPort := ListenPort;

          // Send tftp write request!
          Self.Comm.SendData(@TxMsg.AsBytes[0], TxLength);

          // wait for TFTP write acknowledge!
          T0 := GetTickCount;
          repeat
            T1 := GetTickCount;
            TDiff := (T1 -T0);
          until GotData or (TDiff > 3000);

          // TFTP acknowledge our write request
          if GotData then
          begin
            BytesRead := 0;
            LostReplies := 0;

            repeat
              OpCode:=(RxMsg.AsBytes[0] shl 8)+RxMsg.AsBytes[1];

              if OpCode = 4 then //Acknowledgment (ACK)
              begin
                Block:=(RxMsg^.AsBytes[2] shl 8) +RxMsg^.AsBytes[3];
                Comm.DestinationPort:=FClientPort;

                FStream.Seek(Block*512, soFromBeginning);
                BytesRead:=FStream.Read(TxMsg.AsBytes[4], 512);

                Inc(Block);
                TxMsg.AsBytes[0]:=0;
                TxMsg.AsBytes[1]:=3;  //3     Data (DATA)
                TxMsg.AsBytes[2]:= Block shr 8;
                TxMsg.AsBytes[3]:= Block and $FF;
                TxLength:=BytesRead+4;
                Comm.SendData(@TxMsg.AsBytes[0], TxLength);

                GotData:=false;
                T0:=GetTickCount;
                repeat
                  T1:=GetTickCount;
                  TDiff := (T1 - T0);
                until GotData or (TDiff> 1000);

                if GotData then LostReplies:=0
                else Inc(LostReplies);

                if BytesRead > 0 then
                begin
                  FPercent := Round(((Block-1)*512+BytesRead) /SizeOfFile*100);
                  if ProgPtr <> nil then
                    PWord(ProgPtr)^ := FPercent;
                  Sleep(1);
                end;
              end;
            until (BytesRead=0) or (LostReplies>2) or Quit;
          end;

        finally
          FStream.Free;
        end;
      end
      else
        Err := Format('Address: %s Unreachable', [FAddr]);

    finally
      Stop;                               // kill process
    end;
  end).Start;
end;

{ TAriadneEx }
constructor TAriadneEx.Create(const BindAddr: String);
begin
  inherited Create;
  RxEvent := TEvent.Create(nil, True, False, '');
  Sock := TUdpSocketEx.Create(0, OnData, nil, nil, BindAddr);
end;

destructor TAriadneEx.Destroy;
begin
  FreeAndNil(Sock);                          // its thread calls OnData: free it before the event
  FreeAndNil(RxEvent);
  inherited;
end;

procedure TAriadneEx.OnData(const Payload: PSocketPayload);
begin
  if (Payload = nil) or (Payload^.Size < 4) then Exit;
  RxOp    := (Payload^.AsBytes[0] shl 8) or Payload^.AsBytes[1];
  RxBlock := (Payload^.AsBytes[2] shl 8) or Payload^.AsBytes[3];
  RxPort  := Payload^.Remote.Port;
  if RxOp = TFTP_ERROR then
  begin
    var S: AnsiString;
    SetString(S, PAnsiChar(@Payload^.AsBytes[4]), Payload^.Size - 4);
    RxText := TrimRight(String(S));
  end;
  RxEvent.SetEvent;
end;

function TAriadneEx.Await(const Block: Word; const Timeout: Cardinal): Boolean;
begin
  Result := False;
  var T0 := GetTickCount64;
  repeat
    var Left := Int64(Timeout) - Int64(GetTickCount64 - T0);
    if (Left <= 0) or (RxEvent.WaitFor(Cardinal(Left)) <> wrSignaled) then Exit;
    RxEvent.ResetEvent;
    if RxOp = TFTP_ERROR then begin FError := 'board error: ' + RxText; Exit; end;
    if (RxOp = TFTP_ACKNOWLEDGE) and (RxBlock = Block) then Exit(True);     // stale or duplicate ACKs are ignored
  until False;
end;

function TAriadneEx.Put(const Host, FileName, Name: String; const Progress: TProc<Int64, Int64>;
  const Cancel: TFunc<Boolean>): Boolean;
begin
  Result := False;
  FError := '';
  if not FileExists(FileName) then begin FError := 'file not found: ' + FileName; Exit; end;

  var BinName := Name;
  if BinName = '' then BinName := ExtractFileName(FileName);

  var Stream := TFileStream.Create(FileName, fmOpenRead or fmShareDenyNone);
  try
    var Total := Stream.Size;
    var Req := TEncoding.ASCII.GetBytes(BinName) + [0] + TEncoding.ASCII.GetBytes('octet') + [0]
      + TEncoding.ASCII.GetBytes('tsize') + [0] + TEncoding.ASCII.GetBytes(IntToStr(Total)) + [0];
    Req := [0, TFTP_WRITE_REQUEST] + Req;

    var Acked := False;
    for var Attempt := 1 to WRQ_TRIES do
    begin
      if Assigned(Cancel) and Cancel() then begin FError := 'cancelled'; Exit; end;
      RxEvent.ResetEvent;
      Sock.SendData(Host, TFTP_SERVER_PORT, Req[0], Length(Req));
      Acked := Await(0, WRQ_TIMEOUT_MS);
      if Acked or (FError <> '') then Break;
      Sleep(WRQ_RETRY_MS);
    end;
    if not Acked then
    begin
      if FError = '' then FError := 'no answer to the write request (is the board in the bootloader?)';
      Exit;
    end;

    var DataPort := RxPort;                  // the bootloader moves the transfer to its own port
    var Chunk: TBytes;
    SetLength(Chunk, 4 + TFTP_DATA_SIZE);
    var Block: Word := 1;
    var Sent: Int64 := 0;
    var N: Integer;
    repeat
      if Assigned(Cancel) and Cancel() then begin FError := 'cancelled'; Exit; end;
      N := Stream.Read(Chunk[4], TFTP_DATA_SIZE);
      Chunk[0] := 0; Chunk[1] := TFTP_DATA; Chunk[2] := Block shr 8; Chunk[3] := Block and $FF;

      var Tries := 0;
      repeat
        RxEvent.ResetEvent;
        Sock.SendData(Host, DataPort, Chunk[0], 4 + N);
        Inc(Tries);
        Acked := Await(Block, ACK_TIMEOUT_MS);
      until Acked or (FError <> '') or (Tries >= LOST_LIMIT);
      if not Acked then
      begin
        if FError = '' then FError := Format('block %d: no ACK after %d tries', [Block, Tries]);
        Exit;
      end;

      Inc(Sent, N);
      if Assigned(Progress) then Progress(Sent, Total);
      Inc(Block);
    until N < TFTP_DATA_SIZE;                  // a file that is an exact multiple of 512 ends with an empty block
    Result := True;
  finally
    Stream.Free;
  end;
end;

{ TAriadneManagerEx }

constructor TAriadneManagerEx.Create(const MaxParallel: Integer);
begin
  inherited Create;
  Gate := TSemaphore.Create(nil, MaxParallel, MaxParallel, '');
  Stop := TEvent.Create(nil, True, False, '');
  Lock := TCriticalSection.Create;
  Pending := TList<IFuture<String>>.Create;
end;

destructor TAriadneManagerEx.Destroy;
begin
  Cancel;
  for var F in Pending do F.Wait(10000);     // every wait inside a job honours Stop, so this ends quickly
  FreeAndNil(Pending);
  FreeAndNil(Lock);
  FreeAndNil(Stop);
  FreeAndNil(Gate);
  inherited;
end;

procedure TAriadneManagerEx.Cancel;
begin
  Stop.SetEvent;
end;

function TAriadneManagerEx.Add(const Host, FileName, BindAddr, Name: String;
  const Progress: TProc<Int64, Int64>): IFuture<String>;
begin
  Stop.ResetEvent;                           // a new job after Cancel starts a fresh batch
  Result := TTask.Future<String>(
    function: String
    begin
      { queued jobs wait for a free slot, but a Cancel frees them at once }
      repeat
        if Stop.WaitFor(0) = wrSignaled then Exit('cancelled');
      until Gate.WaitFor(200) = wrSignaled;
      try
        var Ari := TAriadneEx.Create(BindAddr);
        try
          if Ari.Put(Host, FileName, Name, Progress,
               function: Boolean begin Result := Stop.WaitFor(0) = wrSignaled; end) then Result := ''
          else Result := Ari.Error;
        finally
          Ari.Free;
        end;
      finally
        Gate.Release;
      end;
    end);

  Lock.Enter;
  try
    for var I := Pending.Count - 1 downto 0 do         // drop finished jobs, so the list stays small
      if Pending[I].Status = TTaskStatus.Completed then Pending.Delete(I);
    Pending.Add(Result);
  finally
    Lock.Leave;
  end;
end;

