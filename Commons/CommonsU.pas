end;

procedure GetBrdConfig(MacEnv : PMaccorSystem);
var
  S: TFileStream;
  I, Brd, DataSz: Integer;
  BrdData: BrdTypeStruct;
begin
  if MacEnv = nil then Exit;
  if not FileExists(MacEnv^.BrdCfgFile) then Exit;
  DataSz := SizeOf(BrdTypeStruct);

  S := TFileStream.Create(MacEnv^.BrdCfgFile, fmOpenRead +fmShareDenyNone);
  try
    S.Seek(0, soFromBeginning);
    SetLength(MacEnv^.BrdData, Round(S.Size /DataSz));
    SetLength(MacEnv^.BrdDataNorm, Length(MacEnv^.BrdData));

    for Brd := Low(MacEnv^.BrdData) to High(MacEnv^.BrdData) do
    begin
      if S.Read(BrdData, DataSz) = DataSz then
      begin
        with MacEnv^.BrdData[Brd] do
        begin
          BrdType := BrdData.BrdType;
          BrkType := BrdData.BrkType;
          ActiveChan := BrdData.ActiveChan;
          MinorTic :=  BrdData.minorTic;
          Ad_Speed := BrdData.ad_speed;
          for i := 1 to 8 do SpecialDevice[i] := WideChar(BrdData.SpecialDevice[i]);
          for i := 1 to 4 do BrdVersion[i] := WideChar(BrdData.BrdVersion[i]);
          ACimpInProgress := Min(BrdData.ACimpInProgress, MaxInt);
          SWFlags := BrdData.SWFlags;
          FirstChanOnBrd := BrdData.FirstChanOnBrd;
          PowerFailFlag := BrdData.PowerFailFlag;
          Flags := BrdData.Flags;
          DoorInterLockFlag := BrdData.DoorInterLockFlag;
          SpecialRange := BrdData.SpecialRange;
          RAttn := BrdData.RAttn;
          SpareA := BrdData.SpareA;
          LastERsetPos := BrdData.LastERsetPos;
          Dummy := BrdData.Dummy;
          LastERsetTime := BrdData.LastERsetTime;

          PWR_OFF_USER := BrdData.PWR_OFF_USER;
          CHG_CD_USER := BrdData.CHG_CD_USER;
          ISO_CONN_USER := BrdData.ISO_CONN_USER;
          DL_lost_heartbeat := BrdData.DL_lost_heartbeat;
          LastWFBrdPosChecked := BrdData.LastWFBrdPosChecked;

          if MacEnv^.SysId = t50msPrimaryHV then
            BrdData.ActiveChan := 31;
        end;

        MacEnv^.BrdDataNorm[Brd] := BrdData;
      end;
    end;
  finally
    FreeAndNil(S);
  end;
end;

