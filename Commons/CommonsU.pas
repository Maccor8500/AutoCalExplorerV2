function NetAddr(const Addr : TIPv4AddrBytes): Cardinal;
var
  AStr : String;
  InAddr: TInAddr;
  WSA : TWSAData;
begin
  Result := INADDR_NONE;
  FillChar(InAddr, SizeOf(TInAddr), 0);
  WSAStartup(MakeWord($02, $02), WSA);

  try
    AddrToStr(Addr, AStr);
	{$ifndef VER300}
    if Inet_Pton(AF_INET, PAnsiChar(AnsiString(AStr)), @InAddr) = 1 then
  {$else}
    InAddr.S_addr := Inet_Addr(PAnsiChar(AnsiString(AStr)));
	{$endif}
      Result := InAddr.S_addr;
  finally
    WSACleanup;
  end;
end;

function NetAddr(const Addr : ShortString): Cardinal;
var
  A : TNetAddrConv;
  B : TArray<String>;
  i: Integer;
begin
  SplitStr(String(Addr), '.', B);
  for i := Low(B) to High(B) do
    A.AsBytes[i] := StrToInt(B[i]);
  Result := A.As32Bits;
end;

