constructor TAriadneManager.Create(const StartPort : Word = 55555; const MaxThreads : Byte = 5);
var
  i: Integer;
begin
  try
    AllowedMax := MaxThreads;
    Total := Default(Byte);
    Port := StartPort;
    Timer := TTimer.Create(nil);
    Timer.OnTimer := OnTimer;
    Timer.Interval := 500;
    Timer.Enabled := False;
    Queue := TQueue<TAriadne>.Create;
    Queue.Capacity := 500;
    ReservedPorts := TStringList.Create;
    GetResvdPorts;
    SetLength(Ariadnes, MaxThreads);
    for i := Low(Ariadnes) to High(Ariadnes) do
      Ariadnes[i] := Default(TAriadne);
  except
  end;
end;

destructor TAriadneManager.Destroy;
begin
  Timer.Enabled := false;
  while (Timer.Tag > 0) do;
  FreeAndNil(Timer);
  FreeAndNil(ReservedPorts);
  Queue.Clear;
  FreeAndNil(Queue);

  inherited Destroy;
end;

procedure TAriadneManager.GetResvdPorts;
const
  p = 'ports.bat';
  o = 'ports.tmp';
var
  W : TFileWriter;
  R : TFileReader;
  Line,Pt : String;
  LineA: TArray<String>;
  TInt : Integer;
begin
  try
    W := TFileWriter.Create;
    try
      W.Open(p, true);
      W.Write('netstat -ano > ports.tmp');
      W.Close;
    finally
      FreeANdNil(W);
    end;

    if FileExists(p) then
    begin
      ShellExecute(AppHandle, PWideChar('runas'), PWideChar(p),
                  PWideChar(''),  PWideChar(''), SW_HIDE);
      Sleep(250);
      if FileExists(o) then
      begin
        R := TFileReader.Create(o);
        try
          ReservedPorts.Clear;

          while R.ReadLine(Line) do
          begin
            if AnsiPos('UDP', Line) = 0 then continue;
            SplitStr(Line, '*', LineA);
            Pt := Trim(LineA[Length(LineA) -1]);
            if TryStrToInt(Pt, TInt) then
            begin
              if ValidPort(TInt) then
              begin
                if ReservedPorts.IndexOf(Pt) >= 0 then continue;
                ReservedPorts.Append(Pt);
              end;
            end;
          end;

          R.Close;
        finally
          FreeAndNil(R);
        end;
        DeleteFile(o);
      end;

      Sleep(50);
      DeleteFile(p);
    end;
  except
  end;
end;

