function TArrayManip<T>.clear: boolean;
var
  i: Integer;
begin
  Result := False;
  if Size <= 0 then Exit;


  for i := 0 to size -1 do
    aDataArr[i] := T(nil);

  SetLength(aDataArr, 0);
  Result := True;
end;

constructor TArrayManip<T>.Create;
begin
  SetLength(aDataArr, 0);
  Self.aDuplicate := false;
  Self.aDataLoc := -1;

  case PTypeInfo(TypeInfo(T))^.Kind of
    tkClass: aObjType := otClass;
    else
      aObjType := otRec;
  end;

  {Comparer := TEqualityComparer<T>.Create;}
end;

function TArrayManip<T>.equal(const itemA, itemB: T): boolean;
var
  comp : IComparer<T>;
begin
  comp := TComparer<T>.Default;
  Result := Comp.Compare(itemA, itemB) = 0;
end;

function TArrayManip<T>.same(const itemA, itemB: T): boolean;
var
  sA, sB : TBytesStream;
  //b1, b2 : TBytes;
begin
  sA := TBytesStream.Create;
  sB := TBytesStream.Create;

  try
    sA.WriteData(@itemA, SizeOf(T));
    sB.WriteData(@itemB, SizeOf(T));

    //b1 := sA.Bytes;
    //b2 := sB.Bytes;
    Result := Compare(sA, SB);
  finally
    FreeAndNil(sA);
    FreeAndNil(sB);
  end;
end;

function TArrayManip<T>.exists(const item: T): boolean;
begin
  Result := indexOf(item) >= 0;
end;

function TArrayManip<T>.firstIndex(const item: T): integer;
begin
  Result := -1;

  if aDuplicate then
  begin
    Result := indexOf(item);
    aDataLoc := Result;
  end;
end;

function TArrayManip<T>.get(const index: integer): T;
begin
  Result := T(nil);
  if validIndex(index) then
    Result := aDataArr[index];
end;

function TArrayManip<T>.getAddr(const index: integer): Pointer;
begin
  Result := nil;
  if validIndex(index) then
    Result := @aDataArr[index];
end;

function TArrayManip<T>.getByTag(const tag: integer): T;
begin
    Result := Default(T);
end;

function TArrayManip<T>.next(const item: T): integer;
var
  i : integer;
begin
  Result := -1;

  if aDuplicate then
    if validIndex(aDataLoc) then
    begin
      Result := indexOf(item, aDataLoc +1);
      aDataLoc := Result;
    end;
end;

function TArrayManip<T>.NextItem(var item: T): SmallInt;
begin
  Result := -1;

  if Position <= Size -1 then
  begin
    item := aDataArr[Position];
    Inc(Position);
    Result := Position;
  end;
end;

procedure TArrayManip<T>.NextPtr(item: Pointer);
begin
  item := nil;

  if Position <= Size -1 then
  begin
    item := @(aDataArr[Position]);
    Inc(Position);
  end;
end;

function TArrayManip<T>.findAll(const item: T): TArray<Integer>;
begin
  Result := nil;

  if aDuplicate then
  begin
    aDataLoc := firstIndex(item);
    if aDataLoc < 0 then Exit;

    SetLength(Result, Length(Result) +1);
    Result[Length(Result) -1] := aDataLoc;

    while Next(item) >= 0 do
    begin
      SetLength(Result, Length(Result) +1);
      Result[Length(Result) -1] := aDataLoc;
    end;
  end;
end;

function TArrayManip<T>.findIndex(const item: T): integer;
var
  i: Integer;
  {TEqualityComparer<T>.Default;}
begin
  Result := -1;
  for i := 0 to Length(aDataArr) -1 do
  begin
    if Comparer.Equals(aDataArr[i], item) then
    begin
      Result := i;
      Exit;
    end;
  end;
end;

