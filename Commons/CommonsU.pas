procedure GetFiles(const Dir: String; var FilePaths : TArray<String>; SubFolders : Boolean; Filter: String);
var
  SRec: TSearchRec;
  Res: Integer;
  path : String;
begin
  if Trim(Filter) <> '' then Res := FindFirst(Dir + '\*' +Filter, faAnyfile, SRec)
  else Res := FindFirst(Dir + '\*', faAnyfile, SRec);//     FindFirst('c:\*', faAnyFile, rec) = 0

  if Res = 0 then
  try
    while res = 0 do
    begin
      { valid file paths? }
      if (SRec.Name <> '.') and (SRec.Name <> '..') then
      begin
        { are sub-folders invited? }
        if ((SRec.Attr and faDirectory) = faDirectory) and SubFolders then
        begin
          Path := IncludeTrailingPathDelimiter(Dir) +SRec.Name;
          GetFiles(Path, FilePaths, True, Filter);
          Res := FindNext(SRec);
          continue;
        end;

        SetLength(FilePaths, Length(FilePaths) +1);
        FilePaths[Length(FilePaths) -1] := IncludeTrailingPathDelimiter(Dir) + SRec.Name;
      end;
      { next! }
      Res := FindNext(SRec);
    end;
  finally
    FindClose(SRec);
  end;
end;

