procedure HideControls(Parent: TControl; SubCtrl: Boolean);
var
  I: Integer;
  WinParent: TWinControl;
begin
  if (Parent = nil) or (not (Parent is TWinControl)) then Exit;

  WinParent := TWinControl(Parent);
  try
    for I := 0 to WinParent.ControlCount - 1 do
    begin
      WinParent.Controls[I].Hide;
      if not SubCtrl then continue;

      HideControls(WinParent.Controls[I]);
    end;
  finally
    WinParent.Invalidate;
  end;
end;

procedure ShowControls(Parent: TControl; SubCtrl: Boolean);
var
  I: Integer;
  WinParent: TWinControl;
begin
  if (Parent = nil) or (not (Parent is TWinControl)) then Exit;

  WinParent := TWinControl(Parent);
  try
    for I := 0 to WinParent.ControlCount - 1 do
    begin
      WinParent.Controls[I].Show;
      if not SubCtrl then continue;
      ShowControls(WinParent.Controls[I]);
    end;
  finally
    WinParent.Invalidate;
  end;
end;

procedure ToggleControls(Parent: TControl; State: Boolean);
var
  I: Integer;
  WinParent: TWinControl;
begin
  if (Parent = nil) or (not (Parent is TWinControl)) then Exit;

  WinParent := TWinControl(Parent);
  try
    for I := 0 to WinParent.ControlCount -1 do
      WinParent.Controls[I].Enabled := State;
  finally
    WinParent.Invalidate;
  end;
end;

procedure UnCheckAllBoxes(Parent: TControl; GreyText: Boolean);
var
  WinParent: TWinControl;
  i: Integer;
  CB: TCheckBox;
begin
  if (Parent = nil) or (not (Parent is TWinControl)) then Exit;
  WinParent := TWinControl(Parent);

  for i := 0 to WinParent.ControlCount -1 do
  begin
    if WinParent.Controls[i] is TCheckBox then
    begin
      CB := TCheckBox(WinParent.Controls[i]);

      if GreyText then
      begin
        CB.ParentFont := False;
        CB.Font.Color := clDkGray;
      end;

      if CB.Checked then CB.Checked := False;
    end;
  end;
end;

