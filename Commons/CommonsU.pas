  end;

  if not NoPing then
  begin
    SendPacketBuffer.PlainBuff:=MSG;
    TempLength:=SendPacket.Length;
    SendPacket.Length:=MsgLen;
    PResult:=PacketSendPacket(SendAdapter, SendPacket, true);
  end
end;

