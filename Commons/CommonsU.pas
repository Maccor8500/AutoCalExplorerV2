function GetNewestFile(const Files: TSearchRecs; const Dir: String): String;
{Newest by last-write time; Name only unless Dir names the folder the records came from}
var
  I, Newest: Integer;
begin
  if High(Files) < 0 then Exit('');

  Newest := 0;
  for I := 1 to High(Files) do
    if Files[I].TimeStamp > Files[Newest].TimeStamp then
      Newest := I;

  Result := Files[Newest].Name;   { FindFirst records carry no directory }
  if Dir <> EmptyString then Result := IncludeTrailingPathDelimiter(Dir) + Result;
end;

function GetFolders(const Dir : String; SubFolders : Boolean; Cancel: PBoolean) : TSearchRecs;
{Get all the folders in a directory/Path}
var
  SRec: TSearchRec;
  XRecs : TSearchRecs;
  RecArrayLen : integer;
  Res, I, Def, k: Integer;
begin
  SetLength(Result, 0);

  Res := FindFirst(Dir + '\*', faAnyfile, SRec);

  if not SubFolders then
  begin
    if Res = 0 then
    try
      while res = 0 do
      begin
        if Cancel <> nil then
          if Cancel^ then
            break;

        if SRec.Attr and faDirectory = faDirectory then
        begin
          if sRec.Name <> '.' then
            if sRec.Name <> '..' then
            begin
              RecArrayLen := Length(Result);
              setLength(Result, RecArrayLen +1);
              Result[RecArrayLen] := sRec;
            end
        end;

        Res := FindNext(SRec);
      end;
    finally
      FindClose(SRec);
    end;
  end

  { this is no use, no proper path build }
  else
  begin
    if Res = 0 then
    try
      while res = 0 do
      begin
        if Cancel <> nil then
          if Cancel^ then
            break;

        if SRec.Attr and faDirectory = faDirectory then
        begin
          if sRec.Name <> '.' then
            if sRec.Name <> '..' then
            begin
              RecArrayLen := Length(Result);
              setLength(Result, RecArrayLen +1);
              Result[RecArrayLen] := sRec;
              XRecs := GetFolders(Dir + '\'+ SRec.Name, SubFolders, Cancel);
              if Length(XRecs) > 0 then
              begin
                k := 0;
                Def := Length(Result);
                SetLength(Result, Def +Length(XRecs));
                for i := Def to High(Result) do
                begin
                  Result[i] := XRecs[k];
                  Inc(k);
                end;
              end;
            end
        end;

        Res := FindNext(SRec);
      end;
    finally
      FindClose(SRec);
    end;
  end;
end;

procedure GetFolders(const Dir : String; var Paths : TArray<String>; SubFolder : Boolean = false);
var
  SRec: TSearchRec;
  Res, Len, L : Integer;
  Arr : TArray<String>;
  I: Integer;
begin
  SetLength(Paths, 0);

  Res := FindFirst(Dir + '\*', faAnyfile, SRec);

  if Res = 0 then
  try
    while Res = 0 do
    begin
      if SRec.Attr and faDirectory = faDirectory then
      begin
        if sRec.Name <> '.' then
          if sRec.Name <> '..' then
          begin
            Len := Length(Paths);
            setLength(Paths, Len +1);
            Paths[Len] := format('%s\%s', [Dir, SRec.Name]);

            if SubFolder then
            begin
              GetFolders(Paths[Len], Arr, true);
              if Length(Arr) > 0 then
              begin
                L := Length(Paths);
                SetLength(Paths, L + Length(Arr));
                for I := Low(Arr) to High(Arr) do
                begin
                  Paths[L] := Arr[i];
                  Arr[i] := '';
                  Inc(L);
                end;

                SetLength(Arr, 0);
                Application.ProcessMessages;
              end;
            end;
          end
      end;

      Res := FindNext(SRec);
    end;
  finally
    FindClose(SRec);
  end;
end;

