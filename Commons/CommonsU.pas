function SecsToTime(const Seconds: Int64): Double;
var
  ms, ss, mm, hh: Cardinal;
begin
  //dd := Seconds div SecsPerDay;
  hh := (Seconds mod SecsPerDay) div SecsPerHour;
  mm := ((Seconds mod SecsPerDay) mod SecsPerHour) div SecsPerMin;
  ss := ((Seconds mod SecsPerDay) mod SecsPerHour) mod SecsPerMin;
  ms := 0;
  Result := EncodeTime(hh, mm, ss, ms);
end;

function NpcapTimeToLocalTime(const TimeStamp: TPacketTimeStamp): TDateTime;
begin
  Result := UNIX_EPOCH_ToDELPHI +(TimeStamp.tv_sec / SecsPerDay);
  Result := Result + (TimeStamp.tv_usec / 1000000) / SecsPerDay;
  Result := TTimeZone.Local.ToLocalTime(Result);
end;

function IntToTimeStr(const secs: Integer; fmt : String; Def: Char): String;
begin
  Result := Def;
  if secs < 0 then Exit;

  if fmt = '' then Result := FormatDateTime('hh:nn:ss', secs /SecsPerDay)
  else Result := FormatDateTime(fmt, secs /SecsPerDay);
end;

function TimeStampToTimeStr(const TimeStamp: TPacketTimeStamp; fmt: String; Def: Char): String;
var
  Time: TDateTime;
begin
  try
    Result := Def;
    { validate input: Ensure tv_sec is non-negative }
    if TimeStamp.tv_sec < 0 then Exit;
    { convert to valid date-time }
    Time := NpcapTimeToLocalTime(TimeStamp);
    if fmt = '' then Result := FormatDateTime('HH:NN:SS.ZZZ', Time)
    else Result := FormatDateTime(fmt, Time);
  except
    On E: Exception do
      raise Exception.Create('Error Message');
  end;
end;

