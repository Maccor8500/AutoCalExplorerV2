function DelimitedText(const DataArr: TArray<Byte>; const Delimiter : Char): String;
var
  Tail, i: Integer;
begin
  Result := '';
  Tail := High(DataArr);

  for i := Low(DataArr) to Tail  do
  begin
    if i < Tail then Result := format('%s%d%s ', [Result, DataArr[i], Delimiter])
    else Result := format('%s%d', [Result, DataArr[i]]);
  end;
end;

procedure SetRect(Control: Pointer; const Rect: PRect);
begin
  if (Control = nil) or (Rect = nil) then Exit;
  
  with TControl(Control^) do
  begin
    Left := Rect^.Left;
    Top := Rect^.Top;
    Height := Rect^.Height;
    Width := Rect^.Width;
  end;
end;

procedure CenterForm(const RefForm: Pointer; TargetForm: Pointer);
begin
  if (RefForm = nil) or (TargetForm = nil) then Exit;

  try
    TForm(TargetForm^).Left := TForm(RefForm^).Left +(TForm(RefForm^).Width -TForm(TargetForm^).Width) div 2;
    TForm(TargetForm^).Top := TForm(RefForm^).Top +(TForm(RefForm^).Height -TForm(TargetForm^).Height) div 2;
  finally
    TForm(TargetForm^).Invalidate;
  end;
end;

procedure SetCenter(Child: TControl; const Parent: TControl; ChildIsForm: Boolean);
var
  cx, cy: Integer;
begin
  if (Parent = nil) or (Child = nil) then Exit;

  if ChildIsForm then
  begin
    cx := Parent.Left +Round((Parent.Width -Child.Width) /2);
    cy := Parent.Top  +Round((Parent.Height -Child.Height) /2);
  end
  else
  begin
    cx := Round((Parent.Width -Child.Width) /2);
    cy := Round((Parent.Height -Child.Height) /2);
  end;

  Child.SetBounds(cx, cy, Child.Width, Child.Height);

  if (Child is TPanel) and Child.Visible and Parent.Visible then
    TPanel(Child).SetFocus;
end;

procedure SetCenter(Control: TControl);
var
  Parent: TControl;
begin
  if Control.Parent = nil then Exit;

  Parent := Control.Parent;
  SetCenter(Control, Parent, (Control is TForm));
end;

procedure SetCenterLeft(Child: TControl; const Parent: TControl; ChildIsForm: Boolean = False);
begin
  if (Parent = nil) or (Child = nil) then Exit;

  if ChildIsForm then Child.Left := Parent.Left +(Parent.Width - Child.Width) div 2
  else Child.Left := ((Parent.Width -Child.Width) div 2) -13;
end;

function MessageDlgCentered(const Msg: string; DlgType: TMsgDlgType; Buttons: TMsgDlgButtons; AParent: TCustomForm = nil): Integer;
var
  Dlg: TForm;
  R: TRect;
begin
  if AParent = nil then
    AParent := Screen.ActiveForm;

  Dlg := CreateMessageDialog(Msg, DlgType, Buttons);
  try
    if Assigned(AParent) then
    begin
      R := AParent.BoundsRect;
      // Convert to screen coordinates if the form is parented (e.g. MDI child)
      if Assigned(AParent.Parent) then
        R.TopLeft := AParent.Parent.ClientToScreen(R.TopLeft);

      Dlg.Position := poDesigned;
      Dlg.Left := R.Left + (AParent.Width  - Dlg.Width)  div 2;
      Dlg.Top  := R.Top  + (AParent.Height - Dlg.Height) div 2;
    end
    else
      Dlg.Position := poScreenCenter;

    Result := Dlg.ShowModal;
  finally
    Dlg.Free;
  end;
end;

procedure UpdateControlTags(Container: TWinControl; Order: TOdering);
var
  I, Count, TagIndex: Integer;
begin
  if (Container = nil) then Exit;
  Count := Container.ControlCount -1;

  case Order of
    NoOrdering, Ascending:
    begin
      TagIndex := 0;
      for i := 0 to Count do
      begin
        Container.Controls[i].Tag := TagIndex;
        Inc(TagIndex);
      end;
    end;

    Descending:
    begin
      TagIndex := Count;
      for i := 0 to Count do
      begin
        Container.Controls[i].Tag := TagIndex;
        Dec(TagIndex);
      end;
    end;
  end;
end;

procedure UpdateControlCallback(const AOwner: TForm; Container: TWinControl; const Event: TNotifyEvent; const EventStr: String);
var
  I: Integer;
  Method: TMethod;
begin
  if (Container = nil) then Exit;

  for i := 0 to Container.ControlCount -1 do
  begin
    Method := GetEventMethod(Container.Controls[i], EventStr);
    Method.Code := @Event;
    Method.Data := AOwner;
    SetEventMethod(Container.Controls[i], EventStr, Method);
  end;
end;

function GetEventMethod(Control: TControl; const EventName: String): TMethod;
var
  PropInfo: PPropInfo;
begin
  Result.Code := nil;
  Result.Data := nil;

  PropInfo := GetPropInfo(Control.ClassInfo, EventName);
  if (PropInfo <> nil) and (PropInfo.PropType^.Kind = tkMethod) then
    Result := GetMethodProp(Control, PropInfo);
end;

procedure SetEventMethod(Control: TControl; const EventName: String; const Method: TMethod);
var
  Context: TRttiContext;
  RttiType: TRttiType;
  EventProperty: TRttiProperty;
begin
  Context := TRttiContext.Create;
  try
    RttiType := Context.GetType(Control.ClassType);
    EventProperty := RttiType.GetProperty(EventName);

    if Assigned(EventProperty) then
      EventProperty.SetValue(Control, TValue.From<TNotifyEvent>(TNotifyEvent(Method)));
  finally
    Context.Free;
  end;
end;

