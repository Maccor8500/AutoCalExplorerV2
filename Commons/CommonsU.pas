procedure TGenericArray<T>.Delete(const pos : integer);
var
  lenT, i: Integer;
  tempA : Array of T;
begin
  if pos > Length(A) -1 then
    Exit;

  if pos < 0 then
    Exit;

  i := 0;

  repeat
    if i <> pos then
    begin
      LenT := Length(tempA);
      SetLength(tempA, LenT+1);
      tempA[LenT] := A[i];
    end;

    Inc(i);
  until (i = Length(A));

  setLength(A, Length(tempA));

  for i := 0 to Length(tempA) -1 do
    A[i] := TempA[i];
end;

procedure TGenericArray<T>.Add(item : T);
var
  Len : integer;
begin
  Len := Length(A);
  SetLength(A, Len +1);
  A[Len] := item;

  if SortArr then
    SortArray;
end;

procedure TGenericArray<T>.InsertTop(const item : T);
var
  i: Integer;
begin
  if isEmpty then
  begin
    Add(item);
    Exit;
  end;

  setLength(A, Length(A) +1);

  for i := Length(A) -1 downto 0 do
  begin
    A[i] := A[i -1];
  end;

  A[0] := item;
end;

procedure TGenericArray<T>.Clear;
begin
  setLength(A, 0);
end;

procedure TGenericArray<T>.toStrArray(var StrArr : TStrArray);
var item : T;   index : integer;
begin
  setLength(StrArr, Length(A));
  index := 0;

  for item in A do
  begin
    StrArr[index] := TtoString(item);
    Inc(index);
  end;
end;

function TGenericArray<T>.IndexOf(const item : T) : integer;
var i : integer;
begin
  Result := -1;

  if SortArr then
  begin
    TArray.BinarySearch<T>(A, item, Result);
    Exit;
  end;

  for i := Low(A) to High(A) do
    if TtoString(A[i]) = TtoString(item) then
    begin
      Result := i;
      break;
    end;
end;

procedure TGenericArray<T>.SortArray;
var
  items: T; index : integer;
begin
  SortArr := true;
  setLength(OldA, Length(A));
  index := 0;

  for items in A do
  begin
    OldA[index] := A[index];
    Inc(Index);
  end;

  TArray.Sort<T>(A);
end;

procedure TGenericArray<T>.UnSortArray;
var
  items: T; index : integer;
begin
  SortArr := false;
  setLength(A, Length(OldA));
  index := 0;

  for items in OldA do
  begin
    A[index] := OldA[index];
    Inc(Index);
  end;

  SetLength(OldA, 0);
end;

procedure TGenericArray<T>.Replace(const pos : integer; const item : T);
begin
  if (pos < 0) or (pos > Length(A) -1) then
    Exit;

  A[pos] := item;
end;

function TGenericArray<T>.Get(const pos : integer) : string;
begin
  if (pos < 0) or (pos > Length(A) -1) then
  begin
    Result := 'null';
    Exit;
  end;

  Result := TtoString(A[pos]);
end;

procedure TGenericArray<T>.Print(const M : TMemo);
var
  i: Integer;
begin
  Memo := M;

  Memo.Clear;
  if Length(A) <= 0 then
    Exit;

  for i := Low(A) to High(A) do
    Memo.Lines.Append(TtoString(A[i]));
end;

procedure TGenericArray<T>.Print;
var
  i: Integer;
begin
  if Memo = nil then
