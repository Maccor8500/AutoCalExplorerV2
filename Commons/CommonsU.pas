procedure QuickSort(var A : Array of DWord; Head, Tail : Integer);
var
  Lo, Hi, Pivot, T: UInt32;
begin
  Lo := Head;
  Hi := Tail;
  Pivot := A[(Lo +Hi) div 2];

  repeat
    while A[Lo] < Pivot do Inc(Lo);
    while A[Hi] > Pivot do Dec(Hi);

    if Lo <= Hi then
    begin
      T := A[Lo];
      A[Lo] := A[Hi];
      A[Hi] := T;
      Inc(Lo);
      Dec(Hi);
    end;
  until Lo > Hi;

  if Hi > UInt32(Head) then QuickSort(A, Head, Hi);
  if Lo < UInt32(Tail) then QuickSort(A, Lo, UInt32(Tail));
end;

