  Result := Pos(Search,Comp) - 1;
end;

procedure ByteArrayCmp(const A : array of byte; const B : array of byte; var Res : boolean);
var
  i: Integer;
begin
  Res := false;
  if Length(A) <> Length(B) then  Exit;

  Res := true;
  for i := 0 to Length(A) -1 do
  begin
    if A[i] <> B[i] then
    begin
      Res := false;
      Exit;
    end;
  end;
end;

