procedure SplitStr(const str, delimiter : string; var strArray : TArray<String>);
begin
  if Trim(Str) = '' then Exit;
  setLength(strArray, 0);
  strArray := str.Split([delimiter]);
end;

procedure SplitStr(const Str: String; Delimiters: TArray<String>; var StrArray: TArray<String>);
const
  DefaultDel: Array of Char = [
    '.', '!', '|', '/', '\', '=', '$', '@', ':', ';',
    '<', '>', '(', ')', '&', '*', '^', '%', '#', '~',
    '-', '+', '{', '}', '?', '`', '[', ']', '.', ' '
  ];

var
  S, DelStr: String;
  i, DelIdx: SmallInt;
begin
  case High(delimiters) of
    -1: Exit;
    0: SplitStr(Str, delimiters[0], StrArray);

    else
    begin
      if Trim(Str) = '' then Exit;
      DelStr := '';
      DelIdx := -1;

      for i := Low(DefaultDel) to High(DefaultDel) do
      begin
        if Pos(DefaultDel[i], Str) <> 0 then continue;
        DelIdx := i;
        break;
      end;

      if DelIdx < 0 then
        raise Exception.Create('No available delimiter character for substitution.');

      for i := Low(Delimiters) to High(Delimiters) do DelStr := DelStr +Delimiters[i];
      S := StringReplace(Str, DelStr, DefaultDel[DelIdx], [rfReplaceAll, rfIgnoreCase]);
      if Pos(DefaultDel[DelIdx], S) = Length(S) then
        Delete(S, Length(S), 1);
      SplitStr(S, DefaultDel[DelIdx], StrArray);
    end;
  end;
end;

function SplitStr(const str, delimiter : String) : TStrArray;
var strArray : TArray<String>;
  i: Integer;
begin
  try
    SplitStr(str, delimiter, strArray);
    SetLength(Result, Length(strArray));

    for i := 0 to Length(Result) -1 do
      Result[i] := strArray[i];
  except
  end;
end;

procedure SplitStr(str, delimiter : String; var items : TStrings);
var strArray : TArray<String>;
    i: Integer;
begin
  try
    SplitStr(str, delimiter, strArray);

    for i := 0 to Length(strArray) -1 do
      items.Add(Trim(strArray[i]));
  except
  end;
end;

function AnsiTrim(const Str: AnsiString): AnsiString;
var
  I, L: Integer;
begin
  L := Length(Str);
  if L <= 0 then Exit(Str);
  I := 1;
  { leading spaces }
  while (I <= L) and (Str[I] <= ' ') do Inc(I);
  { trailing spaces }
  while (L >= I) and (Str[L] <= ' ') do Dec(L);
  { copy trimmed substring }
  Exit(AnsiString(Copy(Str, I, L -I +1)));
end;

