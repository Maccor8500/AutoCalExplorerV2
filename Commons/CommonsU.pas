function Watch(const Dir: String; const Filter: DWord; SubFolders: Boolean; Timeout: Integer): Boolean;
var
  ChangeHandle: THandle;
  WaitResult: DWORD;
begin
  Result := False;
  {
    FILE_NOTIFY_CHANGE_FILE_NAME
    FILE_NOTIFY_CHANGE_DIR_NAME
    FILE_NOTIFY_CHANGE_ATTRIBUTES
    FILE_NOTIFY_CHANGE_SIZE
    FILE_NOTIFY_CHANGE_LAST_WRITE
    FILE_NOTIFY_CHANGE_LAST_ACCESS
    FILE_NOTIFY_CHANGE_CREATION
    FILE_NOTIFY_CHANGE_SECURITY
  }

  ChangeHandle := FindFirstChangeNotification(PWideChar(Dir), SubFolders, Filter);
  if ChangeHandle = INVALID_HANDLE_VALUE then Exit;

  try
    { single-shot :: True the moment a change fires, False on timeout/failure —
      the caller owns the re-arm loop <the old version looped internally and
      returned the final timeout's False, swallowing the change it saw> }
    WaitResult := WaitForSingleObject(ChangeHandle, Timeout);
    Result := (WaitResult = WAIT_OBJECT_0);
  finally
    FindCloseChangeNotification(ChangeHandle);
  end;
end;

function WatchFile(const Dir, TargetFile: string; Timeout: Integer): Boolean;
type
  PFILE_NOTIFY_INFORMATION = ^FILE_NOTIFY_INFORMATION;
  FILE_NOTIFY_INFORMATION = record
    NextEntryOffset: DWORD;
    Action: DWORD;
    FileNameLength: DWORD;
    FileName: array[0..0] of WideChar;
  end;

var
  DirHandle: THandle;
  Buffer: array[0..4095] of Byte;
  BytesReturned: DWORD;
  Info: PFILE_NOTIFY_INFORMATION;
begin
  Result := False;
  DirHandle := CreateFile(PChar(Dir), FILE_LIST_DIRECTORY, FILE_SHARE_READ or
    FILE_SHARE_WRITE or FILE_SHARE_DELETE, nil, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, 0);

  if DirHandle = INVALID_HANDLE_VALUE then Exit;

  try
    if ReadDirectoryChangesW(
      DirHandle, @Buffer,  SizeOf(Buffer), False, FILE_NOTIFY_CHANGE_LAST_WRITE,
        @BytesReturned, nil, nil) then
    begin
      Info := PFILE_NOTIFY_INFORMATION(@Buffer);
      Result := SameText(TargetFile, Copy(Info^.FileName, 1, Info^.FileNameLength div SizeOf(WideChar)));
    end;
  finally
    CloseHandle(DirHandle);
  end;
end;

procedure GetUSBList(var Devices: TArray<String>);
var
  SetupAPIDll: HMODULE;
  DeviceInfoSet: HDEVINFO;
  DeviceInfoData: SP_DEVINFO_DATA;
  DeviceId: array[0..511] of WideChar;
  DeviceDesc: array[0..255] of WideChar;
  RequiredSize: DWORD;
  PropertyRegDataType: DWORD;
  i, L: Integer;
  S: String;
begin
  SetLength(Devices, 0);
  SetupAPIDll := LoadLibrary('C:\Windows\System32\setupapi.dll');
  if SetupAPIDll = 0 then raise Exception.Create('Failed to load setupapi.dll');
  try
    // Load the necessary functions
    @SetupDiGetClassDevsW := GetProcAddress(SetupAPIDll, 'SetupDiGetClassDevsW');
    @SetupDiEnumDeviceInfo := GetProcAddress(SetupAPIDll, 'SetupDiEnumDeviceInfo');
    @SetupDiGetDeviceInstanceIdW := GetProcAddress(SetupAPIDll, 'SetupDiGetDeviceInstanceIdW');
    @SetupDiGetDeviceRegistryPropertyW := GetProcAddress(SetupAPIDll, 'SetupDiGetDeviceRegistryPropertyW');
    @SetupDiDestroyDeviceInfoList := GetProcAddress(SetupAPIDll, 'SetupDiDestroyDeviceInfoList');
    // Check if all necessary functions are loaded
    if not Assigned(SetupDiGetClassDevsW) then
      raise Exception.Create('Failed to locate SetupDiGetClassDevsW in setupapi.dll');
    if not Assigned(SetupDiEnumDeviceInfo) then
      raise Exception.Create('Failed to locate SetupDiEnumDeviceInfo in setupapi.dll');
    if not Assigned(SetupDiGetDeviceInstanceIdW) then
      raise Exception.Create('Failed to locate SetupDiGetDeviceInstanceIdW in setupapi.dll');
    if not Assigned(SetupDiGetDeviceRegistryPropertyW) then
      raise Exception.Create('Failed to locate SetupDiGetDeviceRegistryPropertyW in setupapi.dll');
    if not Assigned(SetupDiDestroyDeviceInfoList) then
      raise Exception.Create('Failed to locate SetupDiDestroyDeviceInfoList in setupapi.dll');
    // Get the device info set for USB devices
    DeviceInfoSet := SetupDiGetClassDevsW(nil, nil, 0, DIGCF_ALLCLASSES or DIGCF_PRESENT);
    if DeviceInfoSet = INVALID_HANDLE_VALUE then
      Exit;
    try
      DeviceInfoData.cbSize := SizeOf(SP_DEVINFO_DATA);
      for i := 0 to MaxInt do
      begin
        if not SetupDiEnumDeviceInfo(DeviceInfoSet, i, DeviceInfoData) then
          Break;
        // Get the device ID
        if SetupDiGetDeviceInstanceIdW(DeviceInfoSet, DeviceInfoData, DeviceId, SizeOf(DeviceId) div SizeOf(WideChar), RequiredSize) then
        begin
          // Get the device description
          if SetupDiGetDeviceRegistryPropertyW(DeviceInfoSet, DeviceInfoData, SPDRP_DEVICEDESC, PropertyRegDataType, PByte(@DeviceDesc[0]), SizeOf(DeviceDesc), RequiredSize) then
          begin
            S := format('DIS: %d, INT: %d, PRD: %d, DES: %s', [DeviceInfoSet, DeviceInfoData.DevInst, PropertyRegDataType, String(DeviceDesc)]);
            L := Length(Devices);
            SetLength(Devices, L +1);
            Devices[L] := S;
          end;
        end;
      end;
    finally
      SetupDiDestroyDeviceInfoList(DeviceInfoSet);
    end;
  finally
    FreeLibrary(SetupAPIDll);
  end;
end;

procedure GetUSBList(var Devices: TArray<TUSBDevice>);
var
  SetupAPIDll: HMODULE;
  DeviceInfoSet: HDEVINFO;
  DeviceInfoData: SP_DEVINFO_DATA;
  DeviceId: array[0..511] of WideChar;
  DeviceDesc: array[0..255] of WideChar;
  RequiredSize: DWORD;
  PropertyRegDataType: DWORD;
  i, L: Integer;
begin
  SetLength(Devices, 0);
  SetupAPIDll := LoadLibrary('C:\Windows\System32\setupapi.dll');
  if SetupAPIDll = 0 then raise Exception.Create('Failed to load setupapi.dll');
  RequiredSize := 1024;

  try
    // Load the necessary functions
    @SetupDiGetClassDevsW := GetProcAddress(SetupAPIDll, 'SetupDiGetClassDevsW');
    @SetupDiEnumDeviceInfo := GetProcAddress(SetupAPIDll, 'SetupDiEnumDeviceInfo');
    @SetupDiGetDeviceInstanceIdW := GetProcAddress(SetupAPIDll, 'SetupDiGetDeviceInstanceIdW');
    @SetupDiGetDeviceRegistryPropertyW := GetProcAddress(SetupAPIDll, 'SetupDiGetDeviceRegistryPropertyW');
    @SetupDiDestroyDeviceInfoList := GetProcAddress(SetupAPIDll, 'SetupDiDestroyDeviceInfoList');
    // Check if all necessary functions are loaded
    if not Assigned(SetupDiGetClassDevsW) then
      raise Exception.Create('Failed to locate SetupDiGetClassDevsW in setupapi.dll');
    if not Assigned(SetupDiEnumDeviceInfo) then
      raise Exception.Create('Failed to locate SetupDiEnumDeviceInfo in setupapi.dll');
    if not Assigned(SetupDiGetDeviceInstanceIdW) then
      raise Exception.Create('Failed to locate SetupDiGetDeviceInstanceIdW in setupapi.dll');
    if not Assigned(SetupDiGetDeviceRegistryPropertyW) then
      raise Exception.Create('Failed to locate SetupDiGetDeviceRegistryPropertyW in setupapi.dll');
    if not Assigned(SetupDiDestroyDeviceInfoList) then
      raise Exception.Create('Failed to locate SetupDiDestroyDeviceInfoList in setupapi.dll');

    // Get the device info set for USB devices
    DeviceInfoSet := SetupDiGetClassDevsW(nil, nil, 0, DIGCF_ALLCLASSES or DIGCF_PRESENT);
    if DeviceInfoSet = INVALID_HANDLE_VALUE then
      Exit;

    try
      DeviceInfoData.cbSize := SizeOf(SP_DEVINFO_DATA);
      for i := 0 to MaxInt do
      begin
        if not SetupDiEnumDeviceInfo(DeviceInfoSet, i, DeviceInfoData) then
          Break;
        // Get the device ID
        if SetupDiGetDeviceInstanceIdW(DeviceInfoSet, DeviceInfoData, DeviceId, SizeOf(DeviceId) div SizeOf(WideChar), RequiredSize) then
        begin
          // Get the device description
          if SetupDiGetDeviceRegistryPropertyW(DeviceInfoSet, DeviceInfoData, SPDRP_DEVICEDESC, PropertyRegDataType, PByte(@DeviceDesc[0]), SizeOf(DeviceDesc), RequiredSize) then
          begin
            L := Length(Devices);
            SetLength(Devices, L +1);
            Devices[L].DeviceInfoSet := DeviceInfoSet;
            Devices[L].DeviceInfoData := DeviceInfoData;
            Devices[L].DeviceDesc := String(DeviceDesc);
            Devices[L].DeviceId := String(DeviceId);
            Devices[L].PropertyRegDataType := PropertyRegDataType;
          end;
        end;
      end;
    finally
      SetupDiDestroyDeviceInfoList(DeviceInfoSet);
    end;
  finally
    FreeLibrary(SetupAPIDll);
  end;
end;

{ USB\VID_1A86&PID_7523\5&1A2B3C4D&0&3 }
procedure ResetUSBDevice(const Device_ID: String);
var
  DeviceInfoSet: HDEVINFO;
  DeviceInfoData: SP_DEVINFO_DATA;
  i, Status, DummySize: DWORD;
  Buffer: array[0..1023] of Char;
begin
  i := 0;
  DeviceInfoSet := SetupDiGetClassDevs(nil, nil, 0, DIGCF_PRESENT or DIGCF_ALLCLASSES);
  if DeviceInfoSet = INVALID_HANDLE_VALUE then
    RaiseLastOSError;

  while True do
  begin
    ZeroMemory(@DeviceInfoData, SizeOf(DeviceInfoData));
    DeviceInfoData.cbSize := SizeOf(DeviceInfoData);

    if not SetupDiEnumDeviceInfo(DeviceInfoSet, i, DeviceInfoData) then
      Break;

    if SetupDiGetDeviceInstanceIdW(DeviceInfoSet, DeviceInfoData, @Buffer, Length(Buffer), DummySize) then
    begin
      if Pos(UpperCase(Device_ID), UpperCase(Buffer)) > 0 then
      begin
        { disable it! }
        Status := CM_Disable_DevNode(DeviceInfoData.DevInst, 0);
        if Status <> 0 then raise Exception.CreateFmt('Failed to disable device (CM error %d)', [Status]);

        Sleep(1000);

        { re-enable it! }
        Status := CM_Enable_DevNode(DeviceInfoData.DevInst, 0);
        if Status <> 0 then
          raise Exception.CreateFmt('Failed to enable device (CM error %d)', [Status]);
        break;
      end;
    end;

    Inc(i);
  end;

  SetupDiDestroyDeviceInfoList(DeviceInfoSet);
end;

function ConvertToXMLFormat(S: string): string;
begin
  S:=StringReplace(S, '&', '&amp;', [rfReplaceAll]);
  S:=StringReplace(S, '<', '&lt;', [rfReplaceAll]);
  S:=StringReplace(S, '>', '&gt;', [rfReplaceAll]);
  S:=StringReplace(S, '"', '&quot;', [rfReplaceAll]);
  S:=StringReplace(S, #39, '&apos;', [rfReplaceAll]); // '
  Result:=S;
end;

function ConvertFromXMLFormat(S: string): string;
begin
  S:=StringReplace(S, '&amp;', '&', [rfReplaceAll]);
  S:=StringReplace(S, '&lt;', '<', [rfReplaceAll]);
  S:=StringReplace(S, '&gt;', '>', [rfReplaceAll]);
  S:=StringReplace(S, '&quot;', '"', [rfReplaceAll]);
  S:=StringReplace(S, '&apos;', #39, [rfReplaceAll]);
  Result:=S;
end;

