begin
  Result := nil;

  if aMemPointer <> nil then
    Result := aMemPointer;
end;

procedure TSharedMemory<T>.InitSharedMemory(const Name: PChar);
begin
  aMemHandle :=
    CreateFileMapping(INVALID_HANDLE_VALUE,{same as $FFFFFFFF, Use File paging, not actual file}
      nil,                 {Security, None}
      PAGE_READWRITE,      {4}
      0,                   {maximum object size (high-order DWORD)}
      SizeOf(T),           {maximum object size (low-order DWORD)}
      PChar(Name));        {name of mapping object}

  if aMemHandle > 0 then
    aMemPointer := MapViewOfFile(aMemHandle,     // object to map view of
      FILE_MAP_WRITE, // read/write access
      0,              // high offset:  map from
      0,              // low offset:   beginning
      0);             // default: map entire file
end;

function TSharedMemory<T>.ReadSharedMemory: Pointer;
var
  LMemHandle : THandle;
begin
  Result := nil;
  aBusy := true;

  if aMemName = '' then
    Exit;

  LMemHandle := OpenFileMapping(FILE_MAP_ALL_ACCESS,   // read/write access
                                FALSE,                 // do not inherit the name
                                aMemName);

  if LMemHandle <> 0 then
    Result :=  MapViewOfFile(LMemHandle, // handle to map object
                             FILE_MAP_ALL_ACCESS,  // read/write permission
                             0,
                             0,
                             SizeOf(T));
  CloseHandle(LMemHandle);

  if aMemPointer = nil then
    aMemPointer := Result;

  aBusy := false;
end;

procedure TSharedMemory<T>.WriteSharedMemory(const data: T);
begin
  CopyMemory(aMemPointer, @data, SizeOf(data));
end;

procedure TSharedMemory<T>.Write(const data: T; const Size: SmallInt);
begin
  CopyMemory(aMemPointer, @data, Size);
end;

// --------------------------- SharedMemory related ------------------------
function ReadSharedMemory(const MemoryID : String; var MemHandle : Cardinal; const MemSz : Integer) : Pointer;
begin
  Result := nil;

  if MemoryID <> '' then
  begin
    MemHandle := OpenFileMapping(FILE_MAP_ALL_ACCESS,   // read/write access
                  FALSE,                   // do not inherit the name
                  PChar(MemoryID));

    if MemHandle <> 0 then
      Result :=  MapViewOfFile(MemHandle, // handle to map object
                  FILE_MAP_ALL_ACCESS,    // read/write permission
                  0,
                  0,
                  MemSz);
  end
  else if (MemHandle > 0) then
  begin
    Result :=  MapViewOfFile(MemHandle, // handle to map object
                  FILE_MAP_ALL_ACCESS,  // read/write permission
                  0,
                  0,
                  MemSz);
  end;
end;

function ReadSharedMemory(const MemoryID : String; const MemSz : Integer) : Pointer;
var
  DummyHandle : Cardinal;
begin
  DummyHandle := 0;
  Result := ReadSharedMemory(MemoryID, DummyHandle, MemSz);
end;

function ReadSharedMemory(const MemHandle: Cardinal; const MemSz: Integer) : Pointer;
var
  DummyID : String;
  Hndl : Cardinal;
begin
  DummyID := '';
  Hndl := MemHandle;
  Result := ReadSharedMemory(DummyID, Hndl, MemSz);
end;

function WriteSharedMemory(const MemoryID : String; const data : Pointer; const MemSz : Integer) : Byte;
var
  MemHandle : Cardinal;
  MVoF : Pointer;
begin
  Result := $FF;

  if MemoryID <> '' then
  begin
    MemHandle := OpenFileMapping(FILE_MAP_ALL_ACCESS,   // read/write access
                                    FALSE,                 // do not inherit the name
                                    PChar(MemoryID));

    Result := $FE;
    if MemHandle <> 0 then
    begin
      Result := $FD;
      MVoF := MapViewOfFile(MemHandle, // handle to map object
                                 FILE_MAP_ALL_ACCESS,  // read/write permission
                                 0,
                                 0,
                                 MemSz);
      if MVoF <> nil then
      begin
        CopyMemory(MVoF, data, MemSz);
        Result := 0;
      end;
    end;
  end;
end;

function WriteSharedMemory(const MemHandle: Cardinal; const data : Pointer; const MemSz : Integer) : Byte;
begin
  Result := 0;
end;

{ TSharedMemoryEx<T> }

constructor TSharedMemoryEx<T>.Create(const MemID: String;
  const op: TReadWriteOp; const ObjSz : SmallInt);
begin
  MemStatus := msUnavailable;
  Self.MemID := PChar(MemID);
  ObjSize := ObjSz;

  case op of
    smWrite:
    begin
      MemHandle := CreateFileMapping(INVALID_HANDLE_VALUE, {Use paging file}
                                       NIL,                  {Default Security}
                                       PAGE_READWRITE,
                                       0,
                                       ObjSz,
                                       Self.MemID);
    end;

    smRead: MemHandle := OpenFileMapping(FILE_MAP_READ, False, Self.MemID);
    smReadWrite: MemHandle := OpenFileMapping(FILE_MAP_ALL_ACCESS, False, Self.MemID);
  end;

  if (MemHandle > 0) then
  begin
    case op of
      smWrite: MemPointer := MapViewOfFile(MemHandle, FILE_MAP_WRITE, 0, 0, ObjSz);
      smRead: MemPointer := MapViewOfFile(MemHandle, FILE_MAP_READ, 0, 0, ObjSz);
      smReadWrite: MemPointer := MapViewOfFile(MemHandle, FILE_MAP_ALL_ACCESS, 0, 0, ObjSz);
    end;

    if MemPointer <> nil then MemStatus := msReady
    else CloseHandle(MemHandle);
  end;

  LastError := GetLastError;
end;

destructor TSharedMemoryEx<T>.Destroy;
begin
  try
    CloseHandle(MemHandle);

    if MemPointer <> nil then
      UnmapViewOfFile(MemPointer);
  except
  end;

  inherited;
end;

function TSharedMemoryEx<T>.GetMemHandle: THandle;
begin
  Result := MemHandle;
end;

function TSharedMemoryEx<T>.Read: Pointer;
begin
  Result := MemPointer;
end;

function TSharedMemoryEx<T>.Write(data: Pointer): Byte;
begin
  Result := 0;

  try
    CopyMemory(MemPointer, data, ObjSize);
  except
    Result := 1;
  end;

  LastError := GetLastError;
end;

function TSharedMemoryEx<T>.Write(const data: T): Byte;
begin
  Result := 0;

  try
    CopyMemory(MemPointer, @data, ObjSize);
  except
    Result := 1;
  end;

  LastError := GetLastError;
end;

