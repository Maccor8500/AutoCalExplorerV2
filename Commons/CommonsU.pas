class function TUtils.VKCodeToChar(VKCode, ScanCode: UINT): String;
var
  KeyboardState: TKeyboardState;
  UnicodeChar: array[0..7] of WideChar;
  Layout: HKL;
  ResultLen: Integer;
begin
  Result := '';

  if not GetKeyboardState(KeyboardState) then Exit;
  if (GetAsyncKeyState(VK_SHIFT) and $8000) <> 0 then KeyboardState[VK_SHIFT] := $80
  else KeyboardState[VK_SHIFT] := 0;

  if (GetKeyState(VK_CAPITAL) and 1) <> 0 then KeyboardState[VK_CAPITAL] := 1
  else KeyboardState[VK_CAPITAL] := 0;

  Layout := GetKeyboardLayout(0);

  ResultLen := ToUnicodeEx(
    VKCode,
    ScanCode,
    @KeyboardState,
    UnicodeChar,
    Length(UnicodeChar),
    0,
    Layout
  );
  if ResultLen > 0 then Result := Copy(UnicodeChar, 1, ResultLen);
end;

