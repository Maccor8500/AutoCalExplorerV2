procedure GetGridScrollbars(const Grid: PStringGrid; var Visibility: TGridScrollBarsVisible);
var
  Info: TScrollBarInfo;
const
  OBJID_HSCROLL_SIGNED: LongInt = -6;
  OBJID_VSCROLL_SIGNED: LongInt = -5;
  function HasState(const State, Flag: DWORD): Boolean;
  begin
    Result := (State and Flag) <> 0;
  end;
begin
  Visibility := Default(TGridScrollBarsVisible);
  if not Assigned(Grid) then
    Exit;
  Grid^.HandleNeeded;
  FillChar(Info, SizeOf(Info), 0);
  Info.cbSize := SizeOf(Info);
  if GetScrollBarInfo(Grid^.Handle, OBJID_HSCROLL_SIGNED, Info) then
    Visibility.Horizontal := not HasState(Info.rgstate[0], STATE_SYSTEM_INVISIBLE);
  FillChar(Info, SizeOf(Info), 0);
  Info.cbSize := SizeOf(Info);
  if GetScrollBarInfo(Grid^.Handle, OBJID_VSCROLL_SIGNED, Info) then
    Visibility.Vertical := not HasState(Info.rgstate[0], STATE_SYSTEM_INVISIBLE);
end;

