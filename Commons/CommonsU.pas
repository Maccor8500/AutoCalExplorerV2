  Result := AddrInt <> INADDR_NONE;
end;

procedure PackNetAddr(const Addr: String; var RawAddr : TIPv4AddrBytes);
var
  ByteStr : TArray<String>;
  i: Integer;
begin
  RawAddr := Default(TIPv4AddrBytes);

  if validAddress(Addr) then
  begin
    SplitStr(Addr, '.', ByteStr);
    for i := Low(ByteStr) to High(ByteStr) do
      RawAddr[i] := StrToInt(ByteStr[i]);
  end;
end;

procedure PackNetAddr(const Addr: String; var RawAddr : TIPAddress);
var
  ByteStr : TArray<String>;
  i, IntVal: Integer;
  RAddr: String;
  Port: Word;
begin
  ByteStr := EmptyStrArray;
  RAddr := Addr;
  Port := RawAddr.Port;
  RawAddr := Default(TIPAddress);

  { identify address type by checking unique properties... of IPv6<:> }
  case Pos(':', RAddr) of
    0: RawAddr.Identity := IPv4_ADDR;
    else
    begin
      SplitStr(RAddr, ':', ByteStr);

      case Length(ByteStr) of
        2: RawAddr.Identity := IPv4_ADDR;
        6: RawAddr.Identity := RAW_ETH;
        else RawAddr.Identity := IPv6_ADDR;
      end;
    end;
  end;

  { parse it based on above insight }
  try
    case RawAddr.Identity of
      IPv4_ADDR:
      begin
        if (Length(ByteStr) > 1) then
        begin
          RAddr := ByteStr[0];
          RawAddr.Port := StrToInt(ByteStr[1]);
        end
        else RawAddr.Port := Port;

        SplitStr(RAddr, '.', ByteStr);
        for i := Low(ByteStr) to High(ByteStr) do RawAddr.AsIPv4Addr.AsRAW[i] := StrToInt(ByteStr[i]);
      end;

      IPv6_ADDR:
      begin
        if Pos('/', RAddr) > 0 then
        begin
          SplitStr(RAddr, '/', ByteStr);
          if Length(ByteStr) > 1 then
            if TryStrToInt(ByteStr[1], IntVal) then
              RawAddr.AsIPv6Addr.Prefix := IntVal;
        end;

        if High(ByteStr) >= 0 then SplitStr(ByteStr[0], ':', ByteStr)
        else SplitStr(RAddr, ':', ByteStr);

        for i := Low(ByteStr) to High(ByteStr) do
          RawAddr.AsIPv6Addr.AsRAW[i] := StrToInt('$'+ ByteStr[i]);
      end;

      RAW_ETH:
      begin
         for i := Low(ByteStr) to High(ByteStr) do
          RawAddr.MAC.AsRAW[i] := StrToInt('$'+ ByteStr[i]);
      end;
    end;
  finally
    RawAddr.Str := ShortString(RAddr);
  end;
end;

procedure PackNetAddr(const Addr: String; var RawAddr : TAddressMAC);
var
  ByteStr : TArray<String>;
  i: Integer;
begin
  SplitStr(Addr, ':', ByteStr);
  for i := Low(ByteStr) to High(ByteStr) do
    RawAddr[i] := HexToInt(Trim(ByteStr[i]));
