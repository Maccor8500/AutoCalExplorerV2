begin
  Result := Default(TFileDates);
  if not FileExists(filename) then Exit;

  if not GetFileAttributesEx(PChar(FileName), GetFileExInfoStandard, @fad) then
    RaiseLastOSError;

  { update all }
  Result.AsString.Created := ShortString(ResolveTime(fad.ftCreationTime));
  Result.AsString.Modified := ShortString(ResolveTime(fad.ftLastWriteTime));
  Result.AsString.Accessed := ShortString(ResolveTime(fad.ftLastAccessTime));
  Result.AsDateTime.Created := FileTimeToDateTime(fad.ftCreationTime);
