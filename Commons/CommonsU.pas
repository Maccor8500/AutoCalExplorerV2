procedure GetUserAppDataDir(var AppDataDir: String; TrimRoaming: Boolean = True);
var
  Path: array [0..MAX_PATH] of Char;
begin
  AppDataDir := '';
  CoInitialize(nil);
  try
    if SHGetFolderPath(0, CSIDL_APPDATA, 0, SHGFP_TYPE_CURRENT, @Path[0]) = S_OK then
    begin
      AppDataDir := Path;
      if TrimRoaming then
        AppDataDir := ExcludeTrailingPathDelimiter(ExtractFileDir(AppDataDir));
    end
    else
      raise Exception.Create('Could not retrieve the AppData folder path.');
  finally
    CoUninitialize;
  end;
end;

function GetBit(Data: Pointer; const Pos: Byte; const Bits: TDataBits): Boolean;
begin
  if Pos >= Ord(Bits) then
    Exit(False);

  case Bits of
    _8Bits : Result := (PByte(Data)^   and (1 shl Pos)) <> 0;
    _16Bits: Result := (PWord(Data)^   and (1 shl Pos)) <> 0;
    _32Bits: Result := (PUInt32(Data)^ and (1 shl Pos)) <> 0;
    _64Bits: Result := (PUInt64(Data)^ and (1 shl Pos)) <> 0;
  else
    Result := False;
  end;
end;

procedure SetBit(Data: Pointer; const Pos: Byte; const Bits: TDataBits);
begin
  if (Pos > Ord(Bits)) then Exit;

  case Bits of
    _8Bits : PByte(Data)^ := (PByte(Data)^ or (1 SHL Pos));
    _16Bits: PWord(Data)^ := (PWord(Data)^ or (1 SHL Pos));
    _32Bits: PUInt32(Data)^ := (PUInt32(Data)^ or (1 SHL Pos));
    _64Bits: PUInt64(Data)^ := (PUInt64(Data)^ or (1 SHL Pos));
  end;
end;

procedure ClrBit(Data: Pointer; const Pos: Byte; const Bits: TDataBits);
begin
  if (Pos >= Ord(Bits)) then Exit;

  case Bits of
    _8Bits : PByte(Data)^    := PByte(Data)^   and (not (1 shl Pos));
    _16Bits: PWord(Data)^    := PWord(Data)^   and (not (1 shl Pos));
    _32Bits: PUInt32(Data)^  := PUInt32(Data)^ and (not (1 shl Pos));
    _64Bits: PUInt64(Data)^  := PUInt64(Data)^ and (not (1 shl Pos));
  end;
end;

procedure ToggleBit(Data: Pointer; const Pos: Byte; const Bits: TDataBits; Value: SmallInt);
begin
  if (Pos >= Ord(Bits)) then Exit;

  if Value < 0 then
  begin
    case Bits of
      _8Bits : PByte(Data)^    := PByte(Data)^    xor (1 shl Pos);
      _16Bits: PWord(Data)^    := PWord(Data)^    xor (1 shl Pos);
      _32Bits: PUInt32(Data)^  := PUInt32(Data)^  xor (1 shl Pos);
      _64Bits: PUInt64(Data)^  := PUInt64(Data)^  xor (1 shl Pos);
    end;
  end
  else
  begin
    case Value of
      0: ClrBit(Data, Pos, Bits);
      else SetBit(Data, Pos, Bits);
    end;
  end;
end;

