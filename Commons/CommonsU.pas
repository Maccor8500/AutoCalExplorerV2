// My version of tuple, using simple, easy record templates
// will work for 2 to 3 data-types
type
  Tuple<X,Y> = record
    private
      V1: X;
      V2: Y;
      procedure GetType;
    public
      procedure SetValues(const XValue: X; const YValue: Y);
      property First: X read V1 write V1;
      property Second: Y read V2 write V2;
  end;

type
  Tuple<X,Y,Z> = record
    private
      V1: X;
      V2: Y;
      V3: Z;

    public
      procedure SetValues(const XValue: X; const YValue: Y; const ZValue: Z);
      property First: X read V1 write V1;
      property Second: Y read V2 write V2;
      property Third: Z read V3 write V3;
  end;

  Dict<X> = record
    private
      D : Array of X;
      P : SmallInt;
      F : X;
      FSize : SmallInt;
      //Comp : IComparer<X>;

    public
      procedure Append(const Val: X);
      procedure Insert(const Val: X; const index : SmallInt);
      procedure Remove(const index : SmallInt);
      procedure Replace(const index: SmallInt; const Val : X);
      procedure Add(const Val: X);
      function Count: SmallInt;
      function InvalidIndex(const index :SmallInt) : Boolean;
      procedure Iterate; overload;
      procedure Iterate(Val : X); overload;
      function Next : X;
      function IndexOf(const Val: X) : Smallint;
      function Get(const index : SmallInt) : X; overload;
      procedure Get(const index : SmallInt; var Val : X); overload;
      procedure SetSize(const Size: SmallInt);

      property Size: SmallInt read Count;
  end;

