procedure CopyStr(const src : String; var dst: String; const start: Integer; const Stop : Char; const IncludeChar : Boolean);
var
  i: Integer;
begin
  dst := '';
  if Trim(src) = '' then Exit;

  if Start > Length(src) then Exit;
  for i := Start to Length(Src) do
  begin
    if Stop <> Src[i] then dst := dst + Src[i]
    else
    begin
      if IncludeChar then dst := dst + Src[i];
      break;
    end;
  end;
end;

procedure CopyStr(const src : String; var dst: String; const start: Integer; const Stop : TArray<Char>; const IncludeChar : Boolean);
var
  i, j, x: Integer;
  fin : Boolean;
begin
  Fin := False;
  x := 0;
  dst := '';
  if Trim(src) = '' then Exit;

  if Start > Length(src) then Exit;
  for i := Start to Length(Src) do
  begin
    for j := Low(Stop) to High(Stop) do
      if (Stop[j] = Src[i]) then
      begin
        if x > 0 then
        begin
          fin := True;
          break;
        end;
      end;

    if not Fin then
    begin
      dst := dst + Src[i];
      Inc(x);
    end
    else
    begin
      if IncludeChar then dst := dst + Src[i];
      break;
    end;
  end;

  Dst := Trim(Dst);
end;

procedure CopyStrX(const src : String; var dst: String; const start: Integer; const Stop : Integer);
var
  i: Integer;
begin
  dst := '';
  if Trim(src) = '' then Exit;

  if Start > Length(src) then Exit;
  if Stop < Start then Exit;

  for i := Start to Stop do dst := dst + Src[i];
end;

procedure CopyStr(const src : String; var dst : String; StopAt: String; IncludeChar : Boolean);
var
  i : Integer;
begin

  for i := 1 to Length(src) do
  begin
    { end if char is encountered! }
    if (src[i] = StopAt) then
    begin
      if IncludeChar then
        dst[i] := src[i];

      { we're done here! }
      break;
    end

    { keep it }
    else dst[i] := src[i];
  end;
end;

