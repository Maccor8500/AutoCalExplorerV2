procedure TTCPServerEx.ASyncSendData(const Client : TSocket; const StrData : AnsiString; Success : TAsyncSendCallback = nil);
begin
  { compiler assumes an interface :: no worries }
  TTask.Create(procedure
  var
    S : Boolean;
    L : Integer;
    Session : PClientSession;
  begin
    try
      { since exceptions are caught in senddata, itask should always be freed! }
      L := Length(StrData);
      S := (Send(Client, (@StrData[1])^, L, 0) = L);

      { count tx }
      if S and UseStats then
      begin
        Session := GetSession(Client);
        if Session <> nil then
          AtomicExchange(Session^.Stats.Sent, Session^.Stats.Sent +1);
      end;

      if Assigned(Success) then Success(S, GetClientAddress(Client));
    except
      On E: Exception do
        if Assigned(OnErrorEvent) then
        begin
          BuildSocketError(@E);
          OnErrorEvent(@Error);
        end;
    end;
  end).Start;
end;

procedure TTCPServerEx.ASyncSendData(const Client : TSocket; const Data : PBuffer; const Len : Word; Callback : TAsyncSendCallback = nil);
begin
  { compiler assumes an interface :: no worries }
  TTask.Create(procedure
  var
    S : Boolean;
    Session : PClientSession;
  begin
    try
      { since exceptions are caught in senddata, itask should always be freed! }
      S := SendData(Client, Data, Len);

      { count tx }
      if S and UseStats then
      begin
        Session := GetSession(Client);
        if Session <> nil then
          AtomicExchange(Session^.Stats.Sent, Session^.Stats.Sent +1);
      end;

      if Assigned(Callback) then Callback(S, GetClientAddress(Client));
    except
      On E: Exception do
        if Assigned(OnErrorEvent) then
        begin
          BuildSocketError(@E);
          OnErrorEvent(@Error);
        end;
    end;
  end).Start;
end;

procedure TTCPServerEx.AlertLimit(const Socket: TSocket);
const
  M = AnsiString('Connection actively rejected. Max limit reached!');
var
  Info : TSocketInfo;
begin
  { send limit message }
  SendData(Socket, M);

  if Debug <> nil then
  begin
    GetSocketInfo(Socket, @Info);
    Debug.WriteLn(format('Client %s:%d rejected!', [Info.AddrStr, Info.Port]));
  end;

  { reject socket }
  Shutdown(Socket, SD_BOTH);
  { close it }
  closesocket(Socket);
end;

function TTCPServerEx.Alive: Boolean;
begin
  Result := (WSAOK and SocketOK);
end;

procedure TTCPServerEx.EnableEncryption(YesNo: Boolean; Key : AnsiString);
begin
  if not YesNo then Exit;
  Cipher := TXXTEA.Create(Key);
end;

procedure TTCPServerEx.EnableEncryption(YesNo: Boolean; Key: TBytes);
begin
  if not YesNo then Exit;
  Cipher := TXXTEA.Create(Key);
end;

procedure TTCPServerEx.ASyncSendData(const Client : TSocket; const Data : Pointer; const Len : Word; Callback : TAsyncSendCallback = nil);
begin
  { compiler assumes an interface :: no worries }
  TTask.Create(procedure
  var
    S : Boolean;
  begin
    { since exceptions are caught in senddata, itask should always be freed! }
    S := SendData(Client, Data, Len);
    if Assigned(Callback) then Callback(S, GetClientAddress(Client));
  end).Start;
end;

procedure TTCPServerEx.BuildSocketError(const E: PException);
begin
  if E = nil then exit;

  Error.Code := WSAGetLastError;
  Error.Info := E^.Message;
  Error.Trace := E^.StackTrace;
end;

procedure TTCPServerEx.AlertSocketError;
var
  Error: TSocketError;
begin
  if Assigned(OnErrorEvent) then
  begin
    PackSocketError(WSAGetLastError, Error);
    OnErrorCallback(@Error);
  end;
end;

procedure TTCPServerEx.SessionIndex(const Session: PClientSession; var Index: SmallInt);
var
  i: Integer;
begin
  { default result }
  Index := -1;

  { find it! }
  for i := Low(Sessions) to High(Sessions) do
  begin
    { skip if no match! }
    if Sessions[i].iDescr <> Session^.iDescr then continue;
    { found it! }
    Index := i;
    { get! }
    break;
  end;
end;

function TTCPServerEx.ValidSession(Session: PClientSession): Boolean;
var
  Timeout : TimeVal;
begin
  { initialize the FDSet with the socket }
  FD_ZERO(Session^.FDSet);
  _FD_SET(Session^.iDescr, Session^.FDSet);
  { set a timeout value }
  Timeout.tv_sec := 1;
  Timeout.tv_usec := 0;
  { use select to check socket activity }
  Result := (Winsock2.select(0, @Session^.FDSet, nil, nil, @Timeout) > 0);
end;

{ TTCPASyncContext }
constructor TSocketASyncContext.Create(AClient: PSocket; const Buffer; BufLen: Integer; OnEvent: TSocketErrorCallback);
begin
  inherited Create;
  EventHandler := OnEvent;
  FClientSocket := AClient;

  SetLength(FData, BufLen);
  Move(Buffer, FData[0], BufLen);

  ZeroMemory(@FOverlapped, SizeOf(FOverlapped));
  FWSABuf.buf := PAnsiChar(@FData[0]);
  FWSABuf.len := BufLen;

  FIOCPHandle := CreateIoCompletionPort(FClientSocket^, 0, 0, 0);
  FIOCPThread := TThread.CreateAnonymousThread(IOCPWatchHandler);
  FIOCPThread.Start;
end;

constructor TSocketASyncContext.Create(AClient: PSocket; const Buffer; BufLen: Integer; const DestAddr: TSockAddrIn; const DestAddrLen: Integer; const OnError: TSocketErrorCallback);
begin
  Create(AClient, Buffer, BufLen, OnError);
  FRemoteAddr := DestAddr;
  FRemoteAddrLen := DestAddrLen;
end;

destructor TSocketASyncContext.Destroy;
begin
  inherited;
end;

function TSocketASyncContext.GetSocketType: Integer;
var
  SockType: Integer;
  OptLen: Integer;
begin
  Result := -1;
  SockType := 0;
  OptLen := SizeOf(SockType);

  if getsockopt(FClientSocket^, SOL_SOCKET, SO_TYPE, @SockType, OptLen) = 0 then
    Result := SockType;
end;

procedure TSocketASyncContext.IOCPWatchHandler;
var
  BytesSent: DWORD;
  CompletionKey: ULONG_PTR;
  FOverlappedPtr: POverlapped;
begin
  BytesSent := 0;
  FOverlappedPtr := @FOverlapped;
  GetQueuedCompletionStatus(FIOCPHandle, BytesSent, CompletionKey, FOverlappedPtr, INFINITE);
  OnSendComplete(WSAGetLastError, BytesSent);
end;

function TSocketASyncContext.Send: Boolean;
var
  SentBytes: Cardinal;
  Res: Integer;
begin
  Res := SOCKET_ERROR;

  try
    try
      case GetSocketType of
        SOCK_STREAM: Res := WSASend(FClientSocket^, @FWSABuf, 1, SentBytes, 0, @FOverlapped, nil);
        SOCK_DGRAM:
        begin
          if (FRemoteAddrLen > 0) then Res := WSASendTo(FClientSocket^, @FWSABuf, 1, @SentBytes, 0, TSockAddr(FRemoteAddr), FRemoteAddrLen, @FOverlapped, nil)
          else Res := WSASend(FClientSocket^, @FWSABuf, 1, SentBytes, 0, @FOverlapped, nil);
        end

        else Exit(False);
      end;
    except
      Res := SOCKET_ERROR;
    end;
  finally
    Result := (Res <> SOCKET_ERROR);
    if (not Result) then Result := (WSAGetLastError = WSA_IO_PENDING)
    else PostQueuedCompletionStatus(FIOCPHandle, SentBytes, 0, @FOverlapped);
  end;
end;

procedure TSocketASyncContext.OnSendComplete(ErrorCode: Cardinal; BytesTransferred: Cardinal);
begin
  try
    if Assigned(EventHandler) then
    begin
      Error := Default(TSocketError);
      PackSocketError(ErrorCode, Error);
      EventHandler(@Error);
    end;
  finally
    Free;
  end;
end;

