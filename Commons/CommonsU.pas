{ TThreadQueueManager }
procedure TThreadQueueManager.Increment;
begin
  TInterlocked.Increment(PInt64(@Tasks)^);
end;

procedure TThreadQueueManager.Reset;
begin
  TInterlocked.Exchange(Tasks, 0);
end;

procedure TThreadQueueManager.Decrement;
begin
  if Tasks = 0 then Exit;
  TInterlocked.Decrement(PInt64(@Tasks)^);
end;

function TThreadQueueManager.Empty: Boolean;
begin
  Result := (TInterlocked.Read(PInt64(@Tasks)^) <= 0);
end;

function TThreadQueueManager.WaitFor(Timeout: Integer): Boolean;
var
  T: UInt64;
begin
  T := GetTickCountEx(Timeout);

  repeat
    ProcessMsgs(50)
  until (GetTickCountEx >= T) or Empty;

  Exit(Empty);
end;

{ TDictionaryEx | IDictionaryEx }
constructor TDictionaryEx<TKey, TVal>.Create(AllowDuplicates: Boolean; Alloc: Integer);
begin
  if Alloc > 0 then Dict := TDictionary<TKey, TVal>.Create(Alloc)
  else Dict := TDictionary<TKey, TVal>.Create;

  AllowDuplicateKeys := AllowDuplicates;
end;

constructor TDictionaryEx<TKey, TVal>.Create(const Key: TKey; const Value: TVal; AllowDuplicates: Boolean);
begin
  Create(AllowDuplicates);
  Dict.Add(Key, Value);
end;

constructor TDictionaryEx<TKey, TVal>.Create(const Pairs: TArray<TPair<TKey, TVal>>; AllowDuplicates: Boolean);
var
  Pair: TPair<TKey, TVal>;
begin
  Create(AllowDuplicates);
  for Pair in Pairs do Dict.Add(Pair.Key, Pair.Value);
end;

destructor TDictionaryEx<TKey, TVal>.Destroy;
begin
  Dict.Clear;
  FreeAndNil(Dict);
  inherited;
end;

procedure TDictionaryEx<TKey, TVal>.EnableDuplicate(const Enable: Boolean);
begin
  AllowDuplicateKeys := Enable;
end;

function TDictionaryEx<TKey, TVal>.GetValue(const Key: TKey): TVal;
begin
  Result := Dict[Key];
end;

procedure TDictionaryEx<TKey, TVal>.GetValues(const Keys: TArray<TKey>;
  var Values: TArray<TVal>);
var
  i: Integer;
begin
  SetLength(Values, Length(Keys));

  for i := Low(Keys) to High(Keys) do
    Dict.TryGetValue(Keys[i], Values[i]);
end;

procedure TDictionaryEx<TKey, TVal>.Insert(const Pairs: TArray<TPair<TKey, TVal>>);
var
  i: Integer;
begin
  for i := Low(Pairs) to High(Pairs) do
    Insert(Pairs[i]);
end;

procedure TDictionaryEx<TKey, TVal>.Insert(const Pair: TPair<TKey, TVal>);
begin
  Insert(Pair.Key, Pair.Value);
end;

procedure TDictionaryEx<TKey, TVal>.Insert(const Key: TKey; const Value: TVal);
begin
  if not AllowDuplicateKeys then
    if ContainsKey(Key) then
      raise Exception.Create('Duplicate Keys not allowed. <EnableDuplicate = False>');

  Dict.Add(Key, Value);
end;

procedure TDictionaryEx<TKey, TVal>.SetValue(const Key: TKey; const Value: TVal);
begin
  if ContainsKey(Key) then Dict[Key] := Value;
end;

{ do not use! }
function TDictionaryEx<TKey, TVal>.ToJSON: AnsiString;
var
  JSONObj: TJSONObject;
  Pair: TPair<TKey, TVal>;
  JSONValue: TJSONValue;
  StrValue: string;
  BoolValue: Boolean;
  Kind: TTypeKind;
  Info: PTypeInfo;
begin
  JSONObj := TJSONObject.Create;
  try
    for Pair in Dict do
    begin
      Info := PTypeInfo(TypeInfo(TValue));
      Kind := Info^.Kind;

      GetTypeInfoFromName(String(Info.Name));

      case Kind of
        tkInteger: JSONValue := TJSONNumber.Create(PInteger(@Pair.Value)^);
        tkInt64: JSONValue := TJSONNumber.Create(PInt64(@Pair.Value)^);
        tkFloat: JSONValue := TJSONNumber.Create(PSingle(@Pair.Value)^);
        tkString: JSONValue := TJSONString.Create(PString(@Pair.Value)^);
        tkWString: JSONValue := TJSONString.Create(PWideString(@Pair.Value)^);
        tkUString: JSONValue := TJSONString.Create(PUnicodeString(@Pair.Value)^);

        else
          JSONValue := TJSONNull.Create;
      end;

      //JSONObj.AddPair(Pair.Key, JSONValue);
    end;

    Result := AnsiString(JSONObj.ToString);
  finally
    JSONObj.Free;
  end;
end;

