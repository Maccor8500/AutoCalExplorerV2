function FloatToStrDigits(FloatVal: double; SigDigs: integer): string;    //Significant Digits or decimals
var
  Sign: integer;
  Pof10: integer;
  S: string;

begin
  if SigDigs<1 then
  begin
    Result:=FloatToStr(FloatVal);
    Exit;
  end;

  if FloatVal=0 then
  begin
    S:='0.'+StringOfChar('0', SigDigs-1);
    Result:=FormatFloat(S, 0);
    Exit;
  end
  else if FloatVal>=0 then
    Sign:=1
  else
  begin
    Sign:=-1;
    FloatVal:=-FloatVal;
  end;

  Pof10:=Trunc(Log10(FloatVal));

  if FloatVal>=1 then
  begin
    if (SigDigs-Pof10-1) <= 0 then
      S:='0'
    else
      S:='0.'+StringOfChar('0', SigDigs-Pof10-1);
  end
  else
  begin
    if (SigDigs-Pof10) <= 0 then
      S:='0'
    else
      S:='0.'+StringOfChar('0', SigDigs-Pof10);
  end;

  Result:=FormatFloat(S, Sign*FloatVal);
end;

