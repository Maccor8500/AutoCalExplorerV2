function TTCPServerEx.GetClientInfo(const Index: Byte): TSocketInfo;
begin
  Result := Default(TSocketInfo);
  if Index > High(Sessions) then Exit;
  Result := Sessions[Index].SocketInfo;
end;

function TTCPServerEx.GetClients: TArray<TClientSession>;
var
  i: Integer;
begin
  SetLength(Result, Length(Sessions));
  for i := Low(Result) to High(Result) do
    Result[i] := Sessions[i];
end;

function TTCPServerEx.GetConfigAddr: String;
begin
  Result := format('%s:%d', [GetAddress, GetListenPort]);
end;

function TTCPServerEx.GetListenPort: Word;
begin
  Result := ListenPort;
end;

function TTCPServerEx.GetAddress: String;
begin
  Result := format('%d.%d.%d.%d', [ServerAddr.sin_addr.S_un_b.s_b1,
    ServerAddr.sin_addr.S_un_b.s_b2, ServerAddr.sin_addr.S_un_b.s_b3,
      ServerAddr.sin_addr.S_un_b.s_b4]);
end;

function TTCPServerEx.GetSession(const Socket: TSocket): PClientSession;
var
  i: Integer;
begin
  Result := nil;

  for i := Low(Sessions) to High(Sessions) do
  begin
    { no match! }
    if Sessions[i].iDescr <> Socket then continue;
    { match! }
    Result := @Sessions[i];
    break;
  end;
end;

function TTCPServerEx.GetSessions: TArray<TClientSession>;
begin
  Result := GetClients;
end;

function TTCPServerEx.GetTotalClients: Integer;
begin
  Result := Clients;
end;

function TTCPServerEx.GetClient(const Index: Byte): TClientSession;
begin
  Result := Default(TClientSession);
  if Index > High(Sessions) then Exit;

  Result := Sessions[Index];
end;

function TTCPServerEx.GetClientPtr(const Index: Byte): PClientSession;
begin
  if (High(Sessions) < 0) or (Index > High(Sessions)) then Exit(nil);
  Result := @Sessions[Index];
end;

function TTCPServerEx.Kick(const Socket: TSocket): Boolean;
begin
  GetSession(Socket)^.Kick := True;
  Result := (GetSession(Socket)^.Kick = True);
end;

function TTCPServerEx.Kick(const Session: TClientSession): Boolean;
var
  Index : SmallInt;
begin
  Result := False;
  SessionIndex(@Session, Index);
  if Index >= 0 then
  begin
    Sessions[Index].Kick := True;
    Result := True;
  end;
end;

