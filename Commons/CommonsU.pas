function TTCPClientEx.SendData(const Data: AnsiString): Boolean;
var
  Len : Integer;
begin
  Result := False;

  try
    EnterCriticalSection(Section);

    try
      Len := Length(Data);
      SentBytes := Send(ClientSock, Data[1], Len, 0);
      Result := (SentBytes <> SOCKET_ERROR) and (SentBytes = Len);
    except
      On E: Exception do
        AlertException(E);
    end;
  finally
    LeaveCriticalSection(Section);
  end;
end;

function TTCPClientEx.SendData(Data: Pointer; const Len: Integer): Boolean;
begin
  Result := False;

  try
    EnterCriticalSection(Section);

    try
      SentBytes := Send(ClientSock, Data^, Len, 0);
      Result := (SentBytes <> SOCKET_ERROR) and (SentBytes = Len);
      { error? }
      if SentBytes = SOCKET_ERROR then AlertSocketError;
    except
      On E: Exception do
        AlertException(E);
    end;
  finally
    LeaveCriticalSection(Section);
  end;
end;

procedure TTCPClientEx.AlertSocketError;
var
  Err: TSocketError;
begin
  if not Assigned(OnErrorCallback) then Exit;
  { fill }
  PackSocketError(WSAGetLastError, Err);
  { send it }
  OnErrorCallback(@Err);
end;

procedure TTCPClientEx.AlertException(const E: Exception);
var
  Exc: TSocketException;
begin
  if not Assigned(OnExceptionCallback) then Exit;
  PackSocketException(E, GetLastError, Exc);
  OnExceptionCallback(@Exc);
end;

procedure TTCPClientEx.AutoReconnect(const YesNo: Boolean;
  const Timeout: Integer; Tries : Integer);
begin
  Reconnect := YesNo;
  ReconnectTries := Tries;
  ReconnectTimeout := Timeout;
end;

function TTCPClientEx.AsyncSendData(Data: Pointer; const Len: Integer): Boolean;
var
  Context: TSocketASyncContext;
begin
  Context := TSocketASyncContext.Create(@ClientSock, Data^, Len, OnErrorCallback);
  Result := Context.Send;
end;

procedure TTCPClientEx.AsyncSendData(const Data: AnsiString);
begin
  TTask.Run(
    procedure
    var
      Payload: WSABUF;
      SentBytes : Cardinal; { local }
    begin

      try
        Payload.Len := Length(Data);
        Payload.Buf := PAnsiChar(Data[1]);
        WSASend(ClientSock, @Payload, 1, SentBytes, 0, nil, nil);
      except
        On E: Exception do
          AlertException(E);
      end;
    end);
end;

{ TDebugConfig }
procedure TDebugConfig.Configure(DbgOut: TObject);
var
  i: Integer;
begin
  if DbgOut is TMemo then
  begin
    Self.Output.AsMemo := (DbgOut As TMemo);
    Choice := 0;
  end
  else
  begin
    Self.Output.AsRichEdit := (DbgOut As TRichEdit);
    Choice := 1;
  end;

  Configured := True;

  { any thing waiting to be written? }
  if HoldStr <> nil then
  begin
    try
      { write all strings in wait! }
      for i := 0 to HoldStr.Count -1 do
        Write(HoldStr[i]);
    finally
      FreeAndNil(HoldStr);
    end;
  end;
end;

procedure TDebugConfig.ConfigureCache(const Enable: Boolean; MaxLength: Byte);
begin
  Hold := True;
  HoldStr := TStringList.Create;
  HoldStr.Capacity := MaxLength;
  HoldStr.Clear;
end;

constructor TDebugConfig.Create;
begin

end;

destructor TDebugConfig.Destroy;
begin
  if HoldStr <> nil then
    FreeAndNil(HoldStr);
end;

procedure TDebugConfig.Mark(const S: ShortString; const Color : TColor);
var
  L : Byte;
begin
  L := Length(Marks);
  if L >= MAXBYTE then Exit;

  SetLength(Marks, L +1);
  Marks[L].Str := S;
  Marks[L].Color := Color;
end;

procedure TDebugConfig.Write(const S : String);
begin
  if (Enabled <> DebugON) or (MainThread = nil) then
  begin
    if Hold and (HoldStr <> nil) then
    begin
      if HoldStr.Count < HoldStr.Capacity then
        { hold for later }
        HoldStr.Append(S);
    end;

    Exit;
  end;

  MainThread.Queue(TThread.CurrentThread,
  procedure
  var
    I, P: Integer;
    S1, S2 : String;
  begin
    I := 0;

    case Choice of
      0: if Output.AsMemo <> nil then Output.AsMemo.SelText := S;
      1:
      begin
        if Output.AsRichEdit <> nil then
        begin
          if High(Marks) >= 0 then
          begin
            S1 := '';
            S2 := '';

            for I := Low(Marks) to High(Marks) do
            begin
              P := Pos(String(Marks[i].Str), S);

              if P > 0 then
              begin
                S1 := Copy(S, 1, P -1);
                S2 := Copy(S, P, Length(S) -Length(S1));
                break;
              end;
            end;
          end;


          if S1 <> '' then
          begin
            Output.AsRichEdit.SelAttributes.Color := clBlack;
            Output.AsRichEdit.SelText := S1;
          end;

          if S2 <> '' then
          begin
            Output.AsRichEdit.SelAttributes.Color := Marks[i].Color;
            Output.AsRichEdit.SelText := S2;
          end;

          if (S1 = S2) then Output.AsRichEdit.SelText := S;
        end;
      end;
    end;
  end);
end;

procedure TDebugConfig.Write(const S : Array of String; Colors : Array of TColor);
var
  Sx : TArray<String>;
  Cx : TArray<TColor>;
  i: Integer;
begin
  if (Enabled <> DebugON) or (MainThread = nil) then Exit;
  if Length(S) <> Length(Colors) then Exit;

  SetLength(Sx, Length(S));
  SetLength(Cx, Length(Colors));
  for i := Low(S) to High(S) do Sx[i] := S[i];
  for i := Low(S) to High(S) do Cx[i] := Colors[i];

  MainThread.Queue(TThread.CurrentThread,
  procedure
  var
    i: Integer;

  begin
    case Choice of
      1:
      if Output.AsRichEdit <> nil then
      begin
        for i := Low(Sx) to High(Sx) do
        begin
          Output.AsRichEdit.SelAttributes.Color := Cx[i];
          Output.AsRichEdit.SelText := Sx[i];
        end;
      end;
    end;
  end);
end;

