procedure HighlightIni(var RichEdit: TRichEdit);
var
  i, EqPos, LineStart: Integer;
  Line: string;
begin
  for i := 0 to RichEdit.Lines.Count - 1 do
  begin
    Line := Trim(RichEdit.Lines[i]);
    LineStart := RichEdit.Perform(EM_LINEINDEX, i, 0);

    if (Line <> '') and (Line[1] = '[') then
    begin
      RichEdit.SelStart := LineStart;
      RichEdit.SelLength := Length(RichEdit.Lines[i]);
      RichEdit.SelAttributes.Color := clBlue;
    end
    else
    begin
      EqPos := Pos('=', Line);
      if EqPos > 0 then
      begin
        RichEdit.SelStart := LineStart;
        RichEdit.SelLength := EqPos -1;
        RichEdit.SelAttributes.Color := clTeal;

        RichEdit.SelStart := LineStart +EqPos -1;
        RichEdit.SelLength := 1;
        RichEdit.SelAttributes.Color := clGray;

        RichEdit.SelStart := LineStart +EqPos;
        RichEdit.SelLength := Length(RichEdit.Lines[i]) -EqPos;
        RichEdit.SelAttributes.Color := clPurple;
      end
      else
      begin
        RichEdit.SelStart := LineStart;
        RichEdit.SelLength := Length(RichEdit.Lines[i]);
        RichEdit.SelAttributes.Color := clGray;
      end;
    end;
  end;

  RichEdit.SelStart := 0;
  RichEdit.SelLength := 0;
  RichEdit.Perform(EM_SCROLLCARET, 0, 0);
end;

procedure GetRawSocketPayload(const RawPacket: PRawSocketPacket; var Header: PEthernetFrame; var Payload: PByte; var Size: Integer);
var
  Offset: UInt32;
begin
  Size := 0;
  if RawPacket = nil then Exit;
  
  { parse ethernet frame from pointed address }
  Header := PEthernetFrame(RawPacket^.Data);
  Offset := SizeOf(TEthFrameHeader) +IntTernary((Header^.EthType = $8100), SizeOf(TVLAN_TAG), 0);
  Payload := PByte(NativeUInt(Header) +SizeOf(TEthernetFrame));
  Size := RawPacket^.Header.CaptureLength -Offset;
end;

