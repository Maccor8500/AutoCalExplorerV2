procedure RoundFormCorners(Form: TForm; Radius: Integer);
const
  DWMWA_WINDOW_CORNER_PREFERENCE = 33;
  DWMWCP_ROUND = 2;
var
  Corner: Integer;
begin
  case TUtils.GetWindowsVersion of
    wvWin11:
    begin
      Corner := DWMWCP_ROUND;
      DwmSetWindowAttribute(
        Form.Handle,
        DWMWA_WINDOW_CORNER_PREFERENCE,
        @Corner,
        SizeOf(Corner)
      );
    end;

    wvWin10, wvUnknown: RoundCorner(Form, Radius);
  end;
end;

procedure RoundCorner(Control: TWinControl; const radius : SmallInt);
var
  R: TRect;
  Rgn: HRGN;
begin
   with Control do
   begin
     R := ClientRect;
     rgn := CreateRoundRectRgn(R.Left, R.Top, R.Right, R.Bottom, radius, radius) ;
     Perform(EM_GETRECT, 0, lParam(@r));
     InflateRect(r, -4, -4) ;
     Perform(EM_SETRECTNP, 0, lParam(@r));
     SetWindowRgn(Handle, rgn, True);
     Invalidate;
   end;
end;

procedure RoundCorner(Control: TWinControl; const RadiusX, RadiusY: SmallInt);
var
  R: TRect;
  Rgn: HRGN;
  DC: HDC;
  Pen, OldPen: HPEN;
  Brush, OldBrush: HBRUSH;
begin
  R := Control.ClientRect;
  Rgn := CreateRoundRectRgn(R.Left, R.Top, R.Right, R.Bottom, RadiusX, RadiusY);
  if Rgn = 0 then Exit;

  // Apply rounded region
  if SetWindowRgn(Control.Handle, Rgn, True) = 0 then
    DeleteObject(Rgn);

  // Adjust edit rect only if applicable
  if Control is TCustomEdit then
  begin
    R := Control.ClientRect;
    InflateRect(R, -4, -4);
    Control.Perform(EM_SETRECTNP, 0, LPARAM(@R));
  end;

  // Draw border around the rounded region
  DC := GetWindowDC(Control.Handle);
  try
    Pen := CreatePen(PS_SOLID, R.Width, ColorToRGB(clBtnFace));
    OldPen := SelectObject(DC, Pen);

    Brush := GetStockObject(NULL_BRUSH); // transparent fill
    OldBrush := SelectObject(DC, Brush);

    RoundRect(DC, 0, 0, Control.Width, Control.Height, RadiusX, RadiusY);

    // Restore GDI objects
    SelectObject(DC, OldPen);
    DeleteObject(Pen);
    SelectObject(DC, OldBrush);
  finally
    ReleaseDC(Control.Handle, DC);
  end;

  Control.Repaint;
end;

