procedure DeleteFolderContents(const FolderPath: string; SubFolders: Boolean;
  Cancel : PBoolean; Memo : PDebugMemo);
var
  SearchRec: TSearchRec;
  FilePath: string;
  Res : Boolean;
begin
  if FindFirst(IncludeTrailingPathDelimiter(FolderPath) + '*', faAnyFile, SearchRec) = 0 then
  begin
    try
      repeat
        if (SearchRec.Name <> '.') and (SearchRec.Name <> '..') then
        begin
          FilePath := IncludeTrailingPathDelimiter(FolderPath) + SearchRec.Name;
          if (SearchRec.Attr and faDirectory) = faDirectory then
          begin
            if SubFolders then
            begin
              { recursively delete subfolders and their contents }
              if Memo <> nil then Memo.WriteLn(format('deleting folder [%s]',
                [FilePath]), clSilver);
              DeleteFolderContents(FilePath);
              { remove the empty subfolder }
              RemoveDir(FilePath);
            end;
          end
          else
          begin
            { delete files within the folder }
            if Memo <> nil then Memo.Write(format('deleting file [%s] ',
              [ExtractFilename(FilePath)]), clSilver, True);
            Res :=  DeleteFile(FilePath);
            if Memo <> nil then
            begin
              if Res then Memo.WriteLastLn('success'#13, clGreen)
              else Memo.WriteLastLn('failure'#13, clRed);
            end;
          end;
        end;

        if Cancel <> nil then
          if Cancel^ then
          begin
            if Memo <> nil then Memo.WriteLn('delete operation terminated!', clRed);
            break;
          end;
      until FindNext(SearchRec) <> 0;
    finally
      FindClose(SearchRec);
    end;
  end;
end;

