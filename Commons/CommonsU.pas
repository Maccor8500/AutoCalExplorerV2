  function ResolveTime(const FileTime: TFileTime) : String;
  begin
    Result := '';
    if not FileTimeToSystemTime(FileTime, SystemTime) then Exit;
    if not SystemTimeToTzSpecificLocalTime(nil, SystemTime, LocalTime) then Exit;
    Result := FormatDateTime('MM/DD/YYYY - HH:MM:SS AMPM', SystemTimeToDateTime(LocalTime));
