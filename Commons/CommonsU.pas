{ TConsoleCache }
procedure TConsoleCache.Update(const S: ShortString);
begin
  if Max <= 0 then Max := MAXBYTE;
  if Size <> Max then SetLength(Items, Max);

  { go around }
  if WrIndex >= Max then WrIndex := 0;

  Items[WrIndex] := S;
  Inc(WrIndex);
end;

procedure TConsoleCache.GetHistory(const Direction: Word;
  var Item: ShortString);
begin
  Item := '';
  if Size <= 0 then Exit;

  case Direction of
    VK_UP: Inc(RdIndex);
    VK_DOWN: Dec(RdIndex);
  end;

  if RdIndex > Roof then RdIndex := 0;
  Item := Items[RdIndex];
end;

function TConsoleCache.Roof: Byte;
begin
  Result := High(Items);
end;

function TConsoleCache.Size: Byte;
begin
  Result := Length(Items);
end;

