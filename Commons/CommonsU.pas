procedure TAriadne.Start;
var
  P: Word;
begin
  if Assigned(Comm) then Exit;
  FConnected := true;

  GetUniquePort(stSockUDP, P); 

  try
    Comm := TUDPSocket.Create;
    Comm.DestinationAddress := FAddr;
    Comm.ListeningPort := IntToStr(P);
    Comm.DestinationPort:= '69';
    Comm.OnDataAvailable := HandleAriadneData;
    Comm.Synchronized:=false;
    Comm.Suspended := false;
  except
    FConnected := false;
  end;
end;

