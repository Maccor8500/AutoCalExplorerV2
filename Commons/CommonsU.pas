function BitGet(const aValue: Cardinal; const Bit: Byte): Boolean;
begin
  Result := (aValue and (1 shl Bit)) <> 0;
end;

//set a particular bit as 1
function BitSet(const aValue: Cardinal; const Bit: Byte): Cardinal;
begin
  Result := aValue or (1 shl Bit);
end;

procedure BitSet(var aValue: Cardinal; const Bit: SmallInt);
begin
  aValue := aValue or (1 shl Bit);
end;

//set a particular bit as 0
function BitClear(const aValue: Cardinal; const Bit: Byte): Cardinal;
begin
  Result := aValue and not (1 shl Bit);
end;

procedure BitClear(var aValue: Cardinal; const Bit: SmallInt);
begin
  aValue := aValue and not (1 shl Bit);
end;

//Enable o disable a bit
function BitEnable(const aValue: Cardinal; const Bit: Byte; const Flag: Boolean): Cardinal;
begin
  Result := (aValue or (1 shl Bit)) xor Cardinal(Integer(not Flag) shl Bit);
end;

procedure BitsToStr(const bits : TBits; var str : String);
var
  i: Integer;
begin
  str := '';

  for i := 0 to bits.Size -1 do
    if bits[i] then
      str := str + '1'
    else
      str := str + '0';
end;

procedure IntToBitsStr(const val : Integer; var bitstr : String; len : byte = 16);
var
  i, r, v: Integer;
begin
  bitstr := '';
  for i := 0 to len -1 do
    bitstr := bitstr + '0';

  if val = 0 then Exit;

  i := 1; v := val;
  repeat
    r := v mod 2;
    if r <> 0 then
      bitstr[i] := '1';
    Inc(i);
    v := v div 2;
  until v = 0;

  bitstr := ReverseString(bitstr);
end;

procedure BinaryToHex(bin : String; var hex : String);
const
  BinArray: array[0..15, 0..1] of string =
    (('0000', '0'), ('0001', '1'), ('0010', '2'), ('0011', '3'),
     ('0100', '4'), ('0101', '5'), ('0110', '6'), ('0111', '7'),
     ('1000', '8'), ('1001', '9'), ('1010', 'A'), ('1011', 'B'),
     ('1100', 'C'), ('1101', 'D'), ('1110', 'E'), ('1111', 'F'));
var
  Error: Boolean;
  j: Integer;
  BinPart: string;
begin
  hex :='';

  Error:=False;
  for j:=1 to Length(Bin) do
    if not (CharInSet(Bin[j], ['0', '1'])) then
    begin
      Error:=True;
      Break;
    end;

  if not Error then
  begin
    case Length(Bin) mod 4 of
      1: Bin := '000' +Bin;
      2: Bin := '00' +Bin;
      3: Bin := '0' +Bin;
    end;

    while Length(Bin)>0 do
    begin
      BinPart:=Copy(Bin, Length(Bin) -3, 4);
      Delete(Bin, Length(Bin) -3, 4);
      for j := 1 to 16 do
        if BinPart=BinArray[j-1, 0] then
          hex := BinArray[j-1, 1] +hex;
    end;
  end;
end;

procedure BinToDec(const bin : String; var val : Integer);
var
  hex : String;
begin
  BinaryToHex(bin, hex);
  val := HexToInt(hex);
end;
