function HexToDWordDef(Hex: string; Def: dword): dword;
Const HexDigits = '0123456789ABCDEF';
Var
  Dig: Integer;
  Total: dword;
  ChPos, L: dword;
  Ch: Char;
Begin
  try
    if Pos('0x', LowerCase(Hex))=1 then  //Get rid of 0x hex designator
      Delete(Hex, 1, 2);
    Total := 0;
    L := Length(Hex);
    For ChPos := 1 to L do
    Begin
      Ch := upcase(Hex[ChPos]);
      Dig := Pos(Ch, HexDigits) -1;
      If Dig = -1 then
      Begin
        Result:=Def;
        Exit;
      end;

      Total := Total * 16 + DWord(Dig);
    end;
    Result:=Total;
  except
    Result:=Def;
  end;
end;

