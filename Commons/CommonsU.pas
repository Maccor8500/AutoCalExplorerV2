  TAuxInputParam = packed record
    //Priority : smallint;   //Updated to MacTest32 7-17-14
    Priority : word;   //Not in use
    RGE : RangeParam;
    Chan : ChanParam;
    Cal : CalParam;
    Descriptor : packed array[1..34] of AnsiChar;
    ConstB : longint;
    ConstC : smallint;
  end;

