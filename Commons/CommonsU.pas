procedure LoadCellBalance;
var
  IniFile: TMemIniFile;
  I: SmallInt;
  S: String;
begin
  if FileExists(MacSysPtr^.CellBalFile) then
  begin
    IniFile := TMemIniFile.Create(MacSysPtr^.CellBalFile);
    with IniFile do
    begin
      try
        MacSysPtr^.SysCfg.CellBalPort := ReadInteger('General_Settings', 'Port', 8886);
        MacSysPtr^.SysCfg.CellBalAddr := ReadString('General_Settings', 'IP_address', '192.168.127.');
        MacSysPtr^.SysCfg.CellBalAddr := Copy(MacSysPtr^.SysCfg.CellBalAddr, 1, LastDelimiter('.', MacSysPtr^.SysCfg.CellBalAddr));

        SetLength(MacSysPtr^.CellBals, MacSysPtr^.SysCfg.CellBalBrds);
        for i := Low(MacSysPtr^.CellBals) to High(MacSysPtr^.CellBals) do
        begin
          S := format('Balancer_%.3d', [i]);
          MacSysPtr^.CellBals[i].AddrOctet := ReadInteger(S, 'Address', $FF);
          MacSysPtr^.CellBals[i].AssignedChan := ReadInteger(S, 'Chan', -1);
        end;
      finally
        Free;
      end;
    end;
  end;
end;

procedure SaveBalancerConfig;
var
  IniFile: TMemIniFile;
  I: SmallInt;
  S: String;
begin
  IniFile := TMemIniFile.Create(MacSysPtr^.CellBalFile);
  with IniFile do
  begin
    try
      WriteInteger('General_Settings', 'Port', MacSysPtr^.SysCfg.CellBalPort);
      WriteString('General_Settings', 'IP_address', MacSysPtr^.SysCfg.CellBalAddr);

      if MacSysPtr^.SysCfg.CellBalBrds <= 0 then
      begin
        for i := 0 to 255 do
        begin
          S := format('Balancer_%.3d', [i]);
          if not SectionExists(S) then break;
          EraseSection(S);
        end;
      end;

      for i := Low(MacSysPtr^.CellBals) to High(MacSysPtr^.CellBals) do
      begin
        S := format('Balancer_%.3d', [i]);
        WriteInteger(S, 'Address', MacSysPtr^.CellBals[i].AddrOctet);
        WriteInteger(S, 'Chan', MacSysPtr^.CellBals[i].AssignedChan);
      end;

      UpdateFile;
    finally
      Free;
    end;
  end;
end;

