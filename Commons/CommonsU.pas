procedure MinMax(const Arr: TArray<Double>; var Min, Max: Double);
var
  i, Len: Integer;
begin
  Len := High(Arr);

  case Len of
    -1: Exit;

    else
    begin
      Min := 0; Max := 0;

      for i := Low(Arr) to Len do
      begin
        if Arr[i] < Min then Min := Arr[i];
        if Arr[i] > Max then Max := Arr[i];
      end;
    end;
  end;
end;

