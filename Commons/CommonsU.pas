function FormatDrive(const Letter : Char; const VolumeLabel : String;
  FS: TFileSystem; QuickFormat: Boolean; Timeout : Integer; DebugOut : PDebugMemo) : Boolean;
var
  CommandLine: string;
  StartupInfo: TStartupInfo;
  ProcessInfo: TProcessInformation;
  SecurityAttributes: TSecurityAttributes;
  PipeRead, PipeWrite: THandle;
  Buffer: TBuffer;
  BytesRead: DWORD;
