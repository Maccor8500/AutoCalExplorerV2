class procedure TUtils.ExtractResources(const Instance: HInst; const Destination: String; OnComplete: TOnResourceExtractionComplete; OnProgress: TOnResourceExtractionProgress);
var
  i        : Integer;
  ResPtr   : PResourceItem;
  BasePath : String;
  FileBytes: TBytes;
  FStream  : TFileStream;
  HResData : HGLOBAL;
  Data     : Pointer;
  Count    : Integer;
begin
  if Destination = '' then BasePath := ExtractFileDir(ParamStr(0))
  else BasePath := Destination;
  BasePath := IncludeTrailingPathDelimiter(BasePath);
  Count := Length(Resources);
  ResourcePath := BasePath;

  try
    try
      for i := Low(Resources) to High(Resources) do
      begin
        ResPtr := @Resources[i];
        if Assigned(OnProgress) then OnProgress(ResPtr, Count, i);
        AvoidBusyWait(1);

        { locate resource }
        ResPtr^.Handle := FindResource(
          Instance,
          PChar(ResPtr^.Name.Text),
          ResPtr^.Id
        );

        ResPtr^.Loaded := ResPtr^.Handle <> 0;
        if not ResPtr^.Loaded then continue;

        { load resource }
        ResPtr^.Size := SizeofResource(Instance, ResPtr^.Handle);
        if ResPtr^.Size = 0 then continue;

        HResData := LoadResource(Instance, ResPtr^.Handle);
        if HResData = 0 then continue;

        Data := LockResource(HResData);
        if Data = nil then continue;

        { target path }
        if ResPtr^.Extension.Text[1] = '.' then ResPtr^.Extension.Update(
          Copy(ResPtr^.Extension.Text, 2, Length(ResPtr^.Extension.Text)));
        ResPtr^.Path := format('%s%s.%s', [BasePath, ResPtr^.Name.Text, ResPtr^.Extension.Text]);
        ResPtr^.Available := FileExists(ResPtr^.Path);

        { if file exists, compare contents }
        if ResPtr^.Available then
        begin
          FStream := TFileStream.Create(ResPtr^.Path, fmOpenRead or fmShareDenyWrite);
          ResPtr^.Available := (FStream.Size = ResPtr^.Size);
      
          try
            { same size, gotta check content! }
            if ResPtr^.Available then
            begin
              SetLength(FileBytes, ResPtr^.Size);
              FStream.ReadBuffer(FileBytes[0], ResPtr^.Size);
              { one more time... }
              ResPtr^.Available := CompareMem(Data, @FileBytes[0], ResPtr^.Size);
              { same data... skip file dump! }
              if ResPtr^.Available then continue;
            end;
          finally
            FreeAndNil(FStream);
          end;
        end;

        { write resource to disk }
        FStream := TFileStream.Create(ResPtr^.Path, fmCreate);
        try
          FStream.WriteBuffer(Data^, ResPtr^.Size);
        finally
          FStream.Free;
        end;
      end;
    finally
      if Assigned(OnComplete) then
        OnComplete;
    end;
  except
    On E: Exception do
      raise Exception.Create('E.Message');
  end;
end;

class function TUtils.GetResourcePath(const Name: String; Valid: PBoolean): String;
var
  i: Integer;
begin
  if Assigned(Valid) then Valid^ := False;

  for i := Low(Resources) to High(Resources) do
  begin
    if not SameText(Resources[i].Name.Text, Name) then continue;
    Result := Resources[i].Path;
    if Assigned(Valid) then Valid^ := Resources[i].Available and FileExists(Resources[i].Path);
    break;
  end;
end;

class procedure TUtils.RecordToJSON(const Rec: TValue; var JSONObject: TJSONObject);
  function ValueToJSON(const V: TValue): TJSONValue;
  begin
    case V.Kind of
      tkInteger, tkInt64, tkEnumeration:
      begin
        if V.TypeInfo = TypeInfo(Boolean) then Result := TJSONBool.Create(V.AsBoolean)
        else Result := TJSONNumber.Create(V.AsInt64);
      end;

      tkClass:
      begin
        if V.AsObject is TJSONValue then Result := TJSONValue(V.AsObject)
        else Result := TJSONString.Create(V.AsObject.ToString);
      end;

      tkRecord:
      begin
        Result := TJSONObject.Create;
        RecordToJSON(V, TJSONObject(Result));
      end;
      
      tkFloat: Result := TJSONNumber.Create(V.AsExtended);
      tkUString, tkString, tkLString, tkWString: Result := TJSONString.Create(V.AsString);

      else Result := TJSONString.Create(V.ToString);
    end;
  end;

var
  Ctx: TRttiContext;
  RType: TRttiType;
  Field: TRttiField;
begin
  JSONObject := TJSONObject.Create;
  RType := Ctx.GetType(Rec.TypeInfo);
  for Field in RType.GetFields do
    JSONObject.AddPair(Field.Name, ValueToJSON(Field.GetValue(Rec.AsObject)));
end;

class procedure TUtils.JSONToRecord(const JSONObject: TJSONObject; var Rec: TValue);
  procedure SetFieldValue(Field: TRttiField; const JSONVal: TJSONValue; var Target: TValue);
  begin
    case Field.FieldType.TypeKind of
      tkInteger, tkInt64, tkEnumeration:
      if Field.FieldType.TypeKind = tkEnumeration then
      begin
        if Field.FieldType.Handle = TypeInfo(Boolean) then Field.SetValue(Target.GetReferenceToRawData, JSONVal.AsType<Boolean>)
        else Field.SetValue(Target.GetReferenceToRawData, JSONVal.AsType<Int64>);
      end;

      tkRecord:
      begin
        var SubRec := Field.GetValue(Target.GetReferenceToRawData);
        JSONToRecord(TJSONObject(JSONVal), SubRec);
        Field.SetValue(Target.GetReferenceToRawData, SubRec);
      end;
        
      tkFloat: Field.SetValue(Target.GetReferenceToRawData, JSONVal.AsType<Double>);
      tkUString, tkString, tkLString, tkWString: Field.SetValue(Target.GetReferenceToRawData, JSONVal.Value);
      tkDynArray:;
    end;
  end;
  
var
  Ctx: TRttiContext;
  RType: TRttiType;
  Field: TRttiField;
  JSONValue: TJSONValue;
begin
  rType := ctx.GetType(Rec.TypeInfo);
  for Field in RType.GetFields do
  begin
    JSONValue := JSONObject.GetValue(Field.Name);
    if Assigned(JSONValue) then
      SetFieldValue(Field, JSONValue, Rec);
  end;
end;

