{ r1 clamped to MaxSINGLE }
procedure SeedChanHW(const Norm: ChParm; var HW: ChParmHW);
begin
  HW.VMin := Norm.MinV;
  HW.VMax := Norm.MaxV;
  HW.Chg.IMax := Norm.Chg.IMax;
  HW.Dis.IMax := Norm.Dis.IMax;
  HW.Chg.R4 := Norm.Chg.Ratio4;
  HW.Dis.R4 := Norm.Dis.Ratio4;
  HW.Chg.R3 := Norm.Chg.Ratio3;
  HW.Dis.R3 := Norm.Dis.Ratio3;
  HW.Chg.R2 := Norm.Chg.Ratio2;
  HW.Dis.R2 := Norm.Dis.Ratio2;
  HW.Chg.R1 := Min(Norm.Chg.Ratio1, MaxSINGLE);
  HW.Dis.R1 := Min(Norm.Dis.Ratio1, MaxSINGLE);

  HW.Chg.VSafe := Norm.Chg.VSafe;
  HW.Chg.ISafe := Norm.Chg.ILim;
  HW.Chg.PSafe := Norm.Chg.PLim;
  HW.Chg.PBrick := Norm.Chg.PmaxBr;
  HW.Chg.VPS := Norm.Chg.Vps;
  HW.Dis.VSafe := Norm.Dis.VSafe;
  HW.Dis.ISafe := Norm.Dis.ILim;
  HW.Dis.PSafe := Norm.Dis.PLim;
  HW.Dis.PBrick := Norm.Dis.PmaxBr;
  HW.Dis.VPS := Norm.Dis.Vps;
end;

procedure GetPositionDataHW(MacEnv: PMaccorSystem);
var
  S: TFileStream;
  I, Sz, Start: Integer;
begin
  if (MacEnv = nil) then Exit;
  if MacSysPtr^.SysCfg.ChanCount = 0 then Exit;

  if not FileExists(MacEnv^.PosHWFile) then
  begin
    SetLength(MacEnv^.ChanDataHW, Length(MacEnv^.ChanDataNorm));

    for i := Low(MacEnv^.ChanDataHW) to High(MacEnv^.ChanDataNorm) do
      SeedChanHW(MacEnv^.ChanDataNorm[i], MacEnv^.ChanDataHW[i]);
  end

  else
  begin
    S := TFileStream.Create(MacEnv^.PosHWFile, fmOpenRead +fmShareDenyWrite);
    with S do
    begin
      try
        Seek(0, soFromBeginning);
        Sz := SizeOf(ChParmHW);

        SetLength(MacEnv^.ChanDataHW, Round(Size /Sz));
        for i := Low(MacEnv^.ChanDataHW) to High(MacEnv^.ChanDataHW) do
          Read(MacEnv^.ChanDataHW[i], Sz);
      finally
        Free;
      end;
    end;
  end;

  if High(MacEnv^.ChanDataHW) < High(MacEnv^.ChanDataNorm) then
  begin
    Start := Length(MacEnv^.ChanDataHW);
    SetLength(MacEnv^.ChanDataHW, Length(MacEnv^.ChanDataNorm));

    try
    for i := Start to High(MacEnv^.ChanDataNorm) do
      SeedChanHW(MacEnv^.ChanDataNorm[i], MacEnv^.ChanDataHW[i]);
    except
    end;
  end

  else
    SetLength(MacEnv^.ChanDataHW, Length(MacEnv^.ChanData));
end;

{
  port of the legacy TMainCalForm.ReadAuxVerBinFromFile <program launch> ::
  VerifyAux.cfg -> MacEnv^.AuxBrdVer, one TMaccorAuxVerifyBoard per configured
  aux board. boards beyond the file's tail keep their zero-filled defaults
}
procedure ReadAuxVerBinFromFile(MacEnv: PMaccorSystem);
var
  Stream: TFileStream;
  Board: Integer;
begin
  { check pointer, should we bother? }
  if (MacSysPtr = nil) then Exit;
  if (MacSysPtr^.SysCfg.AuxBrds <= 0) then Exit;
  if not FileExists(MacSysPtr^.AuxVerCfgFile) then Exit;

  { size to the configured boards :: zero-filled until the file says otherwise }
  SetLength(MacEnv^.AuxBrdVer, MacEnv^.SysCfg.AuxBrds);
  for Board := Low(MacEnv^.AuxBrdVer) to High(MacEnv^.AuxBrdVer) do
    MacEnv^.AuxBrdVer[Board] := Default(TMaccorAuxVerifyBoard);

  Stream := TFileStream.Create(MacSysPtr^.AuxVerCfgFile, fmOpenRead +fmShareDenyNone);
  try
    Stream.Seek(0, soFromBeginning);
    for Board := Low(MacEnv^.AuxBrdVer) to High(MacEnv^.AuxBrdVer) do
    begin
      { a short file leaves the remaining boards at their defaults }
      if (Stream.Size -Stream.Position) < SizeOf(MacEnv^.AuxBrdVer[Board]) then Break;
      Stream.Read(MacEnv^.AuxBrdVer[Board], SizeOf(MacEnv^.AuxBrdVer[Board]));
    end;
  finally
    FreeAndNil(Stream);
  end;
end;

procedure GetAuxConfigurations(MacEnv: PMaccorSystem);
var
  Stream: TFileStream;
  i, p, c, ReadSz: Integer;
begin
  {
    AiData.cfg is READ-ONLY at load :: repairs land in memory only. the sole
    writer is the record-save boundary <TReports.SaveAuxiliaryRecord>, where
    the operator commits results — first save is when the data becomes ours.
  }

  { check pointer and file! }
  if MacEnv = nil then Exit;
  if not FileExists(MacEnv^.AiDataFile) then Exit;
  { should we bother? }
  if MacEnv^.SysCfg.AuxBrds <= 0 then Exit;

  { process aux config file! }
  Stream := TFileStream.Create(MacEnv^.AiDataFile, fmOpenRead +fmShareDenyNone);
  SetLength(MacEnv^.AuxBrds, MacEnv^.SysCfg.AuxBrds);

  try
    Stream.Seek(0, soFromBeginning);
    for i := Low(MacEnv^.AuxBrds) to High(MacEnv^.AuxBrds) do
    begin
      Fill(@MacEnv^.AuxBrds[i].AsBytes[0], 0, SizeOf(MacEnv^.AuxBrds[i].AsBytes));

      if Stream.Position < Stream.Size then
      begin
        ReadSz := Stream.Read(MacEnv^.AuxBrds[i], SizeOf(AiBoardParam));

        if (ReadSz = SizeOf(AiBoardParam))  then
        begin
          { for every panel... }
          for p := 0 to 7 do
          begin
            { for every aux pos  }
            for c := 0 to 15 do
            begin
              if MacEnv^.AuxBrds[i].Panel[p].AddInput[c].Chan.Channel <= 0 then
                MacEnv^.AuxBrds[i].Panel[p].AddInput[c].Priority := 0;

              {
                repair Range in memory. <Range := High -Low> cannot clear
                <Range = 0> on an input whose High and Low are both zero —
                and an UNUSED panel is exactly that <verified against the
                live config 2026-07-31: panel 8, TypeX 0, all 16 inputs>.
              }
              if (MacEnv^.AuxBrds[i].Panel[p].AddInput[c].RGE.Range = 0)
                and (MacEnv^.AuxBrds[i].Panel[p].AddInput[c].RGE.High
                      <> MacEnv^.AuxBrds[i].Panel[p].AddInput[c].RGE.Low) then
              begin
                MacEnv^.AuxBrds[i].Panel[p].AddInput[c].RGE.Range :=
                  (MacEnv^.AuxBrds[i].Panel[p].AddInput[c].RGE.High
                    -MacEnv^.AuxBrds[i].Panel[p].AddInput[c].RGE.Low);
              end;
            end;
          end;
        end;
      end;
    end;
  finally
    FreeAndNil(Stream);
  end;

  MacSysPtr^.LoadResistanceBoardConfig;
  MacSysPtr^.CompileAuxiliaryBoards;
  ReadAuxVerBinFromFile(MacEnv);
end;

