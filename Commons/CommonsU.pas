  if blkSock.sktSocket <> INVALID_SOCKET then
  begin
    iSize := Sizeof( TSockAddrIn );
    if winsock.getsockname( blkSock.sktSocket, rClientAddress, iSize ) = -1 then
      raise Exception.Create( IntToStr(WSAGetLastError) );

    result := String(AnsiString(winsock.Inet_NtoA( rClientAddress.sin_addr )));
  end
  else
    result := '';
end;

