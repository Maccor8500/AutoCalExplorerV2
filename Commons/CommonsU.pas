function IsValidWindowsFileName(const FileName: string): Boolean;
const
  InvalidChars: set of AnsiChar = ['\', '/', ':', '*', '?', '"', '<', '>', '|'];
  ReservedNames: array[0..21] of string = (
    'CON', 'PRN', 'AUX', 'NUL',
    'COM1', 'COM2', 'COM3', 'COM4', 'COM5', 'COM6', 'COM7', 'COM8', 'COM9',
    'LPT1', 'LPT2', 'LPT3', 'LPT4', 'LPT5', 'LPT6', 'LPT7', 'LPT8', 'LPT9'
  );
var
  I: Integer;
  UpperFileName: string;
begin
  { assume all goes well }
  Result := True;
  { check if the filename is empty or contains only dots}
  if (FileName = '') or (FileName = '.') or (FileName = '..') then
    Exit(False);
  { check for invalid characters }
  for i := 1 to Length(FileName) do
    if CharInSet(FileName[i], InvalidChars) then
      Exit(False);
  { check if filename ends with or dot }
  if (FileName[Length(FileName)] = '.') then
    Exit(False);
  { check for reserved names (case-insensitive) }
  UpperFileName := Trim(UpperCase(FileName));
  for i := Low(ReservedNames) to High(ReservedNames) do
    if UpperFileName = ReservedNames[i] then
      Exit(False);
end;

