function ValidMAC(var MAC: String): Boolean;
var
  A: TArray<String>;
  i, Int: Integer;
  Dash, Column: Boolean;
begin
  Result := False;

  { find the regulars :, - }
  Dash := (Pos('-', MAC) > 0);
  Column := (Pos(':', MAC) > 0);

  { split it by the delimeter! }
  if (Dash and Column) then Exit
  else if Dash then SplitStr(MAC, '-', A)
  else if Column then SplitStr(MAC, ':', A)
  { no delimeter! }
  else
  begin
    MAC := Trim(MAC);
    if (Length(MAC) <> 12) then Exit;
    SetLength(A, 6);
    for i := 0 to 5 do A[i] := Copy(MAC, (i *2) +1, 2);
  end;

  { check the length is a valid MAC address' }
  if Length(A) <> 6 then Exit;

  { try convert them all to byte: assert <= $FF }
  for i := Low(A) to High(A) do
  begin
    Result := TryStrToInt('$'+A[i], Int);
    if not Result then
      break;
  end;
end;

{ adjust for IP:Port validation }
function ValidAddress(const Addr: string) : boolean;
var
  ipRegExp: String;
  HasPort: Boolean;
begin
  Result := False;
  if Trim(Addr) = '' then Exit;
  ipRegExp := '\b(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b';

  HasPort := (Pos(':', Addr) > 0);
  if HasPort then
  begin
    var AddrArr: TArray<String>;
    SplitStr(Addr, ':', AddrArr);

    if High(AddrArr) > 0 then
      Result := ValidPort(AddrArr[1]) and ValidAddress(AddrArr[0]);
  end

  else Result := TRegEx.IsMatch(Addr, ipRegExp);
end;

