function LogicalDrives: TLogicalDrives;
var
  Drives: TStrings;
  InfoPtr: TArray<PLogicalDrive>;
  x: SmallInt;
begin
  Drives := TStringList.Create;
  try
    Drives.Clear;
    GetLogicalDrives(Drives);

    if Drives.Count <> 0 then
    begin
      SetLength(Result, Drives.Count);
      Setlength(InfoPtr, Drives.Count);
      for x := Low(InfoPtr) to High(InfoPtr) do
        InfoPtr[x] := @Result[x];

      TParallel.For(0, High(Result),
      procedure(i: Integer)
      var
        Infos: TArray<PLogicalDrive> absolute InfoPtr;
        Info: PLogicalDrive;
      begin
        Info := Infos[i];
        Info^.Drive := ShortString(Drives[i]);
        Info^.Letter := Char(Drives[i][1]);
        Info^.DriveType := GetDriveType(PChar(Drives[i]));
        Info^.DriveTypeStr := DriveStr(Int32(Info^.DriveType));

        { remote and optical letters stall on SMB/media timeouts; type is enough for them }
        if not (Info^.DriveType in [DRIVE_FIXED, DRIVE_REMOVABLE]) then Exit;
        if not DriveReady(Info^.Letter) then Exit;

        try
          Info^.SerialId := GetDiskVolSerialID(Info^.Letter);
          Info^.Number   := GetPhysicalDiskNumber(Info^.Letter);
          { DiskSize/DiskFree take 1=A..26=Z, not the physical disk number }
          Info^.Size     := DiskSize(Ord(UpCase(Info^.Letter)) -Ord('A') +1);
          Info^.Free     := DiskFree(Ord(UpCase(Info^.Letter)) -Ord('A') +1);
          Info^.Used     := (Info^.Size -Info^.Free);
          Info^.Serial   := ShortString(GetHardDiskSerial(Info^.Letter));
        except
          { a drive that refuses the raw open keeps its type-only entry }
        end;
      end);
    end;
  finally
    Drives.Free;
  end;
end;

procedure GetDrives(var Drives : TLogicalDrives; dType: Integer = -1);
var
  All : TLogicalDrives;
  i, Len : Integer;
begin
  All := LogicalDrives;

  if dType < 0 then
  begin
    Drives := All;
  end
  else
  begin
    SetLength(Drives, 0);

    for i := Low(All) to High(All) do
    begin
      if dType = Integer(All[i].DriveType) then
      begin
        Len := Length(Drives);
        SetLength(Drives, Len +1);
        Drives[Len] := All[i];
      end;
    end;
  end;
end;

