function CreateDesktopShortcut(const app: string; const desc : String): Boolean;
var
  IObject: IUnknown;
  ISLink: IShellLink;
  IPFile: IPersistFile;
  PIDL: PItemIDList;
  LinkName: string;
  InFolder: array [0..MAX_PATH-1] of Char;
begin
  Result := False;

  IObject := CreateComObject(CLSID_ShellLink);
  ISLink := IObject as IShellLink;
  IPFile := IObject as IPersistFile;

  with ISLink do
  begin
    SetDescription(PWideChar(desc));
    SetPath(PChar(app));
    SetWorkingDirectory(PChar(ExtractFilePath(app)));
  end;

  SHGetSpecialFolderLocation(0, CSIDL_DESKTOPDIRECTORY, PIDL);
  SHGetPathFromIDList(PIDL, InFolder) ;

  LinkName := IncludeTrailingBackslash(GetDesktopPath);
  LinkName := LinkName + ExtractFileNameEx(app) + '.lnk';

  if not FileExists(LinkName) then
    if IPFile.Save(PWideChar(LinkName), False) = S_OK then
      Result := True;
end;

procedure ExecutionTime(proc : TProc; var Time : Double; loop : Integer = 1);
var
  Freq, Time1, Time2: Comp;
  i: Integer;
  T : Double;
begin
  if not QueryPerformanceFrequency(TLargeInteger((@Freq)^)) then
  begin
    ShowMessage('Your computer does not support Performance Timers!');
    Exit;
  end;

  T := 0;

  for i := 0 to (loop -1) do
  begin
    QueryPerformanceCounter(TLargeInteger((@Time1)^));
    {run!}
    try
      Proc;
    except
    end;
    QueryPerformanceCounter(TLargeInteger((@Time2)^));

    T := (T + (Time2 - Time1));
  end;

  Time := (T / loop / freq);
end;

procedure ExecutionTime(proc : TProc; var Time : String; loop : Integer = 1);
var
  tFloat : Double;
begin
  ExecutionTime(proc, TFloat, loop);
  Time := FormatFloat('0.################', TFloat);
end;

function ExecutionTime(proc : TProc; loop : Integer = 1) : String;
begin
  ExecutionTime(proc, Result, loop);
end;

procedure DeleteShortcut(const exe_path : String);
var
  LinkName: string;
begin
  if FileExists(exe_path) then
  begin
    LinkName := IncludeTrailingBackslash(GetDesktopPath);
    LinkName := LinkName + ExtractFileNameEx(exe_path) + '.lnk';
    DeleteFile(LinkName);
    SHChangeNotify(SHCNE_DELETE, SHCNF_PATH or SHCNF_FLUSHNOWAIT, PWideChar(LinkName), NIL);
