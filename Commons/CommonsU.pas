{ TPingService }

constructor TPingService.Create(const AutoStart: Boolean; StartSuspended: Boolean);
begin
  Inherited Create(StartSuspended);
  FAutoStart := AutoStart;
  ARPList := TStringList.Create;
  PauseEvent := CreateEvent(nil, True, False, PWideChar('PingService'));
  InitializeCriticalSection(Lock);
end;

{ in-flight ping tasks hold a ref, so a purge never frees a record under them }
procedure ReleasePingRec(const P: PPingData);
begin
  if AtomicDecrement(P^.Refs) = 0 then Dispose(P);
end;

destructor TPingService.Destroy;
var
  T: UInt64;
begin
  if not Terminated then Terminate;
  Suspended := False;
  PurgeAll;

  { tasks use ARPList/USBList: bounded so a hung 'arp -a' cannot block shutdown }
  T := GetTickCountEx(3000);
  while ((Tasks > 0) or ArpBusy or UsbBusy) and (GetTickCountEx < T) do AvoidBusyWait(10);

  DeleteCriticalSection(Lock);
  FreeAndNil(ARPList);
  inherited;
end;

{ must not pump messages: a nested tab change would re-enter and wipe fresh registrations }
procedure TPingService.PurgeAll;
var
  I: Integer;
begin
  if High(PingRecs) < 0 then Exit;

  if (not Suspended) then SetEvent(PauseEvent);
  while Busy do AvoidBusyWait(10);

  try
    for i := Low(PingRecs) to High(PingRecs) do ReleasePingRec(PingRecs[i]);
    SetLength(PingRecs, 0);
  finally
    if (not Suspended) then ResetEvent(PauseEvent);
  end;
end;

procedure TPingService.Execute;
var
  T: UInt64;
  Rec: PPingData;
begin
  inherited;

  repeat
    try
      case WaitForSingleObject(PauseEvent, 50) of
        0: Busy := False;

        else
        begin
          { wait on every reset }
          if ZeroWait > 0 then
          begin
            Dec(ZeroWait);
            continue;
          end;

          if Idx <= High(PingRecs) then
          begin
            Busy := True;
            Rec := PingRecs[Idx];

            T := GetTickCountEx;
            if ((T -Rec^.Status.LastPing) >= Rec^.Interval) and (not Rec^.Busy) then
            begin
              if (Rec^.Status.LastPing <= 0) then Rec^.Status.State := psPending;
              if not Rec^.Busy then
              begin
                Rec^.Busy := True;
                PingIt(Rec);
              end;
              Rec^.Status.LastPing := T;
            end;

            { every ~1.5s }
            if (GetTickCountEx >= LastArpPing) then
            begin
              RunTask(RefreshArpList);
              RunTask(RefreshUSBList);
              LastArpPing := GetTickCountEx(15000);
            end;

            Inc(Idx);
          end

          { reset ping index, skips a turn! }
          else Idx := 0;
        end;
      end;
    except
      On E: Exception do;
    end;

    AvoidBusyWait(Self, 1);
  until Terminated;

  Busy := False;
end;

procedure TPingService.PingIt(const Data: PPingData);
begin
  { refs taken here, on the ping thread, while the array still owns Data }
  AtomicIncrement(Data^.Refs);
  AtomicIncrement(Tasks);

  { let it go! }
  TTask.Create(
    procedure
    var
      MAC: String;
      I: SmallInt;
    begin
      try
        try
          if Data^.Addr <> '' then
          begin
            if (Pos(':', Data^.Addr) > 0) or (Pos('-', Data^.Addr) > 0) then
            begin
              while ArpBusy do Sleep(250);
              MAC := StringReplace(Data^.Addr, ':', '-', [rfReplaceAll]);
              if ARPList.Count > 0 then Data^.Status.Token := (ArpList.IndexOf(MAC) >= 0)
              else Data^.Status.Token := False;
            end

            else
              Data^.Status.Token := Ping(AnsiString(Data^.Addr),
                Data^.Status.LastRTT, Data^.Status.LastMessage, Data^.Timeout);
          end

          else
          begin
            while UsbBusy do Sleep(250);
            AcquireLock;
            try
              if High(USBList) < 0 then Data^.Status.Token := False
              else
              begin
                for i := 0 to High(USBList) do
                begin
                  Data^.Status.Token := (Pos(Data^.Serial, USBList[i].DeviceId) > 0);
                  if Data^.Status.Token then break;
                end;

                Data^.Status.LastMessage := StrTernary(Data^.Status.Token, 'Connected!', 'Disconnected!');
              end;
            finally
              ReleaseLock;
            end;
          end;

          { sort it <ping-result>! }
          if Data^.Status.Token then
          begin
            Data^.Status.LastSeen := Now;
            Data^.Status.State := psOnline;
          end

          else Data^.Status.State := psOffline;
        finally
          Data^.Busy := False;
        end;
      except
        On E: Exception do;
      end;

      ReleasePingRec(Data);
      AtomicDecrement(Tasks);
    end).Start;
end;

function TPingService.GetAddrCount: Integer;
begin
  Result := Length(PingRecs);
end;

function TPingService.HasAddress(const Addr: String; Index: PInteger): Boolean;
var
  i: Integer;
begin
  Result := False;
  if Index <> nil then Index^ := -1;

  for i := Low(PingRecs) to High(PingRecs) do
  begin
    Result := (Addr = PingRecs[i]^.Addr) or (Addr = PingRecs[i]^.Serial);
    if Result then
    begin
      if Index <> nil then Index^ := i;
      break;
    end;
  end;
end;

procedure TPingService.Replace(const Index: Integer; const NewAddr: String);
begin
  if Index > High(PingRecs) then Exit;
  while PingRecs[Index]^.Busy do;
  PingRecs[Index]^.Addr := NewAddr;
end;

procedure TPingService.Replace(const OldAddr, NewAddr: String);
var
  Index: Integer;
begin
  if not ValidAddress(NewAddr) then Exit;

  AcquireLock;
  SetEvent(PauseEvent);
  while Busy do Sleep(10);

  try
    if HasAddress(OldAddr, @Index) then
    begin
      { wait for it... }
      while PingRecs[Index]^.Busy do;
      { update it! }
      PingRecs[Index]^.Addr := NewAddr;
    end;
  finally
    ResetEvent(PauseEvent);
    ReleaseLock;
  end;
end;

procedure TPingService.RegisterAddr(const AddrData: PPingData);
begin
  RegisterAddr(AddrData^);
end;

procedure TPingService.RegisterAddr(const Addr: String; const Interval, Timeout: Integer);
var
  PingRec: TPingData;
  Address: String;
begin
  Address := Addr;
  
  if (ValidAddress(Address) or ValidMAC(Address)) then
  begin
    AcquireLock;

    try
      if not HasAddress(Addr) then
      begin
        PingRec := Default(TPingData);
        PingRec.Addr := Addr;
        PingRec.Interval := Interval;
        PingRec.Timeout := Max(DEFAULT_PING_TIMEOUT, Timeout);
        RegisterAddr(PingRec);
      end;
    finally
      ReleaseLock;
    end;
  end;
end;

procedure TPingService.RefreshArpList;
begin
  if ArpBusy then Exit;
  
  ArpBusy := True;
  try
    ExecuteCommand('arp -a', ARPList);
  finally
    ArpBusy := False;
  end;
end;

procedure TPingService.RefreshUSBList;
begin
  if (UsbBusy) then Exit;
  UsbBusy := True;
  AcquireLock;

  try
    GetUSBList(USBList);
  finally
    UsbBusy := False;
    ReleaseLock;
  end;
end;

procedure TPingService.RegisterAddr(const Serial: String; Interval: Integer);
var
  PingRec: TPingData;
begin
  AcquireLock;

  try
    if not HasAddress(Serial) then
    begin
      PingRec := Default(TPingData);
      PingRec.Serial := Serial;
      RegisterAddr(PingRec);
    end;
  finally
    ReleaseLock;
  end;
end;

procedure TPingService.RegisterPair(const Addr: String; const Interval, Timeout: Integer);
var
  PingRec: TPingData;
  AddrArr: TArray<String>;
  AddrX: String;
  i: Integer;
begin
  AcquireLock;
  AddrArr := Addr.Split([',']);

  try
    if High(AddrArr) < 0 then Exit;

    for i := 0 to High(AddrArr) do
    begin
      AddrX := Trim(AddrArr[i]);
      if not HasAddress(AddrX) then
      begin
        PingRec := Default(TPingData);
        PingRec.Addr := AddrX;
        PingRec.Interval := DEFAULT_PING_INTERVAL;
        PingRec.Timeout := DEFAULT_PING_TIMEOUT;
        PingRec.Status := Default(TPingStatus);

        RegisterAddr(PingRec);
      end;
    end;
  finally
    ReleaseLock;
  end;
end;

procedure TPingService.RegisterAddr(const AddrData: TPingData);
var
  L, I: Integer;
  ThreadState: Boolean;
  P: PPingData;
begin
  if (PauseEvent = 0) then Exit;
  ThreadState := not Suspended;
  if ThreadState then SetEvent(PauseEvent);
  while Busy do Sleep(10);

  try
    L := Length(PingRecs);
    SetLength(PingRecs, L +1);
    New(P);
    P^ := AddrData;
    P^.Refs := 1;
    PingRecs[L] := P;
    Idx := 0;
    ZeroWait := 100;
    for i := 0 to High(PingRecs) do PingRecs[i]^.Status.State := psPending;

    { auto start if suspended and auto-start flag is true, and array has data }
    Suspended := not ((FAutoStart or ThreadState) and (GetAddrCount > 0));
  finally
    if ThreadState then ResetEvent(PauseEvent);
  end;
end;

procedure TPingService.RegisterAddr(const Addr: String);
var
  PingRec: TPingData;
begin
  AcquireLock;

  try
    if not HasAddress(Addr) then
    begin
      PingRec := Default(TPingData);
      PingRec.Addr := Addr;
      PingRec.Interval := DEFAULT_PING_INTERVAL;
      PingRec.Timeout := DEFAULT_PING_TIMEOUT;
      PingRec.Status := Default(TPingStatus);

      RegisterAddr(PingRec);
    end;
  finally
    ReleaseLock;
  end;
end;

procedure TPingService.GetStatus(const Addr: String; var Status: TPingStatus);
var
  Index: Integer;
begin
  Status.State := psUnknown;
  if HasAddress(Addr, @Index) then Status := PingRecs[Index]^.Status;
end;

function TPingService.GetStatus(const Addr: String): PPingStatus;
var
  Index: Integer;
begin
  Result := nil;
  if HasAddress(Addr, @Index) then Result := @PingRecs[Index]^.Status;
end;

