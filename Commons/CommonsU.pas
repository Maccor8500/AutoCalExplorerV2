{ TUSBDeviceManagerEx }

constructor TUSBDeviceManagerEx.Create(EventCallback: TAppEventCallback; AccessType: TUSBAcessType; LibPath: String);
begin
  try
    { refresh every 5 seconds }
    Interval := 5;
    Self.EventCallback := EventCallback;
    InitializeCriticalSection(CriticalSection);

    case AccessType of
      USB_WINDOWS:
      begin
        LibHandle := LoadLibrary('C:\Windows\System32\setupapi.dll');
        if LibHandle = 0 then raise Exception.Create('Failed to load setupapi.dll');

        @SetupDiGetClassDevsW := GetProcAddress(LibHandle, 'SetupDiGetClassDevsW');
        @SetupDiEnumDeviceInfo := GetProcAddress(LibHandle, 'SetupDiEnumDeviceInfo');
        @SetupDiGetDeviceInstanceIdW := GetProcAddress(LibHandle, 'SetupDiGetDeviceInstanceIdW');
        @SetupDiGetDeviceRegistryPropertyW := GetProcAddress(LibHandle, 'SetupDiGetDeviceRegistryPropertyW');
        @SetupDiDestroyDeviceInfoList := GetProcAddress(LibHandle, 'SetupDiDestroyDeviceInfoList');

        { check if all necessary functions are loaded }
        if not Assigned(SetupDiGetClassDevsW) then
          raise Exception.Create('Failed to locate SetupDiGetClassDevsW in setupapi.dll');
        if not Assigned(SetupDiEnumDeviceInfo) then
          raise Exception.Create('Failed to locate SetupDiEnumDeviceInfo in setupapi.dll');
        if not Assigned(SetupDiGetDeviceInstanceIdW) then
          raise Exception.Create('Failed to locate SetupDiGetDeviceInstanceIdW in setupapi.dll');
        if not Assigned(SetupDiGetDeviceRegistryPropertyW) then
          raise Exception.Create('Failed to locate SetupDiGetDeviceRegistryPropertyW in setupapi.dll');
        if not Assigned(SetupDiDestroyDeviceInfoList) then
          raise Exception.Create('Failed to locate SetupDiDestroyDeviceInfoList in setupapi.dll');
      end;

      USB_LIBUSB:
      begin
        { resolve libusb missing file! }
        if not FileExists(LibPath) then
        begin
          HandleEvent('usb library is not specified! attempting to resolve...'#13#10);

          var SysInfo: TSystemInformation;
          var Resources := TStrList.Create;
          var ResourceName := '';
          LibPath := '';

          try
            { check for existing... }
            EnumerateResourceNames(Resources);

            if Resources.Count <> 0 then
            begin
              GetSystemInfoEx(SysInfo);

              case SysInfo.OS.Architecture of
                arIntelX86:
                begin
                  {$if defined(WIN32)}
                    ResourceName := 'libusb_x32';
                  {$ifend}
                end;

                arIntelX64:
                begin
                  {$if defined(WIN64)}
                    ResourceName := 'libusb_x64';
                  {$ifend}
                end;
              end;

              if Resources.IndexOf(UpperCase(ResourceName)) >= 0 then
              begin
                HandleEvent(format('found: %s'#13#10, [ResourceName]));
                { check existing }
                LibPath := StrTernary(
                  SaveResourceToFile(HInstance, ResourceName,
                    DEFAULT_LIB_PATH), DEFAULT_LIB_PATH, '');
              end

              else
              begin
                if ResourceName = '' then
                begin
                  if (Resources.IndexOf(UpperCase('libusb_x32')) < 0) or (Resources.IndexOf(UpperCase('libusb_x64')) < 0) then
                    HandleEvent('Failed to resolve internal resource. Resource not found!'#13#10)
                  else HandleEvent('Resource and OS arch. mis-match!'#13#10);
                end
                else HandleEvent(format('failed to find useful resource file [%s]'#13#10, [ResourceName]));
              end;
            end;
          finally
            FreeAndNil(Resources);
          end;
        end;

        if LibPath = '' then
        begin
          HandleEvent('library<.dll> path is invalid or empty!'#13#10
            +'please call with valid library path or include "libusb" dll file in project''s '
            +'resource file or list with the name "libusb_x32" and/or "libusb_x64" as RC_DATA'#13#10);
          Exit;
        end;

        HandleEvent(format('loading library: %s...'#13#10, [ExtractFileName(LibPath)]));

        { load the libusb library }
        UsbDLL := TDllLoader.Create(LibPath);

        if Assigned(USBDll) then
        begin
          HandleEvent('library loaded!'#13#10);
          { get the handle to this dll }
          LibHandle := USBDll.GetHandle(ShortString(LibPath));

          { if valid handle, load these functions for later use! }
          if LibHandle <> INVALID_HANDLE then
          begin
            HandleEvent(format('library version: %s'#13#10
              + 'retreiving function handles...'#13#10, [GetFileVersionString(LibPath)]));

            USBDll.GetFuncAddr(LibHandle, USB_INIT, @libusb_init);
            USBDll.GetFuncAddr(LibHandle, USB_OPEN, @libusb_open);
            USBDll.GetFuncAddr(LibHandle, USB_OPEN_WITH, @libusb_open_device_with_vid_pid);
            USBDll.GetFuncAddr(LibHandle, USB_RESET, @libusb_reset_device);
            USBDll.GetFuncAddr(LibHandle, USB_BUS_NUM, @libusb_get_bus_number);
            USBDll.GetFuncAddr(LibHandle, USB_PORT_NUMS, @libusb_get_port_numbers);
            USBDll.GetFuncAddr(LibHandle, USB_GET_DESC, @libusb_get_device_descriptor);
            USBDll.GetFuncAddr(LibHandle, USB_GET_LIST, @libusb_get_device_list);
            USBDll.GetFuncAddr(LibHandle, USB_FREE_LIST, @libusb_free_device_list);
            USBDll.GetFuncAddr(LibHandle, USB_CLOSE, @libusb_close);
            USBDll.GetFuncAddr(LibHandle, USB_EXIT, @libusb_exit);
            AnnounceHandleStatuses;
          end

          else HandleEvent('failed to get library handle!'#13#10);

          {initialize it!};
          InitUSB;
        end

        else
        begin
          if Assigned(EventCallback) then
          begin
            with Event do
            begin
              try
                Reason := etAppError;
                Msg := (format('TDllLoader.Create(%s), failed!', [LibPath]));
              finally
                EventCallback(@Event);
              end;
            end;
          end;
        end;
      end;
    end;
  finally
    Access := AccessType;
  end;
end;

destructor TUSBDeviceManagerEx.Destroy;
begin
  case Access of
    USB_WINDOWS:
    begin
      if LibHandle <> INVALID_HANDLE then
        FreeLibrary(LibHandle);
    end;

    USB_LIBUSB:
    begin
      If Assigned(UsbDLL) then FreeAndNil(UsbDLL);
      if FileExists(DEFAULT_LIB_PATH) then DeleteFile(DEFAULT_LIB_PATH);
    end;
  end;

  DeleteCriticalSection(CriticalSection);
  inherited;
end;

procedure TUSBDeviceManagerEx.GetDevice(const Serial: Integer; var USBDevPtr: PUSBDevice);
var
  i: Integer;
  SerStr: String;
begin
  Spin.Lock;
  USBDevPtr := nil;

  try
    RefreshList;

    if TryIntToStr(Serial, SerStr) then
    begin
      for I := Low(Devices) to High(Devices) do
      begin
        if Pos(SerStr, Devices[i].DeviceId) <= 0 then continue;

        USBDevPtr := @Devices[i];
        break;
      end;
    end;
  finally
    Spin.Unlock;
  end;
end;

procedure TUSBDeviceManagerEx.GetDevicePath(Dev: Plibusb_device; DevRec: ptrlibusb_device);
var
  I, PathLen: Integer;
  PathParts: TArray<String>;
begin
  PathLen := libusb_get_port_numbers(Dev, @DevRec^.Path[0], 8);
  SetLength(PathParts, PathLen);
  for i := 0 to (PathLen -1) do PathParts[i] := IntToStr(DevRec^.Path[i]);
  DevRec^.Bus := libusb_get_bus_number(Dev);
  DevRec^.PathStr := IntToStr(DevRec^.Bus) + '.' + String.Join('.', PathParts);
end;

procedure TUSBDeviceManagerEx.GetDevices(var DevPtr: PUSBDevice;
  var Count: Integer; ForceListRefresh: Boolean);
begin
  DevPtr := nil;
  ForceRefresh := ForceListRefresh;

  try
    RefreshList;
    Count := Length(Devices);
    if Count > 0 then DevPtr := @Devices[0];
  finally
    ForceRefresh := False;
  end;
end;

