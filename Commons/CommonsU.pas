procedure Dict<X>.Append(const Val : X);
begin
  if Size = 0 then P := -1;

  SetLength(D, Length(D) +1);
  D[Length(D) -1] := Val;
end;

function Dict<X>.Count: SmallInt;
begin
  Result := Length(D);
end;

function Dict<X>.Get(const index: SmallInt): X;
begin
  Result := Default(X);
  if InvalidIndex(index) then Exit;
  Result := D[index];
end;

procedure Dict<X>.Get(const index : SmallInt; var Val : X);
begin
  FillChar(Val, FSize, 0);
  if InvalidIndex(index) then Exit;
  Val := D[index];
end;

function Dict<X>.IndexOf(const Val: X): Smallint;
var
  i: Integer;
  A, B : TBytesStream;
begin
  Result := -1;
  A := TBytesStream.Create;
  B := TBytesStream.Create;

  try
    A.Clear;
    A.Write(Val, FSize);

    for i := Low(D) to High(D) do
    begin
      B.Clear;
      B.Write(D[i], FSize);

      if CompareMem(A.Memory, B.Memory, FSize) then
      begin
        Result := i;
        break;
      end;
    end;
  finally
    FreeAndNIl(A);
    FreeAndNil(B);
  end;
end;

procedure Dict<X>.Insert(const Val: X; const index: SmallInt);
begin
  if InvalidIndex(index) then Exit;
  D[index] := Val;
end;

function Dict<X>.InvalidIndex(const index: SmallInt): Boolean;
begin
  Result := false;

  if index = 0 then
  begin
    if Size = 0 then
      Result := true;
  end
  else
    Result := (index < Low(D)) and (index > High(D));
end;

procedure Dict<X>.Iterate;
begin
  P := 0;
end;

procedure Dict<X>.Iterate(Val: X);
begin
  if FSize = 0 then
  begin
    ShowMessage('Call SetSize(<SizeOf(X)>)');
    Exit;
  end;

  P := 0;
  F := Val;
  FillChar(F, FSize, 0);
end;

function Dict<X>.Next: X;
var
  i: Integer;
  A, B : TBytesStream;
begin
  Result := Default(X);
  if P < 0 then Exit;

  A := TBytesStream.Create;
  B := TBytesStream.Create;

  try
    A.Clear;
    A.Write(F, FSize);

    for i := P to High(D) do
    begin
      B.Clear;
      B.Write(D[i], FSize);

      if CompareMem(A.Memory, B.Memory, FSize) then
      begin
        Result := D[i];
        P := i +1;
        break;
      end;
    end;

  finally
    FreeAndNIl(A);
    FreeAndNil(B);
  end;
end;

procedure Dict<X>.Remove(const index: SmallInt);
var
  i, start_index, next_index: Integer;
begin
  if InvalidIndex(index) then Exit;
  start_index := index;
  next_index := start_index;

  for i := start_index to High(D) do
  begin
    Inc(next_index);

    if next_index <= High(D) then
      D[i] := D[next_index];
  end;
end;

procedure Dict<X>.Replace(const index: SmallInt; const Val: X);
begin
  Insert(Val, index);
end;

procedure Dict<X>.SetSize(const Size: SmallInt);
begin
  FSize := Size;
end;

procedure Dict<X>.Add(const Val : X);
begin
  Append(Val);
end;

