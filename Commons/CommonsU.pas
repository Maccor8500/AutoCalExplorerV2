{ TRemoteAddress }

procedure TRemoteAddress.Pack;
begin
  if Trim(Addr) = '' then Exit;
  if not ValidAddress(Addr) then Exit;

  ZeroMemory(@Sock, SizeOf(TSockAddrIn));
  Sock.sin_family := AF_INET;
  Sock.sin_addr.S_addr := inet_addr(PAnsiChar(AnsiString(Addr)));
  Sock.sin_port := htons(Port);
end;

procedure TRemoteAddress.Unpack;
begin
  Addr := String(AnsiString(inet_ntoa(Sock.sin_addr)));
  Port := htons(Sock.sin_port);
  UnPacked := ValidAddress(String(Addr)) and ValidPort(Port);
end;

