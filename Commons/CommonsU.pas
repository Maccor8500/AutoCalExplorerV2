function ExecuteCommand(const cmd: String; var Output: TStrings): Boolean;
var
  Res, cmd_str : String;
  StartupInfo: TStartupInfo;
  ProcessInfo: TProcessInformation;
  SecurityAttr: TSecurityAttributes;
  ReadPipe, WritePipe: THandle;
  Buffer: array[0..1023] of AnsiChar;
  BytesRead: DWORD;
begin
  Result := False;
  if Trim(cmd) = '' then Exit;
  cmd_str := format('cmd.exe /c %s', [cmd]);

  if Output = nil then Output := TStringList.Create;
  Output.Clear;
  Output.Text := #13#10;

  SecurityAttr.nLength := SizeOf(TSecurityAttributes);
  SecurityAttr.bInheritHandle := True;
  SecurityAttr.lpSecurityDescriptor := nil;

  if CreatePipe(ReadPipe, WritePipe, @SecurityAttr, 0) then
  begin
    FillChar(StartupInfo, SizeOf(TStartupInfo), 0);
    StartupInfo.cb := SizeOf(TStartupInfo);
    StartupInfo.hStdInput := ReadPipe;
    StartupInfo.hStdOutput := WritePipe;
    StartupInfo.hStdError := WritePipe;
    StartupInfo.dwFlags := STARTF_USESTDHANDLES or STARTF_USESHOWWINDOW;
    StartupInfo.wShowWindow := SW_HIDE;

    if CreateProcess(nil, PChar(cmd_str), @SecurityAttr, @SecurityAttr, True, 0, nil, nil, StartupInfo, ProcessInfo) then
    begin
      CloseHandle(WritePipe);
      try
        repeat
          Res := '';
          FillChar(Buffer, SizeOf(Buffer), #0);
          if not ReadFile(ReadPipe, Buffer, SizeOf(Buffer), BytesRead, nil) then
            continue
          else
          begin
            SetString(Res, PAnsiChar(@Buffer[0]), BytesRead);
            {if Trim(Res) <> '' then }Output.Text := Output.Text +Res;
          end;
        until BytesRead = 0;

        Result := True;
      finally
        CloseHandle(ReadPipe);
        CloseHandle(ProcessInfo.hProcess);
        CloseHandle(ProcessInfo.hThread);
      end;
    end;
  end;
end;

function ExecuteCommand(const cmd: String; var Output: PAnsiString): Boolean;
var
  Res, cmd_str : String;
  StartupInfo: TStartupInfo;
  ProcessInfo: TProcessInformation;
  SecurityAttr: TSecurityAttributes;
  ReadPipe, WritePipe: THandle;
  Buffer: array[0..255] of AnsiChar;
  BytesRead: DWORD;
begin
  Result := False;
  if (Trim(cmd) = '') or (Output = nil) then Exit;
  cmd_str := format('cmd.exe /c %s', [cmd]);

  Output^ := #13#10;

  SecurityAttr.nLength := SizeOf(TSecurityAttributes);
  SecurityAttr.bInheritHandle := True;
  SecurityAttr.lpSecurityDescriptor := nil;

  if CreatePipe(ReadPipe, WritePipe, @SecurityAttr, 0) then
  begin
    FillChar(StartupInfo, SizeOf(TStartupInfo), 0);
    StartupInfo.cb := SizeOf(TStartupInfo);
    StartupInfo.hStdInput := ReadPipe;
    StartupInfo.hStdOutput := WritePipe;
    StartupInfo.hStdError := WritePipe;
    StartupInfo.dwFlags := STARTF_USESTDHANDLES or STARTF_USESHOWWINDOW;
    StartupInfo.wShowWindow := SW_HIDE;

    if CreateProcess(nil, PChar(cmd_str), @SecurityAttr, @SecurityAttr, True, 0, nil, nil, StartupInfo, ProcessInfo) then
    begin
      CloseHandle(WritePipe);
      try
        repeat
          Res := '';
          FillChar(Buffer, 256, #0);
          if not ReadFile(ReadPipe, Buffer, SizeOf(Buffer), BytesRead, nil) then
            continue
          else
          begin
            SetString(Res, PAnsiChar(@Buffer[0]), BytesRead);
            AddStr(Output^, Res);
