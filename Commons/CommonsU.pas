{ THxConnThread }

constructor THxConnThread.Create( thd: TTCPServer );
begin
  lstConnections := TConnRecList.Create;

  thdOwner := thd;

  inherited Create;
end;

destructor THxConnThread.Destroy;
begin
  inherited;

  if Assigned( lstConnections )then
    lstConnections.Free;
end;

function THxConnThread.GetServerAddress( iDescr: integer ): string;
begin
  csLock.Acquire;
  try
    CheckDescriptor( iDescr );
    result := lstConnections[iDescr].GetServerAddress;
  finally
    csLock.Release;
  end;
end;

function THxConnThread.GetPort( iDescr: integer ): string;
begin
  csLock.Acquire;
  try
    CheckDescriptor( iDescr );
    result := lstConnections[iDescr].GetPort;
  finally
    csLock.Release;
  end;
end;

procedure THxConnThread.CheckDescriptor( iDescr: integer );
begin
  if( iDescr >= lstConnections.Count )or( iDescr < 0 )then
    raise Exception.Create('Invalid descriptor (out of bounds)');

  if lstConnections[iDescr].GetSocket = INVALID_SOCKET then
    raise Exception.CreateFmt('Connection is closed for descr: %d', [iDescr]);
end;

function THxConnThread.SendData( ptr: pointer; iSize, iDescr: integer ): boolean;
begin
  csLock.Acquire;
  try
    CheckDescriptor( iDescr );
    result := lstConnections[iDescr].SendData( ptr, iSize );
  finally
    csLock.Release;
  end;
end;

procedure THxConnThread.Notify( s: string );
begin
  if Assigned( thdOwner )then
    thdOwner.Notify( s );
end;

procedure THxConnThread.ExecProc;
var
  p: pointer;
  iSize, iIdx: integer;
begin
  iIdx := -1;
  if AnyThingToRead( iIdx )then
  begin
    if iIdx = -1 then
    begin
      Notify('Unexpected index returned' );
      exit;
    end;

    p := lstConnections[iIdx].ReceiveData( iSize );

    if p <> nil then
      HandleData( p, iSize, iIdx );
  end;
end;

function THxConnThread.AnyThingToRead( var iIdx: integer ): boolean;
var
  i, iRes: integer;
  sktMax, skt: winsock.TSocket;
  readfds: winsock.TFDSet;
  Timeout: TTimeVal;
  bLockSet: boolean;
begin
  csLock.Acquire;
  bLockSet := True;

  try
    Timeout.tv_sec := 1;
    TimeOut.tv_usec := 0;

    winsock.FD_ZERO( readfds );
    sktMax := -1;

    for i := 0 to lstConnections.Count -1 do
    begin
      skt := lstConnections[i].GetSocket;
      if skt <> NativeInt(INVALID_SOCKET) then
      begin
        if skt > sktMax then
          sktMax := skt;
        winsock.FD_SET( skt, readfds );
      end;
    end;
    csLock.Release;
    bLockSet := False;

    iRes := select( sktMax+1, @readfds, nil, nil, @Timeout );
    result := iRes > 0;

    csLock.Acquire;
    bLockSet := True;
    if result then
    begin
      iIdx := -1;
      for i := 0 to lstConnections.Count -1 do
      begin
        skt := lstConnections[i].GetSocket;
        if skt <> NativeInt(INVALID_SOCKET) then
        begin
          if winsock.FD_ISSET( skt, readfds )then
          begin
            iIdx := i;
            break;
          end;
        end;
      end;
    end;
    csLock.Release;
  except
    if bLockSet then
      csLock.Release;
    raise;
  end;
end;

function THxConnThread.AddConnection( blkS: THxBlockSocket ): integer;
var
  i: integer;
  bReUse: boolean;
begin
  csLock.Acquire;
  try
    result := -1; // keep the compiler happy..

    bReUse := False;
    for i := 0 to lstConnections.Count -1 do
    begin
      if lstConnections[i].GetSocket = INVALID_SOCKET then
      begin
//        lstConnections[i].Free;  Cleanup.. This is done implicitly..
        lstConnections[i] := blkS;  // and re-use
        bReUse := True;
        result := i;
        break;
      end;
    end;
    if not( bReUse )then
    begin
      lstConnections.Add( blkS );
      result := lstConnections.Count-1;
    end;

    blkS.OnDisconnect := HandleDisconnect;
  finally
    csLock.Release;
  end;
end;

procedure THxConnThread.HandleDisconnect( blkS: THxBlockSocket );
var
  iIdx: integer;
begin
  iIdx := GetIndexByBlockSocket( blkS );

  if Assigned( thdOwner )then
    thdOwner.ClientAbortedSync( iIdx );

  if( NumActiveConnections = 0 )and( not( Terminated ))then
    Suspended := True;
end;

function THxConnThread.NumActiveConnections: integer;
var
  i: integer;
begin
  result := 0;
  csLock.Acquire;
  try
    for i := 0 to lstConnections.Count -1 do
      if lstConnections[i].GetSocket <> INVALID_SOCKET then
        Inc( result );
  finally
    csLock.Release;
  end;
end;

function THxConnThread.GetIndexByBlockSocket( blkS: THxBlockSocket ): integer;
var
  i: integer;
begin
  csLock.Acquire;
  try
    for i := 0 to lstConnections.Count -1 do
    begin
       if lstConnections[i] = blkS then
       begin
         result := i;
         exit;
       end;
    end;
    result := -1;
  finally
    csLock.Release;
  end;
end;

