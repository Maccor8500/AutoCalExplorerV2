procedure THxBlockSocket.SetServerAddress( sAddr: string );
var
  pHe: winsock.PhostEnt;
  iInAdres: TNetAddrConv;
  Exc : Boolean;
  AnsiAddr: AnsiString;
begin
  Exc := False;
  {
    for some odd reasons that i cant explain, inet_addr(PAnsiChar) fails
    and consistently too, i wonder if it has something to do with Delphi 11.1?
    but, the following solution seems to fix it.
  }
  { default value, if all fails }
  iInAdres.As32Bits := INADDR_NONE;
  AnsiAddr := AnsiString(sAddr);

  try
    sServerAddress := Trim(sAddr);
    try
      rServerAddress.sin_addr.s_addr := Integer(NetAddr(ShortString(sServerAddress)));
    except
      On E: Exception do
        Exc := True;
    end;
  finally
    if Exc then
    begin
      iInAdres.As32Bits := winsock.inet_addr(PAnsiChar(AnsiAddr));
      pHe := winsock.GetHostByName(PAnsiChar(AnsiAddr));
      if pHe = nil then
         raise Exception.Create('Invalid address: ' +String(AnsiAddr));
      rServerAddress.sin_addr := winsock.PInAddr( pHe^.h_addr_list^ )^;
      sServerAddress := String(AnsiString(winsock.Inet_NtoA( rServerAddress.sin_addr )));
      rServerAddress.sin_family := AF_INET;
    end

    else
    begin
      pHe := winsock.gethostbyname(PAnsiChar(AnsiAddr));
      if pHe = nil then
        raise Exception.CreateFmt('Invalid address: %s', [sAddr]);
      rServerAddress.sin_addr := winsock.PInAddr(pHe^.h_addr_list^)^;
      sServerAddress := String(AnsiString(winsock.Inet_NtoA( rServerAddress.sin_addr )));
      rServerAddress.sin_family := AF_INET;
    end;    
  end;
end;

function THxBlockSocket.GetSocket: TSocket;
begin
  result := sktSocket;
end;

procedure THxBlockSocket.SetPort( sPort: string );
var
  pSe: PServEnt;
begin
  if bConnected then
    Disconnect;

  sPort := Trim( sPort );
  if sPort = '' then
    exit;

  if IsNumber( sPort ) then
  begin
    rServerAddress.sin_port := HtoNS( StrToInt( sPort ));
    sPortNr := sPort;
  end
  else
  begin
    pSe := GetServByName(PAnsiChar( AnsiString(sPort) ), nil );
    if pSe = nil then
       raise Exception.Create('Invalid port: '+sPort );
    rServerAddress.sin_port := pSe^.s_port;
    sPort := IntToStr( NtoHS( pSe^.s_port ));
  end;
end;

function THxBlockSocket.GetPort: string;
var
  iSize: integer;
begin
  if sktSocket <> INVALID_SOCKET then
  begin
    iSize := Sizeof( TSockAddrIn );
    if winsock.getpeername( sktSocket, rServerAddress, iSize ) = -1 then
      raise Exception.Create( GetSocketLastError );
    result := IntToStr( NtoHs( rServerAddress.sin_port ));
  end
  else
    result := sPortNr;
end;

function THxBlockSocket.CanRead( iTimeOutInSec: integer = 1 ): boolean;
var
  readfds: winsock.TFDSet;
  Timeout: TTimeVal;
  iRes: integer;
begin
  Result := False;

  try
    if sktSocket = INVALID_SOCKET then
      exit(False);

    Timeout.tv_sec := iTimeOutInSec;
    TimeOut.tv_usec := 0;

    winsock.FD_ZERO( readfds );
    winsock.FD_SET( sktSocket, readfds );

    iRes := select( sktSocket+1, @readfds, nil, nil, @Timeout );
    result := iRes > 0;
  except
  end;
end;

function THxBlockSocket.CanWrite: boolean;
var
  writefds: winsock.TFDSet;
  Timeout: TTimeVal;
  iRes: integer;
begin
  winsock.FD_ZERO( writefds );
  winsock.FD_SET( sktSocket, writefds );

  Timeout.tv_sec := 0;
  TimeOut.tv_usec := 10;

  iRes := select( sktSocket+1, nil, @writefds, nil, @Timeout );

  result := iRes > 0;
end;

// NEVER free, dispose or whatever.. the result pointer.!!
// It is maintained by this class.
function THxBlockSocket.ReceiveData( var iSize: integer ): pointer;
var
  iRcvRes: integer;
begin
  if not( bConnected )then
  begin
    result := nil;
    Exit;
  end;
//    raise Exception.Create('No connection established');    //Changed by JM 09 JAN 2012

  result := nil;

  if CanRead then
  begin
    iSize := 0;
    if winsock.ioctlSocket( sktSocket, FIONREAD, iSize )<> 0 then
    begin
      Notify('Ioctl went wrong, message: '+GetSocketLastError );
      exit;
    end;

    if Assigned( pRcvBuf )then
      FreeMem( pRcvBuf );

    pRcvBuf := AllocMem( iSize );

    iRcvRes := TcpRecv( sktSocket, pRcvBuf, iSize, 0 );

    iSize := iRcvRes;

    if iRcvRes <= 0 then
      Disconnect
    else
      result := pRcvBuf;
  end;
end;

function THxBlockSocket.SendData( ptr: pointer;
                                  iSize: integer): boolean;
var
  iRes: integer;
begin
  if not( bConnected )then
  begin
    result:=false;
    Exit;
    //raise Exception.Create('No connection established');
  end;

  result := CanWrite;

  if result then
  begin
    iRes := TcpSend( sktSocket, ptr, iSize, 0 );
    if ( iRes <= 0 )then
    begin
      result := False;
      Disconnect;
    end
  end;
end;

{ THxTcpClient }

constructor TTCPClient.Create;
begin
  inherited;

  blkSock := THxBlockSocket.Create( Self );
  blkSock.OnDisconnect := HandleDisconnect;
  ifSock := blkSock;
end;

function TTCPClient.Connect: boolean;
var
  iRes: integer;
  sktSocket: TSocket;
  Timeout: Integer;
begin
  result := True;
  if Connected then
    exit;

  if ServerAddress = UNSET then
    raise Exception.Create('Server-address not set.');

  if Port = UNSET then
    raise Exception.Create('Server-port not set');

  sktSocket := Socket( AF_INET, SOCK_STREAM, IPPROTO_TCP );

  Timeout := 1000;
  iRes := winsock.setsockopt(sktSocket, SOL_SOCKET, SO_RCVTIMEO, @Timeout, SizeOf(Timeout));
  if iRes = NativeInt(INVALID_SOCKET) then raise Exception.CreateFmt('Socket failed: %d', [WSAGetLastError]);

  iRes := winsock.setsockopt(sktSocket, SOL_SOCKET, SO_SNDTIMEO, @Timeout, SizeOf(Timeout));
  if iRes = NativeInt(INVALID_SOCKET) then raise Exception.CreateFmt('Socket failed: %d', [WSAGetLastError]);

  if sktSocket = INVALID_SOCKET then
    raise Exception.Create('Invalid socket returned, message: '+
                            ifSock.GetSocketLastError );


  ifSock.SetSocket( sktSocket );

  iRes := ifSock.Connect;

  result := iRes = 0;
  if result then
  begin
    if Suspended then
      Suspended := False;
  end
  else
  begin
    iRes := WSAGetLastError;
    case iRes of
      0 : result := True;
    end;
    ifSock.CloseSocket;
  end;
end;

procedure TTCPClient.ServerAborted;
begin
  if Assigned( FOnConnectionClosed )then
    FOnConnectionClosed;
end;

procedure TTCPClient.HandleDisconnect( blkS: THxBlockSocket );
begin
  Synchronize( ServerAborted );

// This is a very important check!
// Under (rare) situations it is possible that this procedure is called while
// this class is beeing destroyed. In this case it is better NOT to suspend the
// thread.
  if not Terminated then
    Suspended := True;
end;

procedure TTCPClient.SetConnected( const bValue: boolean );
begin
  if bValue = Connected then
    exit; // Nothing to do..

  if bValue then
    Connect
  else
    ifSock.Disconnect; // this will 'fire' the eventhandler 'HandleDisconnect'
end;

function TTCPClient.SendData( ptr: pointer; iSize: integer ): boolean;
