{ TUdpSocketEx }

{
  [ updates... ]
  added sync mode for detached process to consume payload! simply process
  callback in it's own detached thread!. all synchronization issues shall be
  handled by caller <all fall-through exceptions captured!> when done right,
  this should be redundant!.

  [how-to]
  call the overloaded Create:
    Create(const ListenPort: Word; const OnDataRecvd: TAsyncSocketDataCallback; const OnEvent: TAppEventCallback);
  ... callback expects a newly defined TAsyncSocketDataCallback, indicating
  asynchronous data processing in a new parallel process, where user may be
  axpected to handle all needed synchronization, implementations of mutexes or
  locks to shared resources and all headaches thay may come with such implementations.

  [pros]
  - a non-blocking way to comsume received data, for high traffic and when
    *synchronization may not be important. ex, instances of no ui-access and
    when resource sharing is minimal* to non-existent, and overall parallel processing
    may be beneficial with all considerations made!

  [best-use case]
  prerequisites... (no ui updates, unique resource)
  resource >>> Data: TArray<TRec>;
  calback  >>> OnDataRx(const Payload: TSock...);

  <translate payload to recognisable record perhaps>
  RxData := TNamedType(Payload^.AsBytes);
  <access unique resource>
  Data[RxData.DataIndex] := new values, etc!

  if there's going to be a ui access, either queue or synchronize it
    (
      for calls where the result of this call is needed to proceed, say
      updated local record may be accessed next and we want the access to use
      the newly updated values.
    )
  TThread.Synchronize(nil <or desired thread> (usually nil: for main-ui thread),
    procedure
    begin
      Memo.SelText := IntToStr(Data[RxData.DataIndex]);
      ... more ui related stuff for this call
    end);

  OR

  (
    for calls where the result of this call is not needed to proceed, say
    we only need to update resources only and it wont matter what the next caller
    sees, or just notification purposes where it doesn't matter in what order
    it executes, as demonstrated by the example.
  )
  TThread.Queue(nil or desired thread,
    procedure
    begin
      Memo.SelText := IntToStr(Data[RxData.DataIndex]);
      ... more ui related stuff for this call
    end);
}
constructor TUdpSocketEx.Create(const ListenPort: Word; const OnDataRecvd: TAsyncSocketDataCallback; const OnEvent: TAppEventCallback);
begin
  SyncType := stASync;
  OnSocketEvent := OnEvent;
  Create(ListenPort, nil, nil, nil);
  AsyncDataCallback := OnDataRecvd;
end;

constructor TUdpSocketEx.Create(const ListenPort: Word; const OnDataRecvd: TSocketDataCallback;
  const ErrTask: TSocketErrorCallback; const ExcTask: TSocketExceptionCallback;
  const BindAddr: String);
const
  SocketTimeout = 2000;

var
  WSA : TWsaData;
  NonBlocking: ULong;
begin
  inherited Create(True);

  { gotta know state at init. }
  SyncThread := nil;
  UseSync := False;
  SocketOK := False;
  NonBlocking := 1;
  Port := ListenPort;

  try
    { important WSAStartup call before all/any socket activities! }
    case WSAStartup(MAKEWORD($02, $02), WSA) of
      ERROR_SUCCESS:
      begin
        { try get a port if listen port = 0 }
        if ListenPort = 0 then GetUniquePort(stSockUDP, Port);

        { general size of SockAddrIn }
        AddrLen := SizeOf(TSockAddrIn);

        { init. the socket }
        Sock := Socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
        SocketOK := Sock <> INVALID_SOCKET;
        if not SocketOK then Exit;

        {
          binding [interface] prep]
          FillChar(Hints, SizeOf(Hints), 0);
          Hints.ai_family := AF_INET;
          Hints.ai_socktype := SOCK_DGRAM;
          Hints.ai_protocol := IPPROTO_UDP;
          Hints.ai_flags := 0;
          sockaddr_in localAddr;
        }
        ZeroMemory(@SockAddr, AddrLen);
        SockAddr.sin_family := AF_INET;
        SockAddr.sin_addr.S_addr := INADDR_ANY;
        if BindAddr <> '' then
        begin
          SockAddr.sin_addr.S_addr := inet_addr(PAnsiChar(AnsiString(BindAddr)));
          { never fall back to any-interface: the caller asked for a specific one }
          SocketOK := (SockAddr.sin_addr.S_addr <> INADDR_NONE);
          if not SocketOK then Exit;
        end;
        SockAddr.sin_port := htons(Math.Max(Port, ListenPort));

        {
          SocketOK := (GetAddrInfo(nil, PAnsiChar(@PortStr[1]), Hints,
            InterfaceInfo) = ERROR_SUCCESS);
          if not SocketOK then Exit;
        }

        { binding... }
        SocketOK := (Bind(Sock, TSockAddr(SockAddr), SizeOf(TSockAddr)) <> SOCKET_ERROR);
        if not SocketOK then Exit;

        { make it non-blocking }
        SocketOK := ioctlsocket(Sock, Int32(WInsock2.FIONBIO), NonBlocking) <> SOCKET_ERROR;

        { set 1MB send buffer }
        //Options := $100000;
        //setsockopt(Sock, SOL_SOCKET, SO_RCVBUF, @Options, SizeOf(UInt32));

        {
          improve on context switching and general operations.
          the whole socket depends on this now, though it isn't directly socket related
          but if this fails, the loop is doomed! so... if we're here, socket is OK
        }
        WSAEvent := WSACreateEvent;
        SocketOK := (WSAEvent <> WSA_INVALID_EVENT);
        { attach WSA event }
        if not SocketOK then Exit;
        { finish with this socket event }
        SocketOK := WSAEventSelect(Sock, WSAEvent, SocketEventFlags) <> SOCKET_ERROR;
        //WSASetEvent(WSAEvent);

        { assign callbacks }
        DataCallback := OnDataRecvd;
        OnErrorCallback := ErrTask;
        OnExceptionCallback := ExcTask;
      end;
    end;
  except
    On E: Exception do
      AlertSocketException(E);
  end;

  Suspended := (not SocketOK);
end;

{ Execute waits on WSAEvent with WSA_INFINITE: Terminate alone would never wake it }
procedure TUdpSocketEx.TerminatedSet;
begin
  if SocketOK and (WSAEvent <> 0) then SetEvent(WSAEvent);
  inherited;
end;

destructor TUdpSocketEx.Destroy;
begin
  Terminate;
  { joins the thread (TThread.Destroy terminates again, so the event must still be valid): release only afterwards }
  inherited;

  try
    if SocketOK and (WSAEvent <> 0) then CloseHandle(WSAEvent);
    if Sock <> INVALID_SOCKET then CloseSocket(Sock);
  finally
    WSACleanup;
  end;
end;

procedure TUdpSocketEx.Execute;
var
  Payload: TSocketPayload;
  APayload: TASyncSocketPayload;
  WaitResult: Cardinal;
  Time: Integer;
begin
  inherited;
  { well, is all good?! }
  if not SocketOK then Exit;

  { do this once, for when buffer is custom }
  Payload := Default(TSocketPayload);
  Time := 5;

  { listen and read all incoming packets until suspend &/ terminated }
  repeat
    { wsa-socket-event controlled loop }
    WaitResult := WSAWaitForMultipleEvents(1, @WSAEvent, False, WSA_INFINITE, False);

    { check termination, early exit! }
    if Terminated then break;

    case WaitResult of
      WSA_WAIT_EVENT_0:
      begin
        WSAResetEvent(WSAEvent);
        if (SocketEventFlags and FD_READ) <> 0 then
        begin
          try
            { default buffer 1024 }
            if (not AltRxBuffer) then
            begin
              Payload.AsDataPtr := nil;
              Payload.Size := WinSock2.RecvFrom(Sock, Payload.AsBytes[0], Length(Payload.AsBytes), 0,
                TSockAddr(Payload.Remote.Sock), AddrLen);
            end

            { alternate buffer configured! }
            else
            begin
              { initialize this once! }
              if (Payload.AsDataPtr = nil) then Payload.AsDataPtr := AltBufferPtr;

              { always be checking! }
              if (Payload.AsDataPtr <> nil) then
                Payload.Size := WinSock2.RecvFrom(Sock, PRawBytes(AltBufferPtr)^[0],
                  AltBufferSize, 0, TSockAddr(Payload.Remote.Sock), AddrLen);
            end;

            { unpack source address and payload data, handle errors }
            case Payload.Size of
              { rats! }
              SOCKET_ERROR:
              begin
                Err := Default(TSocketError);
                Err.Code := WSAGetLastError;

                case Err.Code of
                  { no data! }
                  WSAEWOULDBLOCK:
                  begin
                    TIme := IntTernary(Time >= ONE_SEC, ONE_SEC {max}, (Time *2));
                    continue;
                  end;

                  WSAEMSGSIZE:
                  begin
                    HandleSocketError('receive buffer overflow!'#13);
                    continue;
                  end;

                  WSAECONNRESET:;

                  { we may have a problem! }
                  else
                  begin
                    if not Terminated then
                    begin
                      AlertSocketError;
                      HandleSocketError(String(Peer.Addr));
                      AvoidBusywait(ONE_SEC);
                      continue;
                    end;
                  end;
                end;
              end;

              {
                do not announce this! chatgpt thinks it may be due to packet loss!
                wireshark thinks destination port unreachable, ...more likely.
              }
              WSAECONNRESET: AlertSocketError;

              { otherwise, handle packet }
              else
              begin
                { for interruption control }
                SocketActive := (Payload.Size > 0);

                { good? }
                if SocketActive then
                begin
                  try
                    { caution?!! }
                    if WantResponse then GotResponse := True
                    else GotResponse := False;

                    if Assigned(DataCallback) then
                    begin
                      { current time-stamp }
                      Payload.Timestamp := Now;
                      { create human readable address and port from SockAddr }
                      Payload.Remote.Unpack;

                      {
                        since all created objects of this class will have a parent class
                        of TTHREAD, and would all have private members and data. There
                        should be no requirement for default synchronizations.

                        except unless user's data/resources is shared outside of this
                        implementation. therefore, user is advised to handle this by
                        enabling the Synchronize feature...
                          1. EnableSynchronization; (default: nil)
                          2. EnableSynchronization(your_own_thread);


                        now, go do caller's biddings!
                        synchronize/queue user's callback with/to choice of thread if
                        configured. otherwise, just execute it here!
                      }
                      if (UseSync) then
                      begin
                        case SyncType of
                          { sync. blocking }
                          stSyncronize: Synchronize(TThread(SyncThread),
                          procedure begin
                            DataCallback(@Payload);
                          end);

                          { queue non-blocking }
                          stQueue: Queue(TThread(SyncThread),
                          procedure begin
                            DataCallback(@Payload);
                          end);
                        end;
                      end

                      { least efficient! }
                      else DataCallback(@Payload);
                    end

                    else if Assigned(AsyncDataCallback) then
                    begin
                      APayload.Remote := Payload.Remote;
                      APayload.Size := Payload.Size;
                      APayload.Timestamp := Payload.Timestamp;

                      { prepare for copy! }
                      if APayload.Buffer.Size < Payload.Size then APayload.Buffer.Init(Payload.Size)
                      else APayload.Buffer.Reset;

                      if (AltRxBuffer) then Move(Byte(Payload.AsDataPtr^), APayload.Buffer.Bytes[0], Payload.Size)
                      else Move(Payload.AsBytes[0], APayload.Buffer.Bytes[0], Payload.Size);

                      TThread.CreateAnonymousThread(
                        procedure
                        begin
                          try
                            APayload.ThreadId := GetCurrentThreadId;
                            AsyncDataCallback(APayload);
                          except
                            On E: Exception do
                              AlertSocketException(E);
                          end;
                        end).Start;
                    end;

                  finally
                    SocketActive := False;
                  end;
                end;
              end;
            end;

            { clean buffer: once is good, advise: consume payload by its reported size }
            if Payload.Size <> 0 then
            begin
              Fill(@Payload.AsBytes[0], 0, Payload.Size);
              if (Payload.AsDataPtr <> nil) then Fill(AltBufferPtr, 0, Payload.Size);
              Payload.Size := 0;
            end;
          except
            { for other non-specific range of socket exceptions! }
            On E: Exception do AlertSocketException(E);
          end;
        end

        else if (SocketEventFlags and FD_CLOSE) <> 0 then continue;
      end;

      WSA_WAIT_FAILED: AlertSocketError;
    end;

    { spin on! }
  until Terminated;
end;

