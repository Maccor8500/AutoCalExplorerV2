procedure IncEx(var Val: Integer; const Limit: Integer; ResetVal: Integer);
begin
  case ResetVal of
    { for Val [0:Max -1] }
    0: if (Val < (Limit -1)) then Inc(Val) else Val := ResetVal;
    { for Val [1:Max] }
    1: if (Val < Limit) then Inc(Val) else Val := ResetVal;
  end;
end;

procedure IncEx(var Val: SmallInt; const Limit: SmallInt; ResetVal: SmallInt);
begin
  case ResetVal of
    { for Val [0:Max -1] }
    0: Val := IntTernary((Val < (Limit -1)), (Val +1), ResetVal);
    { for Val [1:Max] }
    1: Val := IntTernary((Val < Limit), (Val +1), ResetVal);
  end;
end;

