procedure TMemoLock.OnMouseIn(Sender: TObject);
begin
  MouseIn := True;
end;

procedure TMemoLock.OnMouseOut(Sender: TObject);
begin
  MouseIn := False;
end;

procedure TMemoLock.RichEditWindowProc(var Message: TMessage);
begin
  case Message.Msg of
    WM_LBUTTONDOWN, WM_LBUTTONUP, WM_LBUTTONDBLCLK,
    WM_MBUTTONDOWN, WM_MBUTTONUP, WM_MBUTTONDBLCLK,
    WM_RBUTTONDOWN, WM_RBUTTONUP, WM_RBUTTONDBLCLK:
    begin
      Message.Result := 0;
      Exit;
    end;
  end;

  MemoLockProc(Message);
end;

procedure TMemoLock.OnMemoChange(Sender: TObject);
begin
  if not MouseIn then
  begin
    if Sender is TMemo then SendMessage(TMemo(Sender).Handle, WM_VSCROLL, SB_BOTTOM, 0)
    else SendMessage(TRichEdit(Sender).Handle, WM_VSCROLL, SB_BOTTOM, 0);
  end;

  if Sender is TMemo then
  begin
    if MemoLock[TMemo(Sender).Tag].CallBackProc <> nil then
      CallBackProc;
  end
  else { Its a richedit... what else could it be?! }
  begin
    if Assigned(MemoLock[TRichEdit(Sender).Tag].CallBackProc) then
      CallBackProc;
  end;

  TWinControl(Sender).Invalidate;
end;

{
   There is a short-coming here... I used file generated by MacCalibration
    which assumes a single Aux Board, and 3 panels for some reason
      this was done to solve invalid VerifyAux.cfg with invalid data for some
        odd reason.
}
procedure LoadAuxFromLog(PAuxBrds : PMaccorAuxVerifyBoards);
var
  Line : TArray<String>;
  Panel, Pos : Integer;
  Reader : TFileReader;
  Flt : Single;
  DateFmt : TFormatSettings;
begin;
  if PAuxBrds = nil then Exit;

  Reader := TFileReader.Create(MacSys.AuxLogFile);
  DateFmt := TFormatSettings.Create;
  with DateFmt do
  begin
    ShortDateFormat := 'DD-MMM-YYYY';
    DateSeparator := '-';
  end;

  with Reader do
  begin
    try
      while ReadLine(Line, #9) do
      begin
        try
          { gotta be exactly 11 columns }
          if Length(Line) <> 11 then continue;
          { header }
          if Line[0] = 'Cal_Type' then continue;
          { dont care for now! }
          if Line[0] = '_Pre-Cal' then continue;

          { consider only post-cal & voltage (V) }
          if (Line[0] = 'Post-Cal') then
          begin
            { get panel #}
            if not TryStrToInt(Line[1], Panel) then continue;
            { get pos}
            if not TryStrToInt(Line[2], Pos) then continue;
            { adjust for 0-indexed array }
            Dec(Pos);
            Dec(Panel);
            { only aux position 1 (0) considered! }
            PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].HasValue := true;
            { reads! }
            if TryStrToFloat(Line[3], Flt) then
              PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].TstAvg[0] := Flt;
            if TryStrToFloat(Line[5], Flt) then
              PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].TstAvg[1] := Flt;
            if TryStrToFloat(Line[7], Flt) then
              PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].TstAvg[2] := Flt;

            { measured! }
            if TryStrToFloat(Line[4], Flt) then
              PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].RefAvg[0] := Flt;
            if TryStrToFloat(Line[6], Flt) then
              PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].RefAvg[1] := Flt;
            if TryStrToFloat(Line[8], Flt) then
              PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].RefAvg[2] := Flt;

            { date! }
            if ReplaceMonthStr(Line[$A]) then
            begin
              Line[$A] := StringReplace(Line[$A], ' ', '-', [rfReplaceAll]);
              Line[$A] := format('%sT12:49:08Z', [Line[$A]]);
              PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].Date := StrToDateTime(Line[$A], DateFmt);
            end
            else PAuxBrds^[0].Panel[Panel, 1].Posn[Pos].Date := Now;
            { this is at best questionable! and unacceptable! }
            //SimulateUC;
          end;
        except
        end;
      end;
    finally
      Free;
    end;
  end;
end;

function ReplaceMonthStr(var date_str : String): Boolean;
var
  S : TArray<String>;
  M : Integer;
begin
  SplitStr(date_str, ' ', S);
  Result := Length(S) > 2;
  if not Result then Exit;

  Result := StringInSet(S[1], ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'], M);
  if Result then
    date_str := StringReplace(date_str, S[1], IntToStr(M +1), [rfReplaceAll]);
end;

