    if not R.OpenKey('SOFTWARE\Microsoft\Windows NT\CurrentVersion', false) then Exit;

    try
      Result := R.ReadString('ProductId');
    except
      on ERegistryException do
        Result := 'error';
    end;
  finally
    R.Free;
  end;
end;

