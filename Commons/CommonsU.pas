constructor TTCPServerEx.Create(ListenAt: Word; MaxClients: Byte;
  DbgOut: PDebugMemo);
begin
  Create(ListenAt, MaxClients, DbgOut, MakeWord(2, 2));
end;

constructor TTCPServerEx.Create(ListenAt: Word; MaxClients : Byte;
  DbgOut : PDebugMemo; WinSockVer: Word);
var
  WSAData : TWSAData;
  I{, Timeout}: Integer;
begin
  { start thread spinning! }
  inherited Create(False);

  { connected clients }
  Clients := 0;
  Closing := False;
  //Timeout := 250;

  { configure debug-out }
  Debug := DbgOut;

  { set listen port }
  if (ListenAt = 0) then GetUniquePort(stSockTCP, ListenPort)
  else ListenPort := ListenAt;

  try
    { start winsock [2.0] }
    WSAOK := (WSAStartup(WinSockVer, WSAData) = 0);

    { winsock started ok? }
    if WSAOK then
    begin
      { debug
        if Debug <> nil then Debug.WriteLn('WSAStartup Successful!', clGreen);
      }

      { init mutex object }
      Mutex := TCriticalSection.Create;
      { start server socket }
      ServerSocket := Winsock2.Socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);

      if ServerSocket <> INVALID_SOCKET then
      begin
//        setsockopt(ServerSocket, SOL_SOCKET, SO_RCVTIMEO, @Timeout, SizeOf(Timeout));
//        setsockopt(ServerSocket, SOL_SOCKET, SO_SNDTIMEO, @Timeout, SizeOf(Timeout));

        { proceed... }
        FillChar(ServerAddr, SizeOf(ServerAddr), 0);
        ServerAddr.sin_family := AF_INET;
        { listen on all available network interface }
        ServerAddr.sin_addr.s_addr := htonl(INADDR_ANY);
        ServerAddr.sin_port := htons(ListenPort);

        { binding... }
        SocketOK := (Winsock2.Bind(ServerSocket, Winsock2.PSockAddr(@ServerAddr)^,
          SizeOf(ServerAddr)) <> SOCKET_ERROR);

        { start listening }
        if SocketOK then
        begin
          SocketOK := (Listen(ServerSocket, SOMAXCONN) <> SOCKET_ERROR);

          if SocketOK then
          begin
            { configure max sessions, at least 1 }
            SetLength(Sessions, Max(MaxClients, 1));
            for I := Low(Sessions) to High(Sessions) do
              Sessions[i] := Default(TClientSession);

            { debug:
              if (Debug <> nil) then
                Debug.WriteLn(format('Listening @ port #%d'#13, [ListenPort]),
                  clGreen);
            }

            { socket timeout }
            //RecvTimeout := Round(RxTimeout *1000);
          end;
        end;
      end;
    end;
  except
    On E: Exception do
    begin
      if Assigned(OnErrorEvent) then
      begin
        BuildSocketError(@E);
        OnErrorEvent(@Error);
      end;
    end;
  end;
end;

destructor TTCPServerEx.Destroy;
var
  i: Integer;
begin
  Closing := True;

  if WSAOK then
  begin
    for i := Low(Sessions) to High(Sessions) do
    begin
      if not ValidSession(@Sessions[i]) then continue;
      ShutDown(Sessions[i].iDescr, SD_BOTH);
      CloseSocket(Sessions[i].iDescr);
    end;

    SetLength(Sessions, 0);
    CloseSocket(ServerSocket);
    WSACleanUp;
  end;

  if Assigned(Task) then Task := nil;
  if (Mutex <> nil) then FreeAndNil(Mutex);
  if (Cipher <> nil) then FreeAndNil(Cipher);

  inherited;
end;

