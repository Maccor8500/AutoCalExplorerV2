const
  VC_DLLs: array[0..9] of string = (
    'msvcp140.dll',
    'msvcp140_1.dll',
    'msvcp140_2.dll',
    'msvcp140_atomic_wait.dll',
    'vcruntime140.dll',
    'vcruntime140_1.dll',
    'concrt140.dll',
    { VC++ 2013 }
    'msvcp120.dll',
    'msvcr120.dll',
    'vccorlib120.dll'
  );

function FindAnyVCRuntime(out DLLPath: string): Boolean;
var
  SR: TSearchRec;
  WinDir: string;
  P: string;

const
  Patterns: TArray<String> = [
    'msvcp*.dll',
    'msvcr*.dll',
    'vcruntime*.dll',
    'concrt*.dll',
    'vccorlib*.dll'
  ];
begin
  Result := False;
  DLLPath := '';
  WinDir := IncludeTrailingPathDelimiter(GetEnvironmentVariable('WINDIR'));

  for P in Patterns do
  begin
    if FindFirst(WinDir + 'WinSxS\*\' + P, faAnyFile, SR) = 0 then
    begin
      DLLPath := WinDir + 'WinSxS\' + SR.Name;
      FindClose(SR);
      Exit(True);
    end;
  end;
end;

function GetVCRedistInfoFromRegistry(out Ver: TMVCInfo): Boolean;
var
  R: TRegistry;
  Key: string;
  VersionStr: string;
  Parts: TArray<string>;
begin
  Result := False;
  FillChar(Ver, SizeOf(Ver), 0);
  R := TRegistry.Create(KEY_READ);
  try
    R.RootKey := HKEY_LOCAL_MACHINE;
    { attempt x64 first, then x86 }
    if R.OpenKeyReadOnly('SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64') then Key := 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64'
    else if R.OpenKeyReadOnly('SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86') then Key := 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86'
    else Exit(False);
    { next... read version string }
    VersionStr := R.ReadString('Version');
    if VersionStr = '' then Exit(False);
    Parts := VersionStr.Split(['.']);
    if Length(Parts) < 4 then Exit(False);
    { fill TMVCInfo }
    Ver.Major    := StrToIntDef(Parts[0], 0);
    Ver.Minor    := StrToIntDef(Parts[1], 0);
    Ver.Build    := StrToIntDef(Parts[2], 0);
    Ver.Revision := StrToIntDef(Parts[3], 0);
    { product version = same as file version for VC++ redist }
    Ver.ProductMajor    := Ver.Major;
    Ver.ProductMinor    := Ver.Minor;
    Ver.ProductBuild    := Ver.Build;
    Ver.ProductRevision := Ver.Revision;
    Ver.DisplayName := ShortString(Format('Microsoft Visual C++ Redistributable | %s', [VersionStr]));
    { must be good! }
    Result := True;
  finally
    R.Free;
  end;
end;

function FindVCRuntimeDLL(out FilePath: string): Boolean;
var
  SysDir, WinDir: array[0..MAX_PATH] of Char;
  Dir: string;
  DLL: string;
  SR: TSearchRec;
begin
  Result := False;

  GetSystemDirectory(SysDir, MAX_PATH);
  GetWindowsDirectory(WinDir, MAX_PATH);

  for DLL in VC_DLLs do
  begin
    { System32 }
    Dir := IncludeTrailingPathDelimiter(SysDir) + DLL;
    if FileExists(Dir) then begin FilePath := Dir; Exit(True); end;

    { SysWOW64 }
    Dir := IncludeTrailingPathDelimiter(WinDir) + 'SysWOW64\' + DLL;
    if FileExists(Dir) then begin FilePath := Dir; Exit(True); end;

    { WinSxS (slow but fool-proof) }
    if FindFirst(IncludeTrailingPathDelimiter(WinDir) + 'WinSxS\*\' + DLL, faAnyFile, SR) = 0 then
    begin
      FilePath := IncludeTrailingPathDelimiter(ExtractFilePath(SR.Name)) + DLL;
      FindClose(SR);
      Exit(True);
    end;
  end;
end;

function GetMVCDistEnv(out Ver: TMVCInfo; Eventcallback: TAppEventCallback): Boolean;
var
  SysDir: array[0..MAX_PATH] of Char;
  FileName: string;

  function GetFileVersion(const Path: string; out V: TMVCInfo): Boolean;
  var
    Handle: DWORD;
    Size: DWORD;
    Buffer: Pointer;
    FixedInfo: PVSFixedFileInfo;
    Len: UINT;
  begin
    Result := False;
    Size := GetFileVersionInfoSize(PChar(Path), Handle);
    if Size = 0 then Exit;

    GetMem(Buffer, Size);
    try
      if GetFileVersionInfo(PChar(Path), Handle, Size, Buffer) then
        if VerQueryValue(Buffer, '\', Pointer(FixedInfo), Len) then
        begin
          V.Major    := HiWord(FixedInfo.dwFileVersionMS);
          V.Minor    := LoWord(FixedInfo.dwFileVersionMS);
          V.Build    := HiWord(FixedInfo.dwFileVersionLS);
          V.Revision := LoWord(FixedInfo.dwFileVersionLS);

          V.ProductMajor    := HiWord(FixedInfo.dwProductVersionMS);
          V.ProductMinor    := LoWord(FixedInfo.dwProductVersionMS);
          V.ProductBuild    := HiWord(FixedInfo.dwProductVersionLS);
          V.ProductRevision := LoWord(FixedInfo.dwProductVersionLS);

          V.FileFlagsMask := FixedInfo.dwFileFlagsMask;
          V.FileFlags     := FixedInfo.dwFileFlags;
          V.FileOS        := FixedInfo.dwFileOS;
          V.FileType      := FixedInfo.dwFileType;
          V.FileSubtype   := FixedInfo.dwFileSubtype;
          V.FileDateMS    := FixedInfo.dwFileDateMS;
          V.FileDateLS    := FixedInfo.dwFileDateLS;

          Ver.DisplayName := ShortString(
            Format('Microsoft Visual C++ Redistributable | %d.%d.%d.%d',
              [Ver.Major, Ver.Minor, Ver.Build, Ver.Revision]));
          Result := True;
        end;
    finally
      FreeMem(Buffer);
    end;
  end;
begin
  try
    Result := False;

    { Check System32 (x64 DLLs) }
    GetSystemDirectory(SysDir, MAX_PATH);
    FileName := IncludeTrailingPathDelimiter(SysDir) +'msvcp140.dll';
    Result := FileExists(FileName);

    { Check SysWOW64 (x86 DLLs on 64-bit Windows) }
    if (not Result) then
    begin
      if Assigned(Eventcallback) then
        TUtils.HandleEvent(etMessage, 'Nope! 1', TUtils.RED, Eventcallback);
      GetWindowsDirectory(SysDir, MAX_PATH);
      FileName := IncludeTrailingPathDelimiter(SysDir) +'SysWOW64\msvcp140.dll';
      Result := FileExists(FileName);
    end;

    { last resorts from here on... !!! }
    if (not Result) then
    begin
      if Assigned(Eventcallback) then
        TUtils.HandleEvent(etMessage, 'Nope! 2', TUtils.RED, Eventcallback);
      FindVCRuntimeDLL(FileName);
      Result := FileExists(Filename);
    end;

    { any?! }
    if not Result then
    begin
      FindAnyVCRuntime(Filename);
      Result := FileExists(Filename);
      if (not Result) and Assigned(Eventcallback) then
        TUtils.HandleEvent(etMessage, 'Nope! 3', TUtils.RED, Eventcallback)
    end;

    { one of the above! }
    if Result then Result := GetFileVersion(FileName, Ver)
    { none of the above! }
    else Result := GetVCRedistInfoFromRegistry(Ver);

    if not Result then
    begin
      if Assigned(Eventcallback) then
        TUtils.HandleEvent(etMessage, 'Nope! 4', TUtils.RED, Eventcallback);
    end
    else if Assigned(Eventcallback) then
      TUtils.HandleEvent(etMessage, 'Good!'#13#10, TUtils.GREEN, Eventcallback);
  except
    On E: Exception do
      Result := False;
  end;
end;

