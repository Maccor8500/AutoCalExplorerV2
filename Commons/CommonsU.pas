procedure SaveSysChanConfig;
var
  S: TFileStream;
  i: Integer;
begin
  S := TFileStream.Create(MacSys.ChCfgFile, fmCreate +fmOpenWrite +fmShareDenyNone);

  try
    with S, MacSysPtr^{MacSys} do
    begin
      Seek(0, soFromBeginning);
      for i := Low(ChanDataNorm) to High(ChanDataNorm) do
      begin
        WriteBuffer(ChanDataNorm[i], SizeOf(ChParm));

        { dump index to  vbstruct! }
        if i > High(ChanData) then SetLength(ChanData, i +1);

        with ChanData[i] do
        begin
          Chg := ChanDataNorm[i].chg;
          Dis := ChanDataNorm[i].dis
        end;
      end;
    end;
  finally
    FreeAndNil(S);
  end;
end;

