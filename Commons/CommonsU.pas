procedure ReverseIntArr(A: Array of Integer; B:PInteger);
var
  i : Integer;
begin
  for i := High(A) downto 0 do
  begin
    B^ := A[i];
    Inc(B);
  end;
end;

procedure ReverseArr(var A: Array of Integer; Len : Integer = -1);
var
  M, L, I, T : Integer;
begin
  if Len < 0 then L := Length(A)
  else L := Len;

  if L <= 0 then Exit;

  {Max A for i}
  M := High(A);

  for i := 0 to (M div 2) do
  begin
    T := A[i];
    A[i] := A[M -i];
    A[M -i] := T;
  end;
end;

