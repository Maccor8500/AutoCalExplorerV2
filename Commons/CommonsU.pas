class procedure TMaccorSystem.CompileAuxiliaryBoards;
begin
  { rebuild from scratch so repeated loads don't accumulate stale entries }
  MacSysPtr^.CompiledAux := nil;
  if High(MacSysPtr^.AuxBrds) < 0 then Exit;

  { date format for Descriptor parsing :: once, not per input! }
  var FS: TFormatSettings := TFormatSettings.Create('en-US');
  FS.ShortDateFormat := TUtils.DT_FMT_STYLES[8];

  { at most one summary entry per installed board; boards with no populated
    panels are purged, so the outer array is packed densely too }
  SetLength(MacSysPtr^.CompiledAux, Length(MacSysPtr^.AuxBrds));
  var BoardCount: Integer := 0;

  for var B: Byte := Low(MacSysPtr^.AuxBrds) to High(MacSysPtr^.AuxBrds) do
  begin
    { collect this board's valid panels into the next free slot }
    SetLength(MacSysPtr^.CompiledAux[BoardCount].Panels, Length(MacSysPtr^.AuxBrds[B].Panel));
    var PanelCount: Integer := 0;

    for var P: Integer := Low(MacSysPtr^.AuxBrds[B].Panel) to High(MacSysPtr^.AuxBrds[B].Panel) do
    begin
      if MacSysPtr^.AuxBrds[B].Panel[P].TypeX <= 0 then Continue;

      { found a valid one! register it! }
      Include(MacSysPtr^.CompiledAux[BoardCount].List, P);
      MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Index := P;
      {
        TRANSLATE, never cast :: TypeX is the legacy enumeration and diverges
        from TMaccorAuxType at ordinals 4|6 <pressure vs PTC, Therm_T vs
        pressure> with nothing at all for 7..9. the old hard cast read a
        PRESSURE panel as a thermistor and turned 8|9 into invalid enum
        values <undefined in every case statement downstream>.
      }
      MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Sensor := LegacyAuxTypeToMaccorAuxType(MacSysPtr^.AuxBrds[B].Panel[P].TypeX);
      MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].ItsRes := (MacSysPtr^.AuxBrds[B].Panel[P].TypeX = Ord(maResistance));

      for var i: Byte := 0 to 15 do
      begin
        MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].Slope := MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].Cal.Slope;
        MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].Offset := MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].Cal.Offset;

        {
          Descriptor is dual-purpose! when Chan.Options[0] = 1 it holds BINARY
          ExtThermistorData <see MacFileU aux conversion>, not a date string ::
          parsing those bytes as text is garbage-in <or worse, a spurious date>
        }
        MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].Date := 0;
        if MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].Chan.Options[0] <> 1 then
        begin
          var DateStr: String := TUtils.GetString(MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].Descriptor);
          var ParsedDate: TDateTime;
          { assign only on success :: TryStrToDate's out param is undefined on failure }
          if (DateStr <> EmptyString) and TryStrToDate(DateStr, ParsedDate, FS) then
            MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].Date := ParsedDate;
        end;
        MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].Low := MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].RGE.low;
        MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].High := MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].RGE.high;
        MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].Span :=
          (MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].RGE.high -MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].RGE.low);

        TUtils.UpdateShortString(MacSysPtr^.CompiledAux[BoardCount].Panels[PanelCount].Calibration[i].eUnit,
          TUtils.GetString(MacSysPtr^.AuxBrds[B].Panel[P].AddInput[i].RGE.engUnit));
      end;

      Inc(PanelCount);
    end;

    { purge boards with no populated panels }
    if PanelCount = 0 then Continue;

    MacSysPtr^.CompiledAux[BoardCount].Index := (MacSysPtr^.SysCfg.CtlrBrds +B);
    SetLength(MacSysPtr^.CompiledAux[BoardCount].Panels, PanelCount);
    Inc(BoardCount);
  end;

  { trim to the number of boards that actually had panels }
  SetLength(MacSysPtr^.CompiledAux, BoardCount);
end;

class procedure TMaccorSystem.LoadTesterIdFile;
var
  Aggregates: TArray<TAuxAggregate>;

  procedure GetToken(const Str: String; var Token: String);
  var
    Arr: TArray<String>;
  begin
    SplitStr(Trim(Str), ':', Arr);
    if High(Arr) >= 1 then
      Token := Trim(Arr[1]);
  end;

  procedure ParseSystemDesc(const DescStr: TArray<String>; var DescRec: TTesterDescItem);

    { pulls the leading numeric portion: '10mSec' -> '10', '-5V' -> '-5', '7.5A' -> '7.5' }
    function NumPrefix(const S: string): string;
    var
      i: Integer;
    begin
      Result := '';
      for i := 1 to Length(S) do
        if CharInSet(S[i], ['0'..'9', '.']) or ((Result = '') and CharInSet(S[i], ['-', '+'])) then
          Result := Result + S[i]
        else if Result <> '' then
          Break;
    end;

  begin
    DescRec := Default(TTesterDescItem);

    try
      if not TryStrToInt(DescStr[0], DescRec.Channels) then
      begin
        var DashPos: Integer := Pos('-', DescStr[0]);
        if DashPos > 0 then
          TryStrToInt(Trim(Copy(DescStr[0], DashPos +1, Length(DescStr[0]) -DashPos)), DescRec.Channels);
      end;
      
      { '2/1' and '2' both mean 2 channels per brick }
      DescRec.ChansPerBrick := StrToInt(NumPrefix(Trim(DescStr[1])));
      DescRec.Ranges        := StrToInt(Trim(DescStr[2]));
      DescRec.Speed         := StrToInt(NumPrefix(Trim(DescStr[3])));
      DescRec.MinV          := StrToCurr(Trim(DescStr[4]));
      DescRec.DPS           := (Trim(DescStr[5]) = 'Y');
      DescRec.MaxV          := StrToCurr(Trim(DescStr[6]));
      DescRec.CPS           := (Trim(DescStr[7]) = 'Y');
      DescRec.CCurr         := StrToCurr(NumPrefix(Trim(DescStr[8])));
      DescRec.DCurr         := StrToCurr(NumPrefix(Trim(DescStr[9])));
    except
      on E: Exception do
        TUtils.HandleEvent(etAppException, format('ParseSystemDesc: %s'#13#10'%s'#13#10,
          [E.Message, E.StackTrace]));
    end;
  end;

  function AuxTypeExists(const Aux: PAuxAggregate; var Pos: Integer): Boolean;
  begin
    Pos := -1;
    Result := False;
    if High(Aggregates) < 0 then Exit;

    for var I: Integer:= 0 to High(Aggregates) do
    begin
      if (Aggregates[i].IdStr <> Aux^.IdStr) then continue;
      if (Aggregates[i].Range.Low <> Aux^.Range.Low) then continue;
      if (Aggregates[i].Range.High <> Aux^.Range.High) then continue;

      Pos := i;
      Exit(True);
    end;
  end;

  var Strings: TStrings;
begin
  MacSysPtr^.TesterId := Default(TTesterIdEx);

  { at least, do the known! }
  TUtils.UpdateShortString(MacSysPtr^.TesterId.MacTestVersion, MacSysPtr^.SW_Info.EXE_Ver);
  TUtils.UpdateShortString(MacSysPtr^.TesterId.MacTestDate, MacSysPtr^.SW_Info.EXE_Date);
  TUtils.UpdateShortString(MacSysPtr^.TesterId.DLLDate, MacSysPtr^.SW_Info.DLL_Date);

  if not FileExists(MacSysPtr^.SysIDFile) then
  begin
    MacSysPtr^.TesterId.Present := False;
    TUtils.HandleEvent(etMessage, 'Tester_Id.txt not found'#13#10, TUtils.RED);
    Exit;
  end;

  var Reader := TFileReader.Create(MacSysPtr^.SysIDFile);
  var Line: String := '';
  var Value: String := '';
  var SkipCounter: Integer := 0;
  var StrArr: TArray<String>;
  MacSysPtr^.TesterId.Present := True;

  try
    while Reader.ReadLine(Line) do
    begin
      if Trim(Line) = EmptyString then continue;

      { system information organization state-machine }
      case SkipCounter of
        0: { customer }
        begin
          if AnsiPos('Customer:', Line) <= 0 then continue;

          { parse customer name }
          GetToken(Line, Value);
          UnpackAnsiStr(AnsiString(Value), MacSysPtr^.TesterId.Customer);
          Inc(SkipCounter);
        end;

        1: { system-type, job-number, serial-number }
        begin
          if AnsiPos('System Type:', Line) <= 0 then continue;
          SplitStr(Line, #9, StrArr);

          for var i := Low(StrArr) to High(StrArr) do
          begin
            GetToken(StrArr[i], Value);

            case i of
              0: UnpackAnsiStr(AnsiString(Value), MacSysPtr^.TesterId.SystemType);
              1: UnpackAnsiStr(AnsiString(Value), MacSysPtr^.TesterId.JobNumber);
              2: UnpackAnsiStr(AnsiString(Value), MacSysPtr^.TesterId.SerialNumber);
            end;
          end;

          var Equ: TMaccorEquipmentType := GetEquipmentType(MacSysPtr^.SysId, MacSysPtr^.TesterId.SystemType);
          if Equ <> meUNSET then UnpackAnsiStr(EquipmentTypeToStr(Equ), MacSysPtr^.TesterId.EquipmentType);
          Inc(SkipCounter);
        end;

        2: { System Description }
        begin
          if AnsiPos('System Description:', Line) <= 0 then continue;
          var ExitCounter: Integer := 0;

          while Reader.ReadLine(Line) do
          begin
            if (Trim(Line) = EmptyString) then
            begin
              Inc(ExitCounter);
              if (ExitCounter >= 2) then break;
              Continue;
            end;

            if (AnsiPos('Ch#', Line) > 0) or (AnsiPos('Ch/Brk#', Line) > 0) or (AnsiPos('#ofRngs', Line) > 0) then continue;

            { pack system descs. }
            var Desc: TStrArray := SplitStr(Line, #9);
            { malformed entry... leave! }
            if Length(Desc) <> 10 then break;

            with MacSysPtr^.TesterId do
            begin
              ParseSystemDesc(Desc, Description[DescCount]);
              Inc(DescCount);
            end;
          end;

          Inc(SkipCounter);
        end;

        3: { auxiliary }
        begin
          if  (High(MacSysPtr^.AuxBrds) < 0) then
            break;

          if AnsiPos('Auxiliaries:', Line) <= 0 then continue;

          { derive the auxiliary configuration from the installed hardware }
          begin
            var AuxStr: String := '';

            { get aux config first... }
            for var Brd: AiBoardParam in MacSysPtr^.AuxBrds do
            begin
              for var Panel: PanelParam in Brd.Panel do
              begin
                case TMaccorAuxType(Panel.TypeX) of
                  maThermistor: AuxStr := 'Thermistor';
                  maThermocouple: AuxStr := 'Thermocouple';
                  maVoltage: AuxStr := 'Voltage';
                  maPressure: AuxStr := 'Pressure';
                  else continue;
                end;

                var InputCount: Integer := 0;
                var Min: Currency;
                var Max: Currency;
                var SIU: ShortString := EmptyString;

                for var Input: Integer := 0 to High(Panel.AddInput) do
                begin
                 Min := Panel.AddInput[Input].RGE.Low;
                 Max := Panel.AddInput[Input].RGE.High;
                 SIU := ShortString(Trim(TUtils.GetString(Panel.AddInput[Input].RGE.engUnit)));

                  if (Min <> Max) and (SIU <> EmptyString) then
                    Inc(InputCount);
                end;

                if InputCount > 0 then
                begin
                  var Aux: TAuxAggregate := Default(TAuxAggregate);

                  { pack it! }
                  with Aux do
                  begin
                    Id := TMaccorAuxType(Panel.TypeX);
                    Inputs := InputCount;
                    Range.High := Max;
                    Range.Low := Min;
                    Count := 1;
                    TUtils.UpdateShortString(@IdStr, Length(IdStr), AuxStr);
                    TUtils.UpdateShortString(@Range._Unit, Length(Range._Unit), String(SIU));
                  end;

                  { dump to existing record if we found one! }
                  var Index: Integer := 0;
                  if AuxTypeExists(@Aux, Index) then
                  begin
                    Inc(Aggregates[Index].Inputs, Aux.Inputs);
                    Inc(Aggregates[Index].Count);
                  end

                  { otherwise, make a unique one! }
                  else
                  begin
                    Index := Length(Aggregates);
                    SetLength(Aggregates, Index +1);
                    Aggregates[Index] := Aux;
                  end;
                end;
              end;
            end;

            { commit derived aggregates to the tester id record }
            MacSysPtr^.TesterId.AuxCount := 0;
            for var I: Integer := 0 to High(Aggregates) do
            begin
              if MacSysPtr^.TesterId.AuxCount > High(MacSysPtr^.TesterId.Auxiliary) then Break;
              MacSysPtr^.TesterId.Auxiliary[MacSysPtr^.TesterId.AuxCount] := Aggregates[I];
              Inc(MacSysPtr^.TesterId.AuxCount);
            end;
          end;

          break;
        end;
      end;
    end;
  finally
    FreeAndNil(Reader);
  end;
end;

procedure RunOnStartup(sProgTitle, sCmdLine : string; bRunOnce : boolean);
var
  sKey: string;
  Reg: TRegistry;
begin
  if bRunOnce then sKey := '\Software\Microsoft\Windows\CurrentVersion\RunOnce'
  else sKey := '\Software\Microsoft\Windows\CurrentVersion\Run';

  Reg := TRegistry.Create;
  try
    Reg.RootKey := HKEY_CURRENT_USER;
    if Reg.OpenKey(sKey, True) then
    begin
      if not Reg.ValueExists(sProgTitle) then
        Reg.WriteString(sProgTitle, sCmdLine);
    end;
  finally
    Reg.Free;
  end;
end;

procedure ResetApplication;
var
  ID: Cardinal;
  FullExe, Exe: String;
begin
  FullExe := ParamStr(0);
  Exe := ExtractFileName(FullExe);

  // find self!
  if ProcessExists(Exe, ID, 1) then
  begin
    // re-incarnate!
    RunAsAdmin(FullExe);
    // suicide!
    KillProcessById(ID);
  end;

  Application.ProcessMessages;
end;

procedure SetAlwaysOnTop(AForm: TForm; Enable: Boolean);
const
  HWND_TOPMOST = 0;
  HWND_NOTOPMOST = 0;
begin
  if Enable then
    SetWindowPos(AForm.Handle, HWND_TOPMOST,
      0, 0, 0, 0,
      SWP_NOMOVE or SWP_NOSIZE)
  else
    SetWindowPos(AForm.Handle, HWND_NOTOPMOST,
      0, 0, 0, 0,
      SWP_NOMOVE or SWP_NOSIZE);
end;

