function FastCRC16(const Buffer: Pointer; const Size : Integer): Word;
var
  i: Integer;
  DataPtr: PByte;
begin
  Result := $FFFF;
  { bounds checking... }
  if (Buffer = nil) or (Size <= 0) then Exit;

  { pointer to data as byte pointer}
  DataPtr := Buffer;

  { roll through the bytes }
  for i := 0 to Size -1 do
    Result := Word((Result shl 8) xor CRC16Table[Byte(Result shr 8) xor DataPtr^]);
end;

{
  variables and constant names are treated as constants
  dereference them using [] square-brackets

  ex. copy the address of var X into EDX
  MOV EDX, [Sqr]
}

function SquareASM(const X: Integer): Integer;
asm
  MOV EAX, X;
  IMUL X
end;

procedure SquareASM(const X: Integer; var Sqr: Integer);
asm
{$ifdef CPUX86}
  MOV   EAX, [X]     { move X into EAX }
  IMUL  EAX, EAX     { multiply it by itself }
  MOV   EDX, [Sqr]   { move the addr of Sqr into EDX }
  MOV   [EDX], EAX   { move value (result) in EAX into location pointed by Sqr }
{$else}
  MOV   RAX, [X]
  IMUL  RAX, RAX
  MOV   [Sqr], RAX
{$endif}
end;

procedure AddASM(const X, Y: Single; var Sum: Single);
asm
{$ifdef CPUX86}
  MOVSS XMM0, [X]    { move the value of X into XMM0 }
  MOVSS XMM1, [Y]    { move the value of Y into XMM1 }
  ADDSS XMM0, XMM1   { add the values in XMM0 and XMM1, store the result in XMM0 }
  MOVSS [Sum], XMM0  { move the result from XMM0 into Sum }
{$else}
  MOVSS XMM0, [X]
  MOVSS XMM1, [Y]
  ADDSS XMM0, XMM1
  MOVSS [Sum], XMM0
{$endif}
end;

{
  this function simply returns 10

  when 32bits use EAX register
  when returning 64bit values use RAX register
}
function Nothing: Integer;
asm
{$ifdef CPUX86}
  MOV EAX, 10
  MOV [Result], EAX    { this line is redundant! its implicit after end }
{$else}
  MOV RAX, 10
{$endif}
end;

function GetFileVersionString(const FileName: string): String;
var
  InfoSize, Wnd: DWORD;
  VerBuf: Pointer;
  VerValue: PVSFixedFileInfo;
  Len: UINT;
begin
  Result := '';
  InfoSize := GetFileVersionInfoSize(PChar(FileName), Wnd);
  if InfoSize = 0 then Exit;

  GetMem(VerBuf, InfoSize);
  try
    if GetFileVersionInfo(PChar(FileName), Wnd, InfoSize, VerBuf) then
      if VerQueryValue(VerBuf, '\', Pointer(VerValue), Len) then
        Result := Format('%d.%d.%d.%d',
          [HiWord(VerValue^.dwFileVersionMS),
            LoWord(VerValue^.dwFileVersionMS),
              HiWord(VerValue^.dwFileVersionLS),
                LoWord(VerValue^.dwFileVersionLS)]);
  finally
    FreeMem(VerBuf);
  end;
end;

procedure ChangeDirectory(var Path: String; const Dir: String);
var
  P: Integer;
begin
  if Dir = '' then Exit;

  { is the directory even possible? }
  P := AnsiPos(Dir, Path);
  if P <= 0 then Exit;

  Path := ExcludeTrailingPathDelimiter(Copy(Path, 1, P +Length(Dir)));
end;

function IntToTime(const T: UInt64; TimeUnit: TTimeUnit = tMicros): TTimeValEx;
var
  RemainSecs: UInt64;
  TotalMillis: UInt64;
begin
  ZeroMemory(@Result, SizeOf(TTimeValEx));
  if T = 0 then Exit;

  case TimeUnit of
    tAttos:   TotalMillis := T div UInt64(Round(1.0E15));
    tFemtos:  TotalMillis := T div UInt64(Round(1.0E12));
    tPicos:   TotalMillis := T div UInt64(Round(1.0E9));
    tNanos:   TotalMillis := T div UInt64(Round(1.0E6));
    tMicros:  TotalMillis := UInt64(Round(T  /1000));
    tMillis:  TotalMillis := T;
    tSecs:    TotalMillis := T *1000;
    else      Exit;
  end;

  { do the math }
  RemainSecs := TotalMillis div 1000;
  Result.Millis := TotalMillis mod 1000;
  Result.Mins := RemainSecs div 60;
  Result.Secs := RemainSecs mod 60;
  DivMod(Result.Mins, 60, Result.Hours, Result.Mins);
  DivMod(Result.Hours, 24, Result.Days, Result.Hours);
  Result.Secs := Result.Secs +Round(Result.Millis /1000);
end;

procedure GetProcessID(const Name: String; var PID: Cardinal);
var
  SnapshotHandle: THandle;
  ProcessEntry: TProcessEntry32;
begin
  PID := 0;
  SnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);

  if SnapshotHandle <> INVALID_HANDLE_VALUE then
  begin
    ProcessEntry.dwSize := SizeOf(ProcessEntry);
    if Process32First(SnapshotHandle, ProcessEntry) then
    begin
      repeat
        if CompareText(ProcessEntry.szExeFile, Name) = 0 then
        begin
          PID := ProcessEntry.th32ProcessID;
          Break;
        end;
      until not Process32Next(SnapshotHandle, ProcessEntry);
    end;
    CloseHandle(SnapshotHandle);
  end;
end;

function EnumWindowsProc(hWnd: HWND; lParam: LPARAM): BOOL;
var
  WinPID: DWORD;
  Data: PFindWindowData;
begin
  Data := PFindWindowData(lParam);
  GetWindowThreadProcessId(hWnd, WinPID);

  if (WinPID = Data^.PID) and
     IsWindowVisible(hWnd) and
     (GetWindow(hWnd, GW_OWNER) = 0) then
  begin
    Data^.hWnd := hWnd;
    Exit(False);
  end;

  Result := True;
end;

function GetFormHandle(const ProcessHandle: Cardinal; var FormHandle: HWND): Boolean;
var
  Data: TFindWindowData;
begin
  Result := False;
  if ProcessHandle = 0 then Exit;
  FormHandle := 0;

  try
    Data.PID := Windows.GetProcessId(ProcessHandle);
    if Data.PID = 0 then Exit;

    Data.hWnd := 0;
    EnumWindows(@EnumWindowsProc, LPARAM(@Data));
    FormHandle := Data.hWnd;
  finally
    Result := (FormHandle <> 0);
  end;
end;

function FormIsVisible(const Handle: HWND): Boolean;
begin
  if Handle = 0 then Exit(False);
  Result := IsWindowVisible(Handle) and (not IsIconic(Handle));
end;

procedure GetProcessIDByModule(const Name: String; var PID: Cardinal);
var
  SnapshotHandle: THandle;
  ProcessEntry: TProcessEntry32;
  ModuleEntry: TModuleEntry32;
begin
  PID := INVALID_DLL_HANDLE;
  SnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  if SnapshotHandle <> INVALID_HANDLE_VALUE then
  begin
    ProcessEntry.dwSize := SizeOf(ProcessEntry);
    if Process32First(SnapshotHandle, ProcessEntry) then
    begin
      repeat
        ModuleEntry.dwSize := SizeOf(ModuleEntry);
        if Module32First(SnapshotHandle, ModuleEntry) then
        begin
          repeat
            if CompareText(ExtractFileName(ModuleEntry.szExePath), Name) = 0 then
            begin
              PID := ProcessEntry.th32ProcessID;
              Break;
            end;
          until not Module32Next(SnapshotHandle, ModuleEntry);
        end;
      until (PID <> 0) or (not Process32Next(SnapshotHandle, ProcessEntry));
    end;
    CloseHandle(SnapshotHandle);
  end;
end;

procedure PurgeDanglingDLLHandles(const Name: String; Handles: TArray<HMODULE> = nil);
var
  PID, Count, I: Cardinal;
  cbNeeded: DWORD;
  Modules: Array [0..1023] of HMODULE;
begin
  { first, get the handle }
  GetProcessIDByModule(Name, PID);

  if PID <> INVALID_DLL_HANDLE then
  begin
    if EnumProcessModules(PID, @Modules, SizeOf(Modules), cbNeeded) then
    begin
      Count := cbNeeded div SizeOf(HMODULE);

      if (Count <> 0) and (handles <> nil) then
        SetLength(Handles, Count);

      for i := 0 to Count -1 do
      begin
        { well, we've come this far! purge it! }
        try FreeLibrary(Modules[i]); except On E: Exception do; end;
        if Handles = nil then continue;
        Handles[i] := Modules[i];
      end;
    end;
  end;
end;

procedure KillProcessByID(var id : DWORD);
var
  hProcess : THandle;
begin
  if Id = 0 then Exit;

  hProcess := OpenProcess(PROCESS_TERMINATE, False, id);

  if hProcess > 0 then
  begin
    if Win32Check(TerminateProcess(hProcess, 0)) then
      if CloseHandle(hProcess) then
      begin
        id := 0;
        AvoidBusywait(QTR_SEC);
      end;
  end;
end;

function TerminateProcessEx(const ProcessName: String): Boolean;
var
  ID: Cardinal;
begin
  Result := False;
  GetProcessID(Processname, ID);
  KillProcessByID(ID);
  Result := (ID <> 0);
end;

procedure ReleaseDeadHandles(const Name: String);
