  N1, N2 : Byte;

  function LNibble(const n : Byte): String;
  begin
    case N of
      0 : if N1 = 0 then Result := 'Zero';
      1 : Result := ' One';
      2 : Result := ' Two';
      3 : Result := ' Three';
      4 : Result := ' Four';
      5 : Result := ' Five';
      6 : Result := ' Six';
      7 : Result := ' Seven';
      8 : Result := ' Eight';
      9 : Result := ' Nine';
    end;
  end;
begin
  Result := '0 - 99 only!';
  if i > 99 then Exit;


  N1 := (i div 10);
  N2 := (i mod 10);

  case N1 of
    0: Result := LNibble(N2);
    1:
    case N2 of
      0: Result := 'Ten';
      1: Result := 'Eleven';
      2: Result := 'Twelve';
      3: Result := 'Thirteen';
