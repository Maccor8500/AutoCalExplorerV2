begin
  FltVal := RoundTo(AsFloat, -(Round));
  Result := FormatFloat('0.################', FltVal);
end;

function TBufferEx.AsInteger: Int64;
var
  S: String;
  Flt: Extended;
begin
  Result := 0;
  S := AsString;
  if TryStrToInt64(S, Result) then Exit;
  { instrument replies are often scientific notation <'+1.00000000E+01'> :: round the float }
  if TryStrToFloat(S, Flt, TFormatSettings.Invariant) then
    Result := Round(Flt);
end;

function TBufferEx.AsFloat: Single;
var
  FltVal: Single;
begin
  Result := 0;
  if TryStrToFloat(AsString, FltVal) then
    Result := FltVal;
end;

