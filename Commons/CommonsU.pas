{TWaitForResponse}
constructor TWaitForResponse.Create(Target: PBoolean; const Timeout: Single; CheckState: Boolean);
var
  Triggered: Boolean;
begin
  if CheckState then Initial := Target^;
  Start := GetTickCountEx;
  Fluffer := Start +FLUFFTMR;
  Finish:= GetTickCountEx(UInt64(Round(Timeout *ONE_SEC)));

  repeat
    TNow := GetTickCountEx;
    if (TNow >= Fluffer)then
    begin
      ProcessMsgs;
      Fluffer := TNow +FLUFFTMR;
    end;

    if CheckState then  Triggered := (Initial <> Target^)
    else Triggered := Target^;
  until Triggered or (TNow >= Finish);
  Duration := (TNow -Start);
end;

destructor TWaitForResponse.Destroy;
begin
  inherited;
end;

function TAwaitResponseEx.WaitFor(Target: PBoolean; const Timeout: Single; CheckState: Boolean): UInt64;
begin
  Wait := TWaitForResponse.Create(Target, Timeout, CheckState);
  try
    Result := Wait.Duration;
  finally
    FreeAndNil(Wait);
  end
end;

