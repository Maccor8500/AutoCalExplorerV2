{$ifdef DEBUG}
//  {$define SINGLE_SYSTEM_NG}
  {$define SINGLE_SYS_LEGACY}
{$endif}
procedure GetMaccorEnv(var MacEnv : TMaccorSystem);
var
  cfgfile : String;
  Drives : TStrings;
  Ini : TMemIniFile;
  Strings : TStrings;
  S : String;
  FS : TFileStream;
  I, Chan, X: Integer;
  NG: Boolean;
begin
  RawSocketData.DllPath := '';
  RawSocketData.Adapter := '';

  OutputDebugString(PWideChar('[Calibration] :: Loading system configurations'));
  if not DirectoryExists(MacEnv.SysPath) then
    Fill(@MacEnv, 0, SizeOf(MacEnv));
  NG := False;
  { give me a pointer to this whole thing! }
  MacSysPtr := @MacSys;

  { seek out whats configured locally }
  GetLocalPaths(@MacEnv.LocalPaths);

  { locate BatTest.cfg: system drive first, then fixed drive roots only, so a
    mapped or removable drive never stalls startup. Not found: stays on the
    system drive, where a new setup then writes it }
  cfgfile := GetEnvironmentVariable('SystemDrive') +'\BatTest.cfg';
  if not FileExists(cfgfile) then
  begin
    Drives := TStringList.Create;
    try
      GetLogicalDrives(Drives);
      for I := 0 to Drives.Count -1 do
        if (GetDriveType(PChar(Drives[I])) = DRIVE_FIXED)
          and FileExists(Drives[I] +'BatTest.cfg') then
        begin
          cfgfile := Drives[I] +'BatTest.cfg';
          Break;
        end;
    finally
      Drives.Free;
    end;
  end;
  MacEnv.BatTest := cfgfile;

  { check if next-gen is present C:\Users\jolaoye\AppData\Local\Maccor }
  if DirectoryExists(MacEnv.LocalPaths.MaccorCfgBase) and
    DirectoryExists(MacEnv.LocalPaths.MaccorAppBase) then
  begin
    NG := True;

    { next gen configurations }
    Include(MacEnv.Config, mscNextGen);
    GetMaccorEnvEx(MacEnv);
    {$ifdef SINGLE_SYSTEM_NG}
      OutputDebugString(PWideChar('[Calibration] :: Loading system [1]:: Exit!'));
      Exit;
    {$endif}
  end;

  { Legacy environment }
  if not FileExists(cfgfile) then
  begin
    if not NG then { just leave, this is no error! }
      MacEnv.Error := format('%s %s', [cfgfile, 'not found.']);
      OutputDebugString(PWideChar('[Calibration] :: Loading system [2]:: Exit!'));
    Exit;
  end;

  OutputDebugString(PWideChar('[Calibration] :: Loading system [100]'));
  if not DirectoryExists(MacEnv.SysPath) then
  begin
    Strings := TStringList.Create;
    try
      Strings.LoadFromFile(cfgfile);
      if Strings.Count < 2 then
      begin
        MacEnv.Error := format('%s %s', [cfgfile, 'currupted.']);
        Exit;  {finally still executes}
      end;

      MacEnv.Base := UnQuoteStr(Strings[0]);
      MacEnv.SysName := UnQuoteStr(Strings[1]);
    finally
      FreeAndNil(Strings);
    end;
  end
  else
    MacEnv.SysName := ExtractFilename(MacEnv.SysPath);

  { other systems present? }
  GetAllSysPaths(MacSys);

  if not DirectoryExists(MacEnv.Base) then
  begin
    MacEnv.Error := format('%s. %s', [MacEnv.Base, 'Dir does not exist.']);
    OutputDebugString(PWideChar('[Calibration] :: Loading system [3]:: Exit!'));
    Exit;
  end;

  {$ifdef SINGLE_SYS_LEGACY} Exclude(MacEnv.Config, mscNextGen); {$endif}
  Include(MacEnv.Config, mscLegacy);
  OutputDebugString(PWideChar('[Calibration] :: Loading system [101]'));

  MacEnv.DLLPath := format('%s\%s', [MacEnv.Base, 'MacTest32.dll']);
  MacEnv.EXEPath := format('%s\%s', [MacEnv.Base, 'MacTest32.exe']);
  MacEnv.ProcPath := format('%s\%s', [MacEnv.Base, 'Procedur']);
  MacEnv.FRAPath := format('%s\%s', [MacEnv.Base, 'FRA']);
  MacEnv.CANPath := format('%s\%s', [MacEnv.Base, 'CAN']);
  MacEnv.CANCfgPath := format('%s\%s', [MacEnv.CANPath, '.config\']);
  MacEnv.WFormPath := format('%s\%s', [MacEnv.Base, 'Waveforms']);

  S := format('%s\%s', [MacEnv.Base, 'System']);
  if not DirectoryExists(S) then
  begin
    MacEnv.Error := format('%s. %s', [S, 'Dir does not exist.']);
    OutputDebugString(PWideChar('[Calibration] :: Loading system [4]:: Exit!'));
    Exit;
  end;
  OutputDebugString(PWideChar('[Calibration] :: Loading system [102]'));

  S := format('%s\%s', [S, MacEnv.SysName]);
  if not DirectoryExists(S) then
  begin
    MacEnv.Error := format('%s. %s', [S, 'Dir does not exist.']);
    OutputDebugString(PWideChar('[Calibration] :: Loading system [5]:: Exit!'));
    Exit;
  end;

  OutputDebugString(PWideChar('[Calibration] :: Loading system [103]'));
  if DirectoryExists(MacEnv.CANCfgPath) then HideDirectory(MacEnv.CANCfgPath)
  else ForceDirectories(MacEnv.CANCfgPath);

  MacEnv.SysPath := S;
  MacEnv.SysIni := format('%s\%s', [MacEnv.SysPath, 'System.ini']);
  MacEnv.SysIniRaw := format('%s\%s', [MacEnv.SysPath, 'Settings.dat']);
  MacEnv.SysIDFile := format('%s\%s', [MacEnv.SysPath, 'Tester_ID.txt']);
  MacEnv.FuncPath := format('%s\%s', [MacEnv.SysPath, 'MacUserFunctions']);
  MacEnv.ActivePath := format('%s\%s', [MacEnv.SysPath, 'Active']);
  MacEnv.ArchivePath := format('%s\%s', [MacEnv.SysPath, 'Archive']);
  MacEnv.ChCfgFile := format('%s\%s', [MacEnv.SysPath, 'chData.cfg']);
  MacEnv.ExtCfgFile := format('%s\%s', [MacEnv.SysPath, 'Ext.cfg']);
  MacEnv.BrdCfgFile := format('%s\%s', [MacEnv.SysPath, 'Brd.cfg']);
  MacEnv.BrdCfgFileNew := format('%s\%s', [MacEnv.SysPath, 'ToolboxBrd.cfg']);
  MacEnv.CmbCfgFile := format('%s\%s', [MacEnv.SysPath, 'CombCh.cfg']);
  MacEnv.Init0DatFile := format('%s\%s', [MacEnv.SysPath, 'Initialize0.dat']);
  MacEnv.PosCfgFile := format('%s\%s', [MacEnv.SysPath, 'Position.dat']);
  MacEnv.PosExtFile := format('%s\%s', [MacEnv.SysPath, 'PositionEXT.dat']);
  MacEnv.PosHWFile := format('%s\%s', [MacEnv.SysPath, 'PositionHW.dat']);
  MacEnv.SysCfgFile := format('%s\%s', [MacEnv.SysPath, 'System.cfg']);
  MacEnv.BinFtrCfgFile := format('%s\%s', [MacEnv.SysPath, 'BinFooters.dat']);
  MacEnv.AiDataFile := format('%s\%s', [MacEnv.SysPath, 'AiData.cfg']);
  { this represents a shadow configuration of all Thermistor boards! not just RTD anymore! }
  MacEnv.ThermistorCfgFile := format('%s\%s', [MacEnv.SysPath, 'RTDThermistor.cfg']);
  MacEnv.AiExtThermFile := format('%s\%s', [MacEnv.SysPath, 'AIextTherm.cfg']);
  MacEnv.AuxVerCfgFile := format('%s\%s', [MacEnv.SysPath, 'VerifyAux.cfg']);
  MacEnv.SMBCfgFile := format('%s\%s', [MacEnv.SysPath, 'SMB4BoardAddresses.cfg']);
  MacEnv.AuxLogFile := format('%s\%s', [MacEnv.SysPath, 'Auxiliary Verify Log.txt']);
  MacEnv.DebugFile := format('%s\%s', [MacEnv.SysPath, 'Debug.ini']);
  MacEnv.CellBalFile := format('%s\%s', [MacEnv.SysPath, 'CellBalance.ini']);
  MacEnv.VoltVerLog := format('%s\%s', [MacEnv.SysPath, 'Voltage Verify Log.txt']);
  MacEnv.CurrVerLog := format('%s\%s', [MacEnv.SysPath, 'Current Verify Log.txt']);

  OutputDebugString(PWideChar('[Calibration] :: Loading system [104]'));
  { all still good? get system type, and perhaps later other things }
  if FileExists(MacEnv.SysIni) then
  begin
    Ini := TMemIniFile.Create(MacEnv.SysIni);

    with Ini do
    begin
      try
        S := 'System_Settings';
        MacEnv.SysCfg.SysType := ReadInteger(S, 'SystemType', 0);
        MacEnv.SysId := TMaccorSystemIdentity(MacEnv.SysCfg.SysType);
        MacEnv.SysCfg.SysTypeEnum := TMaccorSystemType(MacSys.SysCfg.SysType);
        MacEnv.SysCfg.LanAdapterName := ReadString(S, 'Net_Adapter_Name', '');
        MacEnv.SysCfg.LanAdapterAlias :=
          format('\Device\NPF_%s', [Copy(MacSysPtr^.SysCfg.LanAdapterName, Pos('{', MacSysPtr^.SysCfg.LanAdapterName), Length(MacSysPtr^.SysCfg.LanAdapterName))]);
        MacEnv.SysCfg.CellBalBrds := ReadInteger(S, 'CellBalanceBoards', 0);

        { sort chamber types : path }
        MacEnv.EVType := ReadInteger(S, 'Environmental_Chamber', 0);
        if MacEnv.EVType <> 0 then
        begin
          MacEnv.EVCfgFile := format('%s\%s', [MacEnv.SysPath,
            format('EVType%d.ini', [MacEnv.EVType])]);
        end;

        S := 'Hardware_Configuration';
        MacEnv.SysCfg.ChanCount := ReadInteger(S, 'Max_Channels', 0);
        MacEnv.MaxChan := MacEnv.SysCfg.ChanCount -1;
        X := TUtils.GetLength(MacEnv.SysCfg.ChanCount);
        MacEnv.ChanStrFmt := format('%%.%dd', [IntTernary((X < 2), 2, X)]);
        //MacEnv.Channels := [0..Max(MacEnv.MaxChan, 8)];
        MacEnv.SysCfg.CtlrBrds := ReadInteger(S, 'Channel_Controller_Boards', 1);
        MacEnv.SysCfg.AuxBrds := ReadInteger(S, 'Auxiliary_Input_Boards', 0);

        if MacEnv.SysCfg.SysType = 7 then
        begin
          { read config or set defaults if not found! }
          MacEnv.SysCfg.CtlrBrds8500 := ReadInteger(S, '8500_Processor_Boards', 1);
          MacEnv.SysCfg.ChanBrds8500 := ReadInteger(S, 'Max_Channels', 1);
          MacEnv.SysCfg.AuxBrds8500 := ReadInteger(S, '8500_Aux_Boards', 1);
          MacEnv.SysCfg.MultiSys := ReadBool(S, '8500_MultiSystem', False);
          MacEnv.SysCfg.FirstCtlrAddr := ReadString(S, '8500_Processor_Board_Address', '192.168.127.40');
          MacEnv.SysCfg.FirstAuxAddr := ReadString(S, '8500_Aux_Board_Address', '192.168.127.80');
          MacEnv.SysCfg.UploadPorts.CtlrBrk8500 := ReadInteger(S, '8500_Processor_Board_Port', 16389);
          MacEnv.SysCfg.UploadPorts.Aux8500 := ReadInteger(S, '8500_Aux_Board_Port', 16387);
          MacEnv.SysCfg.BuckBoostStyle := ReadInteger(S, '8500_BuckBoost_Style', 0);
          MacEnv.SysCfg.FirstBuckBoostAddr := ReadString(S, '8500_BuckBoost_Address', '192.168.127.60');

          { Write defaults }
          WriteInteger(S, '8500_Processor_Boards', MacEnv.SysCfg.CtlrBrds8500);
          WriteInteger(S, 'Max_Channels', MacEnv.SysCfg.ChanBrds8500);
          WriteInteger(S, '8500_Aux_Boards', MacEnv.SysCfg.AuxBrds8500);
          WriteBool(S, '8500_MultiSystem', MacEnv.SysCfg.MultiSys);
          WriteString(S, '8500_Processor_Board_Address', MacEnv.SysCfg.FirstCtlrAddr);
          WriteString(S, '8500_Aux_Board_Address', MacEnv.SysCfg.FirstAuxAddr);
          WriteInteger(S, '8500_Processor_Board_Port', MacEnv.SysCfg.UploadPorts.CtlrBrk8500);
          WriteInteger(S, '8500_Aux_Board_Port', MacEnv.SysCfg.UploadPorts.Aux8500);
          WriteInteger(S, '8500_BuckBoost_Style', MacEnv.SysCfg.BuckBoostStyle);
          WriteString(S, '8500_BuckBoost_Address', MacEnv.SysCfg.FirstBuckBoostAddr);
        end;

        { SMB 2,3,4 }
        MacEnv.SysCfg.SMBBrds := ReadInteger(S, 'SMB2_Boards', 0);
        if MacEnv.SysCfg.SMBBrds <> 0 then MacEnv.SysCfg.SMBType := tSMBType2
        else
        begin
          MacEnv.SysCfg.SMBBrds := ReadInteger(S, 'SMB3_Boards', 0);
          if MacEnv.SysCfg.SMBBrds <> 0 then MacEnv.SysCfg.SMBType := tSMBType3
          else
          begin
            MacEnv.SysCfg.SMBBrds := ReadInteger(S, 'SMB4_Boards', 0);
            if MacEnv.SysCfg.SMBBrds <> 0 then MacEnv.SysCfg.SMBType := tSMBType4;
          end;

          MacEnv.SysCfg.SMB4Port := ReadInteger('SMB4', 'ListenPortSMB4', 57521);
        end;

        { CAN }
        MacEnv.SysCfg.CANBrds := ReadInteger('CAN', 'Channels', 0);
        SetLength(MacEnv.CANBrds, MacEnv.SysCfg.CANBrds);
        for i := 1 to MacEnv.SysCfg.CANBrds do
        begin
          S := FormatFloat('CAN_000', i);
          MacEnv.CANBrds[i -1].Id := ReadInteger(S, 'Type', 0);
          MacEnv.CANBrds[i -1].Addr := ShortString(ReadString(S, 'IP', '192.168.127.0'));
          MacEnv.CANBrds[i -1].Baud := ReadInteger(S, 'CAN_Baud_Rate_K', 500);
          { legacy files carry one system-wide [CAN] Port }
          MacEnv.CANBrds[i -1].Port := ReadInteger(S, 'Port',
            ReadInteger('CAN', 'Port', IfThen(MacEnv.CANBrds[i -1].Id = 3, MACCOR_GREY_CAN_PORT, MACCOR_CAN_PORT)));
        end;

        { macnet }
        MacEnv.MacNet.Enabled := ReadBool('MacNet', 'Enabled', False);
        MacEnv.MacNet.MaxAllowed := ReadInteger('MacNet', 'MaxClients', 5);
        MacEnv.MacNet.Port := ReadInteger('MacNet', 'Port', 57575);

        { macnet- defaults }
        WriteBool('MacNet', 'Enabled', MacEnv.MacNet.Enabled);
        WriteInteger('MacNet', 'MaxClients', MacEnv.MacNet.MaxAllowed);
        WriteInteger('MacNet', 'Port', MacEnv.MacNet.Port);

        MacEnv.SysCfg.TxInterval := ReadInteger('Misc_Options', 'FirmwareDownloadInterval_ms', 40);

        { flush to file }
        UpdateFile;
      finally
        Free;
      end;
    end;
  end;

  OutputDebugString(PWideChar('[Calibration] :: Loading system [105]'));

  { load channel config. }
  GetSysChanConfig(@MacEnv);
  GetExtChanConfig(@MacEnv);
  GetBrdConfig(@MacEnv);
  GetPositionData(@MacEnv);
  GetPositionDataHW(@MacEnv);
  GetAuxConfigurations(@MacEnv);
  GetSMBSettings(@MacEnv);
  PackSystemChannelSpecs;
  LoadCellBalance;

  OutputDebugString(PWideChar('[Calibration] :: Loading system [106]'));

  { Balancers.ini }
  S := format('%s\%s', [MacEnv.SysPath, 'CellBalance.ini']);
  if FileExists(S) then MacEnv.BalancerIni := S;

  { Bin Files: CtrlHub_Aux }
  S := format('%s\%s', [MacEnv.Base, '8500_Aux.bin']);
  if FileExists(S) then MacEnv.Bin.Aux8500 := S;

  S := format('%s\%s', [MacEnv.Base, '8500_CONTROLLER.bin']);
  if FileExists(S) then MacEnv.Bin.Ctl8500 := S;

  S := format('%s\%s', [MacEnv.Base, '8500_BRICK.bin']);
  if FileExists(S) then MacEnv.Bin.Brk8500 := S;

  S := format('%s\%s', [MacEnv.Base, '8500_MINIBRICK.bin']);
  if FileExists(S) then MacEnv.Bin.Mini_Brick_8500 := S;

  S := format('%s\%s', [MacEnv.Base, '8500_MINIAUX.bin']);
  if FileExists(S) then MacEnv.Bin.Mini_Aux_8500 := S;

  S := format('%s\%s', [MacEnv.Base, '8500_PIC.bin']);
  if FileExists(S) then MacEnv.Bin.Pic8500 := S;

// 6500 Ctlr & Brick addition
  S := format('%s\%s', [MacEnv.Base, '6500_CONTROLLER.bin']);
  if FileExists(S) then MacEnv.Bin.Ctl6500 := S;

  S := format('%s\%s', [MacEnv.Base, '6500_BRICK.bin']);
  if FileExists(S) then MacEnv.Bin.Brk6500 := S;

  S := format('%s\%s', [MacEnv.Base, 'MaccorCAN2x1.bin']);
  if FileExists(S) then MacEnv.Bin.CAN2x1 := S;

  MacEnv.TempPath := format('%s\TemporaryFolder', [MacEnv.SysPath]);
  OutputDebugString(PWideChar('[Calibration] :: Loading system [107]'));

  // keep a copy of this file
  if FileExists(MacEnv.SysIni) then
  begin
    FS := TFileStream.Create(MacEnv.SysIni, fmOpenRead +fmShareDenyNone);
    try
      SetLength(MacEnv.IniData, FS.Size);
      FS.Read(MacEnv.IniData, FS.Size);
      MacEnv.IniDates := GetFileDates(MacEnv.SysIni);
    finally
      FS.Free;
    end;
  end;
  OutputDebugString(PWideChar('[Calibration] :: Loading system [108] :: START-CASE'));

  try
    case MacSysPtr^.SysId of
      tFormation, tUnTyped:
      begin
        SetLength(MacEnv.ChanXRef, MacEnv.SysCfg.CtlrBrds *256);
        TUtils.FillArray<Word>(MacEnv.ChanXRef, 10000);
        for Chan := 0 to High(MacEnv.ChanXRef) do
        begin
          if Chan > High(MacEnv.ExtData) then break;
          X := (MacEnv.ExtData[Chan].BrdNr *256) +MacEnv.ExtData[Chan].BrdPos;
          if (X > High(MacEnv.ExtData)) then break;
          MacEnv.ChanXRef[X] := Chan;
        end;

        OutputDebugString(PWideChar('[Calibration] :: Loading system [109] :: 1,2'));
      end;

      t50msPrimaryHV:
      begin
        SetLength(MacEnv.ChanXRef, MacEnv.SysCfg.CtlrBrds *32);
        TUtils.FillArray<Word>(MacEnv.ChanXRef, 10000);
        for Chan := 0 to High(MacEnv.ChanXRef) do
        begin
          if Chan > High(MacEnv.ExtData) then break;
          X := (MacEnv.ExtData[Chan].BrdNr *32) +MacEnv.ExtData[Chan].BrdPos;
          if (X > High(MacEnv.ExtData)) then break;
          MacEnv.ChanXRef[X] := Chan;
        end;

        OutputDebugString(PWideChar('[Calibration] :: Loading system [110] :: 3'));
      end;

      else
      begin
        SetLength(MacEnv.ChanXRef, MacEnv.SysCfg.CtlrBrds *8);
        TUtils.FillArray<Word>(MacEnv.ChanXRef, 10000);
        for Chan := 0 to High(MacEnv.ChanXRef) do
        begin
          if Chan > High(MacEnv.ExtData) then break;
          X := (MacEnv.ExtData[Chan].BrdNr *8) +MacEnv.ExtData[Chan].BrdPos;
          if (X > High(MacEnv.ExtData)) then break;
          if X > High(MacEnv.ChanXRef) then Exit;
          MacEnv.ChanXRef[X] := Chan;
        end;

        OutputDebugString(PWideChar('[Calibration] :: Loading system [111] :: END-CASE'));
      end;
    end;
  except
  end;

  // extract MacTest32 (exe, dll) info
  GetEXE_DLL_Info(MacEnv);
  MacSysPtr^.LoadTesterIdFile;
  OutputDebugString(PWideChar('[Calibration] :: Loading system [112]'));

  { DECL.pas Line #2655 }
  with MacSys.Bin.Dates do
  begin
    V5_cntl1 := EncodeDate(2018, 2, 19);
    V5_cntl8 := EncodeDate(2023, 8, 28);
    V5_cntl8_NICE32 := EncodeDate(2022, 4, 26);
    V5_cn256 := EncodeDate(2015, 9, 12);
    V5_ctl32 := EncodeDate(2018, 2, 19);
    V5_8500M := EncodeDate(2013, 5, 21);
    V5_AI := EncodeDate(2016, 9, 20);
    V5_smb := EncodeDate(2015, 9, 12);
    V5_servr := EncodeDate(2016, 8, 16);
  end;

  OutputDebugString(PWideChar('[Calibration] :: Loading system Complete'));
end;

