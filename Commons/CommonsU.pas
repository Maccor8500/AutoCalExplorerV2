class function TUtils.GetWindowsVersion: TWindowsVersion;
var
  Major, Minor, Build: DWORD;
begin
  Result := wvUnknown;

  { Get Windows version info }
  Major := Win32MajorVersion;
  Minor := Win32MinorVersion;
  Build := Win32BuildNumber;

  {
    Windows 10 = Version 10.0, Build < 22000
    Windows 11 = Version 10.0, Build >= 22000
  }
  if (Major = 10) and (Minor = 0) then
  begin
    if Build >= 22000 then Result := wvWin11
    else Result := wvWin10;
  end
  else if Major < 10 then Result := wvOlder;

  WindowsVersion := Result;
end;

