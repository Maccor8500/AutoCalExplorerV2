{
  no race conditions to be feared here, since can-write is always called with
  client's proprietary data set and no shared-resources are involved!
  rest-easy!
}

function TTCPServerEx.CanWrite(const Socket: TSocket; const Timeout{ms}: SmallInt) : Boolean;
var
  T : TimeVal;
  FDSet : TFDSet;
begin
  Result := False;
  if (Socket = INVALID_SOCKET) then Exit;

  WinSock2.FD_ZERO(FDSet);
  WinSock2._FD_SET(Socket, FDSet);

  T.tv_sec := 0;
  T.tv_usec:= Timeout *1000;

  try
    { check read }
    Result := (WinSock2.select(Socket +1, nil, @FDSet, nil, @T) > 0);
  except
    On E: Exception do
      if Assigned(OnErrorEvent) then
      begin
        BuildSocketError(@E);
        OnErrorEvent(@Error);
      end;
  end;
end;

procedure TTCPServerEx.ClientTask(const DataTask : TClientTaskHandle);
begin
  Task := DataTask;
end;

{
  server accepts clients here!
  proceeds to hand individual connected clients their own processes in a
  higher level threading-class::ttask::itask
}

procedure TTCPServerEx.Execute;
var
  ClientSocket : TSocket;
  ClientAddr : sockaddr_in;
  AddrSize : Integer;
begin
  inherited;

  if ServerSocket <> INVALID_SOCKET then
  begin
    repeat
      try
        { accept client-connections here! }
        AddrSize := SizeOf(ClientAddr);
        { reset }
        ClientSocket := INVALID_SOCKET;
        { blocking:: will wait until connection request }
        ClientSocket := Winsock2.Accept(ServerSocket, @ClientAddr, @AddrSize);
        { accept it! }
        AcceptClient(ClientSocket, ClientAddr);
      except
        On E: Exception do
          if Assigned(OnErrorEvent) then
          begin
            BuildSocketError(@E);
            OnErrorEvent(@Error);
          end;
      end;
    until Terminated;
  end;
end;

procedure TTCPServerEx.AcceptClient(const Sock : TSocket; const Addr : sockaddr_in);
const
  FIONBIO_ = Int32(Winsock2.FIONBIO);

var
  I : SmallInt;
  Ptr : PClientSession;
  nonBlockingMode: Cardinal;
  FoundSlot : Boolean;
begin
  if Sock = INVALID_SOCKET then Exit;
  NonBlockingMode := 1;
  FoundSlot := False;

  {Mutex.Enter;
  try
  }
  { find next slot! }
  for i := Low(Sessions) to High(Sessions) do
  begin
    { occupied?! }
    if Sessions[i].iDescr <> 0 then continue;
    { we've found an empty spot, leave }
    FoundSlot := True;
    Sessions[i] := Default(TClientSession);
    break;
  end;
    {
  finally
    Mutex.Leave;
  end;  }

  { assign it! }
  if FoundSlot and (I <= High(Sessions)) then
  begin
    { pointer to session }
    Ptr := @Sessions[i];
    { if session-ptr is valid }
    if Ptr <> nil then
    begin
      { client socket }
      Ptr^.iDescr := Sock;
      Ptr^.iServer:= ServerSocket; { why?! }
      Ptr^.TimeStamp := Now;
      Ptr^.SocketInfo.Active := True;

      try
        { for later usage }
        GetSocketInfo(Ptr^.iDescr, @Ptr^.SocketInfo);
        { set it as non-blocking socket for recv call }
        if Winsock2.ioctlsocket(Ptr^.iDescr, FIONBIO_, NonBlockingMode) <> SOCKET_ERROR then
        begin
          { update total connected clients }
          InterlockedExchange(Clients, Clients +1);
          { reset active watch }
          Ptr^.Stats.LastActive := Now;
          { announce }
          if Assigned(OnClientJoin) then OnClientJoin(Clients, @Ptr^.SocketInfo);

          { clients live-on here in a separate process }
          PersistClient(Ptr, Task);
          { debug:
            if Debug <> nil then
              Debug.WriteLn(format('Client Connection: %s:%d, Total: %d of %d',
                [Ptr^.SocketInfo.AddrStr, Ptr^.SocketInfo.Port, Clients,
                  Length(Sessions)]), clOlive);
          }
        end;
      except
        On E: Exception do
          if Assigned(OnErrorEvent) then
          begin
            BuildSocketError(@E);
            OnErrorEvent(@Error);
          end;
      end;
    end;
  end
  { maximum limit has been reached! can't take more clients }
  else AlertLimit(Sock);
end;

{ clients live here! }
procedure TTCPServerEx.PersistClient(const Session: PClientSession; Task : TClientTaskHandle = nil);
begin
  TThread.CreateAnonymousThread(
  procedure
  var
    Buffer : TBuffer;
    Bytes : Integer;
  begin
    ZeroMemory(@Buffer.AsBytes[0], SizeOf(TBuffer));

    { clients live here until disconnect or socket closure }
    repeat
      { check for data on this socket -1:nothing }
      ZeroMemory(@Buffer.AsBytes[0], SizeOf(TBuffer));
      Bytes := Recv(Session^.iDescr, PByte(@Buffer.AsBytes[0])^, SizeOf(TBuffer), 0);

      { have we received anything? }
      if Bytes > 0 then
      begin
        { @ECHO is this an echo message? }
        if UseECHO then
        begin
          if UpperCase(String(Buffer.AsChars)) = ECHO then
          begin
            { respond to the @ECHO request }
            SendData(Session^.iDescr, @Buffer.AsBytes[0], Length(ECHO));
            { no need to proceed beyond this point! }
            continue;
          end;
        end;

        { count rx }
        if UseStats then AtomicExchange(Session^.Stats.Received,
          Session^.Stats.Received +1);
        { update last time socket was active }
        Session^.Stats.LastActive := Now;

        { assign and go run task! }
        if Assigned(Task) then
        begin
          Mutex.Enter;
          try
            Synchronize(nil,
            procedure
            begin
              Task(@Buffer.AsBytes[0], Bytes, Session);
            end);
          finally
            Mutex.Leave;
          end;
        end;

        { debug:
          Debug.WriteLn(format('Incoming Data [%s:%d]: %s',
            [Session^.SocketInfo.AddrStr, Session^.SocketInfo.Port,
              Buffer.AsChars]), clTeal);
        }
      end
      else TThread.Sleep(1);

      { closing is a shared resource, but all read and object writes }
    until (Bytes = 0{ client! }) or Closing{ server! } or Terminated{ server! };

    { client at this point has a problem or most likely disconnected! }
    if not Closing then
    begin
      { delete it! }
      Mutex.Enter;
      try
        { reduce # of connected clients }
        InterlockedExchange(Clients, Clients -1);
        { announce }
        Session^.SocketInfo.Size := 0;
        Session^.SocketInfo.Active := False;
        if Assigned(OnClientLeave) then OnClientLeave(Clients, @Session^.SocketInfo);

        { debug:
          if Debug <> nil then
          begin
            Debug.WriteLn(format('Client Disconnected: %s:%d, Total: %d of %d',
              [Session^.SocketInfo.AddrStr, Session^.SocketInfo.Port, Clients,
                Length(Sessions)]), clOlive);
          end;
        }
        if Shutdown(Session^.iDescr, SD_BOTH) = SOCKET_ERROR then AlertSocketError;
        CloseSocket(Session^.iDescr);

        { DeleteClient(Session); }
        Session^ := Default(TClientSession);
      finally
        Mutex.Leave;
      end;
    end;
  end).Start;
end;

function TTCPServerEx.GetClientAddress(const Socket: TSocket): String;
var
  I : SmallInt;
begin
  for i := Low(Sessions) to High(Sessions) do
    if Socket = Sessions[i].iDescr then
    begin
      Result := format('%s:%d', [Sessions[i].SocketInfo.AddrStr,
        Sessions[i].SocketInfo.Port]);
      break;
    end;
end;

