procedure PrintBufferToMemo(const Buffer : Array of Byte; Memo : Pointer = nil);
var
  S: String;
  C, ref, idx, i, index, L : Integer;
  B : Byte;
begin
  L := Length(Buffer);
  if L <= 0 then Exit;
  C := 0;
  index := 0;
  idx := 0;
  ref := 0;

  repeat
    S := '';
    if C >= 16 then C := 0;

    B := Buffer[index];
    S := IntToHex(B, 2);

    if (C = 7) then S := format('%s ', [S])
    else if (C = 15) or (index = L) then S := format('%s', [S])
    else S := format('%s:', [S]);

    if B > 0 then TRichEdit(Memo^).SelAttributes.Color := clNavy
    else TRichEdit(Memo^).SelAttributes.Color := clSkyBlue;
    TRichEdit(Memo^).SelText := S;

    if (C = 15) or (index = L) then
    begin
      Inc(idx);

      TRichEdit(Memo^).SelAttributes.Color := clGreen;
      if (index = L)then
      begin
        S := TRichEdit(Memo^).Lines[TRichEdit(Memo^).Lines.Count -1];
        if S[Length(S)] = ':' then
          Delete(S, Length(S), Length(S));

        for i := Length(S) to 46 do S := S +' ';
        TRichEdit(Memo^).Lines[TRichEdit(Memo^).Lines.Count -1] := S;
      end;
      TRichEdit(Memo^).SelAttributes.Color := clGreen;
      TRichEdit(Memo^).SelText := FormatFloat('    :0000', idx) +#13;
      if idx mod 8 = 0 then TRichEdit(Memo^).SelText := #13;
    end;

    Inc(C);
    if ref < 50 then Inc(ref)
    else
    begin
      ref := 0;
      Application.ProcessMessages;
    end;

    Inc(index);
  until (index = L);
end;

