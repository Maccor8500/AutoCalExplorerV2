procedure GetStyleNames(var Styles: TStringList);
var
  StyleName: string;
begin
  try
    if Styles = nil then
      Styles := TStringList.Create;
    Styles.Clear;
    { Safer enumeration }
    for StyleName in TStyleManager.StyleNames do
      Styles.Add(StyleName);
    { If no styles found, add default }
    if Styles.Count = 0 then
      Styles.Add('Windows');
  except
    on E: Exception do
    begin
      if Assigned(Styles) then
      begin
        Styles.Clear;
        Styles.Add('Windows');
      end;
    end;
  end;
end;

