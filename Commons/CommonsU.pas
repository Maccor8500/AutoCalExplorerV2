function TAdvFileWriter.AddFileA(const Path: String; Update: Boolean): Integer;
var
  FileRec: TAdvFileRecord;
  Index: Integer;
begin
  try
    if not FileExists(Path) then
    begin
      if not DirectoryExists(ExtractFileDir(Path)) then
        ForceDirectories(ExtractFileDir(Path));
    end;

    Index := Length(FileRecs);
    FileRec.Index := Index;
    FileRec.Path := Path;
    FileRec.Name := ExtractFilename(Path);
    FileRec.Handle := TStreamWriter.Create(Path, Update, TEncoding.UTF8);

    SetLength(FileRecs, Index +1);
    FileRecs[Index] := FileRec;
  finally
    Result := FileRec.Index;
  end;
end;

function TAdvFileWriter.AddFileB(const Path: String; Update: Boolean): PStreamWriter;
begin
  var Index := AddFileA(Path, Update);
  Result := @FileRecs[Index].Handle;
end;

function TAdvFileWriter.AddFileC(const Path: String; Update: Boolean): PAdvFileRecord;
begin
  var Index := AddFileA(Path, Update);
  Result := @FileRecs[Index];
end;

procedure TAdvFileWriter.Write(const Handle: TAdvFileHandle; const Str: String);
begin
  if (Handle < 0) or (Handle > High(FileRecs)) then Exit;

  if Assigned(FileRecs[Handle].Handle) then
    FileRecs[Handle].Handle.Write(Str);
end;

{TFileWriterEx}
constructor TFileWriterEx.Create(CacheSize : Integer = 500);
begin
  FCacheSz := CacheSize;
  Done := False;
end;

procedure TFileWriterEx.Cache(const Handle: THandle; const data: T2DWords; ReFmt : Boolean = false);
var
  HIndex : Integer;
begin
  if Handle = INVALID_HANDLE_VALUE then Exit;
  HIndex := IndexOfHandle(Handle);
  if HIndex < 0 then
    AddFile(Handle, HIndex);

  Files[HIndex].Cache[Files[HIndex].Count] := data;
  Inc(Files[HIndex].Count);

  if Files[HIndex].Count = FCacheSz then
  begin
    Files[HIndex].Count := 0;
    CopyMemory(@Files[HIndex].Shadow, @Files[HIndex].Cache, SizeOf(Files[HIndex].Cache));
    TThread.CreateAnonymousThread(
    procedure
    var
      I, J: Integer;
    begin
      J := HIndex;

      for I := 0 to FCacheSz -1 do
        Write(Handle, [Files[J].Shadow[i][0], Files[J].Shadow[i][1]]);
    end).Start;
  end;
end;

procedure TFileWriterEx.Close;
begin
end;

procedure TFileWriterEx.AddFile(const Handle : THandle; var Index : Integer);
var
  L : Integer;
begin
  L := Length(Files);
  SetLength(Files, L +1);
  Files[L].Handle := Handle;
  Index := L;

  SetLength(Files[L].Cache, FCacheSz);
  SetLength(Files[L].Shadow, FCacheSz);
end;

destructor TFileWriterEx.Destroy;
begin
  data_str := '';
  fmt_str := '';
end;

procedure TFileWriterEx.Dump;
var
  i, j: Integer;
begin
  for i := Low(Files) to High(Files) do
  begin
    if Files[i].Handle = INVALID_HANDLE_VALUE then continue;

    if Files[i].Count > 0 then
    begin
      CopyMemory(@Files[i].Shadow, @Files[i].Cache, SizeOf(Files[i].Cache));
      for j := 0 to Files[i].Count -1 do
        Write(Files[i].Handle, [Files[i].Shadow[j][0], Files[i].Shadow[j][1]]);

      Files[i].Count := 0;
      Sleep(100);
    end;


    SetLength(Files[i].Cache, 0);
    SetLength(Files[i].Shadow, 0);
  end;

  SetLength(Files, 0);
end;

function TFileWriterEx.IndexOfhandle(const Handle: THandle): Integer;
var
  i: Integer;
begin
  Result := -1;

  for i := Low(Files) to High(Files) do
  begin
    if Files[i].Handle = Handle then
    begin
      Result := i;
      Break;
    end;
  end;
end;

procedure TFileWriterEx.Open(const Filename: String; FileMode: Integer);
var
  Handle: THandle;
begin
  Handle := FileCreate(Filename);

end;

procedure TFileWriterEx.Write(const Handle : THandle; const data : array of const; ReFmt : Boolean = false);
var
  i : Integer;
begin
  if Handle = INVALID_HANDLE_VALUE then Exit;

  if fmt_str = '' then
  begin
    for i := Low(data) to High(data) do
      AddStr(fmt_str, '%d'#9);

    fmt_str := Trim(fmt_str);
  end

  else if ReFmt then
  begin
    for i := Low(data) to High(data)
      do AddStr(fmt_str, '%d'#9);

    fmt_str := Trim(fmt_str);
  end;

  data_str := format(fmt_str, data) +#13;
  FileWrite(Handle, PChar(data_str)^, Length(data_str) *SizeOf(Char));
end;

